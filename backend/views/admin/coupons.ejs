                " delete action."
            );
        }


        document
            .getElementById("createCouponModal")
            .addEventListener(
                "click",
                function(event) {

                    if (
                        event.target ===
                        document.getElementById("createCouponModal")
                    ) {
                        closeCreateCoupon();
                    }

                }
            );


        document
            .getElementById("viewCouponModal")
            .addEventListener(
                "click",
                function(event) {

                    if (
                        event.target ===
                        document.getElementById("viewCouponModal")
                    ) {
                        closeViewCoupon();
                    }

                }
            );

    </script>

