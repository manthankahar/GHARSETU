    <script>

        function openCreateCoupon() {
            document
                .getElementById("createCouponModal")
                .classList
                .add("show");
        }


        function closeCreateCoupon() {
            document
                .getElementById("createCouponModal")
                .classList
                .remove("show");
        }


        function closeViewCoupon() {
            document
                .getElementById("viewCouponModal")
                .classList
                .remove("show");
        }


        function createCoupon(event) {

            event.preventDefault();

            var code =
                document
                    .getElementById("couponCode")
                    .value
                    .trim()
                    .toUpperCase();

            var name =
                document
                    .getElementById("couponName")
                    .value
                    .trim();

            var type =
                document
                    .getElementById("discountType")
                    .value;

            var value =
                document
                    .getElementById("discountValue")
                    .value;

            if (!code || !name || !value) {
                alert("Please fill all required fields.");
                return;
            }

            alert(
                "Coupon " +
                code +
                " created successfully in demo mode."
            );

            closeCreateCoupon();

            event.target.reset();
        }


        function viewDemoCoupon(code) {

            document
                .getElementById("detailCode")
                .textContent = code;

            if (code === "GHAR50") {

                document
                    .getElementById("detailName")
                    .textContent = "Welcome Offer";

                document
                    .getElementById("detailDiscount")
                    .textContent = "50%";

                document
                    .getElementById("detailMinimum")
                    .textContent = "₹299";

                document
                    .getElementById("detailMaximum")
                    .textContent = "₹500";

                document
                    .getElementById("detailUsage")
                    .textContent = "420 / 1000";

                document
                    .getElementById("detailStatus")
                    .textContent = "Active";

                document
                    .getElementById("detailStart")
                    .textContent = "01/09/2026";

                document
                    .getElementById("detailExpiry")
                    .textContent = "30/09/2026";

            } else if (code === "TIFFIN100") {

                document
                    .getElementById("detailName")
                    .textContent = "Tiffin First Order";

                document
                    .getElementById("detailDiscount")
                    .textContent = "₹100";

                document
                    .getElementById("detailMinimum")
                    .textContent = "₹399";

                document
                    .getElementById("detailMaximum")
                    .textContent = "₹100";

                document
                    .getElementById("detailUsage")
                    .textContent = "185 / 500";

                document
                    .getElementById("detailStatus")
                    .textContent = "Active";

                document
                    .getElementById("detailStart")
                    .textContent = "01/09/2026";

                document
                    .getElementById("detailExpiry")
                    .textContent = "15/09/2026";

            } else {

                document
                    .getElementById("detailName")
                    .textContent = "GharSetu Campaign";

                document
                    .getElementById("detailDiscount")
                    .textContent = "Special Offer";

                document
                    .getElementById("detailMinimum")
                    .textContent = "₹299";

                document
                    .getElementById("detailMaximum")
                    .textContent = "₹500";

                document
                    .getElementById("detailUsage")
                    .textContent = "Demo Usage";

                document
                    .getElementById("detailStatus")
                    .textContent = "Campaign";

                document
                    .getElementById("detailStart")
                    .textContent = "01/09/2026";

                document
                    .getElementById("detailExpiry")
                    .textContent = "30/09/2026";
            }

            document
                .getElementById("viewCouponModal")
                .classList
                .add("show");
        }


        function viewCoupon(id) {

            fetch("/admin/coupons/" + id)
                .then(function(response) {

                    if (!response.ok) {
                        throw new Error("Failed to load coupon.");
                    }

                    return response.json();

                })
                .then(function(data) {

                    if (!data || !data.coupon) {
                        throw new Error("Coupon data not found.");
                    }

                    var coupon = data.coupon;

                    document
                        .getElementById("detailCode")
                        .textContent =
                        coupon.code || "COUPON";

                    document
                        .getElementById("detailName")
                        .textContent =
                        coupon.name || "Discount Campaign";

                    document
                        .getElementById("detailDiscount")
                        .textContent =
                        coupon.discountType === "percentage"
                            ? (coupon.discountValue || 0) + "%"
                            : "₹" + (coupon.discountValue || 0);

                    document
                        .getElementById("detailMinimum")
                        .textContent =
                        "₹" + (coupon.minimumOrder || 0);

                    document
                        .getElementById("detailMaximum")
                        .textContent =
                        coupon.maximumDiscount
                            ? "₹" + coupon.maximumDiscount
                            : "-";

                    document
                        .getElementById("detailUsage")
                        .textContent =
                        (coupon.usedCount || 0) +
                        " / " +
                        (coupon.usageLimit || "∞");

                    document
                        .getElementById("detailStatus")
                        .textContent =
                        coupon.status || "Active";

                    document
                        .getElementById("detailStart")
                        .textContent =
                        coupon.startDate
                            ? new Date(coupon.startDate).toLocaleDateString()
                            : "-";

                    document
                        .getElementById("detailExpiry")
                        .textContent =
                        coupon.expiryDate
                            ? new Date(coupon.expiryDate).toLocaleDateString()
                            : "-";

                    document
                        .getElementById("viewCouponModal")
                        .classList
                        .add("show");

                })
                .catch(function(error) {

                    console.error(error);

                    alert(
                        "Coupon details are not connected yet."
                    );

                });
        }


        function editCoupon(id) {

            alert(
                "Edit feature backend connection pachi activate karishu."
            );
        }


        function deleteCoupon(id) {

            var confirmDelete =
                confirm(
