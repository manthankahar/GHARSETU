
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GharSetu | Coupons & Discounts</title>

    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/coupons.css">
    <link rel="stylesheet" href="/css/admin-sidebar.css">
</head>

<body>

    <%
        const currentAdmin =
            typeof admin !== "undefined" && admin
                ? admin
                : null;

        const couponList =
            typeof coupons !== "undefined" && Array.isArray(coupons)
                ? coupons
                : [];

        const currentSearch =
            typeof search !== "undefined" && search
                ? search
                : "";

        const currentStatus =
            typeof status !== "undefined" && status
                ? status
                : "";

        const couponCount =
            typeof totalCoupons !== "undefined"
                ? totalCoupons
                : couponList.length;

        const activeCount =
            typeof activeCoupons !== "undefined"
                ? activeCoupons
                : couponList.filter(c => c.status === "active").length;

        const expiredCount =
            typeof expiredCoupons !== "undefined"
                ? expiredCoupons
                : couponList.filter(c => c.status === "expired").length;

        const usageCount =
            typeof totalCouponUsage !== "undefined"
                ? totalCouponUsage
                : couponList.reduce((sum, c) => sum + (Number(c.usedCount) || 0), 0);
    %>

    <!-- SIDEBAR -->
    <%- include("../partials/adminSidebar", {
        admin: currentAdmin,
        activePage: "coupons"
    }) %>

    <!-- MAIN -->
    <main class="main">

        <header class="topbar">

            <div class="page-title">
                <h1>Coupons & Discounts</h1>
                <p>Manage promotional offers and discount campaigns</p>
            </div>

            <div class="admin-area">
                <div class="admin-info">
                    <div class="admin-name">
                        <%= currentAdmin?.name || "Administrator" %>
                    </div>

                    <div class="admin-role">GharSetu Admin</div>
                </div>

                <div class="admin-avatar">
                    <%= (currentAdmin?.name || "A").charAt(0).toUpperCase() %>
                </div>
            </div>

        </header>

        <section class="content">

            <!-- STATS -->
            <div class="stats-grid">

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon">🎟</div>
                    </div>
                    <div class="stat-label">Total Coupons</div>
                    <div class="stat-value"><%= couponCount %></div>
                    <div class="stat-note">All created coupons</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon">✓</div>
                    </div>
                    <div class="stat-label">Active Coupons</div>
                    <div class="stat-value"><%= activeCount %></div>
                    <div class="stat-note">Currently available</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon">⏱</div>
                    </div>
                    <div class="stat-label">Expired Coupons</div>
                    <div class="stat-value"><%= expiredCount %></div>
                    <div class="stat-note">Campaigns ended</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon">📈</div>
                    </div>
                    <div class="stat-label">Total Usage</div>
                    <div class="stat-value"><%= usageCount.toLocaleString("en-IN") %></div>
                    <div class="stat-note">Coupon redemptions</div>
                </div>

            </div>

            <!-- SEARCH AND FILTER -->
            <div class="toolbar">

                <form method="GET" action="/admin/coupons">
                    <div class="toolbar-row">

                        <div class="search-box">
                            <span>⌕</span>

                            <input
                                type="text"
                                name="search"
                                value="<%= currentSearch %>"
                                placeholder="Search coupon code or campaign..."
                            >
                        </div>

                        <select name="status" class="filter-select">
                            <option value="">All Status</option>

                            <option value="active"
                                <%= currentStatus === "active" ? "selected" : "" %>>
                                Active
                            </option>

                            <option value="inactive"
                                <%= currentStatus === "inactive" ? "selected" : "" %>>
                                Inactive
                            </option>

                            <option value="scheduled"
                                <%= currentStatus === "scheduled" ? "selected" : "" %>>
                                Scheduled
                            </option>

                            <option value="expired"
                                <%= currentStatus === "expired" ? "selected" : "" %>>
                                Expired
                            </option>
                        </select>

                        <button type="submit" class="btn btn-secondary">
                            Filter
                        </button>

                        <button
                            type="button"
                            class="btn btn-primary"
                            onclick="openCreateCoupon()"
                        >
                            + Create Coupon
                        </button>

                    </div>
                </form>

            </div>

            <!-- COUPON TABLE -->
            <div class="table-card">

                <div class="table-header">
                    <div>
                        <h2>Coupon Management</h2>
                        <span>Manage GharSetu promotional campaigns</span>
                    </div>

                    <span><%= couponList.length %> coupons</span>
                </div>

                <div class="table-wrapper">

                    <% if (couponList.length > 0) { %>

                        <table>
                            <thead>
                                <tr>
                                    <th>Coupon</th>
                                    <th>Discount</th>
                                    <th>Minimum Order</th>
                                    <th>Usage</th>
                                    <th>Validity</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% couponList.forEach(function(coupon) { %>

                                    <%
                                        const usedCount = Number(coupon.usedCount) || 0;
                                        const usageLimit = Number(coupon.usageLimit) || 0;

                                        const usagePercentage = usageLimit > 0
                                            ? Math.min((usedCount / usageLimit) * 100, 100)
                                            : 0;

                                        const rowStatus = coupon.status || "active";
                                    %>

                                    <tr>
                                        <td>
                                            <div class="coupon-code">
                                                🎟 <%= coupon.code || "COUPON" %>
                                            </div>

                                            <div class="small-text">
                                                <%= coupon.name || "Discount Campaign" %>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="discount-value">
                                                <% if (coupon.discountType === "percentage") { %>
                                                    <%= Number(coupon.discountValue) || 0 %>%
                                                <% } else { %>
                                                    ₹<%= Number(coupon.discountValue) || 0 %>
                                                <% } %>
                                            </div>

                                            <div class="small-text">
                                                <%= coupon.discountType === "percentage"
                                                    ? "Percentage discount"
                                                    : "Fixed discount" %>
                                            </div>
                                        </td>

                                        <td>
                                            <strong>
                                                ₹<%= Number(coupon.minimumOrder) || 0 %>
                                            </strong>
                                        </td>

                                        <td>
                                            <div class="usage">
                                                <%= usedCount %> /
                                                <%= usageLimit > 0 ? usageLimit : "∞" %>
                                            </div>

<% if (usageLimit > 0) { %>
    <div class="usage-bar">
        <div
            class="usage-fill"
            data-usage="<%= usagePercentage %>"
        ></div>
    </div>
<% } %>
                                        </td>

                                        <td>
                                            <div>
                                                <%= coupon.startDate
                                                    ? new Date(coupon.startDate).toLocaleDateString("en-IN")
                                                    : "-" %>
                                            </div>

                                            <div class="small-text">
                                                to
                                                <%= coupon.expiryDate
                                                    ? new Date(coupon.expiryDate).toLocaleDateString("en-IN")
                                                    : "-" %>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="status <%= rowStatus %>">
                                                <%= rowStatus.charAt(0).toUpperCase() + rowStatus.slice(1) %>
                                            </span>
                                        </td>

                                        <td>
                                            <div class="actions">
                                                <button
                                                    type="button"
                                                    class="action-btn"
                                                    title="View Coupon"
                                                    onclick="viewCoupon('<%= coupon._id %>')"
                                                >👁</button>

                                                <button
                                                    type="button"
                                                    class="action-btn"
                                                    title="Edit Coupon"
                                                    onclick="editCoupon('<%= coupon._id %>')"
                                                >✎</button>

                                                <button
                                                    type="button"
                                                    class="action-btn delete"
                                                    title="Delete Coupon"
                                                    onclick="deleteCoupon('<%= coupon._id %>')"
                                                >🗑</button>
                                            </div>
                                        </td>
                                    </tr>

                                <% }) %>
                            </tbody>
                        </table>

                    <% } else { %>

                        <div class="empty-state">
                            <div class="empty-icon">🎟</div>
                            <h3>No coupons found</h3>
                            <p>
                                No coupons match your search. Create a coupon
                                to start a promotional campaign.
                            </p>

                            <button
                                type="button"
                                class="btn btn-primary"
                                onclick="openCreateCoupon()"
                            >
                                + Create Coupon
                            </button>
                        </div>

                    <% } %>

                </div>
            </div>

        </section>
    </main>

    <!-- CREATE COUPON MODAL -->
    <div class="modal-overlay" id="createCouponModal">
        <div class="modal">

            <div class="modal-header">
                <h2>Create New Coupon</h2>

                <button
                    type="button"
                    class="modal-close"
                    onclick="closeCreateCoupon()"
                >×</button>
            </div>

            <form id="createCouponForm" onsubmit="createCoupon(event)">

                <div class="modal-body">
                    <div class="form-grid">

                        <div class="form-group">
                            <label for="couponCode">Coupon Code</label>
                            <input
                                type="text"
                                id="couponCode"
                                class="coupon-input"
                                placeholder="Example: GHAR50"
                                maxlength="30"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="couponName">Campaign Name</label>
                            <input
                                type="text"
                                id="couponName"
                                class="coupon-input"
                                placeholder="Example: Welcome Offer"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="discountType">Discount Type</label>
                            <select id="discountType" class="coupon-select" required>
                                <option value="percentage">Percentage</option>
                                <option value="fixed">Fixed Amount</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="discountValue">Discount Value</label>
                            <input
                                type="number"
                                id="discountValue"
                                class="coupon-input"
                                placeholder="50"
                                min="1"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="minimumOrder">Minimum Order (₹)</label>
                            <input
                                type="number"
                                id="minimumOrder"
                                class="coupon-input"
                                placeholder="299"
                                min="0"
                                value="0"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="maximumDiscount">Maximum Discount (₹)</label>
                            <input
                                type="number"
                                id="maximumDiscount"
                                class="coupon-input"
                                placeholder="500"
                                min="0"
                            >
                        </div>

                        <div class="form-group">
                            <label for="startDate">Start Date</label>
                            <input
                                type="date"
                                id="startDate"
                                class="coupon-input"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="expiryDate">Expiry Date</label>
                            <input
                                type="date"
                                id="expiryDate"
                                class="coupon-input"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="usageLimit">Usage Limit</label>
                            <input
                                type="number"
                                id="usageLimit"
                                class="coupon-input"
                                placeholder="1000"
                                min="1"
                            >
                        </div>

                        <div class="form-group">
                            <label for="couponStatus">Status</label>
                            <select id="couponStatus" class="coupon-select" required>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                                <option value="scheduled">Scheduled</option>
                            </select>
                        </div>

                        <div class="form-group full">
                            <label for="couponDescription">Description</label>
                            <textarea
                                id="couponDescription"
                                class="coupon-input"
                                placeholder="Write a short campaign description..."
                            ></textarea>
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button
                        type="button"
                        class="btn btn-secondary"
                        onclick="closeCreateCoupon()"
                    >Cancel</button>

                    <button type="submit" class="btn btn-primary">
                        Create Coupon
                    </button>
                </div>

            </form>
        </div>
    </div>

    <!-- VIEW COUPON MODAL -->
    <div class="modal-overlay" id="viewCouponModal">
        <div class="modal">

            <div class="modal-header">
                <h2>Coupon Details</h2>

                <button
                    type="button"
                    class="modal-close"
                    onclick="closeViewCoupon()"
                >×</button>
            </div>

            <div class="modal-body">

                <div class="detail-code">
                    <small>COUPON CODE</small>
                    <strong id="detailCode">COUPON</strong>
                </div>

                <div class="detail-grid">

                    <div class="detail-item">
                        <small>Campaign Name</small>
                        <strong id="detailName">-</strong>
                    </div>

                    <div class="detail-item">
                        <small>Discount</small>
                        <strong id="detailDiscount">-</strong>
                    </div>

                    <div class="detail-item">
                        <small>Minimum Order</small>
                        <strong id="detailMinimum">-</strong>
                    </div>

                    <div class="detail-item">
                        <small>Maximum Discount</small>
                        <strong id="detailMaximum">-</strong>
                    </div>

                    <div class="detail-item">
                        <small>Usage</small>
                        <strong id="detailUsage">-</strong>
                    </div>

                    <div class="detail-item">
                        <small>Status</small>
                        <strong id="detailStatus">-</strong>
                    </div>

                    <div class="detail-item">
                        <small>Start Date</small>
                        <strong id="detailStart">-</strong>
                    </div>

                    <div class="detail-item">
                        <small>Expiry Date</small>
                        <strong id="detailExpiry">-</strong>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button
                    type="button"
                    class="btn btn-secondary"
                    onclick="closeViewCoupon()"
                >Close</button>
            </div>

        </div>
    </div>

    <script src="/js/admin/coupons.js"></script>

</body>
</html>
