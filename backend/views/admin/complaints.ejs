
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complaints Management | GHARSETU</title>

    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/complaints.css">
    <link rel="stylesheet" href="/css/admin-sidebar.css">
</head>

<body>

    <%- include("../partials/adminSidebar", {
        admin: typeof admin !== "undefined" ? admin : null,
        activePage: "complaints"
    }) %>

    <main class="admin-main">

        <section class="page-header">
            <div>
                <h1>Complaints Management</h1>
                <p>Manage customer and partner complaints</p>
            </div>
        </section>

        <!-- Statistics -->
        <section class="stats-grid">

            <div class="stat-card">
                <span class="stat-title">Total Complaints</span>
                <strong><%= typeof totalComplaints !== "undefined" ? totalComplaints : 0 %></strong>
            </div>

            <div class="stat-card pending">
                <span class="stat-title">Pending</span>
                <strong><%= typeof pendingComplaints !== "undefined" ? pendingComplaints : 0 %></strong>
            </div>

            <div class="stat-card progress">
                <span class="stat-title">In Progress</span>
                <strong><%= typeof inProgressComplaints !== "undefined" ? inProgressComplaints : 0 %></strong>
            </div>

            <div class="stat-card resolved">
                <span class="stat-title">Resolved</span>
                <strong><%= typeof resolvedComplaints !== "undefined" ? resolvedComplaints : 0 %></strong>
            </div>

            <div class="stat-card closed">
                <span class="stat-title">Closed</span>
                <strong><%= typeof closedComplaints !== "undefined" ? closedComplaints : 0 %></strong>
            </div>

        </section>

        <!-- Filters -->
        <section class="filter-card">
            <form method="GET" action="/admin/complaints">

                <div class="search-box">
                    <input
                        type="text"
                        name="search"
                        placeholder="Search complaint, name, mobile..."
                        value="<%= typeof search !== 'undefined' ? search : '' %>"
                    >
                </div>

                <select name="status">
                    <option value="all" <%= (typeof status !== "undefined" ? status : "all") === "all" ? "selected" : "" %>>
                        All Status
                    </option>
                    <option value="pending" <%= status === "pending" ? "selected" : "" %>>
                        Pending
                    </option>
                    <option value="in_progress" <%= status === "in_progress" ? "selected" : "" %>>
                        In Progress
                    </option>
                    <option value="resolved" <%= status === "resolved" ? "selected" : "" %>>
                        Resolved
                    </option>
                    <option value="closed" <%= status === "closed" ? "selected" : "" %>>
                        Closed
                    </option>
                </select>

                <select name="role">
                    <option value="all" <%= (typeof role !== "undefined" ? role : "all") === "all" ? "selected" : "" %>>
                        All Users
                    </option>
                    <option value="customer" <%= role === "customer" ? "selected" : "" %>>
                        Customer
                    </option>
                    <option value="restaurant" <%= role === "restaurant" ? "selected" : "" %>>
                        Restaurant
                    </option>
                    <option value="tiffinSeller" <%= role === "tiffinSeller" ? "selected" : "" %>>
                        Tiffin Seller
                    </option>
                    <option value="delivery" <%= role === "delivery" ? "selected" : "" %>>
                        Delivery Partner
                    </option>
                </select>

                <button type="submit" class="filter-btn">Search</button>
                <a href="/admin/complaints" class="reset-btn">Reset</a>

            </form>
        </section>

        <!-- Complaints Table -->
        <section class="table-card">

            <div class="table-header">
                <h2>Complaints</h2>
                <span>
                    <%= typeof complaints !== "undefined" && complaints ? complaints.length : 0 %>
                    results
                </span>
            </div>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Complaint</th>
                            <th>User</th>
                            <th>Role</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (typeof complaints === "undefined" || !complaints || complaints.length === 0) { %>

                            <tr>
                                <td colspan="7" class="empty">No complaints found.</td>
                            </tr>

                        <% } else { %>

                            <% complaints.forEach(function(complaint) { %>
                                <tr>

                                    <td>
                                        <div class="complaint-title">
                                            <strong>
                                                <%= complaint.subject || "Untitled Complaint" %>
                                            </strong>
                                            <small>
                                                <%= complaint.description
                                                    ? (complaint.description.length > 70
                                                        ? complaint.description.substring(0, 70) + "..."
                                                        : complaint.description)
                                                    : "No description available"
                                                %>
                                            </small>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="user-info">
                                            <strong>
                                                <%= complaint.complainantName ||
                                                    (complaint.complainant
                                                        ? complaint.complainant.name
                                                        : "Unknown")
                                                %>
                                            </strong>
                                            <small>
                                                <%= complaint.complainantMobile ||
                                                    (complaint.complainant
                                                        ? complaint.complainant.mobile
                                                        : "-")
                                                %>
                                            </small>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="role-badge">
                                            <%= complaint.complainantRole || "Unknown" %>
                                        </span>
                                    </td>

                                    <td><%= complaint.category || "-" %></td>

                                    <td>
                                        <% const complaintStatus = complaint.status || "pending"; %>
                                        <span class="status-badge status-<%= complaintStatus %>">
                                            <%= complaintStatus.replace("_", " ") %>
                                        </span>
                                    </td>

                                    <td>
                                        <%= complaint.createdAt
                                            ? new Date(complaint.createdAt).toLocaleDateString("en-IN")
                                            : "-"
                                        %>
                                    </td>

                                    <td>
                                        <button
                                            type="button"
                                            class="view-btn"
                                            data-id="<%= complaint._id %>"
                                            onclick="openComplaint(this.dataset.id)"
                                        >
                                            View
                                        </button>
                                    </td>

                                </tr>
                            <% }); %>

                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <!-- Complaint Details Modal -->
    <div id="complaintModal" class="modal">
        <div class="modal-box">

            <button
                type="button"
                class="close-btn"
                onclick="closeComplaint()"
                aria-label="Close complaint details"
            >&times;</button>

            <h2>Complaint Details</h2>
            <div id="complaintDetails">Loading...</div>

        </div>
    </div>

    <script>
        "use strict";

        async function openComplaint(id) {
            const modal = document.getElementById("complaintModal");
            const details = document.getElementById("complaintDetails");

            modal.classList.add("show");

            details.innerHTML =
                '<div class="detail-row"><p>Loading complaint details...</p></div>';

            try {
                const response = await fetch(
                    "/admin/complaints/" + encodeURIComponent(id),
                    {
                        headers: { "Accept": "application/json" }
                    }
                );

                const data = await response.json();

                if (!response.ok || !data.success || !data.complaint) {
                    details.innerHTML =
                        '<div class="detail-row"><p>' +
                        escapeHtml(data.message || "Complaint not found.") +
                        '</p></div>';
                    return;
                }

                const complaint = data.complaint;

                const subject = complaint.subject || "Untitled Complaint";
                const description = complaint.description || "No description available";

                const complainantName =
                    complaint.complainantName ||
                    (complaint.complainant
                        ? complaint.complainant.name
                        : "Unknown");

                const complainantMobile =
                    complaint.complainantMobile ||
                    (complaint.complainant
                        ? complaint.complainant.mobile
                        : "-");

                const category = complaint.category || "-";
                const currentStatus = complaint.status || "pending";
                const adminResponse = complaint.adminResponse || "";
                const complaintId = String(complaint._id || id);

                let html = "";

                html += `
                    <div class="detail-row">
                        <label>Subject</label>
                        <p>${escapeHtml(subject)}</p>
                    </div>

                    <div class="detail-row">
                        <label>Description</label>
                        <p>${escapeHtml(description)}</p>
                    </div>

                    <div class="detail-row">
                        <label>User</label>
                        <p>${escapeHtml(complainantName)}</p>
                    </div>

                    <div class="detail-row">
                        <label>Mobile</label>
                        <p>${escapeHtml(complainantMobile)}</p>
                    </div>

                    <div class="detail-row">
                        <label>Category</label>
                        <p>${escapeHtml(category)}</p>
                    </div>

                    <div class="detail-row">
                        <label>Status</label>
                        <select id="statusSelect">
                            <option value="pending" ${currentStatus === "pending" ? "selected" : ""}>Pending</option>
                            <option value="in_progress" ${currentStatus === "in_progress" ? "selected" : ""}>In Progress</option>
                            <option value="resolved" ${currentStatus === "resolved" ? "selected" : ""}>Resolved</option>
                            <option value="closed" ${currentStatus === "closed" ? "selected" : ""}>Closed</option>
                        </select>
                        <button
                            type="button"
                            class="reply-btn"
                            data-id="${escapeHtml(complaintId)}"
                            onclick="updateStatus(this.dataset.id)"
                        >Save Status</button>
                    </div>

                    <div class="reply-section">
                        <label for="adminReply">Admin Reply</label>
                        <textarea
                            id="adminReply"
                            placeholder="Write your response..."
                        >${escapeHtml(adminResponse)}</textarea>

                        <button
                            type="button"
                            class="reply-btn"
                            data-id="${escapeHtml(complaintId)}"
                            onclick="sendReply(this.dataset.id)"
                        >Send Reply</button>
                    </div>

                    <button
                        type="button"
                        class="delete-btn"
                        data-id="${escapeHtml(complaintId)}"
                        onclick="deleteComplaint(this.dataset.id)"
                    >Delete Complaint</button>
                `;

                details.innerHTML = html;

            } catch (error) {
                console.error("COMPLAINT DETAILS ERROR:", error);

                details.innerHTML =
                    '<div class="detail-row"><p>Failed to load complaint. Please try again.</p></div>';
            }
        }

        async function updateStatus(id) {
            const select = document.getElementById("statusSelect");

            if (!select) return;

            const status = select.value;

            try {
                const response = await fetch(
                    "/admin/complaints/" + encodeURIComponent(id) + "/status",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json"
                        },
                        body: JSON.stringify({ status })
                    }
                );

                const data = await response.json();

                if (response.ok && data.success) {
                    alert("Status updated successfully.");
                    window.location.reload();
                } else {
                    alert(data.message || "Failed to update status.");
                }

            } catch (error) {
                console.error("UPDATE STATUS ERROR:", error);
                alert("Server error while updating status.");
            }
        }

        async function sendReply(id) {
            const textarea = document.getElementById("adminReply");

            if (!textarea) return;

            const adminResponse = textarea.value.trim();

            if (!adminResponse) {
                alert("Please write a reply.");
                textarea.focus();
                return;
            }

            try {
                const response = await fetch(
                    "/admin/complaints/" + encodeURIComponent(id) + "/reply",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json"
                        },
                        body: JSON.stringify({ adminResponse })
                    }
                );

                const data = await response.json();

                if (response.ok && data.success) {
                    alert("Reply sent successfully.");
                    window.location.reload();
                } else {
                    alert(data.message || "Failed to send reply.");
                }

            } catch (error) {
                console.error("SEND REPLY ERROR:", error);
                alert("Server error while sending reply.");
            }
        }

        async function deleteComplaint(id) {
            const confirmDelete = confirm(
                "Are you sure you want to delete this complaint?"
            );

            if (!confirmDelete) return;

            try {
                const response = await fetch(
                    "/admin/complaints/" + encodeURIComponent(id) + "/delete",
                    {
                        method: "POST",
                        headers: { "Accept": "application/json" }
                    }
                );

                const data = await response.json();

                if (response.ok && data.success) {
                    alert("Complaint deleted successfully.");
                    window.location.reload();
                } else {
                    alert(data.message || "Failed to delete complaint.");
                }

            } catch (error) {
                console.error("DELETE COMPLAINT ERROR:", error);
                alert("Server error while deleting complaint.");
            }
        }

        function closeComplaint() {
            const modal = document.getElementById("complaintModal");

            if (modal) {
                modal.classList.remove("show");
            }
        }

        const complaintModal = document.getElementById("complaintModal");

        if (complaintModal) {
            complaintModal.addEventListener("click", function(event) {
                if (event.target === complaintModal) {
                    closeComplaint();
                }
            });
        }

        document.addEventListener("keydown", function(event) {
            if (event.key === "Escape") {
                closeComplaint();
            }
        });

        function escapeHtml(value) {
            if (value === null || value === undefined) return "";

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>

</body>
</html>
