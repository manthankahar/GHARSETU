<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Admin | Complaints</title>

    <link rel="stylesheet" href="/css/admin.css">

</head>


<body>


<!-- =====================================================
     SIDEBAR
===================================================== -->

<%- include("../partials/adminSidebar") %>


<!-- =====================================================
     MAIN
===================================================== -->

<main class="admin-main">


    <!-- HEADER -->

    <section class="page-header">

        <div>

            <h1>
                Complaints Management
            </h1>

            <p>
                Manage customer and partner complaints
            </p>

        </div>

    </section>



    <!-- =================================================
         STATISTICS
    ================================================== -->

    <section class="stats-grid">


        <div class="stat-card">

            <span class="stat-title">
                Total
            </span>

            <strong>
                <%= totalComplaints %>
            </strong>

        </div>


        <div class="stat-card pending">

            <span class="stat-title">
                Pending
            </span>

            <strong>
                <%= pendingComplaints %>
            </strong>

        </div>


        <div class="stat-card progress">

            <span class="stat-title">
                In Progress
            </span>

            <strong>
                <%= inProgressComplaints %>
            </strong>

        </div>


        <div class="stat-card resolved">

            <span class="stat-title">
                Resolved
            </span>

            <strong>
                <%= resolvedComplaints %>
            </strong>

        </div>


        <div class="stat-card closed">

            <span class="stat-title">
                Closed
            </span>

            <strong>
                <%= closedComplaints %>
            </strong>

        </div>


    </section>



    <!-- =================================================
         FILTER
    ================================================== -->

    <section class="filter-card">


        <form
            method="GET"
            action="/admin/complaints"
        >


            <div class="search-box">

                <input
                    type="text"
                    name="search"
                    placeholder="Search complaint, name, mobile..."
                    value="<%= search %>"
                >

            </div>


            <select name="status">

                <option
                    value="all"
                    <%= status === "all" ? "selected" : "" %>
                >
                    All Status
                </option>

                <option
                    value="pending"
                    <%= status === "pending" ? "selected" : "" %>
                >
                    Pending
                </option>

                <option
                    value="in_progress"
                    <%= status === "in_progress" ? "selected" : "" %>
                >
                    In Progress
                </option>

                <option
                    value="resolved"
                    <%= status === "resolved" ? "selected" : "" %>
                >
                    Resolved
                </option>

                <option
                    value="closed"
                    <%= status === "closed" ? "selected" : "" %>
                >
                    Closed
                </option>

            </select>


            <select name="role">

                <option
                    value="all"
                    <%= role === "all" ? "selected" : "" %>
                >
                    All Users
                </option>

                <option
                    value="customer"
                    <%= role === "customer" ? "selected" : "" %>
                >
                    Customer
                </option>

                <option
                    value="restaurant"
                    <%= role === "restaurant" ? "selected" : "" %>
                >
                    Restaurant
                </option>

                <option
                    value="tiffinSeller"
                    <%= role === "tiffinSeller" ? "selected" : "" %>
                >
                    Tiffin Seller
                </option>

                <option
                    value="delivery"
                    <%= role === "delivery" ? "selected" : "" %>
                >
                    Delivery Partner
                </option>

            </select>


            <button
                type="submit"
                class="filter-btn"
            >
                Search
            </button>


            <a
                href="/admin/complaints"
                class="reset-btn"
            >
                Reset
            </a>


        </form>


    </section>



    <!-- =================================================
         TABLE
    ================================================== -->

    <section class="table-card">


        <div class="table-header">

            <h2>
                Complaints
            </h2>

            <span>
                <%= complaints.length %> results
            </span>

        </div>


        <div class="table-wrapper">


            <table>


                <thead>

                    <tr>

                        <th>
                            Complaint
                        </th>

                        <th>
                            User
                        </th>

                        <th>
                            Role
                        </th>

                        <th>
                            Category
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <% if (complaints.length === 0) { %>


                        <tr>

                            <td
                                colspan="7"
                                class="empty"
                            >
                                No complaints found.
                            </td>

                        </tr>


                    <% } %>


                    <% complaints.forEach(complaint => { %>


                        <tr>


                            <td>

                                <div class="complaint-title">

                                    <strong>
                                        <%= complaint.subject %>
                                    </strong>

                                    <small>
                                        <%= complaint.description.length > 70
                                            ? complaint.description.substring(0, 70) + "..."
                                            : complaint.description
                                        %>
                                    </small>

                                </div>

                            </td>


                            <td>

                                <div class="user-info">

                                    <strong>
                                        <%= complaint.complainantName ||
                                            (complaint.complainant
                                                ? complaint.complainant.name
                                                : "Unknown")
                                        %>
                                    </strong>

                                    <small>
                                        <%= complaint.complainantMobile ||
                                            (complaint.complainant
                                                ? complaint.complainant.mobile
                                                : "-")
                                        %>
                                    </small>

                                </div>

                            </td>


                            <td>

                                <span class="role-badge">

                                    <%= complaint.complainantRole %>

                                </span>

                            </td>


                            <td>

                                <%= complaint.category %>

                            </td>


                            <td>

                                <span
                                    class="status-badge status-<%= complaint.status %>"
                                >

                                    <%= complaint.status.replace(
                                        "_",
                                        " "
                                    ) %>

                                </span>

                            </td>


                            <td>

                                <%= new Date(
                                    complaint.createdAt
                                ).toLocaleDateString(
                                    "en-IN"
                                ) %>

                            </td>


                            <td>

                                <button
                                    class="view-btn"
                                    onclick="openComplaint('<%= complaint._id %>')"
                                >
                                    View
                                </button>

                            </td>


                        </tr>


                    <% }) %>


                </tbody>


            </table>


        </div>


    </section>


</main>



<!-- =====================================================
     MODAL
===================================================== -->

<div
    id="complaintModal"
    class="modal"
>


    <div class="modal-box">


        <button
            class="close-btn"
            onclick="closeComplaint()"
        >
            ×
        </button>


        <h2>
            Complaint Details
        </h2>


        <div id="complaintDetails">

            Loading...

        </div>


    </div>

</div>



<script>

async function openComplaint(id) {

    const modal =
        document.getElementById(
            "complaintModal"
        );

    const details =
        document.getElementById(
            "complaintDetails"
        );


    modal.classList.add("show");

    details.innerHTML =
        "Loading...";


    try {

        const response =
            await fetch(
                "/admin/complaints/" + id
            );


        const data =
            await response.json();


        if (!data.success) {

            details.innerHTML =
                "<p>Complaint not found.</p>";

            return;

        }


        const complaint =
            data.complaint;


        details.innerHTML = `

            <div class="detail-row">

                <label>Subject</label>

                <p>
                    ${escapeHtml(
                        complaint.subject
                    )}
                </p>

            </div>


            <div class="detail-row">

                <label>Description</label>

                <p>
                    ${escapeHtml(
                        complaint.description
                    )}
                </p>

            </div>


            <div class="detail-row">

                <label>User</label>

                <p>
                    ${escapeHtml(
                        complaint.complainantName ||
                        (
                            complaint.complainant
                                ? complaint.complainant.name
                                : "Unknown"
                        )
                    )}
                </p>

            </div>


            <div class="detail-row">

                <label>Mobile</label>

                <p>
                    ${escapeHtml(
                        complaint.complainantMobile ||
                        (
                            complaint.complainant
                                ? complaint.complainant.mobile
                                : "-"
                        )
                    )}
                </p>

            </div>


            <div class="detail-row">

                <label>Category</label>

                <p>
                    ${escapeHtml(
                        complaint.category
                    )}
                </p>

            </div>


            <div class="detail-row">

                <label>Status</label>

                <select
                    id="statusSelect"
                    onchange="updateStatus('${complaint._id}')"
                >

                    <option value="pending"
                        ${complaint.status === "pending" ? "selected" : ""}>
                        Pending
                    </option>

                    <option value="in_progress"
                        ${complaint.status === "in_progress" ? "selected" : ""}>
                        In Progress
                    </option>

                    <option value="resolved"
                        ${complaint.status === "resolved" ? "selected" : ""}>
                        Resolved
                    </option>

                    <option value="closed"
                        ${complaint.status === "closed" ? "selected" : ""}>
                        Closed
                    </option>

                </select>

            </div>


            <div class="reply-section">

                <label>
                    Admin Reply
                </label>

                <textarea
                    id="adminReply"
                    placeholder="Write your response..."
                >${escapeHtml(
                    complaint.adminResponse || ""
                )}</textarea>


                <button
                    class="reply-btn"
                    onclick="sendReply('${complaint._id}')"
                >
                    Send Reply
                </button>

            </div>


            <button
                class="delete-btn"
                onclick="deleteComplaint('${complaint._id}')"
            >
                Delete Complaint
            </button>

        `;


    } catch (error) {

        console.error(error);

        details.innerHTML =
            "<p>Failed to load complaint.</p>";

    }

}



async function updateStatus(id) {

    const status =
        document.getElementById(
            "statusSelect"
        ).value;


    try {

        const response =
            await fetch(
                "/admin/complaints/" +
                id +
                "/status",
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body:
                        JSON.stringify({
                            status
                        })

                }
            );


        const data =
            await response.json();


        if (data.success) {

            alert(
                "Status updated successfully."
            );

            location.reload();

        } else {

            alert(
                data.message ||
                "Failed to update status."
            );

        }


    } catch (error) {

        console.error(error);

        alert(
            "Server error."
        );

    }

}



async function sendReply(id) {

    const textarea =
        document.getElementById(
            "adminReply"
        );


    const adminResponse =
        textarea.value.trim();


    if (!adminResponse) {

        alert(
            "Please write a reply."
        );

        return;

    }


    try {

        const response =
            await fetch(
                "/admin/complaints/" +
                id +
                "/reply",
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body:
                        JSON.stringify({
                            adminResponse
                        })

                }
            );


        const data =
            await response.json();


        if (data.success) {

            alert(
                "Reply sent successfully."
            );

            location.reload();

        } else {

            alert(
                data.message ||
                "Failed to send reply."
            );

        }


    } catch (error) {

        console.error(error);

        alert(
            "Server error."
        );

    }

}



async function deleteComplaint(id) {

    const confirmDelete =
        confirm(
            "Are you sure you want to delete this complaint?"
        );


    if (!confirmDelete) {

        return;

    }


    try {

        const response =
            await fetch(
                "/admin/complaints/" +
                id +
                "/delete",
                {

                    method: "POST"

                }
            );


        const data =
            await response.json();


        if (data.success) {

            alert(
                "Complaint deleted."
            );

            location.reload();

        } else {

            alert(
                data.message ||
                "Failed to delete complaint."
            );

        }


    } catch (error) {

        console.error(error);

        alert(
            "Server error."
        );

    }

}



function closeComplaint() {

    document
        .getElementById(
            "complaintModal"
        )
        .classList.remove(
            "show"
        );

}



function escapeHtml(value) {

    if (!value) {

        return "";

    }


    return String(value)

        .replaceAll(
            "&",
            "&amp;"
        )

        .replaceAll(
            "<",
            "&lt;"
        )

        .replaceAll(
            ">",
            "&gt;"
        )

        .replaceAll(
            '"',
            "&quot;"
        )

        .replaceAll(
            "'",
            "&#039;"
        );

}

</script>


</body>

</html>