<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Complaints Management | GHARSETU</title>

    <link rel="stylesheet" href="/css/admin.css">

    <style>

        :root {
            --ivory: #f8f4ec;
            --ivory-light: #fffdf8;
            --beige: #eee4d3;
            --beige-dark: #ddcdb7;

            --coffee: #3f2d25;
            --coffee-light: #6d564b;
            --coffee-soft: #907b70;

            --green: #2f6f4e;
            --green-dark: #245b3f;
            --green-light: #e5f1e9;

            --yellow: #b98216;
            --yellow-light: #fff4d6;

            --blue: #46718f;
            --blue-light: #eaf3f8;

            --red: #b84b4b;
            --red-light: #fdeaea;

            --white: #ffffff;

            --text: #30251f;
            --muted: #83746b;

            --border: rgba(63, 45, 37, 0.10);

            --shadow:
                0 12px 35px
                rgba(63, 45, 37, 0.07);

            --radius: 20px;
        }


        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;

            background: var(--ivory);

            color: var(--text);

            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }


        button,
        input,
        select,
        textarea {
            font: inherit;
        }


        /* =====================================================
           MAIN
        ===================================================== */

        .admin-main {
            min-height: 100vh;

            padding: 34px;
        }


        /* =====================================================
           HEADER
        ===================================================== */

        .page-header {
            display: flex;

            align-items: center;

            justify-content: space-between;

            margin-bottom: 28px;
        }


        .page-header::before {
            content: "ADMIN MANAGEMENT";

            position: absolute;

            margin-top: -58px;

            color: var(--green);

            font-size: 10px;

            font-weight: 800;

            letter-spacing: 1.8px;
        }


        .page-header h1 {
            margin: 0;

            color: var(--coffee);

            font-size: 34px;

            line-height: 1.1;

            letter-spacing: -0.8px;
        }


        .page-header p {
            margin: 8px 0 0;

            color: var(--muted);

            font-size: 14px;
        }


        /* =====================================================
           STATISTICS
        ===================================================== */

        .stats-grid {
            display: grid;

            grid-template-columns:
                repeat(5, 1fr);

            gap: 15px;

            margin-bottom: 22px;
        }


        .stat-card {
            position: relative;

            min-height: 125px;

            padding: 20px;

            overflow: hidden;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: var(--radius);

            box-shadow: var(--shadow);

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }


        .stat-card:hover {
            transform: translateY(-3px);

            box-shadow:
                0 18px 40px
                rgba(63, 45, 37, 0.10);
        }


        .stat-card::after {
            content: "";

            position: absolute;

            right: -25px;

            bottom: -25px;

            width: 80px;

            height: 80px;

            border-radius: 50%;

            background: var(--green-light);

            opacity: 0.8;
        }


        .stat-title {
            position: relative;

            z-index: 2;

            display: block;

            margin-bottom: 10px;

            color: var(--muted);

            font-size: 11px;

            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: 0.8px;
        }


        .stat-card strong {
            position: relative;

            z-index: 2;

            color: var(--coffee);

            font-size: 30px;

            line-height: 1;
        }


        .stat-card.pending::after {
            background: var(--yellow-light);
        }


        .stat-card.progress::after {
            background: var(--blue-light);
        }


        .stat-card.resolved::after {
            background: var(--green-light);
        }


        .stat-card.closed::after {
            background: var(--red-light);
        }


        .stat-card.pending strong {
            color: var(--yellow);
        }


        .stat-card.progress strong {
            color: var(--blue);
        }


        .stat-card.resolved strong {
            color: var(--green);
        }


        .stat-card.closed strong {
            color: var(--red);
        }


        /* =====================================================
           FILTER CARD
        ===================================================== */

        .filter-card {
            margin-bottom: 22px;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: var(--radius);

            box-shadow: var(--shadow);
        }


        .filter-card form {
            display: grid;

            grid-template-columns:
                minmax(260px, 1fr)
                180px
                180px
                105px
                85px;

            gap: 10px;

            padding: 18px;
        }


        .search-box {
            min-height: 46px;

            display: flex;

            align-items: center;

            padding: 0 14px;

            background: var(--ivory-light);

            border: 1px solid var(--border);

            border-radius: 12px;
        }


        .search-box::before {
            content: "🔍";

            margin-right: 9px;

            opacity: 0.65;
        }


        .search-box input {
            width: 100%;

            border: 0;

            outline: 0;

            background: transparent;

            color: var(--coffee);

            font-size: 13px;
        }


        .search-box input::placeholder {
            color: #a89a91;
        }


        .filter-card select {
            min-height: 46px;

            padding: 0 12px;

            background: var(--ivory-light);

            color: var(--coffee);

            border: 1px solid var(--border);

            border-radius: 12px;

            outline: 0;

            cursor: pointer;

            font-size: 12px;
        }


        .filter-btn,
        .reset-btn {
            min-height: 46px;

            display: flex;

            align-items: center;

            justify-content: center;

            border: 0;

            border-radius: 12px;

            cursor: pointer;

            text-decoration: none;

            font-size: 12px;

            font-weight: 750;
        }


        .filter-btn {
            background: var(--green);

            color: white;
        }


        .filter-btn:hover {
            background: var(--green-dark);
        }


        .reset-btn {
            background: var(--beige);

            color: var(--coffee);
        }


        .reset-btn:hover {
            background: var(--beige-dark);
        }


        /* =====================================================
           TABLE CARD
        ===================================================== */

        .table-card {
            overflow: hidden;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: var(--radius);

            box-shadow: var(--shadow);
        }


        .table-header {
            min-height: 80px;

            padding: 18px 22px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            border-bottom: 1px solid var(--border);
        }


        .table-header h2 {
            margin: 0;

            color: var(--coffee);

            font-size: 20px;
        }


        .table-header h2::before {
            content: "SUPPORT CENTER";

            display: block;

            margin-bottom: 5px;

            color: var(--green);

            font-size: 9px;

            font-weight: 800;

            letter-spacing: 1.5px;
        }


        .table-header > span {
            padding: 7px 11px;

            border-radius: 9px;

            background: var(--green-light);

            color: var(--green);

            font-size: 11px;

            font-weight: 800;
        }


        .table-wrapper {
            width: 100%;

            overflow-x: auto;
        }


        table {
            width: 100%;

            min-width: 1000px;

            border-collapse: collapse;
        }


        thead th {
            padding: 13px 18px;

            background: #fcfaf6;

            color: var(--coffee-soft);

            text-align: left;

            font-size: 10px;

            font-weight: 800;

            text-transform: uppercase;

            letter-spacing: 0.8px;

            border-bottom: 1px solid var(--border);
        }


        tbody td {
            padding: 15px 18px;

            border-bottom:
                1px solid
                rgba(63, 45, 37, 0.07);

            vertical-align: middle;

            font-size: 12px;
        }


        tbody tr {
            transition: background 0.15s ease;
        }


        tbody tr:hover {
            background: #fcfaf6;
        }


        tbody tr:last-child td {
            border-bottom: 0;
        }


        /* =====================================================
           COMPLAINT
        ===================================================== */

        .complaint-title {
            max-width: 260px;
        }


        .complaint-title strong {
            display: block;

            overflow: hidden;

            color: var(--coffee);

            font-size: 12px;

            text-overflow: ellipsis;

            white-space: nowrap;
        }


        .complaint-title small {
            display: block;

            margin-top: 5px;

            color: var(--muted);

            font-size: 10px;

            line-height: 1.45;
        }


        /* =====================================================
           USER
        ===================================================== */

        .user-info strong {
            display: block;

            color: var(--coffee);

            font-size: 12px;
        }


        .user-info small {
            display: block;

            margin-top: 4px;

            color: var(--muted);

            font-size: 10px;
        }


        /* =====================================================
           ROLE
        ===================================================== */

        .role-badge {
            display: inline-flex;

            padding: 6px 9px;

            background: var(--beige);

            color: var(--coffee-light);

            border-radius: 8px;

            font-size: 10px;

            font-weight: 750;

            text-transform: capitalize;

            white-space: nowrap;
        }


        /* =====================================================
           CATEGORY
        ===================================================== */

        tbody td:nth-child(4) {
            color: var(--coffee-light);

            font-weight: 600;

            text-transform: capitalize;
        }


        /* =====================================================
           STATUS
        ===================================================== */

        .status-badge {
            display: inline-flex;

            align-items: center;

            padding: 6px 10px;

            border-radius: 8px;

            font-size: 10px;

            font-weight: 800;

            text-transform: capitalize;

            white-space: nowrap;
        }


        .status-pending {
            background: var(--yellow-light);

            color: var(--yellow);
        }


        .status-in_progress {
            background: var(--blue-light);

            color: var(--blue);
        }


        .status-resolved {
            background: var(--green-light);

            color: var(--green);
        }


        .status-closed {
            background: var(--red-light);

            color: var(--red);
        }


        /* =====================================================
           VIEW BUTTON
        ===================================================== */

        .view-btn {
            min-width: 62px;

            min-height: 34px;

            padding: 0 12px;

            border: 0;

            border-radius: 9px;

            background: var(--coffee);

            color: white;

            cursor: pointer;

            font-size: 11px;

            font-weight: 750;

            transition: all 0.2s ease;
        }


        .view-btn:hover {
            background: var(--green);

            transform: translateY(-1px);
        }


        /* =====================================================
           EMPTY
        ===================================================== */

        .empty {
            padding: 70px 20px !important;

            color: var(--muted);

            text-align: center;

            font-size: 13px;
        }


        .empty::before {
            content: "📭";

            display: block;

            margin-bottom: 12px;

            font-size: 30px;
        }


        /* =====================================================
           MODAL
        ===================================================== */

        .modal {
            position: fixed;

            inset: 0;

            display: none;

            align-items: center;

            justify-content: center;

            padding: 20px;

            background:
                rgba(45, 33, 27, 0.58);

            backdrop-filter: blur(7px);

            z-index: 9999;
        }


        .modal.show {
            display: flex;
        }


        .modal-box {
            position: relative;

            width: min(760px, 100%);

            max-height: 90vh;

            overflow-y: auto;

            padding: 27px;

            background: var(--ivory-light);

            border-radius: 24px;

            box-shadow:
                0 30px 90px
                rgba(40, 27, 20, 0.28);
        }


        .close-btn {
            position: absolute;

            top: 17px;

            right: 17px;

            width: 36px;

            height: 36px;

            border: 0;

            border-radius: 10px;

            background: var(--beige);

            color: var(--coffee);

            cursor: pointer;

            font-size: 23px;

            line-height: 1;
        }


        .close-btn:hover {
            background: var(--beige-dark);
        }


        .modal-box > h2 {
            margin: 0;

            padding-right: 45px;

            color: var(--coffee);

            font-size: 23px;
        }


        .modal-box > h2::after {
            content: "Review, update and respond to this complaint";

            display: block;

            margin-top: 6px;

            color: var(--muted);

            font-size: 11px;

            font-weight: 500;
        }


        #complaintDetails {
            margin-top: 22px;
        }


        /* =====================================================
           DETAIL ROW
        ===================================================== */

        .detail-row {
            padding: 15px;

            margin-bottom: 10px;

            background: white;

            border: 1px solid var(--border);

            border-radius: 14px;
        }


        .detail-row label {
            display: block;

            margin-bottom: 7px;

            color: var(--green);

            font-size: 10px;

            font-weight: 800;

            text-transform: uppercase;

            letter-spacing: 0.8px;
        }


        .detail-row p {
            margin: 0;

            color: var(--coffee-light);

            font-size: 13px;

            line-height: 1.6;

            word-break: break-word;
        }


        .detail-row select {
            width: 100%;

            min-height: 42px;

            padding: 0 12px;

            border: 1px solid var(--border);

            border-radius: 10px;

            background: var(--ivory);

            color: var(--coffee);

            outline: none;

            cursor: pointer;
        }


        /* =====================================================
           REPLY
        ===================================================== */

        .reply-section {
            padding: 17px;

            margin-top: 15px;

            background: var(--green-light);

            border: 1px solid rgba(47, 111, 78, 0.12);

            border-radius: 15px;
        }


        .reply-section label {
            display: block;

            margin-bottom: 9px;

            color: var(--green-dark);

            font-size: 11px;

            font-weight: 800;
        }


        .reply-section textarea {
            width: 100%;

            min-height: 110px;

            padding: 12px;

            resize: vertical;

            border: 1px solid rgba(47, 111, 78, 0.16);

            border-radius: 11px;

            outline: none;

            background: white;

            color: var(--coffee);

            font-size: 12px;
        }


        .reply-section textarea:focus {
            border-color: var(--green);
        }


        .reply-btn {
            min-height: 40px;

            margin-top: 10px;

            padding: 0 17px;

            border: 0;

            border-radius: 10px;

            background: var(--green);

            color: white;

            cursor: pointer;

            font-size: 11px;

            font-weight: 750;
        }


        .reply-btn:hover {
            background: var(--green-dark);
        }


        /* =====================================================
           DELETE
        ===================================================== */

        .delete-btn {
            width: 100%;

            min-height: 42px;

            margin-top: 14px;

            border: 0;

            border-radius: 11px;

            background: var(--red-light);

            color: var(--red);

            cursor: pointer;

            font-size: 11px;

            font-weight: 800;
        }


        .delete-btn:hover {
            background: #f8dada;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 1250px) {

            .stats-grid {
                grid-template-columns:
                    repeat(3, 1fr);
            }


            .filter-card form {
                grid-template-columns:
                    minmax(240px, 1fr)
                    160px
                    160px
                    100px
                    80px;
            }

        }


        @media (max-width: 950px) {

            .admin-main {
                padding: 25px;
            }


            .stats-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }


            .filter-card form {
                grid-template-columns:
                    1fr 1fr;
            }


            .search-box {
                grid-column: 1 / -1;
            }

        }


        @media (max-width: 600px) {

            .admin-main {
                padding: 15px;
            }


            .page-header h1 {
                font-size: 27px;
            }


            .stats-grid {
                grid-template-columns: 1fr;
            }


            .filter-card form {
                grid-template-columns: 1fr;
            }


            .search-box {
                grid-column: auto;
            }


            .table-header {
                padding: 16px;

                align-items: flex-start;

                flex-direction: column;

                gap: 10px;
            }


            .modal {
                padding: 10px;
            }


            .modal-box {
                padding: 19px;

                border-radius: 20px;
            }

        }

    </style>

</head>


<body>


<!-- =====================================================
     SIDEBAR
===================================================== -->

<%- include("../partials/adminSidebar") %>


<!-- =====================================================
     MAIN
===================================================== -->

<main class="admin-main">


    <section class="page-header">

        <div>

            <h1>
                Complaints Management
            </h1>

            <p>
                Manage customer and partner complaints
            </p>

        </div>

    </section>


    <!-- =====================================================
         STATISTICS
    ===================================================== -->

    <section class="stats-grid">


        <div class="stat-card">

            <span class="stat-title">
                Total Complaints
            </span>

            <strong>
                <%= totalComplaints || 0 %>
            </strong>

        </div>


        <div class="stat-card pending">

            <span class="stat-title">
                Pending
            </span>

            <strong>
                <%= pendingComplaints || 0 %>
            </strong>

        </div>


        <div class="stat-card progress">

            <span class="stat-title">
                In Progress
            </span>

            <strong>
                <%= inProgressComplaints || 0 %>
            </strong>

        </div>


        <div class="stat-card resolved">

            <span class="stat-title">
                Resolved
            </span>

            <strong>
                <%= resolvedComplaints || 0 %>
            </strong>

        </div>


        <div class="stat-card closed">

            <span class="stat-title">
                Closed
            </span>

            <strong>
                <%= closedComplaints || 0 %>
            </strong>

        </div>


    </section>


    <!-- =====================================================
         FILTER
    ===================================================== -->

    <section class="filter-card">


        <form
            method="GET"
            action="/admin/complaints"
        >


            <div class="search-box">

                <input
                    type="text"
                    name="search"
                    placeholder="Search complaint, name, mobile..."
                    value="<%= search || '' %>"
                >

            </div>


            <select name="status">

                <option
                    value="all"
                    <%= status === "all" ? "selected" : "" %>
                >
                    All Status
                </option>


                <option
                    value="pending"
                    <%= status === "pending" ? "selected" : "" %>
                >
                    Pending
                </option>


                <option
                    value="in_progress"
                    <%= status === "in_progress" ? "selected" : "" %>
                >
                    In Progress
                </option>


                <option
                    value="resolved"
                    <%= status === "resolved" ? "selected" : "" %>
                >
                    Resolved
                </option>


                <option
                    value="closed"
                    <%= status === "closed" ? "selected" : "" %>
                >
                    Closed
                </option>


            </select>


            <select name="role">

                <option
                    value="all"
                    <%= role === "all" ? "selected" : "" %>
                >
                    All Users
                </option>


                <option
                    value="customer"
                    <%= role === "customer" ? "selected" : "" %>
                >
                    Customer
                </option>


                <option
                    value="restaurant"
                    <%= role === "restaurant" ? "selected" : "" %>
                >
                    Restaurant
                </option>


                <option
                    value="tiffinSeller"
                    <%= role === "tiffinSeller" ? "selected" : "" %>
                >
                    Tiffin Seller
                </option>


                <option
                    value="delivery"
                    <%= role === "delivery" ? "selected" : "" %>
                >
                    Delivery Partner
                </option>


            </select>


            <button
                type="submit"
                class="filter-btn"
            >
                Search
            </button>


            <a
                href="/admin/complaints"
                class="reset-btn"
            >
                Reset
            </a>


        </form>


    </section>


    <!-- =====================================================
         TABLE
    ===================================================== -->

    <section class="table-card">


        <div class="table-header">

            <h2>
                Complaints
            </h2>


            <span>

                <%= complaints
                    ? complaints.length
                    : 0
                %>

                results

            </span>

        </div>


        <div class="table-wrapper">


            <table>


                <thead>

                    <tr>

                        <th>
                            Complaint
                        </th>

                        <th>
                            User
                        </th>

                        <th>
                            Role
                        </th>

                        <th>
                            Category
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <% if (
                        !complaints ||
                        complaints.length === 0
                    ) { %>


                        <tr>

                            <td
                                colspan="7"
                                class="empty"
                            >
                                No complaints found.
                            </td>

                        </tr>


                    <% } else { %>


                        <% complaints.forEach(
                            complaint => {
                        %>


                            <tr>


                                <td>

                                    <div class="complaint-title">

                                        <strong>

                                            <%= complaint.subject ||
                                                "Untitled Complaint"
                                            %>

                                        </strong>


                                        <small>

                                            <%= complaint.description
                                                ? (
                                                    complaint.description.length > 70
                                                        ? complaint.description.substring(
                                                            0,
                                                            70
                                                        ) + "..."
                                                        : complaint.description
                                                )
                                                : "No description available"
                                            %>

                                        </small>

                                    </div>

                                </td>


                                <td>

                                    <div class="user-info">

                                        <strong>

                                            <%= complaint.complainantName ||

                                                (
                                                    complaint.complainant
                                                        ? complaint.complainant.name
                                                        : "Unknown"
                                                )
                                            %>

                                        </strong>


                                        <small>

                                            <%= complaint.complainantMobile ||

                                                (
                                                    complaint.complainant
                                                        ? complaint.complainant.mobile
                                                        : "-"
                                                )
                                            %>

                                        </small>

                                    </div>

                                </td>


                                <td>

                                    <span class="role-badge">

                                        <%= complaint.complainantRole ||
                                            "Unknown"
                                        %>

                                    </span>

                                </td>


                                <td>

                                    <%= complaint.category ||
                                        "-"
                                    %>

                                </td>


                                <td>

                                    <span
                                        class="status-badge status-<%= complaint.status || 'pending' %>"
                                    >

                                        <%= (
                                            complaint.status ||
                                            "pending"
                                        ).replace(
                                            "_",
                                            " "
                                        ) %>

                                    </span>

                                </td>


                                <td>

                                    <%= complaint.createdAt
                                        ? new Date(
                                            complaint.createdAt
                                        ).toLocaleDateString(
                                            "en-IN"
                                        )
                                        : "-"
                                    %>

                                </td>


                                <td>

                                    <button
                                        type="button"
                                        class="view-btn"
                                        onclick="openComplaint('<%= complaint._id %>')"
                                    >
                                        View
                                    </button>

                                </td>


                            </tr>


                        <% }) %>


                    <% } %>


                </tbody>


            </table>


        </div>


    </section>


</main>


<!-- =====================================================
     MODAL
===================================================== -->

<div
    id="complaintModal"
    class="modal"
>


    <div class="modal-box">


        <button
            type="button"
            class="close-btn"
            onclick="closeComplaint()"
        >
            ×
        </button>


        <h2>
            Complaint Details
        </h2>


        <div id="complaintDetails">

            Loading...

        </div>


    </div>


</div>


<script>


/* =====================================================
   OPEN COMPLAINT
===================================================== */

async function openComplaint(id) {

    var modal =
        document.getElementById(
            "complaintModal"
        );


    var details =
        document.getElementById(
            "complaintDetails"
        );


    modal.classList.add("show");


    details.innerHTML =
        '<div class="detail-row">' +
            '<p>Loading complaint details...</p>' +
        '</div>';


    try {

        var response =
            await fetch(
                "/admin/complaints/" +
                encodeURIComponent(id)
            );


        var data =
            await response.json();


        if (
            !response.ok ||
            !data.success
        ) {

            details.innerHTML =
                '<div class="detail-row">' +
                    '<p>Complaint not found.</p>' +
                '</div>';

            return;

        }


        var complaint =
            data.complaint || {};


        var subject =
            complaint.subject ||
            "Untitled Complaint";


        var description =
            complaint.description ||
            "No description available";


        var complainantName =
            complaint.complainantName ||
            (
                complaint.complainant
                    ? complaint.complainant.name
                    : "Unknown"
            );


        var complainantMobile =
            complaint.complainantMobile ||
            (
                complaint.complainant
                    ? complaint.complainant.mobile
                    : "-"
            );


        var category =
            complaint.category ||
            "-";


        var currentStatus =
            complaint.status ||
            "pending";


        var adminResponse =
            complaint.adminResponse ||
            "";


        var complaintId =
            String(
                complaint._id || id
            );


        var html = "";


        html +=
            '<div class="detail-row">' +

                '<label>Subject</label>' +

                '<p>' +
                    escapeHtml(subject) +
                '</p>' +

            '</div>';


        html +=
            '<div class="detail-row">' +

                '<label>Description</label>' +

                '<p>' +
                    escapeHtml(description) +
                '</p>' +

            '</div>';


        html +=
            '<div class="detail-row">' +

                '<label>User</label>' +

                '<p>' +
                    escapeHtml(
                        complainantName
                    ) +
                '</p>' +

            '</div>';


        html +=
            '<div class="detail-row">' +

                '<label>Mobile</label>' +

                '<p>' +
                    escapeHtml(
                        complainantMobile
                    ) +
                '</p>' +

            '</div>';


        html +=
            '<div class="detail-row">' +

                '<label>Category</label>' +

                '<p>' +
                    escapeHtml(category) +
                '</p>' +

            '</div>';


        html +=
            '<div class="detail-row">' +

                '<label>Status</label>' +

                '<select ' +
                    'id="statusSelect" ' +
                    'data-id="' +
                        escapeHtml(
                            complaintId
                        ) +
                    '" ' +
                    'onchange="updateStatus(this.dataset.id)"' +
                '>' +

                    '<option ' +
                        'value="pending" ' +
                        (
                            currentStatus === "pending"
                                ? "selected"
                                : ""
                        ) +
                    '>' +
                        'Pending' +
                    '</option>' +

                    '<option ' +
                        'value="in_progress" ' +
                        (
                            currentStatus === "in_progress"
                                ? "selected"
                                : ""
                        ) +
                    '>' +
                        'In Progress' +
                    '</option>' +

                    '<option ' +
                        'value="resolved" ' +
                        (
                            currentStatus === "resolved"
                                ? "selected"
                                : ""
                        ) +
                    '>' +
                        'Resolved' +
                    '</option>' +

                    '<option ' +
                        'value="closed" ' +
                        (
                            currentStatus === "closed"
                                ? "selected"
                                : ""
                        ) +
                    '>' +
                        'Closed' +
                    '</option>' +

                '</select>' +

            '</div>';


        html +=
            '<div class="reply-section">' +

                '<label>' +
                    'Admin Reply' +
                '</label>' +

                '<textarea ' +
                    'id="adminReply" ' +
                    'placeholder="Write your response..."' +
                '>' +
                    escapeHtml(
                        adminResponse
                    ) +
                '</textarea>' +

                '<button ' +
                    'type="button" ' +
                    'class="reply-btn" ' +
                    'data-id="' +
                        escapeHtml(
                            complaintId
                        ) +
                    '" ' +
                    'onclick="sendReply(this.dataset.id)"' +
                '>' +
                    'Send Reply' +
                '</button>' +

            '</div>';


        html +=
            '<button ' +
                'type="button" ' +
                'class="delete-btn" ' +
                'data-id="' +
                    escapeHtml(
                        complaintId
                    ) +
                '" ' +
                'onclick="deleteComplaint(this.dataset.id)"' +
            '>' +
                'Delete Complaint' +
            '</button>';


        details.innerHTML = html;


    } catch (error) {

        console.error(
            "COMPLAINT DETAILS ERROR:",
            error
        );


        details.innerHTML =
            '<div class="detail-row">' +
                '<p>Failed to load complaint.</p>' +
            '</div>';

    }

}


/* =====================================================
   UPDATE STATUS
===================================================== */

async function updateStatus(id) {

    var select =
        document.getElementById(
            "statusSelect"
        );


    if (!select) {

        return;

    }


    var status =
        select.value;


    try {

        var response =
            await fetch(
                "/admin/complaints/" +
                encodeURIComponent(id) +
                "/status",
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body:
                        JSON.stringify({
                            status: status
                        })

                }
            );


        var data =
            await response.json();


        if (data.success) {

            alert(
                "Status updated successfully."
            );


            location.reload();

        } else {

            alert(
                data.message ||
                "Failed to update status."
            );

        }


    } catch (error) {

        console.error(
            "UPDATE STATUS ERROR:",
            error
        );


        alert(
            "Server error."
        );

    }

}


/* =====================================================
   SEND REPLY
===================================================== */

async function sendReply(id) {

    var textarea =
        document.getElementById(
            "adminReply"
        );


    if (!textarea) {

        return;

    }


    var adminResponse =
        textarea.value.trim();


    if (!adminResponse) {

        alert(
            "Please write a reply."
        );

        return;

    }


    try {

        var response =
            await fetch(
                "/admin/complaints/" +
                encodeURIComponent(id) +
                "/reply",
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body:
                        JSON.stringify({
                            adminResponse:
                                adminResponse
                        })

                }
            );


        var data =
            await response.json();


        if (data.success) {

            alert(
                "Reply sent successfully."
            );


            location.reload();

        } else {

            alert(
                data.message ||
                "Failed to send reply."
            );

        }


    } catch (error) {

        console.error(
            "SEND REPLY ERROR:",
            error
        );


        alert(
            "Server error."
        );

    }

}


/* =====================================================
   DELETE COMPLAINT
===================================================== */

async function deleteComplaint(id) {

    var confirmDelete =
        confirm(
            "Are you sure you want to delete this complaint?"
        );


    if (!confirmDelete) {

        return;

    }


    try {

        var response =
            await fetch(
                "/admin/complaints/" +
                encodeURIComponent(id) +
                "/delete",
                {

                    method: "POST"

                }
            );


        var data =
            await response.json();


        if (data.success) {

            alert(
                "Complaint deleted successfully."
            );


            location.reload();

        } else {

            alert(
                data.message ||
                "Failed to delete complaint."
            );

        }


    } catch (error) {

        console.error(
            "DELETE COMPLAINT ERROR:",
            error
        );


        alert(
            "Server error."
        );

    }

}


/* =====================================================
   CLOSE MODAL
===================================================== */

function closeComplaint() {

    var modal =
        document.getElementById(
            "complaintModal"
        );


    if (modal) {

        modal.classList.remove(
            "show"
        );

    }

}


/* =====================================================
   OUTSIDE CLICK
===================================================== */

var complaintModal =
    document.getElementById(
        "complaintModal"
    );


if (complaintModal) {

    complaintModal.addEventListener(
        "click",
        function(event) {

            if (
                event.target === complaintModal
            ) {

                closeComplaint();

            }

        }
    );

}


/* =====================================================
   ESC KEY
===================================================== */

document.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key === "Escape"
        ) {

            closeComplaint();

        }

    }
);


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHtml(value) {

    if (
        value === null ||
        value === undefined
    ) {

        return "";

    }


    return String(value)

        .replace(
            /&/g,
            "&amp;"
        )

        .replace(
            /</g,
            "&lt;"
        )

        .replace(
            />/g,
            "&gt;"
        )

        .replace(
            /"/g,
            "&quot;"
        )

        .replace(
            /'/g,
            "&#039;"
        );

}

</script>


</body>

</html>