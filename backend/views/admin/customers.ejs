<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        GharSetu | Customer Management
    </title>


    <!-- ADMIN CSS -->

<link rel="stylesheet" href="/css/admin.css">

</head>


<body>


    <!-- =========================================
         SIDEBAR
    ========================================== -->

    <aside class="admin-sidebar">

        <div class="admin-brand">

            <div class="brand-icon">
                🏠
            </div>

            <div>
                <strong>
                    GharSetu
                </strong>

                <small>
                    Admin Panel
                </small>
            </div>

        </div>


        <nav>

            <a
                href="/admin/dashboard"
                class="admin-nav-link"
            >
                📊 Dashboard
            </a>


            <a
                href="/admin/restaurants"
                class="admin-nav-link"
            >
                🍽️ Restaurants
            </a>


            <a
                href="/admin/tiffin-sellers"
                class="admin-nav-link"
            >
                🍱 Tiffin Sellers
            </a>


            <a
                href="/admin/customers"
                class="admin-nav-link active"
            >
                👥 Customers
            </a>


            <a
                href="/admin/delivery"
                class="admin-nav-link"
            >
                🚴 Delivery
            </a>


            <a
                href="/admin/orders"
                class="admin-nav-link"
            >
                📦 Orders
            </a>


            <a
                href="/admin/complaints"
                class="admin-nav-link"
            >
                ⚠️ Complaints
            </a>


            <a
                href="/admin/analytics"
                class="admin-nav-link"
            >
                📈 Analytics
            </a>


            <a
                href="/admin/settings"
                class="admin-nav-link"
            >
                ⚙️ Settings
            </a>

        </nav>


        <div class="sidebar-bottom">

            <div class="admin-user-mini">

                <div class="top-avatar">
                    <%= admin?.name
                        ? admin.name
                            .charAt(0)
                            .toUpperCase()
                        : "A"
                    %>
                </div>

                <div>

                    <strong>
                        <%= admin?.name || "Admin" %>
                    </strong>

                    <small>
                        Administrator
                    </small>

                </div>

            </div>


            <a
                href="/admin/logout"
                class="logout-btn"
            >
                🚪 Logout
            </a>

        </div>

    </aside>



    <!-- =========================================
         MAIN
    ========================================== -->

    <main class="admin-main">

        <div class="customer-page">


            <!-- HEADER -->

            <div class="customer-header">

                <div>

                    <div class="eyebrow">
                        ADMIN MANAGEMENT
                    </div>

                    <h1>
                        Customer Management
                    </h1>

                    <p>
                        Manage GharSetu customers,
                        accounts and activity.
                    </p>

                </div>

            </div>



            <!-- =====================================
                 STATS
            ====================================== -->

            <div class="customer-stats">


                <!-- TOTAL -->

                <div class="customer-stat-card">

                    <div class="customer-stat-top">

                        <div>

                            <div class="customer-stat-label">
                                Total Customers
                            </div>

                            <div class="customer-stat-number">
                                <%= totalCustomers %>
                            </div>

                        </div>

                        <div class="customer-stat-icon">
                            👥
                        </div>

                    </div>

                </div>


                <!-- ACTIVE -->

                <div class="customer-stat-card">

                    <div class="customer-stat-top">

                        <div>

                            <div class="customer-stat-label">
                                Active Customers
                            </div>

                            <div class="customer-stat-number">
                                <%= activeCustomers %>
                            </div>

                        </div>

                        <div class="customer-stat-icon">
                            🟢
                        </div>

                    </div>

                </div>


                <!-- INACTIVE -->

                <div class="customer-stat-card">

                    <div class="customer-stat-top">

                        <div>

                            <div class="customer-stat-label">
                                Inactive Customers
                            </div>

                            <div class="customer-stat-number">
                                <%= inactiveCustomers %>
                            </div>

                        </div>

                        <div class="customer-stat-icon">
                            🔴
                        </div>

                    </div>

                </div>

            </div>



            <!-- =====================================
                 SEARCH / FILTER
            ====================================== -->

            <div class="customer-filter-box">

                <form
                    method="GET"
                    action="/admin/customers"
                    class="customer-filter-form"
                >


                    <input
                        type="text"
                        name="search"
                        placeholder="Search name, email or mobile..."
                        value="<%= search || '' %>"
                    >


                    <select name="status">

                        <option
                            value="all"
                            <%= status === "all"
                                ? "selected"
                                : ""
                            %>
                        >
                            All Customers
                        </option>


                        <option
                            value="active"
                            <%= status === "active"
                                ? "selected"
                                : ""
                            %>
                        >
                            Active
                        </option>


                        <option
                            value="inactive"
                            <%= status === "inactive"
                                ? "selected"
                                : ""
                            %>
                        >
                            Inactive
                        </option>

                    </select>


                    <button
                        type="submit"
                        class="customer-search-btn"
                    >
                        🔍 Search
                    </button>

                </form>

            </div>



            <!-- =====================================
                 CUSTOMER TABLE
            ====================================== -->

            <div class="customer-table-box">


                <div class="customer-table-header">

                    <h2>
                        Customers
                    </h2>

                    <span>
                        <%= customers.length %>
                        result(s)
                    </span>

                </div>


                <% if (customers.length === 0) { %>

                    <div class="customer-empty">

                        <div class="customer-empty-icon">
                            👥
                        </div>

                        <h3>
                            No Customers Found
                        </h3>

                        <p>
                            Try changing your search
                            or filter.
                        </p>

                    </div>

                <% } else { %>


                    <table class="customer-table">

                        <thead>

                            <tr>

                                <th>
                                    CUSTOMER
                                </th>

                                <th>
                                    MOBILE
                                </th>

                                <th>
                                    STATUS
                                </th>

                                <th>
                                    JOINED
                                </th>

                                <th>
                                    ACTIONS
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <% customers.forEach(customer => { %>

                                <tr id="customer-row-<%= customer._id %>">


                                    <!-- CUSTOMER -->

                                    <td>

                                        <div class="customer-info">


                                            <div class="customer-avatar">

                                                <% if (customer.profileImage) { %>

                                                    <img
                                                        src="<%= customer.profileImage %>"
                                                        alt="Customer"
                                                    >

                                                <% } else { %>

                                                    <%= customer.name
                                                        ? customer.name
                                                            .charAt(0)
                                                            .toUpperCase()
                                                        : "U"
                                                    %>

                                                <% } %>

                                            </div>


                                            <div>

                                                <div class="customer-name">
                                                    <%= customer.name %>
                                                </div>

                                                <div class="customer-email">
                                                    <%= customer.email %>
                                                </div>

                                            </div>


                                        </div>

                                    </td>


                                    <!-- MOBILE -->

                                    <td>

                                        <%= customer.mobile %>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <% if (customer.isActive) { %>

                                            <span
                                                class="customer-status active"
                                                id="status-<%= customer._id %>"
                                            >
                                                🟢 Active
                                            </span>

                                        <% } else { %>

                                            <span
                                                class="customer-status inactive"
                                                id="status-<%= customer._id %>"
                                            >
                                                🔴 Inactive
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- JOINED -->

                                    <td>

                                        <%= customer.createdAt
                                            ? new Date(
                                                customer.createdAt
                                            ).toLocaleDateString("en-IN")
                                            : "-"
                                        %>

                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        <div class="customer-actions">


                                            <button
                                                type="button"
                                                class="customer-btn view"
                                                onclick="viewCustomer('<%= customer._id %>')"
                                            >
                                                👁 View
                                            </button>


                                            <button
                                                type="button"
                                                class="customer-btn <%= customer.isActive ? 'deactivate' : 'activate' %>"
                                                id="toggle-btn-<%= customer._id %>"
                                                onclick="toggleCustomer('<%= customer._id %>')"
                                            >

                                                <%= customer.isActive
                                                    ? "Deactivate"
                                                    : "Activate"
                                                %>

                                            </button>


                                        </div>

                                    </td>


                                </tr>

                            <% }) %>


                        </tbody>

                    </table>


                <% } %>


            </div>


        </div>

    </main>



    <!-- =========================================
         CUSTOMER DETAILS MODAL
    ========================================== -->

    <div
        class="customer-modal"
        id="customerModal"
    >

        <div class="customer-modal-box">


            <div class="customer-modal-header">

                <h3>
                    Customer Details
                </h3>

                <button
                    class="customer-modal-close"
                    onclick="closeCustomerModal()"
                >
                    ×
                </button>

            </div>


            <div
                class="customer-modal-body"
                id="customerModalBody"
            >

                Loading...

            </div>


        </div>

    </div>



    <!-- =========================================
         JAVASCRIPT
    ========================================== -->

    <script>


        // ==========================================
        // VIEW CUSTOMER
        // ==========================================

        async function viewCustomer(id) {

            const modal =
                document.getElementById(
                    "customerModal"
                );

            const body =
                document.getElementById(
                    "customerModalBody"
                );


            modal.classList.add("show");

            body.innerHTML =
                "<p>Loading customer details...</p>";


            try {

                const response =
                    await fetch(
                        `/admin/customers/${id}`
                    );


                const data =
                    await response.json();


                if (!response.ok || !data.success) {

                    throw new Error(
                        data.message ||
                        "Failed to load customer."
                    );

                }


                const customer =
                    data.customer;


                const joined =
                    customer.createdAt
                        ? new Date(
                            customer.createdAt
                        ).toLocaleDateString(
                            "en-IN"
                        )
                        : "-";


                body.innerHTML = `

                    <div class="detail-row">

                        <span class="detail-label">
                            Name
                        </span>

                        <span class="detail-value">
                            ${escapeHtml(customer.name)}
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Email
                        </span>

                        <span class="detail-value">
                            ${escapeHtml(customer.email)}
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Mobile
                        </span>

                        <span class="detail-value">
                            ${escapeHtml(customer.mobile)}
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Account Status
                        </span>

                        <span class="detail-value">

                            ${
                                customer.isActive
                                    ? "🟢 Active"
                                    : "🔴 Inactive"
                            }

                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Total Orders
                        </span>

                        <span class="detail-value">
                            ${customer.totalOrders}
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Joined
                        </span>

                        <span class="detail-value">
                            ${joined}
                        </span>

                    </div>

                `;


            } catch (error) {

                body.innerHTML = `

                    <p style="
                        color:#c0392b;
                        text-align:center;
                    ">
                        ${escapeHtml(error.message)}
                    </p>

                `;

            }

        }



        // ==========================================
        // CLOSE MODAL
        // ==========================================

        function closeCustomerModal() {

            document
                .getElementById(
                    "customerModal"
                )
                .classList
                .remove("show");

        }



        // ==========================================
        // TOGGLE CUSTOMER
        // ==========================================

        async function toggleCustomer(id) {

            const button =
                document.getElementById(
                    `toggle-btn-${id}`
                );


            button.disabled = true;

            const oldText =
                button.innerText;


            button.innerText =
                "Updating...";


            try {

                const response =
                    await fetch(
                        `/admin/customers/${id}/toggle-status`,
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            }
                        }
                    );


                const data =
                    await response.json();


                if (!response.ok || !data.success) {

                    throw new Error(
                        data.message ||
                        "Failed to update status."
                    );

                }


                const statusElement =
                    document.getElementById(
                        `status-${id}`
                    );


                if (data.isActive) {

                    statusElement.className =
                        "customer-status active";

                    statusElement.innerHTML =
                        "🟢 Active";

                    button.className =
                        "customer-btn deactivate";

                    button.innerText =
                        "Deactivate";

                } else {

                    statusElement.className =
                        "customer-status inactive";

                    statusElement.innerHTML =
                        "🔴 Inactive";

                    button.className =
                        "customer-btn activate";

                    button.innerText =
                        "Activate";

                }


            } catch (error) {

                alert(
                    error.message ||
                    "Something went wrong."
                );

                button.innerText =
                    oldText;

            }


            button.disabled = false;

        }



        // ==========================================
        // ESCAPE HTML
        // ==========================================

        function escapeHtml(value) {

            if (value === null ||
                value === undefined) {

                return "";

            }


            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }



        // ==========================================
        // CLOSE MODAL ON BACKDROP CLICK
        // ==========================================

        document
            .getElementById("customerModal")
            .addEventListener(
                "click",
                function(event) {

                    if (
                        event.target ===
                        this
                    ) {

                        closeCustomerModal();

                    }

                }
            );


    </script>


</body>

</html>