<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GharSetu | Customers</title>

    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/customers.css">
    <link rel="stylesheet" href="/css/admin-sidebar.css">
</head>

<body>
    <%
        const currentAdmin =
            typeof admin !== "undefined" && admin ? admin : null;

        const customerList =
            typeof customers !== "undefined" && Array.isArray(customers)
                ? customers
                : [];

        const currentSearch =
            typeof search !== "undefined" && search ? search : "";

        const currentStatus =
            typeof status !== "undefined" && status ? status : "all";

        const totalCount =
            typeof totalCustomers !== "undefined"
                ? totalCustomers
                : customerList.length;

        const activeCount =
            typeof activeCustomers !== "undefined"
                ? activeCustomers
                : customerList.filter(customer => customer.isActive).length;

        const inactiveCount =
            typeof inactiveCustomers !== "undefined"
                ? inactiveCustomers
                : customerList.filter(customer => !customer.isActive).length;
    %>

    <!-- SIDEBAR -->
    <%- include("../partials/adminSidebar", {
        admin: currentAdmin,
        activePage: "customers"
    }) %>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <!-- TOPBAR -->
        <header class="topbar">
            <div class="top-left">
                <button
                    type="button"
                    class="mobile-menu"
                    id="mobileMenu"
                    aria-label="Open navigation menu"
                    aria-expanded="false"
                >
                    ☰
                </button>

                <div class="top-heading">
                    <h1>Customer Management</h1>
                    <p>Manage your GharSetu customers</p>
                </div>
            </div>

            <div class="top-right">
                <div class="top-icon" aria-label="Notifications">
                    🔔
                    <span class="top-dot"></span>
                </div>

                <div class="top-icon" aria-label="Messages">
                    💬
                </div>

                <div class="admin-profile">
                    <div class="admin-avatar">
                        <%= currentAdmin && currentAdmin.name
                            ? currentAdmin.name.charAt(0).toUpperCase()
                            : "A" %>
                    </div>

                    <div class="admin-details">
                        <strong>
                            <%= currentAdmin && currentAdmin.name
                                ? currentAdmin.name
                                : "Admin" %>
                        </strong>

                        <span>Super Administrator</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- PAGE CONTENT -->
        <section class="content">

            <!-- PAGE HEADER -->
            <div class="page-header">
                <div>
                    <div class="eyebrow">ADMIN MANAGEMENT</div>
                    <h2>Customers</h2>

                    <p>
                        View, search and manage GharSetu customer accounts.
                    </p>
                </div>

                <div class="header-date">
                    📅 Customer Directory
                </div>
            </div>

            <!-- STATISTICS -->
            <div class="stats">

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-label">TOTAL CUSTOMERS</div>
                        <div class="stat-icon stat-total">👥</div>
                    </div>

                    <div class="stat-number">
                        <%= totalCount %>
                    </div>

                    <div class="stat-sub">
                        All registered customers
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-label">ACTIVE CUSTOMERS</div>
                        <div class="stat-icon stat-active">🟢</div>
                    </div>

                    <div class="stat-number">
                        <%= activeCount %>
                    </div>

                    <div class="stat-sub">
                        Customers with active accounts
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-label">INACTIVE CUSTOMERS</div>
                        <div class="stat-icon stat-inactive">🔴</div>
                    </div>

                    <div class="stat-number">
                        <%= inactiveCount %>
                    </div>

                    <div class="stat-sub">
                        Currently inactive accounts
                    </div>
                </div>

            </div>

            <!-- SEARCH AND FILTER -->
            <div class="filter-card">
                <div class="filter-title">
                    🔎 Search Customers
                </div>

                <form
                    method="GET"
                    action="/admin/customers"
                    class="filter-form"
                >
                    <div class="search-wrap">
                        <span>🔍</span>

                        <input
                            type="text"
                            name="search"
                            placeholder="Search by name, email or mobile..."
                            value="<%= currentSearch %>"
                        >
                    </div>

                    <select name="status" aria-label="Filter customers by status">
                        <option
                            value="all"
                            <%= currentStatus === "all" || !currentStatus
                                ? "selected"
                                : "" %>
                        >
                            All Customers
                        </option>

                        <option
                            value="active"
                            <%= currentStatus === "active" ? "selected" : "" %>
                        >
                            Active Customers
                        </option>

                        <option
                            value="inactive"
                            <%= currentStatus === "inactive" ? "selected" : "" %>
                        >
                            Inactive Customers
                        </option>
                    </select>

                    <button type="submit" class="search-btn">
                        Search
                    </button>
                </form>
            </div>

            <!-- CUSTOMER TABLE -->
            <div class="table-card">
                <div class="table-header">
                    <h3>Customer Directory</h3>

                    <span class="result-count">
                        <%= customerList.length %> Result(s)
                    </span>
                </div>

                <% if (customerList.length === 0) { %>

                    <div class="empty-state">
                        <div class="empty-icon">👥</div>

                        <h3>No Customers Found</h3>

                        <p>
                            Try changing your search or status filter.
                        </p>
                    </div>

                <% } else { %>

                    <div class="table-scroll">
                        <table class="customer-table">
                            <thead>
                                <tr>
                                    <th>CUSTOMER</th>
                                    <th>MOBILE</th>
                                    <th>STATUS</th>
                                    <th>JOINED</th>
                                    <th>ACTIONS</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% customerList.forEach(customer => { %>

                                    <%
                                        const customerId = String(customer._id);
                                        const customerName =
                                            customer.name || "Unknown Customer";

                                        const customerActive =
                                            Boolean(customer.isActive);

                                        const joinedDate = customer.createdAt
                                            ? new Date(customer.createdAt)
                                                .toLocaleDateString("en-IN")
                                            : "-";
                                    %>

                                    <tr id="customer-row-<%= customerId %>">

                                        <!-- CUSTOMER DETAILS -->
                                        <td>
                                            <div class="customer-info">

                                                <div class="customer-avatar">
                                                    <% if (customer.profileImage) { %>
                                                        <img
                                                            src="<%= customer.profileImage %>"
                                                            alt="Customer profile"
                                                            loading="lazy"
                                                        >
                                                    <% } else { %>
                                                        <%= customerName.charAt(0).toUpperCase() %>
                                                    <% } %>
                                                </div>

                                                <div>
                                                    <div class="customer-name">
                                                        <%= customerName %>
                                                    </div>

                                                    <div class="customer-email">
                                                        <%= customer.email || "No email" %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- MOBILE -->
                                        <td>
                                            <span class="mobile-number">
                                                <%= customer.mobile || "-" %>
                                            </span>
                                        </td>

                                        <!-- STATUS -->
                                        <td>
                                            <span
                                                class="status <%= customerActive ? "active" : "inactive" %>"
                                                id="status-<%= customerId %>"
                                            >
                                                <%= customerActive
                                                    ? "● Active"
                                                    : "● Inactive" %>
                                            </span>
                                        </td>

                                        <!-- JOINED DATE -->
                                        <td>
                                            <span class="joined-date">
                                                <%= joinedDate %>
                                            </span>
                                        </td>

                                        <!-- ACTIONS -->
                                        <td>
                                            <div class="actions">
                                                <button
                                                    type="button"
                                                    class="action-btn view-btn"
                                                    data-customer-id="<%= customerId %>"
                                                    onclick="viewCustomer(this.dataset.customerId)"
                                                >
                                                    👁 View
                                                </button>

                                                <button
                                                    type="button"
                                                    class="action-btn <%= customerActive
                                                        ? "deactivate-btn"
                                                        : "activate-btn" %>"
                                                    id="toggle-btn-<%= customerId %>"
                                                    data-customer-id="<%= customerId %>"
                                                    onclick="toggleCustomer(this.dataset.customerId)"
                                                >
                                                    <%= customerActive
                                                        ? "Deactivate"
                                                        : "Activate" %>
                                                </button>
                                            </div>
                                        </td>

                                    </tr>

                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                <% } %>
            </div>

        </section>
    </main>

    <!-- CUSTOMER DETAILS MODAL -->
    <div
        class="modal"
        id="customerModal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="customerModalTitle"
    >
        <div class="modal-box">
            <div class="modal-header">
                <h3 id="customerModalTitle">Customer Details</h3>

                <button
                    type="button"
                    class="modal-close"
                    onclick="closeCustomerModal()"
                    aria-label="Close customer details"
                >
                    ×
                </button>
            </div>

            <div class="modal-body" id="customerModalBody">
                Loading...
            </div>
        </div>
    </div>

    <script src="/js/admin/customers.js" defer></script>

</body>
</html>