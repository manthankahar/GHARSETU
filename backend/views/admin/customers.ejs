<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Customers</title>


    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {
            font-family:
                "Segoe UI",
                Arial,
                sans-serif;

            background: #f8f3ed;

            color: #30251e;
        }


        /* =========================================
           LAYOUT
        ========================================= */

        .admin-layout {
            min-height: 100vh;

            display: flex;
        }


        /* =========================================
           SIDEBAR
        ========================================= */

        .sidebar {

            width: 250px;

            position: fixed;

            top: 0;
            left: 0;
            bottom: 0;

            background: #fffaf5;

            border-right:
                1px solid #eaded2;

            padding: 24px 16px;

            overflow-y: auto;

            z-index: 100;
        }


        .brand {

            display: flex;

            align-items: center;

            gap: 12px;

            padding:
                0 10px 25px;

            border-bottom:
                1px solid #eaded2;

            margin-bottom: 22px;
        }


        .brand-icon {

            width: 44px;
            height: 44px;

            border-radius: 13px;

            background: #174f3a;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 22px;
        }


        .brand-text h2 {

            font-size: 20px;

            color: #30251e;
        }


        .brand-text span {

            display: block;

            font-size: 9px;

            color: #907d6e;

            letter-spacing: 1px;

            font-weight: 800;

            margin-top: 2px;
        }


        .menu-title {

            font-size: 9px;

            font-weight: 800;

            letter-spacing: 1.3px;

            color: #a08d7e;

            padding:
                0 12px 10px;
        }


        .nav-menu {

            list-style: none;

            margin-bottom: 22px;
        }


        .nav-menu li {

            margin-bottom: 5px;
        }


        .nav-menu a {

            display: flex;

            align-items: center;

            gap: 12px;

            padding:
                11px 12px;

            border-radius: 11px;

            color: #6c5a4d;

            text-decoration: none;

            font-size: 12px;

            font-weight: 600;

            transition: 0.2s ease;
        }


        .nav-menu a:hover {

            background: #f3e9df;

            color: #174f3a;
        }


        .nav-menu a.active {

            background: #174f3a;

            color: white;

            box-shadow:
                0 8px 18px
                rgba(23,79,58,0.16);
        }


        .nav-icon {

            width: 20px;

            text-align: center;

            font-size: 15px;
        }


        .badge {

            margin-left: auto;

            min-width: 20px;

            height: 20px;

            padding:
                0 6px;

            display: flex;

            align-items: center;
            justify-content: center;

            background: #d58a3c;

            color: white;

            border-radius: 20px;

            font-size: 9px;

            font-weight: 800;
        }


        /* =========================================
           MAIN
        ========================================= */

        .main-content {

            margin-left: 250px;

            width: calc(100% - 250px);

            min-height: 100vh;
        }


        /* =========================================
           TOPBAR
        ========================================= */

        .topbar {

            height: 76px;

            background: #fffdf9;

            border-bottom:
                1px solid #eaded2;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding:
                0 32px;

            position: sticky;

            top: 0;

            z-index: 50;
        }


        .top-left {

            display: flex;

            align-items: center;

            gap: 15px;
        }


        .mobile-menu {

            display: none;

            width: 38px;
            height: 38px;

            border:
                1px solid #eaded2;

            background: #fffaf5;

            border-radius: 10px;

            cursor: pointer;

            font-size: 18px;
        }


        .top-heading h1 {

            font-size: 20px;

            color: #30251e;
        }


        .top-heading p {

            font-size: 11px;

            color: #958275;

            margin-top: 3px;
        }


        .top-right {

            display: flex;

            align-items: center;

            gap: 12px;
        }


        .top-icon {

            width: 38px;
            height: 38px;

            display: flex;

            align-items: center;
            justify-content: center;

            border:
                1px solid #eaded2;

            background: #fffaf5;

            border-radius: 10px;

            position: relative;
        }


        .top-dot {

            position: absolute;

            top: 7px;
            right: 7px;

            width: 7px;
            height: 7px;

            background: #d65b49;

            border-radius: 50%;
        }


        .admin-profile {

            display: flex;

            align-items: center;

            gap: 9px;

            padding-left: 12px;

            border-left:
                1px solid #eaded2;
        }


        .admin-avatar {

            width: 38px;
            height: 38px;

            border-radius: 50%;

            background: #e7c9aa;

            color: #66462f;

            display: flex;

            align-items: center;
            justify-content: center;

            font-weight: 800;
        }


        .admin-details strong {

            display: block;

            font-size: 11px;
        }


        .admin-details span {

            display: block;

            font-size: 9px;

            color: #998577;
        }


        /* =========================================
           CONTENT
        ========================================= */

        .content {

            padding:
                30px 32px 45px;
        }


        .page-header {

            display: flex;

            align-items: flex-end;

            justify-content: space-between;

            margin-bottom: 25px;
        }


        .eyebrow {

            font-size: 9px;

            font-weight: 800;

            color: #174f3a;

            letter-spacing: 1.5px;

            margin-bottom: 7px;
        }


        .page-header h2 {

            font-size: 26px;

            color: #30251e;

            margin-bottom: 5px;
        }


        .page-header p {

            font-size: 12px;

            color: #907d6e;
        }


        .header-date {

            padding:
                10px 14px;

            background: #fffaf5;

            border:
                1px solid #e6d8cc;

            border-radius: 10px;

            font-size: 11px;

            font-weight: 700;

            color: #715d4e;
        }


        /* =========================================
           STATISTICS
        ========================================= */

        .stats {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 18px;

            margin-bottom: 22px;
        }


        .stat-card {

            background: #fffdf9;

            border:
                1px solid #eaded2;

            border-radius: 17px;

            padding: 20px;

            box-shadow:
                0 5px 20px
                rgba(91,65,43,0.04);
        }


        .stat-top {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 15px;
        }


        .stat-label {

            font-size: 10px;

            color: #988477;

            font-weight: 800;

            letter-spacing: .4px;
        }


        .stat-icon {

            width: 42px;
            height: 42px;

            border-radius: 12px;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 19px;
        }


        .stat-total {
            background: #e3eee8;
        }


        .stat-active {
            background: #e6f0e7;
        }


        .stat-inactive {
            background: #f4e3df;
        }


        .stat-number {

            font-size: 28px;

            font-weight: 800;

            color: #30251e;
        }


        .stat-sub {

            margin-top: 6px;

            font-size: 10px;

            color: #9a8779;
        }


        /* =========================================
           SEARCH BOX
        ========================================= */

        .filter-card {

            background: #fffdf9;

            border:
                1px solid #eaded2;

            border-radius: 17px;

            padding: 18px;

            margin-bottom: 20px;

            box-shadow:
                0 5px 20px
                rgba(91,65,43,0.035);
        }


        .filter-title {

            display: flex;

            align-items: center;

            gap: 8px;

            margin-bottom: 13px;

            font-size: 12px;

            font-weight: 800;

            color: #49372c;
        }


        .filter-form {

            display: grid;

            grid-template-columns:
                1fr 190px 110px;

            gap: 10px;
        }


        .search-wrap {

            position: relative;
        }


        .search-wrap span {

            position: absolute;

            left: 13px;

            top: 50%;

            transform:
                translateY(-50%);

            font-size: 14px;
        }


        .filter-form input,
        .filter-form select {

            width: 100%;

            height: 43px;

            border:
                1px solid #e4d6ca;

            background: #fffaf5;

            border-radius: 10px;

            outline: none;

            padding:
                0 13px;

            font-size: 11px;

            color: #49372c;
        }


        .filter-form input {

            padding-left: 38px;
        }


        .filter-form input:focus,
        .filter-form select:focus {

            border-color:
                #174f3a;

            box-shadow:
                0 0 0 3px
                rgba(23,79,58,0.07);
        }


        .search-btn {

            border: none;

            background: #174f3a;

            color: white;

            border-radius: 10px;

            font-size: 11px;

            font-weight: 800;

            cursor: pointer;

            transition: .2s ease;
        }


        .search-btn:hover {

            background: #103d2d;

            transform:
                translateY(-1px);
        }


        /* =========================================
           CUSTOMER TABLE
        ========================================= */

        .table-card {

            background: #fffdf9;

            border:
                1px solid #eaded2;

            border-radius: 17px;

            overflow: hidden;

            box-shadow:
                0 5px 20px
                rgba(91,65,43,0.035);
        }


        .table-header {

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding:
                20px 21px;

            border-bottom:
                1px solid #eaded2;
        }


        .table-header h3 {

            font-size: 15px;

            color: #3d2e25;
        }


        .result-count {

            font-size: 10px;

            font-weight: 700;

            color: #927e70;

            background: #f5ece4;

            padding:
                6px 9px;

            border-radius: 20px;
        }


        .table-scroll {

            overflow-x: auto;
        }


        .customer-table {

            width: 100%;

            border-collapse: collapse;

            min-width: 780px;
        }


        .customer-table th {

            padding:
                12px 18px;

            text-align: left;

            font-size: 9px;

            color: #9a8779;

            letter-spacing: .7px;

            background: #fffaf5;

            border-bottom:
                1px solid #eaded2;
        }


        .customer-table td {

            padding:
                14px 18px;

            border-bottom:
                1px solid #f0e8e1;

            font-size: 11px;

            color: #655448;
        }


        .customer-table tbody tr {

            transition: .15s ease;
        }


        .customer-table tbody tr:hover {

            background: #fffaf5;
        }


        .customer-info {

            display: flex;

            align-items: center;

            gap: 11px;
        }


        .customer-avatar {

            width: 38px;
            height: 38px;

            min-width: 38px;

            border-radius: 11px;

            background: #e8d9ca;

            color: #6b4931;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 13px;

            font-weight: 800;

            overflow: hidden;
        }


        .customer-avatar img {

            width: 100%;
            height: 100%;

            object-fit: cover;
        }


        .customer-name {

            font-size: 11px;

            font-weight: 800;

            color: #443329;

            margin-bottom: 3px;
        }


        .customer-email {

            font-size: 9px;

            color: #9a8779;
        }


        .mobile-number {

            color: #685548;

            font-weight: 600;
        }


        /* =========================================
           STATUS
        ========================================= */

        .status {

            display: inline-flex;

            align-items: center;

            gap: 5px;

            padding:
                6px 9px;

            border-radius: 20px;

            font-size: 9px;

            font-weight: 800;
        }


        .status.active {

            background: #e3efe8;

            color: #267153;
        }


        .status.inactive {

            background: #f5e3df;

            color: #b55344;
        }


        .joined-date {

            color: #887568;

            font-size: 10px;
        }


        /* =========================================
           ACTIONS
        ========================================= */

        .actions {

            display: flex;

            gap: 7px;
        }


        .action-btn {

            border: none;

            height: 30px;

            padding:
                0 9px;

            border-radius: 8px;

            font-size: 9px;

            font-weight: 800;

            cursor: pointer;

            transition: .2s ease;
        }


        .view-btn {

            background: #e7eee9;

            color: #28644e;
        }


        .view-btn:hover {

            background: #d9e8df;
        }


        .activate-btn {

            background: #e2eee7;

            color: #267153;
        }


        .deactivate-btn {

            background: #f5e4df;

            color: #b65343;
        }


        .activate-btn:hover {

            background: #d5e8dd;
        }


        .deactivate-btn:hover {

            background: #efd5cf;
        }


        .action-btn:disabled {

            opacity: .6;

            cursor: not-allowed;
        }


        /* =========================================
           EMPTY
        ========================================= */

        .empty-state {

            padding:
                70px 20px;

            text-align: center;
        }


        .empty-icon {

            width: 65px;
            height: 65px;

            border-radius: 18px;

            background: #f1e5da;

            display: flex;

            align-items: center;
            justify-content: center;

            margin:
                0 auto 14px;

            font-size: 28px;
        }


        .empty-state h3 {

            font-size: 15px;

            margin-bottom: 5px;
        }


        .empty-state p {

            font-size: 11px;

            color: #988578;
        }


        /* =========================================
           MODAL
        ========================================= */

        .modal {

            position: fixed;

            inset: 0;

            background:
                rgba(42,31,24,.48);

            display: none;

            align-items: center;

            justify-content: center;

            padding: 20px;

            z-index: 500;
        }


        .modal.show {

            display: flex;
        }


        .modal-box {

            width: 100%;

            max-width: 520px;

            background: #fffdf9;

            border-radius: 18px;

            overflow: hidden;

            box-shadow:
                0 25px 70px
                rgba(0,0,0,.18);

            animation:
                modalIn .2s ease;
        }


        @keyframes modalIn {

            from {
                opacity: 0;
                transform:
                    translateY(15px)
                    scale(.98);
            }

            to {
                opacity: 1;
                transform:
                    translateY(0)
                    scale(1);
            }

        }


        .modal-header {

            padding:
                18px 20px;

            border-bottom:
                1px solid #eaded2;

            display: flex;

            justify-content: space-between;

            align-items: center;
        }


        .modal-header h3 {

            font-size: 15px;
        }


        .modal-close {

            width: 32px;
            height: 32px;

            border: none;

            border-radius: 9px;

            background: #f4e9df;

            color: #654c3b;

            font-size: 20px;

            cursor: pointer;
        }


        .modal-body {

            padding: 20px;
        }


        .detail-row {

            display: flex;

            justify-content: space-between;

            gap: 20px;

            padding:
                13px 0;

            border-bottom:
                1px solid #f0e7df;
        }


        .detail-row:last-child {

            border-bottom: none;
        }


        .detail-label {

            font-size: 10px;

            color: #988477;

            font-weight: 700;
        }


        .detail-value {

            font-size: 11px;

            font-weight: 700;

            color: #49372c;

            text-align: right;
        }


        /* =========================================
           MOBILE
        ========================================= */

        @media (max-width: 950px) {

            .stats {

                grid-template-columns:
                    repeat(2, 1fr);
            }


            .filter-form {

                grid-template-columns:
                    1fr 1fr;
            }


            .search-btn {

                height: 43px;
            }

        }


        @media (max-width: 760px) {

            .sidebar {

                transform:
                    translateX(-100%);

                transition:
                    .3s ease;
            }


            .sidebar.open {

                transform:
                    translateX(0);
            }


            .main-content {

                margin-left: 0;

                width: 100%;
            }


            .mobile-menu {

                display: block;
            }


            .topbar {

                padding:
                    0 16px;
            }


            .top-heading {

                display: none;
            }


            .admin-details {

                display: none;
            }


            .admin-profile {

                border-left: none;

                padding-left: 0;
            }


            .content {

                padding:
                    22px 16px 35px;
            }


            .page-header {

                align-items: flex-start;
            }


            .page-header h2 {

                font-size: 22px;
            }


            .header-date {

                display: none;
            }


            .stats {

                grid-template-columns: 1fr;

                gap: 12px;
            }


            .filter-form {

                grid-template-columns: 1fr;
            }

        }


        @media (max-width: 430px) {

            .top-right {

                gap: 7px;
            }


            .top-icon {

                width: 34px;
                height: 34px;
            }


            .admin-avatar {

                width: 34px;
                height: 34px;
            }

        }

    </style>

</head>


<body>


<div class="admin-layout">


    <!-- =========================================
         SIDEBAR
    ========================================== -->

    <aside
        class="sidebar"
        id="sidebar"
    >


        <div class="brand">

            <div class="brand-icon">
                🍽️
            </div>

            <div class="brand-text">

                <h2>
                    GharSetu
                </h2>

                <span>
                    ADMIN PANEL
                </span>

            </div>

        </div>


        <div class="menu-title">
            MAIN MENU
        </div>


        <ul class="nav-menu">


            <li>
                <a href="/admin/dashboard">

                    <span class="nav-icon">
                        📊
                    </span>

                    Dashboard

                </a>
            </li>


            <li>
                <a href="/admin/customers"
                   class="active">

                    <span class="nav-icon">
                        👥
                    </span>

                    Customers

                </a>
            </li>


            <li>
                <a href="/admin/restaurants">

                    <span class="nav-icon">
                        🍽️
                    </span>

                    Restaurants

                    <span class="badge">
                        3
                    </span>

                </a>
            </li>


            <li>
                <a href="/admin/tiffin-sellers">

                    <span class="nav-icon">
                        🏠
                    </span>

                    Tiffin Sellers

                    <span class="badge">
                        2
                    </span>

                </a>
            </li>


            <li>
                <a href="/admin/delivery">

                    <span class="nav-icon">
                        🛵
                    </span>

                    Delivery Partners

                </a>
            </li>


        </ul>


        <div class="menu-title">
            MANAGEMENT
        </div>


        <ul class="nav-menu">


            <li>
                <a href="/admin/orders">

                    <span class="nav-icon">
                        📦
                    </span>

                    Orders

                </a>
            </li>


            <li>
                <a href="/admin/payments">

                    <span class="nav-icon">
                        💳
                    </span>

                    Payments

                </a>
            </li>


            <li>
                <a href="/admin/coupons">

                    <span class="nav-icon">
                        🎟️
                    </span>

                    Coupons

                </a>
            </li>


            <li>
                <a href="/admin/reviews">

                    <span class="nav-icon">
                        ⭐
                    </span>

                    Reviews

                </a>
            </li>


            <li>
                <a href="/admin/messages">

                    <span class="nav-icon">
                        💬
                    </span>

                    Mail Center

                    <span class="badge">
                        4
                    </span>

                </a>
            </li>


        </ul>


        <div class="menu-title">
            SYSTEM
        </div>


        <ul class="nav-menu">


            <li>
                <a href="/admin/analytics">

                    <span class="nav-icon">
                        📈
                    </span>

                    Analytics

                </a>
            </li>


            <li>
                <a href="/admin/complaints">

                    <span class="nav-icon">
                        ⚠️
                    </span>

                    Complaints

                </a>
            </li>


            <li>
                <a href="/admin/settings">

                    <span class="nav-icon">
                        ⚙️
                    </span>

                    Settings

                </a>
            </li>


            <li>
                <a href="/admin/logout">

                    <span class="nav-icon">
                        🚪
                    </span>

                    Logout

                </a>
            </li>


        </ul>


    </aside>



    <!-- =========================================
         MAIN
    ========================================== -->

    <main class="main-content">


        <!-- TOPBAR -->

        <header class="topbar">


            <div class="top-left">

                <button
                    class="mobile-menu"
                    id="mobileMenu"
                    type="button"
                >
                    ☰
                </button>


                <div class="top-heading">

                    <h1>
                        Customer Management
                    </h1>

                    <p>
                        Manage your GharSetu customers
                    </p>

                </div>

            </div>


            <div class="top-right">


                <div class="top-icon">

                    🔔

                    <span class="top-dot"></span>

                </div>


                <div class="top-icon">
                    💬
                </div>


                <div class="admin-profile">


                    <div class="admin-avatar">

                        <%= admin?.name
                            ? admin.name
                                .charAt(0)
                                .toUpperCase()
                            : "A"
                        %>

                    </div>


                    <div class="admin-details">

                        <strong>
                            <%= admin?.name || "Admin" %>
                        </strong>

                        <span>
                            Super Administrator
                        </span>

                    </div>


                </div>


            </div>


        </header>



        <!-- CONTENT -->

        <section class="content">


            <!-- HEADER -->

            <div class="page-header">


                <div>

                    <div class="eyebrow">
                        ADMIN MANAGEMENT
                    </div>

                    <h2>
                        Customers
                    </h2>

                    <p>
                        View, search and manage
                        GharSetu customer accounts.
                    </p>

                </div>


                <div class="header-date">
                    📅 Customer Directory
                </div>


            </div>



            <!-- =====================================
                 STATS
            ====================================== -->

            <div class="stats">


                <div class="stat-card">


                    <div class="stat-top">

                        <div class="stat-label">
                            TOTAL CUSTOMERS
                        </div>

                        <div
                            class="stat-icon stat-total"
                        >
                            👥
                        </div>

                    </div>


                    <div class="stat-number">
                        <%= totalCustomers %>
                    </div>


                    <div class="stat-sub">
                        All registered customers
                    </div>


                </div>



                <div class="stat-card">


                    <div class="stat-top">

                        <div class="stat-label">
                            ACTIVE CUSTOMERS
                        </div>

                        <div
                            class="stat-icon stat-active"
                        >
                            🟢
                        </div>

                    </div>


                    <div class="stat-number">
                        <%= activeCustomers %>
                    </div>


                    <div class="stat-sub">
                        Customers with active accounts
                    </div>


                </div>



                <div class="stat-card">


                    <div class="stat-top">

                        <div class="stat-label">
                            INACTIVE CUSTOMERS
                        </div>

                        <div
                            class="stat-icon stat-inactive"
                        >
                            🔴
                        </div>

                    </div>


                    <div class="stat-number">
                        <%= inactiveCustomers %>
                    </div>


                    <div class="stat-sub">
                        Currently inactive accounts
                    </div>


                </div>


            </div>



            <!-- =====================================
                 SEARCH
            ====================================== -->

            <div class="filter-card">


                <div class="filter-title">

                    🔎

                    Search Customers

                </div>


                <form
                    method="GET"
                    action="/admin/customers"
                    class="filter-form"
                >


                    <div class="search-wrap">

                        <span>
                            🔍
                        </span>

                        <input
                            type="text"
                            name="search"
                            placeholder="Search by name, email or mobile..."
                            value="<%= search || '' %>"
                        >

                    </div>


                    <select name="status">


                        <option
                            value="all"
                            <%= status === "all"
                                ? "selected"
                                : ""
                            %>
                        >
                            All Customers
                        </option>


                        <option
                            value="active"
                            <%= status === "active"
                                ? "selected"
                                : ""
                            %>
                        >
                            Active Customers
                        </option>


                        <option
                            value="inactive"
                            <%= status === "inactive"
                                ? "selected"
                                : ""
                            %>
                        >
                            Inactive Customers
                        </option>


                    </select>


                    <button
                        type="submit"
                        class="search-btn"
                    >
                        Search
                    </button>


                </form>


            </div>



            <!-- =====================================
                 CUSTOMER TABLE
            ====================================== -->

            <div class="table-card">


                <div class="table-header">


                    <h3>
                        Customer Directory
                    </h3>


                    <span class="result-count">

                        <%= customers.length %>

                        Result(s)

                    </span>


                </div>



                <% if (customers.length === 0) { %>


                    <div class="empty-state">


                        <div class="empty-icon">
                            👥
                        </div>


                        <h3>
                            No Customers Found
                        </h3>


                        <p>
                            Try changing your search
                            or status filter.
                        </p>


                    </div>


                <% } else { %>


                    <div class="table-scroll">


                        <table
                            class="customer-table"
                        >


                            <thead>

                                <tr>

                                    <th>
                                        CUSTOMER
                                    </th>

                                    <th>
                                        MOBILE
                                    </th>

                                    <th>
                                        STATUS
                                    </th>

                                    <th>
                                        JOINED
                                    </th>

                                    <th>
                                        ACTIONS
                                    </th>

                                </tr>

                            </thead>


                            <tbody>


                                <% customers.forEach(customer => { %>


                                    <tr
                                        id="customer-row-<%= customer._id %>"
                                    >


                                        <!-- CUSTOMER -->

                                        <td>


                                            <div
                                                class="customer-info"
                                            >


                                                <div
                                                    class="customer-avatar"
                                                >


                                                    <% if (customer.profileImage) { %>


                                                        <img
                                                            src="<%= customer.profileImage %>"
                                                            alt="Customer"
                                                        >


                                                    <% } else { %>


                                                        <%= customer.name
                                                            ? customer.name
                                                                .charAt(0)
                                                                .toUpperCase()
                                                            : "U"
                                                        %>


                                                    <% } %>


                                                </div>


                                                <div>


                                                    <div
                                                        class="customer-name"
                                                    >
                                                        <%= customer.name || "Unknown Customer" %>
                                                    </div>


                                                    <div
                                                        class="customer-email"
                                                    >
                                                        <%= customer.email || "No email" %>
                                                    </div>


                                                </div>


                                            </div>


                                        </td>



                                        <!-- MOBILE -->

                                        <td>

                                            <span
                                                class="mobile-number"
                                            >
                                                <%= customer.mobile || "-" %>
                                            </span>

                                        </td>



                                        <!-- STATUS -->

                                        <td>


                                            <% if (customer.isActive) { %>


                                                <span
                                                    class="status active"
                                                    id="status-<%= customer._id %>"
                                                >
                                                    ● Active
                                                </span>


                                            <% } else { %>


                                                <span
                                                    class="status inactive"
                                                    id="status-<%= customer._id %>"
                                                >
                                                    ● Inactive
                                                </span>


                                            <% } %>


                                        </td>



                                        <!-- JOINED -->

                                        <td>


                                            <span
                                                class="joined-date"
                                            >

                                                <%= customer.createdAt
                                                    ? new Date(
                                                        customer.createdAt
                                                    ).toLocaleDateString(
                                                        "en-IN"
                                                    )
                                                    : "-"
                                                %>

                                            </span>


                                        </td>



                                        <!-- ACTIONS -->

                                        <td>


                                            <div class="actions">


                                                <button
                                                    type="button"
                                                    class="action-btn view-btn"
                                                    onclick="viewCustomer('<%= customer._id %>')"
                                                >
                                                    👁 View
                                                </button>


                                                <button
                                                    type="button"
                                                    class="action-btn <%= customer.isActive ? 'deactivate-btn' : 'activate-btn' %>"
                                                    id="toggle-btn-<%= customer._id %>"
                                                    onclick="toggleCustomer('<%= customer._id %>')"
                                                >

                                                    <%= customer.isActive
                                                        ? "Deactivate"
                                                        : "Activate"
                                                    %>

                                                </button>


                                            </div>


                                        </td>


                                    </tr>


                                <% }) %>


                            </tbody>


                        </table>


                    </div>


                <% } %>


            </div>


        </section>


    </main>


</div>



<!-- =========================================
     CUSTOMER DETAILS MODAL
========================================== -->

<div
    class="modal"
    id="customerModal"
>


    <div class="modal-box">


        <div class="modal-header">


            <h3>
                Customer Details
            </h3>


            <button
                type="button"
                class="modal-close"
                onclick="closeCustomerModal()"
            >
                ×
            </button>


        </div>


        <div
            class="modal-body"
            id="customerModalBody"
        >

            Loading...

        </div>


    </div>


</div>



<script>


    /* =========================================
       MOBILE SIDEBAR
    ========================================= */

    const mobileMenu =
        document.getElementById(
            "mobileMenu"
        );


    const sidebar =
        document.getElementById(
            "sidebar"
        );


    if (mobileMenu) {

        mobileMenu.addEventListener(
            "click",
            function () {

                sidebar.classList.toggle(
                    "open"
                );

            }
        );

    }



    /* =========================================
       VIEW CUSTOMER
    ========================================= */

    async function viewCustomer(id) {


        const modal =
            document.getElementById(
                "customerModal"
            );


        const body =
            document.getElementById(
                "customerModalBody"
            );


        modal.classList.add(
            "show"
        );


        body.innerHTML = `
            <p style="
                text-align:center;
                color:#907d6e;
                padding:20px;
            ">
                Loading customer details...
            </p>
        `;


        try {


            const response =
                await fetch(
                    `/admin/customers/${id}`
                );


            const data =
                await response.json();


            if (
                !response.ok ||
                !data.success
            ) {

                throw new Error(
                    data.message ||
                    "Failed to load customer."
                );

            }


            const customer =
                data.customer;


            const joined =
                customer.createdAt
                    ? new Date(
                        customer.createdAt
                    ).toLocaleDateString(
                        "en-IN"
                    )
                    : "-";


            body.innerHTML = `

                <div class="detail-row">

                    <span class="detail-label">
                        Name
                    </span>

                    <span class="detail-value">
                        ${escapeHtml(
                            customer.name ||
                            "-"
                        )}
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Email
                    </span>

                    <span class="detail-value">
                        ${escapeHtml(
                            customer.email ||
                            "-"
                        )}
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Mobile
                    </span>

                    <span class="detail-value">
                        ${escapeHtml(
                            customer.mobile ||
                            "-"
                        )}
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Account Status
                    </span>

                    <span class="detail-value">

                        ${
                            customer.isActive
                                ? "🟢 Active"
                                : "🔴 Inactive"
                        }

                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Total Orders
                    </span>

                    <span class="detail-value">
                        ${customer.totalOrders ?? 0}
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Joined
                    </span>

                    <span class="detail-value">
                        ${joined}
                    </span>

                </div>

            `;


        } catch (error) {


            body.innerHTML = `

                <p style="
                    color:#b55343;
                    text-align:center;
                    padding:20px;
                    font-size:11px;
                ">
                    ${escapeHtml(
                        error.message
                    )}
                </p>

            `;

        }

    }



    /* =========================================
       CLOSE MODAL
    ========================================= */

    function closeCustomerModal() {

        document
            .getElementById(
                "customerModal"
            )
            .classList
            .remove(
                "show"
            );

    }



    /* =========================================
       TOGGLE CUSTOMER
    ========================================= */

    async function toggleCustomer(id) {


        const button =
            document.getElementById(
                `toggle-btn-${id}`
            );


        const statusElement =
            document.getElementById(
                `status-${id}`
            );


        button.disabled = true;


        const oldText =
            button.innerText;


        button.innerText =
            "Updating...";


        try {


            const response =
                await fetch(
                    `/admin/customers/${id}/toggle-status`,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        }
                    }
                );


            const data =
                await response.json();


            if (
                !response.ok ||
                !data.success
            ) {

                throw new Error(
                    data.message ||
                    "Failed to update status."
                );

            }


            if (data.isActive) {


                statusElement.className =
                    "status active";


                statusElement.innerHTML =
                    "● Active";


                button.className =
                    "action-btn deactivate-btn";


                button.innerText =
                    "Deactivate";


            } else {


                statusElement.className =
                    "status inactive";


                statusElement.innerHTML =
                    "● Inactive";


                button.className =
                    "action-btn activate-btn";


                button.innerText =
                    "Activate";

            }


        } catch (error) {


            alert(
                error.message ||
                "Something went wrong."
            );


            button.innerText =
                oldText;

        }


        button.disabled = false;

    }



    /* =========================================
       ESCAPE HTML
    ========================================= */

    function escapeHtml(value) {


        if (
            value === null ||
            value === undefined
        ) {

            return "";

        }


        return String(value)

            .replace(
                /&/g,
                "&amp;"
            )

            .replace(
                /</g,
                "&lt;"
            )

            .replace(
                />/g,
                "&gt;"
            )

            .replace(
                /"/g,
                "&quot;"
            )

            .replace(
                /'/g,
                "&#039;"
            );

    }



    /* =========================================
       MODAL BACKDROP
    ========================================= */

    document
        .getElementById(
            "customerModal"
        )
        .addEventListener(
            "click",
            function(event) {

                if (
                    event.target ===
                    this
                ) {

                    closeCustomerModal();

                }

            }
        );


</script>


</body>

</html>