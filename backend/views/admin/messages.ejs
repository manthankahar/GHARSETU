    <!-- ================= COMPOSE MODAL ================= -->

    <div
        class="modal-overlay"
        id="composeModal"
    >


        <div class="compose-modal">


            <div class="compose-header">

                <h2>
                    Compose Message
                </h2>


                <button
                    type="button"
                    class="close-btn"
                    onclick="closeCompose()"
                >
                    ×
                </button>

            </div>


            <div class="compose-body">


                <div class="form-group">

                    <label>
                        Recipient Type
                    </label>

                    <select id="recipientType">

                        <option value="">
                            Select recipient type
                        </option>

                        <option value="customer">
                            Customer
                        </option>

                        <option value="restaurant">
                            Restaurant
                        </option>

                        <option value="tiffin">
                            Tiffin Seller
                        </option>

                        <option value="delivery">
                            Delivery Partner
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Recipient Email
                    </label>

                    <input
                        type="email"
                        id="recipientEmail"
                        placeholder="Enter recipient email"
                    >

                </div>


                <div class="form-group">

                    <label>
                        Subject
                    </label>

                    <input
                        type="text"
                        id="messageSubject"
                        placeholder="Enter message subject"
                    >

                </div>


                <div class="form-group">

                    <label>
                        Message
                    </label>

                    <textarea
                        id="composeMessage"
                        placeholder="Write your message..."
                    ></textarea>

                </div>

            </div>


            <div class="compose-footer">

                <button
                    type="button"
                    class="cancel-btn"
                    onclick="closeCompose()"
                >
                    Cancel
                </button>


                <button
                    type="button"
                    class="send-btn"
                    onclick="sendMessage()"
                >
                    Send Message
                </button>

            </div>

        </div>

    </div>


    <script>


        function openCompose() {

            document
                .getElementById("composeModal")
                .classList
                .add("show");

        }


        function closeCompose() {

            document
                .getElementById("composeModal")
                .classList
                .remove("show");

        }


        function sendMessage() {

            var type =
                document
                    .getElementById("recipientType")
                    .value;

            var email =
                document
                    .getElementById("recipientEmail")
                    .value
                    .trim();

            var subject =
                document
                    .getElementById("messageSubject")
                    .value
                    .trim();

            var message =
                document
                    .getElementById("composeMessage")
                    .value
                    .trim();


            if (!type) {

                alert(
                    "Please select recipient type."
                );

                return;
            }


            if (!email) {

                alert(
                    "Please enter recipient email."
                );

                return;
            }


            if (!subject) {

                alert(
                    "Please enter message subject."
                );

                return;
            }


            if (!message) {

                alert(
                    "Please write a message."
                );

                return;
            }


            alert(
                "Message sent successfully in demo mode."
            );


            document
                .getElementById("recipientType")
                .value = "";

            document
                .getElementById("recipientEmail")
                .value = "";

            document
                .getElementById("messageSubject")
                .value = "";

            document
                .getElementById("composeMessage")
                .value = "";


            closeCompose();

        }


        function openMessage(
            sender,
            subject,
            email,
            date,
            content
        ) {

            document
                .getElementById("detailTitle")
                .textContent = subject;


            document
                .getElementById("detailSubject")
                .textContent = subject;


            document
                .getElementById("detailSender")
                .textContent = sender;


            document
                .getElementById("detailEmail")
                .textContent = email;


            document
                .getElementById("detailDate")
                .textContent = date;


            document
                .getElementById("detailContent")
                .textContent = content;


            document
                .getElementById("detailAvatar")
                .textContent =
                getInitials(sender);


            var items =
                document.querySelectorAll(
                    ".message-item"
                );


            items.forEach(function(item) {

                item.classList.remove(
                    "active"
                );

            });


            if (
                event &&
                event.currentTarget
            ) {

                event
                    .currentTarget
                    .classList
                    .add("active");

                event
                    .currentTarget
                    .classList
                    .remove("unread");

            }

        }


        function getInitials(name) {

            var parts =
                name
                    .trim()
                    .split(" ");


            if (parts.length === 1) {

                return parts[0]
                    .substring(0, 2)
                    .toUpperCase();

            }


            return (
                parts[0].charAt(0) +
                parts[parts.length - 1].charAt(0)
            ).toUpperCase();

        }


        function searchMessages() {

            var search =
                document
                    .getElementById("messageSearch")
                    .value
                    .toLowerCase()
                    .trim();


            var items =
                document.querySelectorAll(
                    ".message-item"
                );


            items.forEach(function(item) {

                var text =
                    item
                        .getAttribute("data-search")
                        .toLowerCase();


                if (
                    !search ||
                    text.indexOf(search) !== -1
                ) {

                    item.style.display = "";

                } else {

                    item.style.display = "none";

                }

            });

        }


        function refreshMessages() {

            alert(
                "Messages refreshed successfully."
            );

        }


        function moreOptions() {

            alert(
                "More message options will be connected with backend later."
            );

        }


        function selectMailbox(button, mailbox) {

            var buttons =
                document.querySelectorAll(
                    ".mail-menu-link"
                );


            buttons.forEach(function(item) {

                item.classList.remove(
                    "active"
                );

            });


            button.classList.add("active");


            if (
                mailbox !== "Inbox"
            ) {

                alert(
                    mailbox +
                    " mailbox selected. Backend connection will be added later."
                );

            }

        }


        function filterContact(type) {

            alert(
                type +
                " messages filter will be connected with backend later."
            );

        }


        function toggleImportant() {

            alert(
                "Message marked as important in demo mode."
            );

        }


        function archiveMessage() {

            alert(
                "Message archived in demo mode."
            );

        }


        function deleteMessage() {

            var result =
                confirm(
                    "Are you sure you want to delete this message?"
                );


            if (!result) {
                return;
            }


            alert(
                "Message deleted in demo mode."
            );

        }


        function sendReply() {

            var reply =
                document
                    .getElementById("replyText")
                    .value
                    .trim();


            if (!reply) {

                alert(
                    "Please write a reply first."
                );

                return;
            }


            alert(
                "Reply sent successfully in demo mode."
            );


            document
                .getElementById("replyText")
                .value = "";

        }


        document
            .getElementById("composeModal")
            .addEventListener(
                "click",
                function(event) {

                    if (
                        event.target ===
                        document.getElementById(
                            "composeModal"
                        )
                    ) {

                        closeCompose();

                    }

                }
            );


    </script>


