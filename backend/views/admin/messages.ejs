<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GharSetu | Messages</title>
    <link rel="stylesheet" href="/css/admin-message.css">
    <link rel="stylesheet" href="/css/admin-sidebar.css">
</head>
<body>

    <aside class="sidebar">
        <div class="brand">
            <div class="brand-name">GharSetu</div>
            <div class="brand-subtitle">Admin Control Center</div>
        </div>

        <div class="nav-title">Main Menu</div>

        <nav class="nav-menu">
            <a href="/admin/dashboard" class="nav-link"><span class="nav-icon">⌂</span><span class="nav-text">Dashboard</span></a>
            <a href="/admin/customers" class="nav-link"><span class="nav-icon">👥</span><span class="nav-text">Customers</span></a>
            <a href="/admin/restaurants" class="nav-link"><span class="nav-icon">🍽</span><span class="nav-text">Restaurants</span></a>
            <a href="/admin/tiffin-sellers" class="nav-link"><span class="nav-icon">🥘</span><span class="nav-text">Tiffin Sellers</span></a>
            <a href="/admin/delivery" class="nav-link"><span class="nav-icon">🛵</span><span class="nav-text">Delivery Partners</span></a>
            <a href="/admin/orders" class="nav-link"><span class="nav-icon">📦</span><span class="nav-text">Orders</span></a>
            <a href="/admin/payments" class="nav-link"><span class="nav-icon">💳</span><span class="nav-text">Payments</span></a>
            <a href="/admin/complaints" class="nav-link"><span class="nav-icon">💬</span><span class="nav-text">Complaints</span></a>
            <a href="/admin/analytics" class="nav-link"><span class="nav-icon">📊</span><span class="nav-text">Analytics</span></a>
            <a href="/admin/coupons" class="nav-link"><span class="nav-icon">🎟</span><span class="nav-text">Coupons</span></a>
            <a href="/admin/reviews" class="nav-link"><span class="nav-icon">⭐</span><span class="nav-text">Reviews</span></a>
            <a href="/admin/messages" class="nav-link active"><span class="nav-icon">✉</span><span class="nav-text">Messages</span></a>
            <a href="/admin/settings" class="nav-link"><span class="nav-icon">⚙</span><span class="nav-text">Settings</span></a>
            <a href="/admin/profile" class="nav-link"><span class="nav-icon">👤</span><span class="nav-text">Admin Profile</span></a>
            <a href="/admin/logout" class="nav-link"><span class="nav-icon">↪</span><span class="nav-text">Logout</span></a>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="page-title">
                <h1>Messages &amp; Mail Center</h1>
                <p>Manage customer and partner communication</p>
            </div>

            <div class="admin-area">
                <div class="admin-info">
                    <div class="admin-name"><%= admin?.name || "Administrator" %></div>
                    <div class="admin-role">GharSetu Admin</div>
                </div>
                <div class="admin-avatar"><%= (admin?.name || "A").charAt(0).toUpperCase() %></div>
            </div>
        </header>

        <section class="content">
            <div class="stats">
                <div class="stat-card">
                    <div class="stat-icon">📩</div>
                    <div class="stat-label">Total Messages</div>
                    <div class="stat-value"><%= typeof totalMessages !== "undefined" ? totalMessages : "1,286" %></div>
                    <div class="stat-note">All conversations</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">🔵</div>
                    <div class="stat-label">Unread</div>
                    <div class="stat-value"><%= typeof unreadMessages !== "undefined" ? unreadMessages : "24" %></div>
                    <div class="stat-note">Need attention</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">📤</div>
                    <div class="stat-label">Sent</div>
                    <div class="stat-value"><%= typeof sentMessages !== "undefined" ? sentMessages : "642" %></div>
                    <div class="stat-note">Admin communication</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">⭐</div>
                    <div class="stat-label">Important</div>
                    <div class="stat-value"><%= typeof importantMessages !== "undefined" ? importantMessages : "18" %></div>
                    <div class="stat-note">Flagged conversations</div>
                </div>
            </div>

            <div class="mail-layout">
                <div class="mail-menu">
                    <button type="button" class="compose-btn" onclick="openCompose()">＋ Compose Message</button>
                    <div class="mail-menu-title">Mailbox</div>

                    <button type="button" class="mail-menu-link active" onclick="selectMailbox(this,'Inbox')">
                        <span class="mail-menu-left"><span>📥</span><span>Inbox</span></span>
                        <span class="mail-badge">24</span>
                    </button>
                    <button type="button" class="mail-menu-link" onclick="selectMailbox(this,'Sent')">
                        <span class="mail-menu-left"><span>📤</span><span>Sent</span></span>
                    </button>
                    <button type="button" class="mail-menu-link" onclick="selectMailbox(this,'Important')">
                        <span class="mail-menu-left"><span>⭐</span><span>Important</span></span>
                        <span class="mail-badge">18</span>
                    </button>
                    <button type="button" class="mail-menu-link" onclick="selectMailbox(this,'Drafts')">
                        <span class="mail-menu-left"><span>📝</span><span>Drafts</span></span>
                        <span class="mail-badge">3</span>
                    </button>
                    <button type="button" class="mail-menu-link" onclick="selectMailbox(this,'Trash')">
                        <span class="mail-menu-left"><span>🗑</span><span>Trash</span></span>
                    </button>

                    <div class="mail-menu-title contacts-title">Contacts</div>
                    <button type="button" class="mail-menu-link" onclick="filterContact('Customers')"><span class="mail-menu-left"><span>👥</span><span>Customers</span></span></button>
                    <button type="button" class="mail-menu-link" onclick="filterContact('Restaurants')"><span class="mail-menu-left"><span>🍽</span><span>Restaurants</span></span></button>
                    <button type="button" class="mail-menu-link" onclick="filterContact('Tiffin Sellers')"><span class="mail-menu-left"><span>🥘</span><span>Tiffin Sellers</span></span></button>
                    <button type="button" class="mail-menu-link" onclick="filterContact('Delivery Partners')"><span class="mail-menu-left"><span>🛵</span><span>Delivery Partners</span></span></button>
                </div>

                <div class="message-list">
                    <div class="message-toolbar">
                        <div class="message-search">
                            <span>⌕</span>
                            <input type="text" id="messageSearch" placeholder="Search messages..." oninput="searchMessages()">
                        </div>
                        <button type="button" class="toolbar-btn" title="Refresh" onclick="refreshMessages()">↻</button>
                        <button type="button" class="toolbar-btn" title="More" onclick="moreOptions()">⋮</button>
                    </div>

                    <div class="messages" id="messagesList">
                        <div class="message-item unread active"
                             data-search="rahul order delayed delivery complaint"
                             data-sender="Rahul Patel"
                             data-subject="Order delivery is delayed"
                             data-email="rahul@example.com"
                             data-date="11 Sep 2026"
                             data-content="Hi GharSetu Team, my order has been delayed for more than 40 minutes. Please check the delivery status and help me with the current update."
                             onclick="openMessage(this)">
                            <div class="message-top">
                                <div class="sender-avatar">RP</div>
                                <div class="message-main">
                                    <span class="message-date">10:42 AM</span>
                                    <div class="sender-name">Rahul Patel</div>
                                    <div class="message-subject">Order delivery is delayed</div>
                                    <div class="message-preview">Hi GharSetu Team, my order has been delayed...</div>
                                </div>
                                <div class="unread-dot"></div>
                            </div>
                        </div>

                        <div class="message-item unread"
                             data-search="spice garden restaurant menu update"
                             data-sender="Spice Garden"
                             data-subject="Request to update restaurant menu"
                             data-email="spicegarden@example.com"
                             data-date="11 Sep 2026"
                             data-content="Hello Admin, we have added some new dishes to our restaurant menu. Please approve and publish the updated menu for our customers."
                             onclick="openMessage(this)">
                            <div class="message-top">
                                <div class="sender-avatar">SG</div>
                                <div class="message-main">
                                    <span class="message-date">9:58 AM</span>
                                    <div class="sender-name">Spice Garden</div>
                                    <div class="message-subject">Request to update restaurant menu</div>
                                    <div class="message-preview">We have added some new dishes to our restaurant menu...</div>
                                </div>
                                <div class="unread-dot"></div>
                            </div>
                        </div>

                        <div class="message-item"
                             data-search="home taste tiffin subscription"
                             data-sender="Home Taste Tiffin"
                             data-subject="Monthly subscription update"
                             data-email="hometaste@example.com"
                             data-date="10 Sep 2026"
                             data-content="Our monthly tiffin subscription plan has been updated. We would like to discuss the new pricing and delivery schedule with the GharSetu team."
                             onclick="openMessage(this)">
                            <div class="message-top">
                                <div class="sender-avatar">HT</div>
                                <div class="message-main">
                                    <span class="message-date">Yesterday</span>
                                    <div class="sender-name">Home Taste Tiffin</div>
                                    <div class="message-subject">Monthly subscription update</div>
                                    <div class="message-preview">Our monthly tiffin subscription plan has been updated...</div>
                                </div>
                            </div>
                        </div>

                        <div class="message-item unread"
                             data-search="priya refund payment issue"
                             data-sender="Priya Shah"
                             data-subject="Refund request for cancelled order"
                             data-email="priya@example.com"
                             data-date="10 Sep 2026"
                             data-content="I cancelled my order yesterday but I have not received the refund yet. Kindly check the payment status and let me know when the amount will be credited."
                             onclick="openMessage(this)">
                            <div class="message-top">
                                <div class="sender-avatar">PS</div>
                                <div class="message-main">
                                    <span class="message-date">Yesterday</span>
                                    <div class="sender-name">Priya Shah</div>
                                    <div class="message-subject">Refund request for cancelled order</div>
                                    <div class="message-preview">I cancelled my order yesterday but I have not received...</div>
                                </div>
                                <div class="unread-dot"></div>
                            </div>
                        </div>

                        <div class="message-item"
                             data-search="delivery partner earning payment"
                             data-sender="Amit Delivery"
                             data-subject="Earning calculation query"
                             data-email="amitdelivery@example.com"
                             data-date="09 Sep 2026"
                             data-content="Hello Admin, I have a question regarding my delivery earnings for yesterday. One completed order seems to be missing from my earning summary."
                             onclick="openMessage(this)">
                            <div class="message-top">
                                <div class="sender-avatar">AD</div>
                                <div class="message-main">
                                    <span class="message-date">09 Sep</span>
                                    <div class="sender-name">Amit Delivery</div>
                                    <div class="message-subject">Earning calculation query</div>
                                    <div class="message-preview">I have a question regarding my delivery earnings...</div>
                                </div>
                            </div>
                        </div>

                        <div class="message-item"
                             data-search="customer account login problem"
                             data-sender="Neha Mehta"
                             data-subject="Unable to login to my account"
                             data-email="neha@example.com"
                             data-date="08 Sep 2026"
                             data-content="I am unable to login to my GharSetu account even after resetting my password. Please help me access my account again."
                             onclick="openMessage(this)">
                            <div class="message-top">
                                <div class="sender-avatar">NM</div>
                                <div class="message-main">
                                    <span class="message-date">08 Sep</span>
                                    <div class="sender-name">Neha Mehta</div>
                                    <div class="message-subject">Unable to login to my account</div>
                                    <div class="message-preview">I am unable to login to my GharSetu account...</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="message-detail">
                    <div class="detail-header">
                        <h2 id="detailTitle">Order delivery is delayed</h2>
                        <div class="detail-actions">
                            <button type="button" class="detail-btn" title="Star" onclick="toggleImportant()">☆</button>
                            <button type="button" class="detail-btn" title="Archive" onclick="archiveMessage()">▢</button>
                            <button type="button" class="detail-btn" title="Delete" onclick="deleteMessage()">🗑</button>
                        </div>
                    </div>

                    <div class="detail-body">
                        <div class="detail-subject" id="detailSubject">Order delivery is delayed</div>
                        <div class="sender-detail">
                            <div class="sender-large-avatar" id="detailAvatar">RP</div>
                            <div>
                                <strong id="detailSender">Rahul Patel</strong>
                                <span id="detailEmail">rahul@example.com</span>
                            </div>
                            <div class="detail-date" id="detailDate">11 Sep 2026</div>
                        </div>

                        <div class="message-content">
                            <p id="detailContent">Hi GharSetu Team, my order has been delayed for more than 40 minutes. Please check the delivery status and help me with the current update.</p>
                            <span class="message-tag">Customer Support</span>
                        </div>

                        <div class="reply-area">
                            <textarea id="replyText" placeholder="Write your reply..."></textarea>
                            <div class="reply-bottom">
                                <span class="reply-note">Reply will be sent from GharSetu Admin</span>
                                <button type="button" class="reply-btn" onclick="sendReply()">Send Reply</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <div class="modal-overlay" id="composeModal">
        <div class="compose-modal">
            <div class="compose-header">
                <h2>Compose Message</h2>
                <button type="button" class="close-btn" onclick="closeCompose()">×</button>
            </div>

            <div class="compose-body">
                <div class="form-group">
                    <label for="recipientType">Recipient Type</label>
                    <select id="recipientType">
                        <option value="">Select recipient type</option>
                        <option value="customer">Customer</option>
                        <option value="restaurant">Restaurant</option>
                        <option value="tiffin">Tiffin Seller</option>
                        <option value="delivery">Delivery Partner</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="recipientEmail">Recipient Email</label>
                    <input type="email" id="recipientEmail" placeholder="Enter recipient email">
                </div>

                <div class="form-group">
                    <label for="messageSubject">Subject</label>
                    <input type="text" id="messageSubject" placeholder="Enter message subject">
                </div>

                <div class="form-group">
                    <label for="composeMessage">Message</label>
                    <textarea id="composeMessage" placeholder="Write your message..."></textarea>
                </div>
            </div>

            <div class="compose-footer">
                <button type="button" class="cancel-btn" onclick="closeCompose()">Cancel</button>
                <button type="button" class="send-btn" onclick="sendMessage()">Send Message</button>
            </div>
        </div>
    </div>

    <script>
        function openCompose() {
            document.getElementById("composeModal").classList.add("show");
        }

        function closeCompose() {
            document.getElementById("composeModal").classList.remove("show");
        }

        function sendMessage() {
            const type = document.getElementById("recipientType").value;
            const email = document.getElementById("recipientEmail").value.trim();
            const subject = document.getElementById("messageSubject").value.trim();
            const message = document.getElementById("composeMessage").value.trim();

            if (!type) return alert("Please select recipient type.");
            if (!email) return alert("Please enter recipient email.");

            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                return alert("Please enter a valid email address.");
            }

            if (!subject) return alert("Please enter message subject.");
            if (!message) return alert("Please write a message.");

            alert("Message sent successfully in demo mode.");

            document.getElementById("recipientType").value = "";
            document.getElementById("recipientEmail").value = "";
            document.getElementById("messageSubject").value = "";
            document.getElementById("composeMessage").value = "";
            closeCompose();
        }

        function openMessage(item) {
            const sender = item.dataset.sender;
            const subject = item.dataset.subject;

            document.getElementById("detailTitle").textContent = subject;
            document.getElementById("detailSubject").textContent = subject;
            document.getElementById("detailSender").textContent = sender;
            document.getElementById("detailEmail").textContent = item.dataset.email;
            document.getElementById("detailDate").textContent = item.dataset.date;
            document.getElementById("detailContent").textContent = item.dataset.content;
            document.getElementById("detailAvatar").textContent = getInitials(sender);

            document.querySelectorAll(".message-item").forEach(message => {
                message.classList.remove("active");
            });

            item.classList.add("active");
            item.classList.remove("unread");

            const dot = item.querySelector(".unread-dot");
            if (dot) dot.remove();
        }

        function getInitials(name) {
            const parts = name.trim().split(/\s+/);

            if (parts.length === 1) {
                return parts[0].substring(0, 2).toUpperCase();
            }

            return (
                parts[0].charAt(0) +
                parts[parts.length - 1].charAt(0)
            ).toUpperCase();
        }

        function searchMessages() {
            const search = document.getElementById("messageSearch").value.toLowerCase().trim();

            document.querySelectorAll(".message-item").forEach(item => {
                const text = (
                    item.dataset.search + " " +
                    item.dataset.sender + " " +
                    item.dataset.subject + " " +
                    item.dataset.email + " " +
                    item.dataset.content
                ).toLowerCase();

                item.style.display = !search || text.includes(search) ? "" : "none";
            });
        }

        function refreshMessages() {
            alert("Messages refreshed successfully.");
        }

        function moreOptions() {
            alert("More message options will be connected with backend later.");
        }

        function selectMailbox(button, mailbox) {
            document.querySelectorAll(".mail-menu-link").forEach(item => {
                item.classList.remove("active");
            });

            button.classList.add("active");

            if (mailbox !== "Inbox") {
                alert(mailbox + " mailbox selected. Backend connection will be added later.");
            }
        }

        function filterContact(type) {
            alert(type + " messages filter will be connected with backend later.");
        }

        function toggleImportant() {
            alert("Message marked as important in demo mode.");
        }

        function archiveMessage() {
            alert("Message archived in demo mode.");
        }

        function deleteMessage() {
            if (!confirm("Are you sure you want to delete this message?")) return;
            alert("Message deleted in demo mode.");
        }

        function sendReply() {
            const reply = document.getElementById("replyText").value.trim();

            if (!reply) {
                alert("Please write a reply first.");
                return;
            }

            alert("Reply sent successfully in demo mode.");
            document.getElementById("replyText").value = "";
        }

        document.getElementById("composeModal").addEventListener("click", function(event) {
            if (event.target === this) closeCompose();
        });

        document.addEventListener("keydown", function(event) {
            if (event.key === "Escape") closeCompose();
        });
    </script>
</body>
</html>