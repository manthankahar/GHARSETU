<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GharSetu | Admin Profile</title>

    <link rel="stylesheet" href="/css/admin.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f8f4ec;
            color: #3e2b23;
        }

        /* ==========================================
           MAIN PROFILE PAGE
        ========================================== */

        .profile-page {
            min-height: 100vh;
            padding: 34px 38px 50px;
        }

        .profile-container {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
        }


        /* ==========================================
           PAGE HEADER
        ========================================== */

        .profile-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
        }

        .header-left h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
            color: #3e2b23;
            letter-spacing: -0.5px;
        }

        .header-left p {
            margin: 8px 0 0;
            font-size: 14px;
            color: #857369;
        }

        .dashboard-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 17px;
            border-radius: 11px;
            background: #3e2b23;
            color: #ffffff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            transition: all 0.25s ease;
        }

        .dashboard-btn:hover {
            background: #2f6f4e;
            transform: translateY(-2px);
        }


        /* ==========================================
           PROFILE HERO
        ========================================== */

        .profile-hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;

            padding: 27px 30px;

            background: linear-gradient(
                135deg,
                #fffdf9,
                #f2e8d9
            );

            border: 1px solid #e5d8c8;
            border-radius: 20px;

            box-shadow:
                0 10px 30px rgba(62, 43, 35, 0.07);

            margin-bottom: 24px;
        }

        .hero-profile {
            display: flex;
            align-items: center;
            gap: 19px;
        }

        .hero-avatar {
            width: 76px;
            height: 76px;
            min-width: 76px;

            border-radius: 20px;

            background: linear-gradient(
                135deg,
                #3e2b23,
                #72533f
            );

            color: #ffffff;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 29px;
            font-weight: 700;

            box-shadow:
                0 9px 20px rgba(62, 43, 35, 0.18);
        }

        .hero-text h2 {
            margin: 0;
            font-size: 22px;
            color: #3e2b23;
        }

        .hero-text p {
            margin: 5px 0 10px;
            font-size: 13px;
            color: #857369;
        }

        .role-badge {
            display: inline-flex;
            align-items: center;

            padding: 6px 12px;

            border-radius: 30px;

            background: #e4f0e7;
            color: #2f6f4e;

            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .hero-status {
            display: flex;
            align-items: center;
            gap: 8px;

            padding: 10px 14px;

            border-radius: 11px;

            background: #ffffff;
            border: 1px solid #ded2c4;

            font-size: 13px;
            font-weight: 700;
            color: #2f6f4e;
        }

        .online-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #2f6f4e;
        }


        /* ==========================================
           COMMON CARD
        ========================================== */

        .profile-card {
            background: #fffdf9;

            border: 1px solid #e5d8c8;
            border-radius: 18px;

            padding: 26px 28px;

            box-shadow:
                0 8px 25px rgba(62, 43, 35, 0.06);

            margin-bottom: 22px;
        }


        /* ==========================================
           SECTION HEADER
        ========================================== */

        .section-heading {
            display: flex;
            align-items: center;
            gap: 13px;

            margin-bottom: 23px;
        }

        .section-icon {
            width: 43px;
            height: 43px;
            min-width: 43px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background: #eee3d2;

            font-size: 19px;
        }

        .section-heading h3 {
            margin: 0;

            font-size: 18px;
            color: #3e2b23;
        }

        .section-heading p {
            margin: 4px 0 0;

            font-size: 12px;
            color: #8a786c;
        }


        /* ==========================================
           PERSONAL INFORMATION
        ========================================== */

        .information-grid {
            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));

            gap: 16px;
        }

        .information-item {
            padding: 16px 17px;

            background: #faf6ef;

            border: 1px solid #eadfce;

            border-radius: 13px;
        }

        .information-label {
            margin-bottom: 7px;

            font-size: 10px;
            font-weight: 800;

            text-transform: uppercase;
            letter-spacing: 0.7px;

            color: #98877b;
        }

        .information-value {
            font-size: 14px;
            font-weight: 700;

            color: #49362e;

            word-break: break-word;
        }


        /* ==========================================
           EDIT PROFILE FORM
        ========================================== */

        .edit-form {
            margin-top: 22px;

            padding-top: 22px;

            border-top: 1px solid #eee4d8;
        }

        .form-grid {
            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));

            gap: 17px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .form-group label {
            font-size: 12px;
            font-weight: 700;
            color: #5d493e;
        }

        .form-group input {
            width: 100%;

            padding: 12px 14px;

            border: 1px solid #ddcfc0;
            border-radius: 11px;

            background: #ffffff;

            color: #3e2b23;

            font-size: 13px;

            outline: none;

            transition: all 0.2s ease;
        }

        .form-group input:focus {
            border-color: #2f6f4e;

            box-shadow:
                0 0 0 3px rgba(47, 111, 78, 0.09);
        }

        .form-group input[readonly] {
            background: #f2ede5;
            color: #7f7066;
            cursor: not-allowed;
        }

        .save-btn {
            margin-top: 19px;

            padding: 11px 20px;

            border: none;
            border-radius: 10px;

            background: #2f6f4e;
            color: #ffffff;

            font-size: 13px;
            font-weight: 700;

            cursor: pointer;

            transition: all 0.25s ease;
        }

        .save-btn:hover {
            background: #23573c;
            transform: translateY(-2px);
        }


        /* ==========================================
           SECURITY
        ========================================== */

        .security-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .security-item {
            display: flex;

            align-items: center;
            justify-content: space-between;

            gap: 20px;

            padding: 17px;

            background: #faf6ef;

            border: 1px solid #eadfce;

            border-radius: 13px;
        }

        .security-left {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .security-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 11px;

            background: #eee3d2;

            font-size: 17px;
        }

        .security-text strong {
            display: block;

            margin-bottom: 4px;

            font-size: 13px;
            color: #3e2b23;
        }

        .security-text span {
            display: block;

            font-size: 11px;
            color: #8c7b70;
        }

        .security-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            padding: 9px 14px;

            border-radius: 9px;

            border: 1px solid #d9cbbb;

            background: #ffffff;

            color: #3e2b23;

            text-decoration: none;

            font-size: 11px;
            font-weight: 700;

            white-space: nowrap;

            transition: all 0.2s ease;
        }

        .security-btn:hover {
            border-color: #2f6f4e;
            color: #2f6f4e;
        }

        .active-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;

            padding: 8px 12px;

            border-radius: 20px;

            background: #e4f0e7;

            color: #2f6f4e;

            font-size: 11px;
            font-weight: 800;

            white-space: nowrap;
        }


        /* ==========================================
           ADMIN ACCESS
        ========================================== */

        .access-box {
            display: flex;
            align-items: center;
            gap: 15px;

            padding: 18px;

            background: #faf6ef;

            border: 1px solid #eadfce;

            border-radius: 13px;
        }

        .access-icon {
            width: 45px;
            height: 45px;
            min-width: 45px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background: #eee3d2;

            font-size: 19px;
        }

        .access-text strong {
            display: block;

            margin-bottom: 5px;

            font-size: 14px;

            color: #3e2b23;
        }

        .access-text span {
            display: block;

            max-width: 850px;

            font-size: 12px;
            line-height: 1.6;

            color: #88766a;
        }


        /* ==========================================
           RESPONSIVE
        ========================================== */

        @media (max-width: 900px) {

            .profile-page {
                padding: 25px 22px 40px;
            }

            .profile-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .profile-hero {
                align-items: flex-start;
                flex-direction: column;
            }

            .hero-status {
                align-self: flex-start;
            }

            .information-grid,
            .form-grid {
                grid-template-columns: 1fr;
            }
        }


        @media (max-width: 600px) {

            .profile-page {
                padding: 20px 15px 35px;
            }

            .header-left h1 {
                font-size: 25px;
            }

            .profile-card {
                padding: 21px 18px;
            }

            .profile-hero {
                padding: 21px;
            }

            .hero-avatar {
                width: 64px;
                height: 64px;
                min-width: 64px;

                border-radius: 17px;

                font-size: 24px;
            }

            .hero-text h2 {
                font-size: 19px;
            }

            .security-item {
                align-items: flex-start;
                flex-direction: column;
            }

            .security-btn,
            .active-status {
                align-self: flex-start;
            }

            .access-box {
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>

    <!-- ==========================================
         ADMIN SIDEBAR
    ========================================== -->

    <%- include("../partials/adminSidebar") %>


    <!-- ==========================================
         MAIN CONTENT
    ========================================== -->

    <main class="profile-page">

        <div class="profile-container">


            <!-- ======================================
                 PAGE HEADER
            ====================================== -->

            <div class="profile-header">

                <div class="header-left">

                    <h1>
                        Admin Profile
                    </h1>

                    <p>
                        Manage your administrator account and personal information.
                    </p>

                </div>


                <a
                    href="/admin/dashboard"
                    class="dashboard-btn"
                >
                    ← Dashboard
                </a>

            </div>



            <%
                var adminName = admin && admin.name
                    ? admin.name
                    : "Admin";

                var firstLetter = adminName
                    .charAt(0)
                    .toUpperCase();
            %>


            <!-- ======================================
                 PROFILE HERO
            ====================================== -->

            <div class="profile-hero">

                <div class="hero-profile">

                    <div class="hero-avatar">
                        <%= firstLetter %>
                    </div>


                    <div class="hero-text">

                        <h2>
                            <%= adminName %>
                        </h2>

                        <p>
                            GharSetu Administrator
                        </p>

                        <span class="role-badge">
                            SUPER ADMIN
                        </span>

                    </div>

                </div>


                <div class="hero-status">

                    <span class="online-dot"></span>

                    Account Active

                </div>

            </div>



            <!-- ======================================
                 PERSONAL INFORMATION
            ====================================== -->

            <div class="profile-card">

                <div class="section-heading">

                    <div class="section-icon">
                        👤
                    </div>

                    <div>

                        <h3>
                            Personal Information
                        </h3>

                        <p>
                            Your basic administrator information.
                        </p>

                    </div>

                </div>


                <!-- CURRENT INFORMATION -->

                <div class="information-grid">

                    <div class="information-item">

                        <div class="information-label">
                            Full Name
                        </div>

                        <div class="information-value">
                            <%= admin && admin.name
                                ? admin.name
                                : "Not available" %>
                        </div>

                    </div>


                    <div class="information-item">

                        <div class="information-label">
                            Email Address
                        </div>

                        <div class="information-value">
                            <%= admin && admin.email
                                ? admin.email
                                : "Not available" %>
                        </div>

                    </div>


                    <div class="information-item">

                        <div class="information-label">
                            Mobile Number
                        </div>

                        <div class="information-value">
                            <%= admin && admin.mobile
                                ? admin.mobile
                                : "Not available" %>
                        </div>

                    </div>


                    <div class="information-item">

                        <div class="information-label">
                            Administrator Role
                        </div>

                        <div class="information-value">
                            Super Admin
                        </div>

                    </div>

                </div>


                <!-- EDIT PROFILE -->

                <div class="edit-form">

                    <form
                        action="/admin/settings/profile"
                        method="POST"
                    >

                        <div class="form-grid">


                            <div class="form-group">

                                <label for="name">
                                    Full Name
                                </label>

                                <input
                                    type="text"
                                    id="name"
                                    name="name"
                                    value="<%= admin && admin.name ? admin.name : '' %>"
                                    placeholder="Enter full name"
                                    required
                                >

                            </div>


                            <div class="form-group">

                                <label for="email">
                                    Email Address
                                </label>

                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    value="<%= admin && admin.email ? admin.email : '' %>"
                                    placeholder="Enter email address"
                                    required
                                >

                            </div>


                            <div class="form-group">

                                <label for="mobile">
                                    Mobile Number
                                </label>

                                <input
                                    type="text"
                                    id="mobile"
                                    name="mobile"
                                    value="<%= admin && admin.mobile ? admin.mobile : '' %>"
                                    placeholder="Enter mobile number"
                                    required
                                >

                            </div>


                            <div class="form-group">

                                <label for="role">
                                    Role
                                </label>

                                <input
                                    type="text"
                                    id="role"
                                    value="Super Admin"
                                    readonly
                                >

                            </div>


                        </div>


                        <button
                            type="submit"
                            class="save-btn"
                        >
                            Save Changes
                        </button>

                    </form>

                </div>

            </div>



            <!-- ======================================
                 SECURITY
            ====================================== -->

            <div class="profile-card">

                <div class="section-heading">

                    <div class="section-icon">
                        🔐
                    </div>

                    <div>

                        <h3>
                            Security
                        </h3>

                        <p>
                            Keep your administrator account secure.
                        </p>

                    </div>

                </div>


                <div class="security-list">


                    <!-- PASSWORD -->

                    <div class="security-item">

                        <div class="security-left">

                            <div class="security-icon">
                                🔑
                            </div>

                            <div class="security-text">

                                <strong>
                                    Password
                                </strong>

                                <span>
                                    Update your account password regularly.
                                </span>

                            </div>

                        </div>


                        <a
                            href="/admin/settings"
                            class="security-btn"
                        >
                            Change Password
                        </a>

                    </div>


                    <!-- ACCOUNT STATUS -->

                    <div class="security-item">

                        <div class="security-left">

                            <div class="security-icon">
                                🛡️
                            </div>

                            <div class="security-text">

                                <strong>
                                    Account Status
                                </strong>

                                <span>
                                    Your administrator account is currently active.
                                </span>

                            </div>

                        </div>


                        <span class="active-status">

                            <span class="online-dot"></span>

                            Active

                        </span>

                    </div>


                </div>

            </div>



            <!-- ======================================
                 ADMINISTRATOR ACCESS
            ====================================== -->

            <div class="profile-card">

                <div class="section-heading">

                    <div class="section-icon">
                        🛡️
                    </div>

                    <div>

                        <h3>
                            Administrator Access
                        </h3>

                        <p>
                            Administrative access information.
                        </p>

                    </div>

                </div>


                <div class="access-box">

                    <div class="access-icon">
                        ⚙️
                    </div>


                    <div class="access-text">

                        <strong>
                            Full Platform Access
                        </strong>

                        <span>
                            You can manage customers, restaurants,
                            tiffin sellers, delivery partners, orders,
                            complaints, analytics and other GharSetu
                            platform operations.
                        </span>

                    </div>

                </div>

            </div>


        </div>

    </main>

</body>
</html>