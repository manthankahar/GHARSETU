```ejs
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GharSetu | Admin Dashboard</title>

    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin-sidebar.css">
</head>

<body>

    <div class="admin-layout">

        <!-- SHARED ADMIN SIDEBAR -->
        <%- include("../partials/adminSidebar", {
            admin: typeof admin !== "undefined" ? admin : null,
            activePage: "dashboard"
        }) %>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            <!-- TOPBAR -->
            <header class="topbar">

                <div class="page-heading">
                    <h1>Admin Dashboard</h1>
                    <p>GharSetu platform overview</p>
                </div>

                <div class="top-actions">

                    <button
                        class="mobile-menu"
                        id="mobileMenu"
                        type="button"
                        aria-label="Open navigation menu"
                        aria-controls="sidebar"
                        aria-expanded="false">
                        ☰
                    </button>

                    <button class="top-icon" type="button" aria-label="Notifications">
                        🔔
                        <span class="dot"></span>
                    </button>

                    <button class="top-icon" type="button" aria-label="Messages">
                        💬
                    </button>

                    <div class="admin-profile">
                        <div class="profile-avatar">
                            <%= typeof admin !== "undefined" && admin && admin.name
                                ? admin.name.charAt(0).toUpperCase()
                                : "A" %>
                        </div>

                        <div class="profile-info">
                            <strong>
                                <%= typeof admin !== "undefined" && admin && admin.name
                                    ? admin.name
                                    : "Admin" %>
                            </strong>
                            <span>Super Administrator</span>
                        </div>
                    </div>

                </div>

            </header>

            <!-- DASHBOARD CONTENT -->
            <section class="dashboard-content">

                <!-- WELCOME -->
                <div class="welcome-row">
                    <div class="welcome">
                        <h2>Good Morning, Admin 👋</h2>
                        <p>Here's what's happening with GharSetu today.</p>
                    </div>

                    <div class="date-button" id="todayDate">
                        📅 Today
                    </div>
                </div>

                <!-- STATISTICS -->
                <div class="stats-grid">

                    <div class="stat-card">
                        <div class="stat-top">
                            <div class="stat-label">TOTAL CUSTOMERS</div>
                            <div class="stat-icon icon-green">👥</div>
                        </div>
                        <div class="stat-value">
                            <%= typeof totalCustomers !== "undefined" ? totalCustomers : 0 %>
                        </div>
                        <div class="stat-change">Registered customers</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-top">
                            <div class="stat-label">FOOD PARTNERS</div>
                            <div class="stat-icon icon-brown">🍽️</div>
                        </div>
                        <div class="stat-value">
                            <%= (
                                (typeof totalRestaurants !== "undefined" ? totalRestaurants : 0) +
                                (typeof totalTiffinSellers !== "undefined" ? totalTiffinSellers : 0)
                            ) %>
                        </div>
                        <div class="stat-change">Restaurants + Tiffin Sellers</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-top">
                            <div class="stat-label">TOTAL ORDERS</div>
                            <div class="stat-icon icon-orange">📦</div>
                        </div>
                        <div class="stat-value">
                            <%= typeof totalOrders !== "undefined" ? totalOrders : 0 %>
                        </div>
                        <div class="stat-change">All recorded orders</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-top">
                            <div class="stat-label">TOTAL REVENUE</div>
                            <div class="stat-icon icon-blue">💰</div>
                        </div>
                        <div class="stat-value">
                            ₹<%= Number(typeof totalRevenue !== "undefined" ? totalRevenue : 0).toLocaleString("en-IN") %>
                        </div>
                        <div class="stat-change">From completed orders</div>
                    </div>

                </div>

                <!-- CHART + QUICK ACTIONS -->
                <div class="dashboard-grid">

                    <div class="panel">
                        <div class="panel-header">
                            <h3>Orders Overview</h3>
                            <a href="/admin/analytics">View Analytics →</a>
                        </div>

                        <div class="chart-area">
                            <div class="bar-column">
                                <div class="bar" style="height:45%"></div>
                                <span class="bar-label">Mon</span>
                            </div>
                            <div class="bar-column">
                                <div class="bar" style="height:62%"></div>
                                <span class="bar-label">Tue</span>
                            </div>
                            <div class="bar-column">
                                <div class="bar" style="height:52%"></div>
                                <span class="bar-label">Wed</span>
                            </div>
                            <div class="bar-column">
                                <div class="bar" style="height:78%"></div>
                                <span class="bar-label">Thu</span>
                            </div>
                            <div class="bar-column">
                                <div class="bar" style="height:68%"></div>
                                <span class="bar-label">Fri</span>
                            </div>
                            <div class="bar-column">
                                <div class="bar" style="height:91%"></div>
                                <span class="bar-label">Sat</span>
                            </div>
                            <div class="bar-column">
                                <div class="bar" style="height:73%"></div>
                                <span class="bar-label">Sun</span>
                            </div>
                        </div>
                    </div>

                    <!-- QUICK ACTIONS -->
                    <div class="panel">
                        <div class="panel-header">
                            <h3>Quick Actions</h3>
                        </div>

                        <div class="quick-actions">
                            <a href="/admin/restaurants" class="quick-action">
                                <div class="quick-action-icon">🍽️</div>
                                <div>
                                    <strong>Review Restaurants</strong>
                                    <span><%= typeof pendingRestaurants !== "undefined" ? pendingRestaurants : 0 %> pending</span>
                                </div>
                            </a>

                            <a href="/admin/tiffin-sellers" class="quick-action">
                                <div class="quick-action-icon">🏠</div>
                                <div>
                                    <strong>Review Sellers</strong>
                                    <span><%= typeof pendingTiffinSellers !== "undefined" ? pendingTiffinSellers : 0 %> pending</span>
                                </div>
                            </a>

                            <a href="/admin/orders" class="quick-action">
                                <div class="quick-action-icon">📦</div>
                                <div>
                                    <strong>View Orders</strong>
                                    <span><%= typeof totalOrders !== "undefined" ? totalOrders : 0 %> total orders</span>
                                </div>
                            </a>

                            <a href="/admin/messages" class="quick-action">
                                <div class="quick-action-icon">💬</div>
                                <div>
                                    <strong>Mail Center</strong>
                                    <span>Open messages</span>
                                </div>
                            </a>
                        </div>
                    </div>

                </div>

                <!-- PENDING APPROVALS + SUMMARY -->
                <div class="dashboard-grid">

                    <div class="panel">
                        <div class="panel-header">
                            <h3>Pending Approvals</h3>
                            <a href="/admin/restaurants">View All →</a>
                        </div>

                        <div class="approval-list">

                            <div class="approval-item">
                                <div class="approval-avatar">🍴</div>
                                <div class="approval-info">
                                    <strong>Restaurants</strong>
                                    <span>Waiting for review</span>
                                </div>
                                <span class="pending-badge">
                                    <%= typeof pendingRestaurants !== "undefined" ? pendingRestaurants : 0 %>
                                </span>
                            </div>

                            <div class="approval-item">
                                <div class="approval-avatar">🍱</div>
                                <div class="approval-info">
                                    <strong>Tiffin Sellers</strong>
                                    <span>Waiting for review</span>
                                </div>
                                <span class="pending-badge">
                                    <%= typeof pendingTiffinSellers !== "undefined" ? pendingTiffinSellers : 0 %>
                                </span>
                            </div>

                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel-header">
                            <h3>Platform Summary</h3>
                        </div>

                        <div class="approval-list">

                            <div class="approval-item">
                                <div class="approval-avatar">👥</div>
                                <div class="approval-info">
                                    <strong>Total Customers</strong>
                                    <span>Registered users</span>
                                </div>
                                <strong>
                                    <%= typeof totalCustomers !== "undefined" ? totalCustomers : 0 %>
                                </strong>
                            </div>

                            <div class="approval-item">
                                <div class="approval-avatar">🍽️</div>
                                <div class="approval-info">
                                    <strong>Food Partners</strong>
                                    <span>Restaurants + Tiffin Sellers</span>
                                </div>
                                <strong>
                                    <%= (
                                        (typeof totalRestaurants !== "undefined" ? totalRestaurants : 0) +
                                        (typeof totalTiffinSellers !== "undefined" ? totalTiffinSellers : 0)
                                    ) %>
                                </strong>
                            </div>

                            <div class="approval-item">
                                <div class="approval-avatar">🛵</div>
                                <div class="approval-info">
                                    <strong>Delivery Partners</strong>
                                    <span>Registered delivery users</span>
                                </div>
                                <strong>
                                    <%= typeof totalDeliveryPartners !== "undefined" ? totalDeliveryPartners : 0 %>
                                </strong>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- RECENT ORDERS -->
                <div class="panel orders-panel">
                    <div class="panel-header">
                        <h3>Recent Orders</h3>
                        <a href="/admin/orders">View All Orders →</a>
                    </div>

                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>ORDER ID</th>
                                    <th>CUSTOMER</th>
                                    <th>AMOUNT</th>
                                    <th>STATUS</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% if (typeof recentOrders !== "undefined" && recentOrders.length > 0) { %>
                                    <% recentOrders.forEach(order => { %>
                                        <tr>
                                            <td class="order-id">
                                                #<%= order._id %>
                                            </td>

                                            <td class="customer-name">
                                                <%= order.customer && order.customer.name
                                                    ? order.customer.name
                                                    : "Customer" %>
                                            </td>

                                            <td>
                                                ₹<%= Number(order.totalAmount || 0).toLocaleString("en-IN") %>
                                            </td>

                                            <td>
                                                <span class="status <%= String(order.status || "pending").toLowerCase() %>">
                                                    <%= order.status || "Pending" %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4">No recent orders found.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </section>

        </main>

    </div>

    <script src="/js/dashboard.js" defer></script>

</body>
</html>
```