<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Admin Dashboard</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family:
                "Segoe UI",
                Arial,
                sans-serif;

            background: #f8f3ed;

            color: #30251e;
        }


        /* =================================
           LAYOUT
        ================================= */

        .admin-layout {
            min-height: 100vh;

            display: flex;
        }


        /* =================================
           SIDEBAR
        ================================= */

        .sidebar {

            width: 250px;

            min-height: 100vh;

            position: fixed;

            left: 0;
            top: 0;
            bottom: 0;

            background: #fffaf5;

            border-right:
                1px solid #eaded2;

            padding: 24px 16px;

            overflow-y: auto;

            z-index: 100;
        }


        .brand {

            display: flex;

            align-items: center;

            gap: 12px;

            padding:
                0 10px 28px;

            border-bottom:
                1px solid #eaded2;

            margin-bottom: 22px;
        }


        .brand-icon {

            width: 44px;
            height: 44px;

            border-radius: 13px;

            background: #174f3a;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 23px;
        }


        .brand-text h2 {

            font-size: 20px;

            color: #2f241d;
        }


        .brand-text span {

            font-size: 10px;

            color: #8b7768;

            letter-spacing: 1px;

            font-weight: 700;
        }


        .menu-title {

            font-size: 10px;

            font-weight: 800;

            color: #a18d7d;

            letter-spacing: 1.4px;

            padding:
                0 12px 10px;
        }


        .nav-menu {

            list-style: none;
        }


        .nav-menu li {

            margin-bottom: 5px;
        }


        .nav-menu a {

            display: flex;

            align-items: center;

            gap: 12px;

            padding:
                11px 12px;

            border-radius: 11px;

            text-decoration: none;

            color: #6d5c4f;

            font-size: 13px;

            font-weight: 600;

            transition:
                0.2s ease;
        }


        .nav-menu a:hover {

            background: #f3e9df;

            color: #174f3a;
        }


        .nav-menu a.active {

            background: #174f3a;

            color: white;

            box-shadow:
                0 8px 18px
                rgba(23,79,58,0.15);
        }


        .nav-icon {

            width: 20px;

            text-align: center;

            font-size: 16px;
        }


        .notification-count {

            margin-left: auto;

            min-width: 20px;

            height: 20px;

            padding: 0 6px;

            border-radius: 20px;

            background: #d48a3b;

            color: white;

            font-size: 10px;

            display: flex;

            align-items: center;
            justify-content: center;
        }


        /* =================================
           MAIN
        ================================= */

        .main-content {

            margin-left: 250px;

            width: calc(100% - 250px);

            min-height: 100vh;
        }


        /* =================================
           TOPBAR
        ================================= */

        .topbar {

            height: 76px;

            background: #fffdf9;

            border-bottom:
                1px solid #eaded2;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding:
                0 32px;

            position: sticky;

            top: 0;

            z-index: 50;
        }


        .page-heading h1 {

            font-size: 21px;

            color: #30251e;

            margin-bottom: 4px;
        }


        .page-heading p {

            font-size: 12px;

            color: #907d6e;
        }


        .top-actions {

            display: flex;

            align-items: center;

            gap: 18px;
        }


        .top-icon {

            width: 38px;
            height: 38px;

            border-radius: 11px;

            border:
                1px solid #eaded2;

            background: #fffaf5;

            display: flex;

            align-items: center;
            justify-content: center;

            cursor: pointer;

            position: relative;
        }


        .top-icon .dot {

            position: absolute;

            width: 7px;
            height: 7px;

            background: #d45745;

            border-radius: 50%;

            top: 7px;
            right: 7px;
        }


        .admin-profile {

            display: flex;

            align-items: center;

            gap: 10px;

            padding-left: 16px;

            border-left:
                1px solid #eaded2;
        }


        .profile-avatar {

            width: 38px;
            height: 38px;

            border-radius: 50%;

            background: #e5c7a9;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 16px;

            font-weight: 800;

            color: #65462f;
        }


        .profile-info strong {

            display: block;

            font-size: 12px;

            color: #3b2b21;
        }


        .profile-info span {

            display: block;

            font-size: 10px;

            color: #988577;
        }


        /* =================================
           CONTENT
        ================================= */

        .dashboard-content {

            padding: 30px 32px 40px;
        }


        .welcome-row {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 25px;
        }


        .welcome h2 {

            font-size: 25px;

            color: #30251e;

            margin-bottom: 5px;
        }


        .welcome p {

            font-size: 13px;

            color: #8b7768;
        }


        .date-button {

            padding:
                10px 15px;

            background: #fffaf5;

            border:
                1px solid #e4d6ca;

            border-radius: 10px;

            color: #725c4d;

            font-size: 12px;

            font-weight: 700;
        }


        /* =================================
           STAT CARDS
        ================================= */

        .stats-grid {

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 18px;

            margin-bottom: 25px;
        }


        .stat-card {

            background: #fffdf9;

            border:
                1px solid #eaded2;

            border-radius: 17px;

            padding: 20px;

            box-shadow:
                0 5px 20px
                rgba(91,65,43,0.04);
        }


        .stat-top {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 18px;
        }


        .stat-icon {

            width: 43px;
            height: 43px;

            border-radius: 13px;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 20px;
        }


        .icon-green {
            background: #e1eee7;
        }


        .icon-brown {
            background: #f1e4d7;
        }


        .icon-orange {
            background: #f8e6cc;
        }


        .icon-blue {
            background: #e1ebef;
        }


        .stat-label {

            font-size: 11px;

            color: #927e6e;

            font-weight: 700;
        }


        .stat-value {

            font-size: 27px;

            font-weight: 800;

            color: #30251e;

            margin-bottom: 8px;
        }


        .stat-change {

            font-size: 11px;

            font-weight: 700;

            color: #26825d;
        }


        .stat-change.neutral {

            color: #907d6e;
        }


        /* =================================
           GRID
        ================================= */

        .dashboard-grid {

            display: grid;

            grid-template-columns:
                1.7fr
                1fr;

            gap: 20px;

            margin-bottom: 20px;
        }


        .panel {

            background: #fffdf9;

            border:
                1px solid #eaded2;

            border-radius: 17px;

            padding: 21px;

            box-shadow:
                0 5px 20px
                rgba(91,65,43,0.04);
        }


        .panel-header {

            display: flex;

            align-items: center;

            justify-content: space-between;

            margin-bottom: 20px;
        }


        .panel-header h3 {

            font-size: 15px;

            color: #3c2d24;
        }


        .panel-header a {

            font-size: 11px;

            color: #174f3a;

            text-decoration: none;

            font-weight: 800;
        }


        /* =================================
           CHART
        ================================= */

        .chart-area {

            height: 245px;

            display: flex;

            align-items: flex-end;

            gap: 14px;

            padding:
                15px 8px 0;

            border-bottom:
                1px solid #e8ddd3;
        }


        .bar-column {

            flex: 1;

            height: 100%;

            display: flex;

            flex-direction: column;

            justify-content: flex-end;

            align-items: center;

            gap: 8px;
        }


        .bar {

            width: 100%;

            max-width: 34px;

            background:
                linear-gradient(
                    to top,
                    #174f3a,
                    #3d8469
                );

            border-radius:
                7px 7px 0 0;

            min-height: 12px;
        }


        .bar-label {

            font-size: 10px;

            color: #9b897a;
        }


        /* =================================
           QUICK ACTIONS
        ================================= */

        .quick-actions {

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 10px;
        }


        .quick-action {

            padding: 14px;

            border-radius: 12px;

            border:
                1px solid #eaded2;

            background: #fffaf5;

            text-decoration: none;

            color: #574539;

            display: flex;

            align-items: center;

            gap: 10px;

            transition: 0.2s ease;
        }


        .quick-action:hover {

            border-color:
                #cdb8a6;

            transform:
                translateY(-1px);
        }


        .quick-action-icon {

            width: 34px;
            height: 34px;

            border-radius: 9px;

            background: #e7efe9;

            display: flex;

            align-items: center;
            justify-content: center;
        }


        .quick-action strong {

            font-size: 11px;

            display: block;
        }


        .quick-action span {

            font-size: 9px;

            color: #9a8778;
        }


        /* =================================
           APPROVALS
        ================================= */

        .approval-list {

            display: grid;

            gap: 11px;
        }


        .approval-item {

            display: flex;

            align-items: center;

            gap: 12px;

            padding: 11px;

            background: #fffaf5;

            border-radius: 11px;
        }


        .approval-avatar {

            width: 38px;
            height: 38px;

            border-radius: 10px;

            background: #e8d6c4;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 17px;
        }


        .approval-info {

            flex: 1;
        }


        .approval-info strong {

            display: block;

            font-size: 11px;

            color: #49372b;
        }


        .approval-info span {

            display: block;

            font-size: 9px;

            color: #998679;

            margin-top: 3px;
        }


        .pending-badge {

            background: #f8e8ce;

            color: #a46725;

            font-size: 9px;

            font-weight: 800;

            padding:
                5px 8px;

            border-radius: 20px;
        }


        /* =================================
           RECENT ORDERS
        ================================= */

        .orders-panel {

            width: 100%;
        }


        .table-wrapper {

            overflow-x: auto;
        }


        table {

            width: 100%;

            border-collapse: collapse;
        }


        th {

            text-align: left;

            padding:
                11px 10px;

            font-size: 10px;

            color: #9a8778;

            border-bottom:
                1px solid #eaded2;

            white-space: nowrap;
        }


        td {

            padding:
                13px 10px;

            font-size: 11px;

            color: #5c4b3f;

            border-bottom:
                1px solid #f0e7df;

            white-space: nowrap;
        }


        .order-id {

            font-weight: 800;

            color: #174f3a;
        }


        .customer-name {

            font-weight: 700;

            color: #49372b;
        }


        .status {

            display: inline-block;

            padding:
                5px 9px;

            border-radius: 20px;

            font-size: 9px;

            font-weight: 800;
        }


        .status.completed {

            background: #e1eee7;

            color: #267052;
        }


        .status.pending {

            background: #f8e8ce;

            color: #a46725;
        }


        .status.preparing {

            background: #e5edf1;

            color: #557381;
        }


        /* =================================
           BOTTOM CARDS
        ================================= */

        .bottom-grid {

            display: grid;

            grid-template-columns:
                1fr 1fr 1fr;

            gap: 20px;
        }


        .mini-stat {

            display: flex;

            align-items: center;

            gap: 14px;
        }


        .mini-icon {

            width: 45px;
            height: 45px;

            border-radius: 13px;

            background: #f0e3d5;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 20px;
        }


        .mini-stat strong {

            display: block;

            font-size: 21px;

            color: #34271f;
        }


        .mini-stat span {

            display: block;

            font-size: 10px;

            color: #948174;

            margin-top: 3px;
        }


        /* =================================
           MOBILE
        ================================= */

        .mobile-menu {

            display: none;

            width: 38px;
            height: 38px;

            border:
                1px solid #eaded2;

            border-radius: 10px;

            background: #fffaf5;

            cursor: pointer;

            align-items: center;
            justify-content: center;

            font-size: 18px;
        }


        @media (max-width: 1100px) {

            .stats-grid {

                grid-template-columns:
                    repeat(2, 1fr);
            }

            .dashboard-grid {

                grid-template-columns: 1fr;
            }

            .bottom-grid {

                grid-template-columns:
                    1fr 1fr;
            }
        }


        @media (max-width: 760px) {

            .sidebar {

                transform:
                    translateX(-100%);

                transition:
                    0.3s ease;
            }


            .sidebar.open {

                transform:
                    translateX(0);
            }


            .main-content {

                margin-left: 0;

                width: 100%;
            }


            .mobile-menu {

                display: flex;
            }


            .topbar {

                padding:
                    0 16px;

                height: 68px;
            }


            .page-heading {

                display: none;
            }


            .admin-profile {

                padding-left: 8px;

                border-left: none;
            }


            .profile-info {

                display: none;
            }


            .dashboard-content {

                padding:
                    22px 16px 30px;
            }


            .welcome-row {

                align-items: flex-start;
            }


            .welcome h2 {

                font-size: 21px;
            }


            .stats-grid {

                grid-template-columns: 1fr;

                gap: 12px;
            }


            .bottom-grid {

                grid-template-columns: 1fr;
            }


            .quick-actions {

                grid-template-columns: 1fr;
            }

        }


        @media (max-width: 450px) {

            .welcome-row {

                display: block;
            }


            .date-button {

                display: inline-block;

                margin-top: 12px;
            }


            .chart-area {

                gap: 7px;
            }


            .bar {

                max-width: 24px;
            }

        }

    </style>

</head>


<body>


<div class="admin-layout">


    <!-- ======================================
         SIDEBAR
    ======================================= -->

    <aside
        class="sidebar"
        id="sidebar"
    >


        <div class="brand">

            <div class="brand-icon">
                🍽️
            </div>

            <div class="brand-text">

                <h2>
