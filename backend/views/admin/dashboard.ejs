        </div>


        <ul class="nav-menu">


            <li>

                <a
                    href="/admin/dashboard"
                    class="active"
                >

                    <span class="nav-icon">
                        📊
                    </span>

                    Dashboard

                </a>

            </li>


            <li>

                <a href="/admin/customers">

                    <span class="nav-icon">
                        👥
                    </span>

                    Customers

                </a>

            </li>


            <li>

                <a href="/admin/restaurants">

                    <span class="nav-icon">
