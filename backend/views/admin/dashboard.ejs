                        </div>


                        <div class="bar-column">

                            <div
                                class="bar"
                                style="height: 52%;"
                            ></div>

                            <span class="bar-label">
                                Wed
                            </span>

                        </div>


                        <div class="bar-column">

                            <div
                                class="bar"
                                style="height: 78%;"
                            ></div>

                            <span class="bar-label">
                                Thu
