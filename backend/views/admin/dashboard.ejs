        </ul>


    </aside>



    <!-- ======================================
         MAIN CONTENT
    ======================================= -->

    <main class="main-content">


        <!-- TOPBAR -->

        <header class="topbar">


            <div class="page-heading">

                <h1>
                    Admin Dashboard
                </h1>

                <p>
                    GharSetu platform overview
                </p>

            </div>


            <div class="top-actions">


                <button
                    class="mobile-menu"
                    id="mobileMenu"
                    type="button"
                >
                    ☰
                </button>


                <div class="top-icon">

                    🔔

                    <span class="dot"></span>

                </div>


                <div class="top-icon">

                    💬

                </div>


                <div class="admin-profile">

                    <div class="profile-avatar">
