            MANAGEMENT
        </div>


        <ul class="nav-menu">


            <li>

                <a href="/admin/orders">

                    <span class="nav-icon">
                        📦
                    </span>

                    Orders

                </a>

            </li>


            <li>

                <a href="/admin/payments">

                    <span class="nav-icon">
                        💳
                    </span>

                    Payments

                </a>

            </li>


            <li>

                <a href="/admin/coupons">

                    <span class="nav-icon">
                        🎟️
                    </span>

                    Coupons

                </a>

            </li>


            <li>

                <a href="/admin/reviews">

                    <span class="nav-icon">
                        ⭐
                    </span>

                    Reviews

                </a>

            </li>


            <li>

                <a href="/admin/messages">

                    <span class="nav-icon">
                        💬
                    </span>

                    Mail Center

                    <span class="notification-count">
                        4
                    </span>

                </a>

            </li>


        </ul>


        <div
            class="menu-title"
            style="margin-top: 22px;"
        >
            SYSTEM
        </div>


        <ul class="nav-menu">


            <li>

                <a href="/admin/analytics">

                    <span class="nav-icon">
                        📈
                    </span>

                    Analytics

                </a>

            </li>


            <li>

                <a href="/admin/complaints">

                    <span class="nav-icon">
                        ⚠️
                    </span>

                    Complaints

                </a>

            </li>


            <li>

                <a href="/admin/settings">

                    <span class="nav-icon">
                        ⚙️
                    </span>

                    Settings

                </a>

            </li>


            <li>

                <a href="/admin/logout">

                    <span class="nav-icon">
                        🚪
                    </span>

                    Logout

                </a>

