<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Admin Settings | GharSetu
    </title>

    <link rel="stylesheet" href="/css/admin.css">

    <style>

        /* =====================================================
           GHARSETU ADMIN SETTINGS
        ===================================================== */

        :root {
            --ivory: #f8f4ec;
            --ivory-light: #fffdf8;
            --beige: #eee3d2;
            --coffee: #3e2b23;
            --coffee-light: #6b5044;
            --green: #2f6f4e;
            --green-light: #e7f2eb;
            --green-dark: #23573c;
            --border: #e7ddd0;
            --text: #342720;
            --muted: #8a7b70;
            --danger: #b94a48;
            --danger-light: #fcebea;
            --shadow: 0 12px 35px rgba(62, 43, 35, 0.07);
            --radius: 22px;
        }


        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;
            background:
                radial-gradient(
                    circle at top right,
                    rgba(47, 111, 78, 0.06),
                    transparent 30%
                ),
                var(--ivory);

            color: var(--text);
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }


        .admin-main {
            min-height: 100vh;
        }


        /* =====================================================
           HEADER
        ===================================================== */

        .settings-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;

            margin-bottom: 30px;
            padding: 30px 32px;

            background: var(--ivory-light);
            border: 1px solid var(--border);
            border-radius: var(--radius);

            box-shadow: var(--shadow);
        }


        .settings-label {
            display: inline-flex;
            align-items: center;

            margin-bottom: 9px;

            color: var(--green);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
        }


        .settings-header h1 {
            margin: 0 0 8px;

            color: var(--coffee);
            font-size: 34px;
            line-height: 1.1;
            font-weight: 800;
        }


        .settings-header p {
            margin: 0;

            color: var(--muted);
            font-size: 14px;
        }


        .admin-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            padding: 11px 16px;

            background: var(--green-light);
            color: var(--green-dark);

            border: 1px solid #cfe3d7;
            border-radius: 999px;

            font-size: 13px;
            font-weight: 700;

            white-space: nowrap;
        }


        .status-dot {
            width: 8px;
            height: 8px;

            background: #3b9b65;

            border-radius: 50%;

            box-shadow:
                0 0 0 4px rgba(59, 155, 101, 0.12);
        }


        /* =====================================================
           SUCCESS MESSAGE
        ===================================================== */

        .success-message {
            display: flex;
            align-items: flex-start;
            gap: 14px;

            margin-bottom: 25px;
            padding: 17px 20px;

            background: var(--green-light);

            border: 1px solid #cde2d5;
            border-radius: 16px;

            color: var(--green-dark);

            animation: slideDown 0.35s ease;
        }


        .success-message.hide {
            opacity: 0;
            transform: translateY(-10px);
            pointer-events: none;
            transition: 0.4s ease;
        }


        .success-icon {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 34px;
            height: 34px;

            flex-shrink: 0;

            background: var(--green);

            color: white;

            border-radius: 50%;

            font-weight: 900;
        }


        .success-message strong {
            display: block;

            margin-bottom: 3px;

            font-size: 14px;
        }


        .success-message p {
            margin: 0;

            font-size: 13px;
            opacity: 0.8;
        }


        @keyframes slideDown {

            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }


        /* =====================================================
           SETTINGS GRID
        ===================================================== */

        .settings-grid {
            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));

            gap: 24px;
        }


        /* =====================================================
           SETTINGS CARD
        ===================================================== */

        .settings-card {
            padding: 27px;

            background: var(--ivory-light);

            border: 1px solid var(--border);
            border-radius: var(--radius);

            box-shadow: var(--shadow);

            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }


        .settings-card:hover {
            transform: translateY(-2px);

            box-shadow:
                0 18px 42px rgba(
                    62,
                    43,
                    35,
                    0.09
                );
        }


        /* =====================================================
           CARD HEADING
        ===================================================== */

        .card-heading {
            display: flex;
            align-items: center;
            gap: 14px;

            margin-bottom: 25px;
        }


        .heading-icon {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 48px;
            height: 48px;

            flex-shrink: 0;

            border-radius: 15px;

            font-size: 21px;
        }


        .profile-icon {
            background: #f2e7d8;
        }


        .security-icon {
            background: var(--green-light);
        }


        .account-icon {
            background: #eee7df;
        }


        .card-heading h2 {
            margin: 0 0 4px;

            color: var(--coffee);

            font-size: 18px;
            font-weight: 800;
        }


        .card-heading p {
            margin: 0;

            color: var(--muted);

            font-size: 12px;
            line-height: 1.5;
        }


        /* =====================================================
           FORM
        ===================================================== */

        .settings-form {
            display: flex;
            flex-direction: column;
            gap: 17px;
        }


        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }


        .form-group label {
            color: var(--coffee-light);

            font-size: 12px;
            font-weight: 700;
        }


        .form-group input,
        .password-wrapper input {

            width: 100%;

            padding: 13px 14px;

            background: #fffefa;

            border: 1px solid var(--border);
            border-radius: 12px;

            color: var(--text);

            font-size: 13px;

            outline: none;

            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }


        .form-group input::placeholder {
            color: #b0a49b;
        }


        .form-group input:focus,
        .password-wrapper input:focus {

            border-color: var(--green);

            box-shadow:
                0 0 0 4px rgba(
                    47,
                    111,
                    78,
                    0.08
                );
        }


        /* =====================================================
           PASSWORD
        ===================================================== */

        .password-wrapper {
            position: relative;
        }


        .password-wrapper input {
            padding-right: 48px;
        }


        .password-toggle {
            position: absolute;

            top: 50%;
            right: 8px;

            width: 35px;
            height: 35px;

            transform: translateY(-50%);

            border: 0;
            background: transparent;

            color: var(--muted);

            border-radius: 9px;

            cursor: pointer;

            font-size: 16px;
        }


        .password-toggle:hover {
            background: var(--beige);
        }


        .form-error {
            display: none;

            padding: 11px 13px;

            background: var(--danger-light);

            border: 1px solid #f2cccc;
            border-radius: 10px;

            color: var(--danger);

            font-size: 12px;
            line-height: 1.5;
        }


        .form-error.show {
            display: block;
        }


        /* =====================================================
           PRIMARY BUTTON
        ===================================================== */

        .primary-btn {
            width: 100%;

            margin-top: 4px;
            padding: 13px 18px;

            border: 0;
            border-radius: 12px;

            background:
                linear-gradient(
                    135deg,
                    var(--green),
                    var(--green-dark)
                );

            color: white;

            font-size: 13px;
            font-weight: 800;

            cursor: pointer;

            box-shadow:
                0 8px 18px rgba(
                    47,
                    111,
                    78,
                    0.18
                );

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }


        .primary-btn:hover {
            transform: translateY(-1px);

            box-shadow:
                0 12px 23px rgba(
                    47,
                    111,
                    78,
                    0.25
                );
        }


        .primary-btn:active {
            transform: translateY(0);
        }


        /* =====================================================
           ACCOUNT INFORMATION
        ===================================================== */

        .account-info-list {
            display: flex;
            flex-direction: column;
        }


        .account-info-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;

            padding: 17px 0;

            border-bottom: 1px solid var(--border);
        }


        .account-info-row:first-child {
            padding-top: 0;
        }


        .account-info-row:last-child {
            padding-bottom: 0;
            border-bottom: 0;
        }


        .info-left {
            display: flex;
            align-items: center;
            gap: 12px;

            min-width: 0;
        }


        .info-icon {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 38px;
            height: 38px;

            flex-shrink: 0;

            background: var(--ivory);

            border: 1px solid var(--border);
            border-radius: 11px;

            font-size: 15px;
        }


        .info-left > div {
            min-width: 0;
        }


        .info-label {
            display: block;

            margin-bottom: 3px;

            color: var(--muted);

            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }


        .info-left strong {
            display: block;

            max-width: 260px;

            color: var(--coffee);

            font-size: 13px;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }


        .info-badge,
        .status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            padding: 6px 10px;

            border-radius: 999px;

            font-size: 10px;
            font-weight: 800;

            white-space: nowrap;
        }


        .info-badge {
            background: #f0e8df;
            color: var(--coffee);
        }


        .status-badge.active {
            background: var(--green-light);
            color: var(--green-dark);
        }


        .status-badge.inactive {
            background: var(--danger-light);
            color: var(--danger);
        }


        /* =====================================================
           SECURITY
        ===================================================== */

        .security-list {
            display: flex;
            flex-direction: column;
            gap: 17px;
        }


        .security-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;

            padding: 14px;

            background: #fffaf3;

            border: 1px solid #eee3d5;
            border-radius: 14px;
        }


        .security-check {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 27px;
            height: 27px;

            flex-shrink: 0;

            background: var(--green-light);

            color: var(--green);

            border-radius: 50%;

            font-size: 12px;
            font-weight: 900;
        }


        .security-item strong {
            display: block;

            margin-bottom: 4px;

            color: var(--coffee);

            font-size: 13px;
        }


        .security-item p {
            margin: 0;

            color: var(--muted);

            font-size: 11px;
            line-height: 1.6;
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .settings-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-top: 28px;
            padding: 18px 4px 30px;

            color: var(--muted);

            font-size: 11px;
        }


        .settings-footer span:last-child {
            color: var(--green);
            font-weight: 700;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 1000px) {

            .settings-grid {
                grid-template-columns: 1fr;
            }

        }


        @media (max-width: 700px) {

            .settings-header {
                align-items: flex-start;
                flex-direction: column;

                padding: 23px;
            }


            .settings-header h1 {
                font-size: 28px;
            }


            .admin-status-badge {
                align-self: flex-start;
            }


            .settings-card {
                padding: 21px;
                border-radius: 18px;
            }


            .account-info-row {
                align-items: flex-start;
            }


            .info-badge,
            .status-badge {
                margin-top: 3px;
            }


            .settings-footer {
                flex-direction: column;
                align-items: flex-start;
                gap: 7px;
            }

        }


        @media (max-width: 480px) {

            .settings-header {
                margin-bottom: 20px;
            }


            .settings-header h1 {
                font-size: 25px;
            }


            .card-heading {
                align-items: flex-start;
            }


            .heading-icon {
                width: 43px;
                height: 43px;

                border-radius: 13px;

                font-size: 18px;
            }


            .info-left {
                gap: 9px;
            }


            .info-icon {
                width: 34px;
                height: 34px;
            }


            .info-left strong {
                max-width: 170px;
            }

        }

    </style>

</head>


<body>


<!-- =====================================================
     SIDEBAR
===================================================== -->

<%- include("../partials/adminSidebar") %>



<!-- =====================================================
     MAIN
===================================================== -->

<main class="admin-main">


    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="settings-header">

        <div>

            <span class="settings-label">
                ADMIN PANEL
            </span>

            <h1>
                Settings
            </h1>

            <p>
                Manage your administrator account and security settings.
            </p>

        </div>


        <div class="admin-status-badge">

            <span class="status-dot"></span>

            System Active

        </div>

    </div>



    <!-- =================================================
         SUCCESS MESSAGE
    ================================================== -->

    <% if (
        typeof success !== "undefined" &&
        success
    ) { %>


        <div class="success-message">

            <span class="success-icon">
                ✓
            </span>


            <div>

                <% if (success === "profile") { %>

                    <strong>
                        Profile Updated
                    </strong>

                    <p>
                        Your admin profile has been updated successfully.
                    </p>


                <% } else if (success === "password") { %>

                    <strong>
                        Password Changed
                    </strong>

                    <p>
                        Your password has been changed successfully.
                    </p>


                <% } else { %>

                    <strong>
                        Success
                    </strong>

                    <p>
                        Your settings have been updated.
                    </p>

                <% } %>

            </div>

        </div>


    <% } %>



    <!-- =================================================
         SETTINGS GRID
    ================================================== -->

    <section class="settings-grid">


        <!-- =================================================
             ADMIN PROFILE
        ================================================== -->

        <div class="settings-card profile-card">


            <div class="card-heading">


                <div class="heading-icon profile-icon">
                    👤
                </div>


                <div>

                    <h2>
                        Admin Profile
                    </h2>

                    <p>
                        Update your administrator information.
                    </p>

                </div>


            </div>



            <form
                action="/admin/settings/profile"
                method="POST"
                class="settings-form"
            >


                <!-- NAME -->

                <div class="form-group">

                    <label for="name">
                        Full Name
                    </label>


                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= admin?.name || '' %>"
                        placeholder="Enter your full name"
                        autocomplete="name"
                        required
                    >

                </div>



                <!-- EMAIL -->

                <div class="form-group">

                    <label for="email">
                        Email Address
                    </label>


                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= admin?.email || '' %>"
                        placeholder="Enter email address"
                        autocomplete="email"
                        required
                    >

                </div>



                <!-- MOBILE -->

                <div class="form-group">

                    <label for="mobile">
                        Mobile Number
                    </label>


                    <input
                        type="text"
                        id="mobile"
                        name="mobile"
                        value="<%= admin?.mobile || '' %>"
                        placeholder="Enter mobile number"
                        autocomplete="tel"
                        required
                    >

                </div>



                <button
                    type="submit"
                    class="primary-btn"
                >
                    Save Profile
                </button>


            </form>


        </div>



        <!-- =================================================
             CHANGE PASSWORD
        ================================================== -->

        <div class="settings-card password-card">


            <div class="card-heading">


                <div class="heading-icon security-icon">
                    🔐
                </div>


                <div>

                    <h2>
                        Change Password
                    </h2>

                    <p>
                        Keep your administrator account secure.
                    </p>

                </div>


            </div>



            <form
                action="/admin/settings/password"
                method="POST"
                class="settings-form"
                id="passwordForm"
            >


                <!-- CURRENT PASSWORD -->

                <div class="form-group">

                    <label for="currentPassword">
                        Current Password
                    </label>


                    <div class="password-wrapper">

                        <input
                            type="password"
                            id="currentPassword"
                            name="currentPassword"
                            placeholder="Enter current password"
                            autocomplete="current-password"
                            required
                        >


                        <button
                            type="button"
                            class="password-toggle"
                            onclick="togglePassword(
                                'currentPassword',
                                this
                            )"
                            aria-label="Show password"
                        >
                            👁
                        </button>

                    </div>

                </div>



                <!-- NEW PASSWORD -->

                <div class="form-group">

                    <label for="newPassword">
                        New Password
                    </label>


                    <div class="password-wrapper">

                        <input
                            type="password"
                            id="newPassword"
                            name="newPassword"
                            placeholder="Minimum 6 characters"
                            minlength="6"
                            autocomplete="new-password"
                            required
                        >


                        <button
                            type="button"
                            class="password-toggle"
                            onclick="togglePassword(
                                'newPassword',
                                this
                            )"
                            aria-label="Show password"
                        >
                            👁
                        </button>

                    </div>

                </div>



                <!-- CONFIRM PASSWORD -->

                <div class="form-group">

                    <label for="confirmPassword">
                        Confirm New Password
                    </label>


                    <div class="password-wrapper">

                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Confirm new password"
                            minlength="6"
                            autocomplete="new-password"
                            required
                        >


                        <button
                            type="button"
                            class="password-toggle"
                            onclick="togglePassword(
                                'confirmPassword',
                                this
                            )"
                            aria-label="Show password"
                        >
                            👁
                        </button>

                    </div>

                </div>



                <div
                    id="passwordError"
                    class="form-error"
                ></div>



                <button
                    type="submit"
                    class="primary-btn"
                >
                    Change Password
                </button>


            </form>


        </div>



        <!-- =================================================
             ACCOUNT INFORMATION
        ================================================== -->

        <div class="settings-card account-card">


            <div class="card-heading">


                <div class="heading-icon account-icon">
                    🛡️
                </div>


                <div>

                    <h2>
                        Account Information
                    </h2>

                    <p>
                        Your administrator account details.
                    </p>

                </div>


            </div>



            <div class="account-info-list">


                <!-- ROLE -->

                <div class="account-info-row">


                    <div class="info-left">


                        <span class="info-icon">
                            👑
                        </span>


                        <div>

                            <span class="info-label">
                                Account Role
                            </span>

                            <strong>
                                Administrator
                            </strong>

                        </div>


                    </div>


                    <span class="info-badge">
                        ADMIN
                    </span>


                </div>



                <!-- STATUS -->

                <div class="account-info-row">


                    <div class="info-left">


                        <span class="info-icon">
                            ●
                        </span>


                        <div>

                            <span class="info-label">
                                Account Status
                            </span>


                            <strong>
                                <%= admin?.isActive
                                    ? "Active"
                                    : "Inactive"
                                %>
                            </strong>

                        </div>


                    </div>



                    <% if (admin?.isActive) { %>

                        <span class="status-badge active">
                            Active
                        </span>

                    <% } else { %>

                        <span class="status-badge inactive">
                            Inactive
                        </span>

                    <% } %>


                </div>



                <!-- EMAIL -->

                <div class="account-info-row">


                    <div class="info-left">


                        <span class="info-icon">
                            ✉
                        </span>


                        <div>

                            <span class="info-label">
                                Login Email
                            </span>


                            <strong>
                                <%= admin?.email ||
                                    "Not available"
                                %>
                            </strong>

                        </div>


                    </div>


                </div>



                <!-- MOBILE -->

                <div class="account-info-row">


                    <div class="info-left">


                        <span class="info-icon">
                            📱
                        </span>


                        <div>

                            <span class="info-label">
                                Mobile Number
                            </span>


                            <strong>
                                <%= admin?.mobile ||
                                    "Not available"
                                %>
                            </strong>

                        </div>


                    </div>


                </div>


            </div>


        </div>



        <!-- =================================================
             SECURITY
        ================================================== -->

        <div class="settings-card security-card">


            <div class="card-heading">


                <div class="heading-icon security-icon">
                    🔒
                </div>


                <div>

                    <h2>
                        Security
                    </h2>

                    <p>
                        Recommended security practices.
                    </p>

                </div>


            </div>



            <div class="security-list">


                <div class="security-item">


                    <span class="security-check">
                        ✓
                    </span>


                    <div>

                        <strong>
                            Use a strong password
                        </strong>


                        <p>
                            Use at least 6 characters with a combination of letters and numbers.
                        </p>

                    </div>


                </div>



                <div class="security-item">


                    <span class="security-check">
                        ✓
                    </span>


                    <div>

                        <strong>
                            Keep your account private
                        </strong>


                        <p>
                            Never share your administrator login credentials with anyone.
                        </p>

                    </div>


                </div>



                <div class="security-item">


                    <span class="security-check">
                        ✓
                    </span>


                    <div>

                        <strong>
                            Logout on shared devices
                        </strong>


                        <p>
                            Always logout when using an unfamiliar or shared computer.
                        </p>

                    </div>


                </div>


            </div>


        </div>


    </section>



    <!-- =================================================
         FOOTER
    ================================================== -->

    <footer class="settings-footer">

        <span>
            GharSetu Admin Panel
        </span>

        <span>
            Secure Administration System
        </span>

    </footer>


</main>



<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script>


/* =====================================================
   PASSWORD SHOW / HIDE
===================================================== */

function togglePassword(inputId, button) {

    const input =
        document.getElementById(inputId);


    if (!input) {

        return;

    }


    if (input.type === "password") {

        input.type = "text";

        button.textContent = "🙈";

    } else {

        input.type = "password";

        button.textContent = "👁";

    }

}



/* =====================================================
   PASSWORD VALIDATION
===================================================== */

const passwordForm =
    document.getElementById(
        "passwordForm"
    );


const passwordError =
    document.getElementById(
        "passwordError"
    );


if (passwordForm) {

    passwordForm.addEventListener(
        "submit",
        function(event) {

            const newPassword =
                document.getElementById(
                    "newPassword"
                ).value;


            const confirmPassword =
                document.getElementById(
                    "confirmPassword"
                ).value;


            passwordError.textContent = "";

            passwordError.classList.remove(
                "show"
            );


            if (
                newPassword.length < 6
            ) {

                event.preventDefault();


                passwordError.textContent =
                    "New password must be at least 6 characters.";


                passwordError.classList.add(
                    "show"
                );


                return;

            }


            if (
                newPassword !==
                confirmPassword
            ) {

                event.preventDefault();


                passwordError.textContent =
                    "New password and confirm password do not match.";


                passwordError.classList.add(
                    "show"
                );


                return;

            }

        }
    );

}



/* =====================================================
   AUTO HIDE SUCCESS
===================================================== */

const successMessage =
    document.querySelector(
        ".success-message"
    );


if (successMessage) {

    setTimeout(
        function() {

            successMessage.classList.add(
                "hide"
            );

        },
        5000
    );

}

</script>


