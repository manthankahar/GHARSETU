<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        GHARSETU | Tiffin Seller Management
    </title>

    <link rel="stylesheet" href="/css/admin.css">

</head>


<body>

<div class="admin-layout">


    <!-- SIDEBAR -->

    <aside class="admin-sidebar">

        <div class="admin-brand">

            <div class="brand-icon">
                🏠
            </div>

            <div>

                <h2>GHARSETU</h2>

                <span>
                    ADMIN CONTROL
                </span>

            </div>

        </div>


        <nav class="admin-nav">

            <a href="/admin/dashboard">
                📊
                <span>Dashboard</span>
            </a>


            <a href="/admin/restaurants">
                🏪
                <span>Restaurants</span>
            </a>


            <a
                href="/admin/tiffin-sellers"
                class="active"
            >

                🍱

                <span>
                    Tiffin Sellers
                </span>

                <% if (pendingSellers > 0) { %>

                    <b class="nav-badge">
                        <%= pendingSellers %>
                    </b>

                <% } %>

            </a>


            <a href="/admin/customers">
                👥
                <span>Customers</span>
            </a>


            <a href="/admin/delivery">
                🚴
                <span>Delivery Partners</span>
            </a>


            <a href="/admin/orders">
                📦
                <span>Orders</span>
            </a>


            <a href="/admin/complaints">
                💬
                <span>Complaints</span>
            </a>


            <a href="/admin/analytics">
                📈
                <span>Analytics</span>
            </a>


            <a href="/admin/settings">
                ⚙️
                <span>Settings</span>
            </a>

        </nav>


        <div class="sidebar-bottom">

            <div class="admin-user-mini">

                <div class="admin-avatar">

                    <%= admin.name
                        ? admin.name
                            .charAt(0)
                            .toUpperCase()
                        : "A" %>

                </div>

                <div>

                    <strong>
                        <%= admin.name %>
                    </strong>

                    <small>
                        Administrator
                    </small>

                </div>

            </div>


            <form
                action="/admin/logout"
                method="POST"
            >

                <button
                    class="logout-btn"
                    type="submit"
                >
                    🚪 Logout
                </button>

            </form>

        </div>

    </aside>



    <!-- MAIN -->

    <main class="admin-main">


        <header class="admin-topbar">

            <div>

                <p class="eyebrow">
                    PARTNER MANAGEMENT
                </p>

                <h1>
                    Tiffin Seller Management 🍱
                </h1>

                <p class="top-description">
                    Review and manage tiffin seller registration requests.
                </p>

            </div>


            <div class="top-admin">

                <div class="top-avatar">
                    <%= admin.name
                        ? admin.name
                            .charAt(0)
                            .toUpperCase()
                        : "A" %>
                </div>

                <div>

                    <strong>
                        <%= admin.name %>
                    </strong>

                    <span>
                        Administrator
                    </span>

                </div>

            </div>

        </header>



        <!-- STATS -->

        <section class="partner-stats">


            <div class="partner-stat">

                <span>
                    Total
                </span>

                <strong>
                    <%= totalSellers %>
                </strong>

            </div>


            <div class="partner-stat pending">

                <span>
                    Pending
                </span>

                <strong>
                    <%= pendingSellers %>
                </strong>

            </div>


            <div class="partner-stat approved">

                <span>
                    Approved
                </span>

                <strong>
                    <%= approvedSellers %>
                </strong>

            </div>


            <div class="partner-stat rejected">

                <span>
                    Rejected
                </span>

                <strong>
                    <%= rejectedSellers %>
                </strong>

            </div>

        </section>



        <!-- FILTER -->

        <section class="management-panel">

            <form
                method="GET"
                action="/admin/tiffin-sellers"
                class="filter-bar"
            >

                <div class="search-box">

                    🔍

                    <input
                        type="text"
                        name="search"
                        value="<%= search %>"
                        placeholder="Search company, owner, email or mobile..."
                    >

                </div>


                <select name="status">

                    <option
                        value="all"
                        <%= status === "all" ? "selected" : "" %>
                    >
                        All Status
                    </option>

                    <option
                        value="pending"
                        <%= status === "pending" ? "selected" : "" %>
                    >
                        Pending
                    </option>

                    <option
                        value="approved"
                        <%= status === "approved" ? "selected" : "" %>
                    >
                        Approved
                    </option>

                    <option
                        value="rejected"
                        <%= status === "rejected" ? "selected" : "" %>
                    >
                        Rejected
                    </option>

                </select>


                <button
                    type="submit"
                    class="filter-btn"
                >
                    Search
                </button>

            </form>

        </section>



        <!-- SELLERS -->

        <section class="management-panel">

            <div class="section-heading">

                <div>

                    <p class="eyebrow">
                        TIFFIN PARTNERS
                    </p>

                    <h2>
                        Registration Requests
                    </h2>

                </div>

                <span class="section-count">
                    <%= sellers.length %> Results
                </span>

            </div>


            <div class="partner-table-wrapper">

                <table class="partner-table">

                    <thead>

                        <tr>

                            <th>
                                Tiffin Company
                            </th>

                            <th>
                                Owner
                            </th>

                            <th>
                                Contact
                            </th>

                            <th>
                                Address
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                    <% if (sellers.length > 0) { %>


                        <% sellers.forEach(seller => { %>

                            <tr>

                                <td>

                                    <div class="partner-name">

                                        <div class="partner-avatar">
                                            🍱
                                        </div>

                                        <div>

                                            <strong>
                                                <%= seller.tiffinCompanyName %>
                                            </strong>

                                            <small>
                                                <%= seller.email || "No email" %>
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    <strong>
                                        <%= seller.ownerName || "N/A" %>
                                    </strong>

                                </td>


                                <td>

                                    <span>
                                        <%= seller.mobile || "N/A" %>
                                    </span>

                                </td>


                                <td>

                                    <span class="address-text">
                                        <%= seller.address || "N/A" %>
                                    </span>

                                </td>


                                <td>

                                    <span
                                        class="approval-status <%= seller.registrationStatus %>"
                                    >
                                        <%= seller.registrationStatus || "pending" %>
                                    </span>

                                </td>


                                <td>

                                    <div class="approval-actions">


                                        <% if (seller.registrationStatus === "pending") { %>


                                            <button
                                                class="approve-btn"
                                                onclick="approveSeller('<%= seller._id %>')"
                                            >
                                                ✓ Approve
                                            </button>


                                            <button
                                                class="reject-btn"
                                                onclick="rejectSeller('<%= seller._id %>')"
                                            >
                                                ✕ Reject
                                            </button>


                                        <% } else if (seller.registrationStatus === "approved") { %>


                                            <span class="action-done">
                                                ✓ Approved
                                            </span>


                                        <% } else { %>


                                            <span class="action-rejected">
                                                ✕ Rejected
                                            </span>


                                        <% } %>


                                    </div>

                                </td>

                            </tr>

                        <% }) %>


                    <% } else { %>

                        <tr>

                            <td
                                colspan="6"
                                class="empty-table"
                            >

                                No tiffin seller registration requests found.

                            </td>

                        </tr>

                    <% } %>

                    </tbody>

                </table>

            </div>

        </section>


    </main>

</div>



<script>

async function approveSeller(id) {

    const confirmed =
        confirm(
            "Approve this tiffin seller?"
        );


    if (!confirmed) {
        return;
    }


    try {

        const response =
            await fetch(
                `/admin/tiffin-sellers/${id}/approve`,
                {
                    method: "POST"
                }
            );


        const data =
            await response.json();


        if (!response.ok || !data.success) {

            alert(
                data.message ||
                "Failed to approve seller."
            );

            return;

        }


        alert(
            "Tiffin seller approved successfully! ✓"
        );


        window.location.reload();

    } catch (error) {

        console.error(error);

        alert(
            "Something went wrong."
        );

    }

}



async function rejectSeller(id) {

    const confirmed =
        confirm(
            "Reject this tiffin seller?"
        );


    if (!confirmed) {
        return;
    }


    try {

        const response =
            await fetch(
                `/admin/tiffin-sellers/${id}/reject`,
                {
                    method: "POST"
                }
            );


        const data =
            await response.json();


        if (!response.ok || !data.success) {

            alert(
                data.message ||
                "Failed to reject seller."
            );

            return;

        }


        alert(
            "Tiffin seller rejected successfully."
        );


        window.location.reload();

    } catch (error) {

        console.error(error);

        alert(
            "Something went wrong."
        );

    }

}

</script>


</body>

</html>