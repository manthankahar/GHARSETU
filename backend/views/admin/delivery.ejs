
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GharSetu | Delivery Management</title>

    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/delivery.css">
    <link rel="stylesheet" href="/css/admin-sidebar.css">

    <script src="/js/delivery.js" defer></script>
</head>
<body>

    <!-- COMMON ADMIN SIDEBAR -->
    <%- include('../partials/adminSidebar', {
        admin: admin,
        activePage: 'delivery'
    }) %>

    <main class="admin-main">
        <div class="delivery-page">

            <!-- HEADER -->
            <div class="delivery-header">
                <div>
                    <div class="delivery-eyebrow">DELIVERY OPERATIONS</div>

                    <h1>Delivery Partner Management 🚴</h1>

                    <p>
                        Monitor delivery partners, deliveries and earnings from one place.
                    </p>
                </div>
            </div>

            <!-- STATS -->
            <div class="delivery-stats">

                <div class="delivery-stat-card">
                    <div class="delivery-stat-icon">🚴</div>
                    <div>
                        <div class="delivery-stat-label">Total Partners</div>
                        <div class="delivery-stat-number"><%= totalPartners %></div>
                    </div>
                </div>

                <div class="delivery-stat-card">
                    <div class="delivery-stat-icon">🟢</div>
                    <div>
                        <div class="delivery-stat-label">Active Partners</div>
                        <div class="delivery-stat-number"><%= activePartners %></div>
                    </div>
                </div>

                <div class="delivery-stat-card">
                    <div class="delivery-stat-icon">🔴</div>
                    <div>
                        <div class="delivery-stat-label">Inactive Partners</div>
                        <div class="delivery-stat-number"><%= inactivePartners %></div>
                    </div>
                </div>

                <div class="delivery-stat-card">
                    <div class="delivery-stat-icon">⏳</div>
                    <div>
                        <div class="delivery-stat-label">Pending Deliveries</div>
                        <div class="delivery-stat-number"><%= pendingDeliveries %></div>
                    </div>
                </div>

                <div class="delivery-stat-card">
                    <div class="delivery-stat-icon">📍</div>
                    <div>
                        <div class="delivery-stat-label">Active Deliveries</div>
                        <div class="delivery-stat-number"><%= activeDeliveries %></div>
                    </div>
                </div>

                <div class="delivery-stat-card">
                    <div class="delivery-stat-icon">✅</div>
                    <div>
                        <div class="delivery-stat-label">Completed Deliveries</div>
                        <div class="delivery-stat-number"><%= completedDeliveries %></div>
                    </div>
                </div>

            </div>

            <!-- FILTER -->
            <div class="delivery-filter-box">
                <form method="GET" action="/admin/delivery" class="delivery-filter-form">

                    <div class="delivery-input-wrapper">
                        <span>🔍</span>

                        <input
                            type="text"
                            name="search"
                            placeholder="Search name, email or mobile..."
                            value="<%= search || '' %>"
                        >
                    </div>

                    <select name="status">
                        <option value="all" <%= status === "all" ? "selected" : "" %>>
                            All Partners
                        </option>

                        <option value="active" <%= status === "active" ? "selected" : "" %>>
                            Active
                        </option>

                        <option value="inactive" <%= status === "inactive" ? "selected" : "" %>>
                            Inactive
                        </option>
                    </select>

                    <button type="submit" class="delivery-search-btn">
                        🔍 Search
                    </button>
                </form>
            </div>

            <!-- DELIVERY PARTNERS TABLE -->
            <div class="delivery-table-box">

                <div class="delivery-table-header">
                    <div>
                        <h2>Delivery Partners</h2>
                        <p>
                            Manage registered delivery partners and their performance.
                        </p>
                    </div>

                    <div class="delivery-result-count">
                        <%= partners.length %> result(s)
                    </div>
                </div>

                <% if (partners.length === 0) { %>

                    <div class="delivery-empty">
                        <div class="delivery-empty-icon">🚴</div>
                        <h3>No Delivery Partners Found</h3>
                        <p>Try changing your search or status filter.</p>
                    </div>

                <% } else { %>

                    <div class="delivery-table-scroll">
                        <table class="delivery-table">

                            <thead>
                                <tr>
                                    <th>PARTNER</th>
                                    <th>MOBILE</th>
                                    <th>STATUS</th>
                                    <th>DELIVERIES</th>
                                    <th>EARNINGS</th>
                                    <th>JOINED</th>
                                    <th>ACTIONS</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% partners.forEach(partner => { %>

                                    <tr id="partner-row-<%= partner._id %>">

                                        <!-- PARTNER -->
                                        <td>
                                            <div class="delivery-partner-info">

                                                <div class="delivery-avatar">
                                                    <% if (partner.profileImage) { %>
                                                        <img
                                                            src="<%= partner.profileImage %>"
                                                            alt="Partner"
                                                        >
                                                    <% } else { %>
                                                        <%= partner.name
                                                            ? partner.name.charAt(0).toUpperCase()
                                                            : "D"
                                                        %>
                                                    <% } %>
                                                </div>

                                                <div>
                                                    <div class="delivery-partner-name">
                                                        <%= partner.name || "Unknown" %>
                                                    </div>

                                                    <div class="delivery-partner-email">
                                                        <%= partner.email || "-" %>
                                                    </div>
                                                </div>

                                            </div>
                                        </td>

                                        <!-- MOBILE -->
                                        <td><%= partner.mobile || "-" %></td>

                                        <!-- STATUS -->
                                        <td>
                                            <% if (partner.isActive) { %>
                                                <span
                                                    class="delivery-status active"
                                                    id="status-<%= partner._id %>"
                                                >
                                                    🟢 Active
                                                </span>
                                            <% } else { %>
                                                <span
                                                    class="delivery-status inactive"
                                                    id="status-<%= partner._id %>"
                                                >
                                                    🔴 Inactive
                                                </span>
                                            <% } %>
                                        </td>

                                        <!-- DELIVERIES -->
                                        <td>
                                            <div class="delivery-count-box">
                                                <strong><%= partner.totalDeliveries || 0 %></strong>
                                                <small>
                                                    <%= partner.completedDeliveries || 0 %> completed
                                                </small>
                                            </div>
                                        </td>

                                        <!-- EARNINGS -->
                                        <td>
                                            <div class="delivery-earning">
                                                ₹<%= Number(partner.totalEarning || 0).toFixed(2) %>
                                            </div>

                                            <small class="earning-small">
                                                Current:
                                                ₹<%= Number(partner.currentEarning || 0).toFixed(2) %>
                                            </small>
                                        </td>

                                        <!-- JOINED -->
                                        <td>
                                            <%= partner.createdAt
                                                ? new Date(partner.createdAt).toLocaleDateString("en-IN")
                                                : "-"
                                            %>
                                        </td>

                                        <!-- ACTIONS -->
                                        <td>
                                            <div class="delivery-actions">

                                                <button
                                                    type="button"
                                                    class="delivery-btn view"
                                                    data-action="view"
                                                    data-id="<%= partner._id %>"
                                                >
                                                    👁 View
                                                </button>

                                                <button
                                                    type="button"
                                                    class="delivery-btn <%= partner.isActive ? 'deactivate' : 'activate' %>"
                                                    id="toggle-btn-<%= partner._id %>"
                                                    data-action="toggle"
                                                    data-id="<%= partner._id %>"
                                                >
                                                    <%= partner.isActive ? "Deactivate" : "Activate" %>
                                                </button>

                                            </div>
                                        </td>

                                    </tr>

                                <% }) %>
                            </tbody>

                        </table>
                    </div>

                <% } %>

            </div>
        </div>
    </main>

    <!-- PARTNER DETAILS MODAL -->
    <div class="delivery-modal" id="partnerModal">

        <div class="delivery-modal-box">

            <div class="delivery-modal-header">
                <div>
                    <span class="modal-eyebrow">DELIVERY PARTNER</span>
                    <h3>Partner Details</h3>
                </div>

                <button
                    type="button"
                    class="delivery-modal-close"
                    id="closePartnerModal"
                    aria-label="Close modal"
                >
                    ×
                </button>
            </div>

            <div class="delivery-modal-body" id="partnerModalBody">
                <div class="modal-loading">Loading...</div>
            </div>

        </div>
    </div>

</body>
</html>
