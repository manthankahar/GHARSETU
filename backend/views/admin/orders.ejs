<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Admin Orders | GHARSETU</title>

    <link rel="stylesheet" href="/css/admin.css">

    <style>

        :root {
            --ivory: #f8f4ec;
            --ivory-light: #fffdf8;
            --beige: #eee4d3;
            --beige-dark: #dfd1bc;

            --coffee: #3f2d25;
            --coffee-light: #6b5145;
            --coffee-soft: #8b7468;

            --green: #2f6f4e;
            --green-dark: #245a3e;
            --green-light: #e6f1ea;

            --yellow: #b98416;
            --yellow-light: #fff4d6;

            --red: #b84a4a;
            --red-light: #fdeaea;

            --blue: #426b8c;
            --blue-light: #eaf2f8;

            --white: #ffffff;

            --text: #30251f;
            --muted: #82736a;

            --border: rgba(63, 45, 37, 0.10);

            --shadow: 0 12px 35px rgba(63, 45, 37, 0.07);

            --radius: 20px;
        }


        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;

            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            background: var(--ivory);

            color: var(--text);
        }


        button,
        input,
        select {
            font: inherit;
        }


        /* =====================================================
           SIDEBAR
        ===================================================== */

        .admin-sidebar {
            position: fixed;

            left: 0;
            top: 0;
            bottom: 0;

            width: 250px;

            padding: 24px 16px;

            background:
                linear-gradient(
                    180deg,
                    #fffaf2 0%,
                    #f4eadb 100%
                );

            border-right: 1px solid var(--border);

            display: flex;

            flex-direction: column;

            z-index: 100;
        }


        .admin-brand {
            display: flex;

            align-items: center;

            gap: 12px;

            padding: 6px 10px 24px;
        }


        .brand-icon {
            width: 46px;
            height: 46px;

            border-radius: 14px;

            background: var(--green);

            color: white;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 22px;

            font-weight: 800;

            box-shadow:
                0 8px 20px
                rgba(47, 111, 78, 0.20);
        }


        .admin-brand strong {
            display: block;

            color: var(--coffee);

            font-size: 17px;

            letter-spacing: 1px;
        }


        .admin-brand small {
            display: block;

            margin-top: 3px;

            color: var(--coffee-soft);

            font-size: 9px;

            font-weight: 700;

            letter-spacing: 1.7px;
        }


        .admin-navigation {
            display: flex;

            flex-direction: column;

            gap: 5px;

            overflow-y: auto;
        }


        .admin-nav-link {
            display: flex;

            align-items: center;

            gap: 12px;

            min-height: 48px;

            padding: 0 14px;

            border-radius: 13px;

            color: var(--coffee-light);

            text-decoration: none;

            font-size: 14px;

            font-weight: 600;

            transition: all 0.2s ease;
        }


        .admin-nav-link:hover {
            background: rgba(47, 111, 78, 0.08);

            color: var(--green);

            transform: translateX(2px);
        }


        .admin-nav-link.active {
            background: var(--green);

            color: white;

            box-shadow:
                0 8px 20px
                rgba(47, 111, 78, 0.18);
        }


        .sidebar-bottom {
            margin-top: auto;

            padding-top: 18px;

            border-top: 1px solid var(--border);
        }


        .admin-user-mini {
            display: flex;

            align-items: center;

            gap: 10px;

            padding: 8px;
        }


        .top-avatar {
            width: 40px;
            height: 40px;

            flex-shrink: 0;

            border-radius: 50%;

            background: var(--coffee);

            color: white;

            display: flex;

            align-items: center;
            justify-content: center;

            font-weight: 800;
        }


        .admin-user-mini strong {
            display: block;

            color: var(--coffee);

            font-size: 13px;
        }


        .admin-user-mini small {
            display: block;

            margin-top: 2px;

            color: var(--muted);

            font-size: 11px;
        }


        .logout-btn {
            display: flex;

            align-items: center;

            justify-content: center;

            width: 100%;

            min-height: 42px;

            margin-top: 10px;

            border-radius: 12px;

            background: var(--red-light);

            color: var(--red);

            text-decoration: none;

            font-size: 13px;

            font-weight: 700;
        }


        .logout-btn:hover {
            background: #f8dcdc;
        }


        /* =====================================================
           MAIN
        ===================================================== */

        .admin-main {
            min-height: 100vh;

            margin-left: 250px;

            padding: 34px;
        }


        .orders-page {
            max-width: 1550px;

            margin: 0 auto;
        }


        /* =====================================================
           HEADER
        ===================================================== */

        .orders-header {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 28px;
        }


        .orders-eyebrow {
            margin: 0 0 7px;

            color: var(--green);

            font-size: 11px;

            font-weight: 800;

            letter-spacing: 1.8px;
        }


        .orders-header h1 {
            margin: 0;

            color: var(--coffee);

            font-size: 34px;

            line-height: 1.1;

            letter-spacing: -0.8px;
        }


        .orders-description {
            margin: 8px 0 0;

            color: var(--muted);

            font-size: 14px;
        }


        .orders-admin-badge {
            display: flex;

            align-items: center;

            gap: 10px;

            padding: 10px 15px;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: 14px;

            box-shadow: var(--shadow);
        }


        .orders-admin-badge span {
            width: 32px;
            height: 32px;

            border-radius: 10px;

            background: var(--green-light);

            display: flex;

            align-items: center;
            justify-content: center;
        }


        .orders-admin-badge strong {
            color: var(--coffee);

            font-size: 13px;
        }


        /* =====================================================
           STATS
        ===================================================== */

        .order-stats {
            display: grid;

            grid-template-columns: repeat(4, 1fr);

            gap: 16px;

            margin-bottom: 22px;
        }


        .order-stat-card {
            min-height: 130px;

            padding: 21px;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: var(--radius);

            box-shadow: var(--shadow);

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;

            transition: all 0.2s ease;
        }


        .order-stat-card:hover {
            transform: translateY(-3px);

            box-shadow:
                0 18px 42px
                rgba(63, 45, 37, 0.10);
        }


        .order-stat-card span {
            display: block;

            margin-bottom: 8px;

            color: var(--muted);

            font-size: 12px;

            font-weight: 600;
        }


        .order-stat-card strong {
            display: block;

            color: var(--coffee);

            font-size: 27px;

            letter-spacing: -0.5px;
        }


        .order-stat-icon {
            width: 52px;
            height: 52px;

            flex-shrink: 0;

            border-radius: 16px;

            background: var(--green-light);

            color: var(--green);

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 21px;

            font-weight: 800;
        }


        .order-stat-card:nth-child(2)
        .order-stat-icon {
            background: var(--yellow-light);

            color: var(--yellow);
        }


        .order-stat-card:nth-child(3)
        .order-stat-icon {
            background: #eee8e1;

            color: var(--coffee);
        }


        .order-stat-card:nth-child(4)
        .order-stat-icon {
            background: var(--blue-light);

            color: var(--blue);
        }


        /* =====================================================
           STATUS SUMMARY
        ===================================================== */

        .status-summary {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            padding: 18px 20px;

            margin-bottom: 22px;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: var(--radius);

            box-shadow: var(--shadow);
        }


        .summary-title span {
            display: block;

            color: var(--green);

            font-size: 10px;

            font-weight: 800;

            letter-spacing: 1.5px;
        }


        .summary-title small {
            display: block;

            margin-top: 5px;

            color: var(--muted);

            font-size: 11px;
        }


        .status-summary-list {
            display: flex;

            align-items: center;

            justify-content: flex-end;

            flex-wrap: wrap;

            gap: 8px;
        }


        .summary-item {
            display: flex;

            align-items: center;

            gap: 9px;

            padding: 8px 11px;

            background: var(--ivory);

            border: 1px solid var(--border);

            border-radius: 10px;

            font-size: 12px;
        }


        .summary-item span {
            color: var(--coffee-light);

            font-weight: 600;

            text-transform: capitalize;
        }


        .summary-item strong {
            min-width: 22px;

            height: 22px;

            padding: 0 6px;

            border-radius: 7px;

            background: var(--green);

            color: white;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 11px;
        }


        /* =====================================================
           PANEL
        ===================================================== */

        .orders-panel {
            margin-bottom: 22px;

            overflow: hidden;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: var(--radius);

            box-shadow: var(--shadow);
        }


        /* =====================================================
           FILTER
        ===================================================== */

        .orders-filter {
            display: grid;

            grid-template-columns:
                minmax(280px, 1fr)
                190px
                105px
                85px;

            gap: 10px;

            padding: 18px;
        }


        .orders-search {
            min-height: 46px;

            display: flex;

            align-items: center;

            gap: 10px;

            padding: 0 14px;

            background: var(--ivory-light);

            border: 1px solid var(--border);

            border-radius: 12px;
        }


        .orders-search span {
            opacity: 0.65;

            font-size: 15px;
        }


        .orders-search input {
            width: 100%;

            border: 0;

            outline: 0;

            background: transparent;

            color: var(--coffee);

            font-size: 13px;
        }


        .orders-search input::placeholder {
            color: #a99a91;
        }


        .orders-status-select {
            min-height: 46px;

            padding: 0 12px;

            outline: none;

            background: var(--ivory-light);

            color: var(--coffee);

            border: 1px solid var(--border);

            border-radius: 12px;

            cursor: pointer;
        }


        .orders-filter-btn,
        .orders-clear-btn {
            min-height: 46px;

            border: 0;

            border-radius: 12px;

            display: flex;

            align-items: center;
            justify-content: center;

            cursor: pointer;

            text-decoration: none;

            font-size: 13px;

            font-weight: 700;
        }


        .orders-filter-btn {
            background: var(--green);

            color: white;
        }


        .orders-filter-btn:hover {
            background: var(--green-dark);
        }


        .orders-clear-btn {
            background: var(--beige);

            color: var(--coffee);
        }


        .orders-clear-btn:hover {
            background: var(--beige-dark);
        }


        /* =====================================================
           TABLE HEADER
        ===================================================== */

        .orders-panel-header {
            min-height: 78px;

            padding: 18px 22px;

            border-bottom: 1px solid var(--border);

            display: flex;

            align-items: center;

            justify-content: space-between;
        }


        .orders-panel-header h2 {
            margin: 0;

            color: var(--coffee);

            font-size: 20px;
        }


        .orders-count {
            padding: 7px 11px;

            border-radius: 9px;

            background: var(--green-light);

            color: var(--green);

            font-size: 11px;

            font-weight: 800;
        }


        /* =====================================================
           TABLE
        ===================================================== */

        .orders-table-wrapper {
            width: 100%;

            overflow-x: auto;
        }


        .orders-table {
            width: 100%;

            min-width: 950px;

            border-collapse: collapse;
        }


        .orders-table th {
            padding: 13px 18px;

            background: #fcfaf6;

            color: var(--coffee-soft);

            text-align: left;

            font-size: 10px;

            font-weight: 800;

            letter-spacing: 0.9px;

            text-transform: uppercase;

            border-bottom: 1px solid var(--border);
        }


        .orders-table td {
            padding: 15px 18px;

            vertical-align: middle;

            border-bottom:
                1px solid rgba(63, 45, 37, 0.07);

            font-size: 13px;
        }


        .orders-table tbody tr {
            transition: background 0.15s ease;
        }


        .orders-table tbody tr:hover {
            background: #fcfaf6;
        }


        .orders-table tbody tr:last-child td {
            border-bottom: 0;
        }


        /* =====================================================
           ORDER ID
        ===================================================== */

        .order-id {
            color: var(--green);

            font-size: 12px;

            letter-spacing: 0.3px;
        }


        /* =====================================================
           CUSTOMER
        ===================================================== */

        .customer-cell {
            min-width: 190px;

            display: flex;

            align-items: center;

            gap: 10px;
        }


        .customer-avatar {
            width: 38px;
            height: 38px;

            flex-shrink: 0;

            border-radius: 11px;

            background: var(--beige);

            color: var(--coffee);

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 13px;

            font-weight: 800;
        }


        .customer-cell strong {
            display: block;

            color: var(--coffee);

            font-size: 12px;
        }


        .customer-cell small {
            display: block;

            max-width: 130px;

            margin-top: 3px;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;

            color: var(--muted);

            font-size: 10px;
        }


        .muted {
            color: var(--muted);

            font-size: 12px;
        }


        /* =====================================================
           ITEMS
        ===================================================== */

        .items-count {
            display: inline-flex;

            padding: 6px 9px;

            border-radius: 8px;

            background: var(--ivory);

            color: var(--coffee-light);

            font-size: 11px;

            font-weight: 650;
        }


        /* =====================================================
           AMOUNT
        ===================================================== */

        .order-amount {
            color: var(--coffee);

            font-size: 13px;
        }


        /* =====================================================
           PAYMENT
        ===================================================== */

        .payment-badge {
            display: inline-flex;

            padding: 6px 9px;

            border-radius: 8px;

            background: var(--blue-light);

            color: var(--blue);

            font-size: 10px;

            font-weight: 750;

            text-transform: capitalize;
        }


        /* =====================================================
           STATUS
        ===================================================== */

        .order-status {
            display: inline-flex;

            align-items: center;

            padding: 6px 10px;

            border-radius: 8px;

            background: var(--green-light);

            color: var(--green);

            font-size: 10px;

            font-weight: 800;

            text-transform: capitalize;

            white-space: nowrap;
        }


        .order-status[data-status="pending"],
        .order-status[data-status="placed"] {
            background: var(--yellow-light);

            color: var(--yellow);
        }


        .order-status[data-status="cancelled"],
        .order-status[data-status="rejected"],
        .order-status[data-status="failed"] {
            background: var(--red-light);

            color: var(--red);
        }


        .order-status[data-status="completed"],
        .order-status[data-status="delivered"] {
            background: var(--green-light);

            color: var(--green);
        }


        .order-status[data-status="processing"],
        .order-status[data-status="accepted"],
        .order-status[data-status="picked_up"] {
            background: var(--blue-light);

            color: var(--blue);
        }


        /* =====================================================
           DATE
        ===================================================== */

        .order-date {
            color: var(--coffee-light);

            font-size: 11px;

            white-space: nowrap;
        }


        /* =====================================================
           VIEW
        ===================================================== */

        .view-order-btn {
            min-width: 62px;

            min-height: 34px;

            padding: 0 12px;

            border: 0;

            border-radius: 9px;

            background: var(--coffee);

            color: white;

            cursor: pointer;

            font-size: 11px;

            font-weight: 750;

            transition: all 0.2s ease;
        }


        .view-order-btn:hover {
            background: var(--green);

            transform: translateY(-1px);
        }


        /* =====================================================
           EMPTY
        ===================================================== */

        .orders-empty {
            padding: 70px 20px;

            text-align: center;
        }


        .empty-icon {
            width: 68px;
            height: 68px;

            margin: 0 auto 15px;

            border-radius: 20px;

            background: var(--ivory);

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 28px;
        }


        .orders-empty h3 {
            margin: 0 0 7px;

            color: var(--coffee);

            font-size: 18px;
        }


        .orders-empty p {
            margin: 0;

            color: var(--muted);

            font-size: 13px;
        }


        /* =====================================================
           MODAL
        ===================================================== */

        .order-modal {
            position: fixed;

            inset: 0;

            display: none;

            align-items: center;
            justify-content: center;

            padding: 20px;

            background: rgba(45, 33, 27, 0.55);

            backdrop-filter: blur(7px);

            z-index: 999;
        }


        .order-modal.show {
            display: flex;
        }


        .order-modal-box {
            position: relative;

            width: min(780px, 100%);

            max-height: 90vh;

            overflow-y: auto;

            padding: 25px;

            background: var(--ivory-light);

            border-radius: 24px;

            box-shadow:
                0 30px 90px
                rgba(40, 27, 20, 0.25);
        }


        .modal-close {
            position: absolute;

            right: 18px;
            top: 18px;

            width: 36px;
            height: 36px;

            border: 0;

            border-radius: 11px;

            background: var(--beige);

            color: var(--coffee);

            font-size: 24px;

            line-height: 1;

            cursor: pointer;
        }


        .modal-close:hover {
            background: var(--beige-dark);
        }


        .modal-loading {
            min-height: 250px;

            display: flex;

            align-items: center;
            justify-content: center;

            color: var(--muted);

            font-size: 14px;
        }


        .modal-header {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;

            padding-right: 45px;

            padding-bottom: 20px;

            margin-bottom: 20px;

            border-bottom: 1px solid var(--border);
        }


        .modal-header p {
            margin: 0 0 5px;

            color: var(--green);

            font-size: 10px;

            font-weight: 800;

            letter-spacing: 1.5px;
        }


        .modal-header h2 {
            margin: 0;

            color: var(--coffee);

            font-size: 25px;
        }


        .modal-grid {
            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 14px;

            margin-bottom: 15px;
        }


        .modal-section {
            padding: 17px;

            margin-bottom: 15px;

            background: white;

            border: 1px solid var(--border);

            border-radius: 15px;
        }


        .modal-section h3 {
            margin: 0 0 13px;

            color: var(--coffee);

            font-size: 13px;
        }


        .modal-section p {
            margin: 5px 0;

            color: var(--muted);

            font-size: 12px;

            line-height: 1.5;

            word-break: break-word;
        }


        .modal-section p strong {
            color: var(--coffee);

            font-size: 13px;
        }


        .modal-items {
            display: flex;

            flex-direction: column;

            gap: 8px;
        }


        .modal-item {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;

            padding: 12px;

            background: var(--ivory);

            border-radius: 11px;
        }


        .modal-item strong {
            color: var(--coffee);

            font-size: 12px;
        }


        .modal-item small {
            display: block;

            margin-top: 3px;

            color: var(--muted);

            font-size: 10px;
        }


        .modal-no-items {
            padding: 18px;

            background: var(--ivory);

            border-radius: 11px;

            color: var(--muted);

            text-align: center;

            font-size: 12px;
        }


        .modal-payment-grid {
            display: grid;

            grid-template-columns: repeat(4, 1fr);

            gap: 10px;

            margin-top: 5px;
        }


        .modal-payment-grid > div {
            padding: 14px;

            background: white;

            border: 1px solid var(--border);

            border-radius: 13px;
        }


        .modal-payment-grid span {
            display: block;

            margin-bottom: 6px;

            color: var(--muted);

            font-size: 10px;
        }


        .modal-payment-grid strong {
            color: var(--coffee);

            font-size: 13px;

            word-break: break-word;
        }


        .modal-payment-grid .modal-total {
            background: var(--green);

            border-color: var(--green);
        }


        .modal-payment-grid .modal-total span,
        .modal-payment-grid .modal-total strong {
            color: white;
        }


        .modal-payment-grid .modal-total strong {
            font-size: 17px;
        }


        .modal-footer {
            padding-top: 15px;

            margin-top: 16px;

            border-top: 1px solid var(--border);

            color: var(--muted);

            font-size: 10px;
        }


        .modal-error {
            padding: 50px 20px;

            text-align: center;
        }


        .modal-error h3 {
            margin: 0 0 8px;

            color: var(--red);

            font-size: 18px;
        }


        .modal-error p {
            margin: 0;

            color: var(--muted);

            font-size: 13px;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 1200px) {

            .admin-sidebar {
                width: 220px;
            }


            .admin-main {
                margin-left: 220px;

                padding: 25px;
            }


            .order-stats {
                grid-template-columns: repeat(2, 1fr);
            }


            .orders-filter {
                grid-template-columns:
                    1fr
                    170px
                    100px
                    80px;
            }

        }


        @media (max-width: 850px) {

            .admin-sidebar {
                position: relative;

                width: 100%;

                height: auto;

                min-height: auto;

                border-right: 0;

                border-bottom: 1px solid var(--border);
            }


            .admin-navigation {
                display: grid;

                grid-template-columns: repeat(2, 1fr);
            }


            .sidebar-bottom {
                display: flex;

                align-items: center;

                gap: 12px;
            }


            .sidebar-bottom .logout-btn {
                width: auto;

                padding: 0 15px;

                margin-top: 0;
            }


            .admin-main {
                margin-left: 0;

                padding: 20px;
            }


            .orders-header {
                align-items: flex-start;

                flex-direction: column;
            }


            .orders-admin-badge {
                width: 100%;
            }


            .orders-filter {
                grid-template-columns: 1fr 1fr;
            }


            .orders-search {
                grid-column: 1 / -1;
            }


            .modal-grid {
                grid-template-columns: 1fr;
            }


            .modal-payment-grid {
                grid-template-columns: repeat(2, 1fr);
            }

        }


        @media (max-width: 560px) {

            .admin-main {
                padding: 14px;
            }


            .admin-navigation {
                grid-template-columns: 1fr;
            }


            .sidebar-bottom {
                flex-direction: column;

                align-items: stretch;
            }


            .sidebar-bottom .logout-btn {
                width: 100%;
            }


            .orders-header h1 {
                font-size: 28px;
            }


            .order-stats {
                grid-template-columns: 1fr;
            }


            .orders-filter {
                grid-template-columns: 1fr;
            }


            .orders-search {
                grid-column: auto;
            }


            .orders-panel-header {
                padding: 16px;

                align-items: flex-start;

                flex-direction: column;

                gap: 10px;
            }


            .order-modal {
                padding: 10px;
            }


            .order-modal-box {
                padding: 18px;

                border-radius: 20px;
            }


            .modal-payment-grid {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>


<body>


<!-- =====================================================
     SIDEBAR
===================================================== -->

<aside class="admin-sidebar">


    <div class="admin-brand">

        <div class="brand-icon">
            G
        </div>


        <div>

            <strong>
                GHARSETU
            </strong>

            <small>
                ADMIN PANEL
            </small>

        </div>

    </div>


    <nav class="admin-navigation">


        <a
            href="/admin/dashboard"
            class="admin-nav-link"
        >
            📊 Dashboard
        </a>


        <a
            href="/admin/restaurants"
            class="admin-nav-link"
        >
            🍽️ Restaurants
        </a>


        <a
            href="/admin/tiffin-sellers"
            class="admin-nav-link"
        >
            🍱 Tiffin Sellers
        </a>


        <a
            href="/admin/customers"
            class="admin-nav-link"
        >
            👥 Customers
        </a>


        <a
            href="/admin/delivery"
            class="admin-nav-link"
        >
            🚴 Delivery
        </a>


        <a
            href="/admin/orders"
            class="admin-nav-link active"
        >
            📦 Orders
        </a>


        <a
            href="/admin/complaints"
            class="admin-nav-link"
        >
            ⚠️ Complaints
        </a>


        <a
            href="/admin/analytics"
            class="admin-nav-link"
        >
            📈 Analytics
        </a>


        <a
            href="/admin/settings"
            class="admin-nav-link"
        >
            ⚙️ Settings
        </a>


    </nav>


    <div class="sidebar-bottom">


        <div class="admin-user-mini">


            <div class="top-avatar">

                <%= admin?.name
                    ? admin.name.charAt(0).toUpperCase()
                    : "A"
                %>

            </div>


            <div>

                <strong>
                    <%= admin?.name || "Admin" %>
                </strong>


                <small>
                    Administrator
                </small>

            </div>


        </div>


        <a
            href="/admin/logout"
            class="logout-btn"
        >
            🚪 Logout
        </a>


    </div>


</aside>


<!-- =====================================================
     MAIN
===================================================== -->

<main class="admin-main">


    <div class="orders-page">


        <!-- HEADER -->

        <header class="orders-header">


            <div>

                <p class="orders-eyebrow">
                    ADMIN MANAGEMENT
                </p>


                <h1>
                    Orders
                </h1>


                <p class="orders-description">
                    Monitor and manage all customer orders.
                </p>

            </div>


            <div class="orders-admin-badge">

                <span>
                    👤
                </span>


                <strong>
                    <%= admin?.name || "Admin" %>
                </strong>

            </div>


        </header>


        <!-- STATS -->

        <section class="order-stats">


            <div class="order-stat-card">

                <div>

                    <span>
                        Total Orders
                    </span>


                    <strong>
                        <%= totalOrders || 0 %>
                    </strong>

                </div>


                <div class="order-stat-icon">
                    📦
                </div>

            </div>


            <div class="order-stat-card">

                <div>

                    <span>
                        Placed Orders
                    </span>


                    <strong>
                        <%= placedOrders || 0 %>
                    </strong>

                </div>


                <div class="order-stat-icon">
                    🟡
                </div>

            </div>


            <div class="order-stat-card">

                <div>

                    <span>
                        Total Revenue
                    </span>


                    <strong>
                        ₹<%= Number(
                            totalRevenue || 0
                        ).toLocaleString("en-IN") %>
                    </strong>

                </div>


                <div class="order-stat-icon">
                    ₹
                </div>

            </div>


            <div class="order-stat-card">

                <div>

                    <span>
                        Status Types
                    </span>


                    <strong>
                        <%= statusSummary
                            ? statusSummary.length
                            : 0
                        %>
                    </strong>

                </div>


                <div class="order-stat-icon">
                    🔄
                </div>

            </div>


        </section>


        <!-- STATUS SUMMARY -->

        <% if (
            statusSummary &&
            statusSummary.length > 0
        ) { %>


            <section class="status-summary">


                <div class="summary-title">

                    <span>
                        ORDER STATUS
                    </span>


                    <small>
                        Current database status distribution
                    </small>

                </div>


                <div class="status-summary-list">


                    <% statusSummary.forEach(item => { %>


                        <div class="summary-item">

                            <span>
                                <%= item._id || "Unknown" %>
                            </span>


                            <strong>
                                <%= item.count %>
                            </strong>

                        </div>


                    <% }) %>


                </div>


            </section>


        <% } %>


        <!-- FILTER -->

        <section class="orders-panel">


            <form
                method="GET"
                action="/admin/orders"
                class="orders-filter"
            >


                <div class="orders-search">

                    <span>
                        🔍
                    </span>


                    <input
                        type="text"
                        name="search"
                        value="<%= search || '' %>"
                        placeholder="Search order ID, customer name, email or mobile..."
                    >

                </div>


                <select
                    name="status"
                    class="orders-status-select"
                >


                    <option
                        value="all"
                        <%= status === "all"
                            ? "selected"
                            : ""
                        %>
                    >
                        All Status
                    </option>


                    <% if (
                        statusSummary &&
                        statusSummary.length > 0
                    ) { %>


                        <% statusSummary.forEach(item => { %>


                            <% if (item._id) { %>


                                <option
                                    value="<%= item._id %>"
                                    <%= status === item._id
                                        ? "selected"
                                        : ""
                                    %>
                                >
                                    <%= item._id %>
                                </option>


                            <% } %>


                        <% }) %>


                    <% } %>


                </select>


                <button
                    type="submit"
                    class="orders-filter-btn"
                >
                    Search
                </button>


                <a
                    href="/admin/orders"
                    class="orders-clear-btn"
                >
                    Clear
                </a>


            </form>


        </section>


        <!-- ORDERS -->

        <section class="orders-panel">


            <div class="orders-panel-header">


                <div>

                    <p class="orders-eyebrow">
                        ALL ORDERS
                    </p>


                    <h2>
                        Customer Orders
                    </h2>

                </div>


                <span class="orders-count">

                    <%= orders
                        ? orders.length
                        : 0
                    %>

                    Results

                </span>


            </div>


            <% if (
                orders &&
                orders.length > 0
            ) { %>


                <div class="orders-table-wrapper">


                    <table class="orders-table">


                        <thead>

                            <tr>

                                <th>Order ID</th>

                                <th>Customer</th>

                                <th>Items</th>

                                <th>Amount</th>

                                <th>Payment</th>

                                <th>Status</th>

                                <th>Date</th>

                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>


                            <% orders.forEach(order => { %>


                                <tr>


                                    <td>

                                        <strong class="order-id">

                                            #<%= String(
                                                order._id
                                            ).slice(-8) %>

                                        </strong>

                                    </td>


                                    <td>


                                        <% if (
                                            order.customer
                                        ) { %>


                                            <div class="customer-cell">


                                                <div class="customer-avatar">

                                                    <%= order.customer.name
                                                        ? order.customer.name
                                                            .charAt(0)
                                                            .toUpperCase()
                                                        : "C"
                                                    %>

                                                </div>


                                                <div>

                                                    <strong>

                                                        <%= order.customer.name
                                                            || "Customer"
                                                        %>

                                                    </strong>


                                                    <small>

                                                        <%= order.customer.mobile
                                                            || order.customer.email
                                                            || "-"
                                                        %>

                                                    </small>

                                                </div>


                                            </div>


                                        <% } else { %>


                                            <span class="muted">
                                                Guest / Unknown
                                            </span>


                                        <% } %>


                                    </td>


                                    <td>

                                        <span class="items-count">

                                            <%= order.items
                                                ? order.items.length
                                                : 0
                                            %>

                                            item(s)

                                        </span>

                                    </td>


                                    <td>

                                        <strong class="order-amount">

                                            ₹<%= Number(
                                                order.total || 0
                                            ).toLocaleString(
                                                "en-IN"
                                            ) %>

                                        </strong>

                                    </td>


                                    <td>

                                        <span class="payment-badge">

                                            <%= order.paymentMethod
                                                || "-"
                                            %>

                                        </span>

                                    </td>


                                    <td>

                                        <span
                                            class="order-status"
                                            data-status="<%= order.status || 'unknown' %>"
                                        >

                                            <%= order.status
                                                || "Unknown"
                                            %>

                                        </span>

                                    </td>


                                    <td>

                                        <span class="order-date">

                                            <%= order.createdAt
                                                ? new Date(
                                                    order.createdAt
                                                ).toLocaleDateString(
                                                    "en-IN"
                                                )
                                                : "-"
                                            %>

                                        </span>

                                    </td>


                                    <td>

                                        <button
                                            type="button"
                                            class="view-order-btn"
                                            onclick="viewOrder('<%= order._id %>')"
                                        >
                                            View
                                        </button>

                                    </td>


                                </tr>


                            <% }) %>


                        </tbody>


                    </table>


                </div>


            <% } else { %>


                <div class="orders-empty">


                    <div class="empty-icon">
                        📭
                    </div>


                    <h3>
                        No Orders Found
                    </h3>


                    <p>
                        No orders match your current search or filter.
                    </p>


                </div>


            <% } %>


        </section>


    </div>


</main>


<!-- =====================================================
     MODAL
===================================================== -->

<div
    id="orderModal"
    class="order-modal"
>


    <div class="order-modal-box">


        <button
            type="button"
            class="modal-close"
            onclick="closeOrderModal()"
        >
            ×
        </button>


        <div id="orderModalContent">

            <div class="modal-loading">
                Loading...
            </div>

        </div>


    </div>


</div>


<script>


/* =====================================================
   VIEW ORDER
===================================================== */

async function viewOrder(id) {

    var modal =
        document.getElementById("orderModal");

    var content =
        document.getElementById("orderModalContent");


    modal.classList.add("show");


    content.innerHTML =
        '<div class="modal-loading">' +
        'Loading order details...' +
        '</div>';


    try {

        var response =
            await fetch(
                "/admin/orders/" + encodeURIComponent(id)
            );


        var data =
            await response.json();


        if (
            !response.ok ||
            !data.success
        ) {

            throw new Error(
                data.message ||
                "Failed to load order"
            );

        }


        var order =
            data.order || {};


        var customer =
            order.customer || {};


        var delivery =
            order.deliveryDetails || {};


        var itemsHTML = "";


        if (
            order.items &&
            order.items.length > 0
        ) {


            order.items.forEach(
                function(item) {

                    itemsHTML +=
                        '<div class="modal-item">' +

                            '<div>' +

                                '<strong>' +
                                    escapeHtml(
                                        item.name || "Item"
                                    ) +
                                '</strong>' +

                                '<small>' +
                                    'Qty: ' +
                                    Number(
                                        item.quantity || 1
                                    ) +
                                '</small>' +

                            '</div>' +

                            '<strong>' +
                                '₹' +
                                Number(
                                    item.price || 0
                                ).toLocaleString("en-IN") +
                            '</strong>' +

                        '</div>';

                }
            );


        } else {


            itemsHTML =
                '<div class="modal-no-items">' +
                    'No item details available.' +
                '</div>';

        }


        var orderId =
            String(order._id || id).slice(-8);


        var orderStatus =
            order.status || "Unknown";


        var customerName =
            customer.name || "Customer";


        var customerMobile =
            customer.mobile || "-";


        var customerEmail =
            customer.email || "-";


        var deliveryName =
            delivery.name || "-";


        var deliveryMobile =
            delivery.mobile || "-";


        var deliveryAddress =
            delivery.address || "-";


        var deliveryCity =
            delivery.city || "-";


        var deliveryPincode =
            delivery.pincode || "-";


        var subtotal =
            Number(
                order.subtotal || 0
            ).toLocaleString("en-IN");


        var deliveryCharge =
            Number(
                order.deliveryCharge || 0
            ).toLocaleString("en-IN");


        var total =
            Number(
                order.total || 0
            ).toLocaleString("en-IN");


        var paymentMethod =
            order.paymentMethod || "-";


        var createdDate =
            order.createdAt
                ? new Date(
                    order.createdAt
                ).toLocaleString("en-IN")
                : "-";


        content.innerHTML =

            '<div class="modal-header">' +

                '<div>' +

                    '<p>ORDER DETAILS</p>' +

                    '<h2>#' +
                        escapeHtml(orderId) +
                    '</h2>' +

                '</div>' +

                '<span ' +
                    'class="order-status" ' +
                    'data-status="' +
                        escapeHtml(
                            String(orderStatus)
                        ) +
                    '">' +

                    escapeHtml(
                        String(orderStatus)
                    ) +

                '</span>' +

            '</div>' +


            '<div class="modal-grid">' +


                '<div class="modal-section">' +

                    '<h3>👤 Customer</h3>' +

                    '<p>' +
                        '<strong>' +
                            escapeHtml(
                                String(customerName)
                            ) +
                        '</strong>' +
                    '</p>' +

                    '<p>' +
                        escapeHtml(
                            String(customerMobile)
                        ) +
                    '</p>' +

                    '<p>' +
                        escapeHtml(
                            String(customerEmail)
                        ) +
                    '</p>' +

                '</div>' +


                '<div class="modal-section">' +

                    '<h3>📍 Delivery</h3>' +

                    '<p>' +
                        escapeHtml(
                            String(deliveryName)
                        ) +
                    '</p>' +

                    '<p>' +
                        escapeHtml(
                            String(deliveryMobile)
                        ) +
                    '</p>' +

                    '<p>' +
                        escapeHtml(
                            String(deliveryAddress)
                        ) +
                    '</p>' +

                    '<p>' +
                        escapeHtml(
                            String(deliveryCity)
                        ) +
                        ' - ' +
                        escapeHtml(
                            String(deliveryPincode)
                        ) +
                    '</p>' +

                '</div>' +

            '</div>' +


            '<div class="modal-section">' +

                '<h3>🛒 Items</h3>' +

                '<div class="modal-items">' +

                    itemsHTML +

                '</div>' +

            '</div>' +


            '<div class="modal-payment-grid">' +


                '<div>' +

                    '<span>Subtotal</span>' +

                    '<strong>₹' +
                        subtotal +
                    '</strong>' +

                '</div>' +


                '<div>' +

                    '<span>Delivery Charge</span>' +

                    '<strong>₹' +
                        deliveryCharge +
                    '</strong>' +

                '</div>' +


                '<div>' +

                    '<span>Payment</span>' +

                    '<strong>' +
                        escapeHtml(
                            String(paymentMethod)
                        ) +
                    '</strong>' +

                '</div>' +


                '<div class="modal-total">' +

                    '<span>Total</span>' +

                    '<strong>₹' +
                        total +
                    '</strong>' +

                '</div>' +


            '</div>' +


            '<div class="modal-footer">' +

                'Created: ' +
                escapeHtml(
                    String(createdDate)
                ) +

            '</div>';


    } catch (error) {

        console.error(
            "ORDER DETAILS ERROR:",
            error
        );


        content.innerHTML =

            '<div class="modal-error">' +

                '<h3>' +
                    '❌ Unable to load order' +
                '</h3>' +

                '<p>' +
                    escapeHtml(
                        error.message ||
                        "Something went wrong"
                    ) +
                '</p>' +

            '</div>';

    }

}


/* =====================================================
   CLOSE MODAL
===================================================== */

function closeOrderModal() {

    var modal =
        document.getElementById(
            "orderModal"
        );


    if (modal) {

        modal.classList.remove(
            "show"
        );

    }

}


/* =====================================================
   OUTSIDE CLICK
===================================================== */

var orderModal =
    document.getElementById(
        "orderModal"
    );


if (orderModal) {

    orderModal.addEventListener(
        "click",
        function(event) {

            if (
                event.target === orderModal
            ) {

                closeOrderModal();

            }

        }
    );

}


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHtml(value) {

    return String(value)
        .replace(
            /&/g,
            "&amp;"
        )
        .replace(
            /</g,
            "&lt;"
        )
        .replace(
            />/g,
            "&gt;"
        )
        .replace(
            /"/g,
            "&quot;"
        )
        .replace(
            /'/g,
            "&#039;"
        );

}


/* =====================================================
   ESC KEY
===================================================== */

document.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key === "Escape"
        ) {

            closeOrderModal();

        }

    }
);

</script>


</body>

</html>