<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Admin Login</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;

            font-family:
                Inter,
                "Segoe UI",
                Arial,
                sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #f8f1e7 0%,
                    #fffaf4 50%,
                    #f1e2d0 100%
                );

            color: #2d211a;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 30px;
        }


        /* ==========================================
           MAIN LOGIN WRAPPER
        ========================================== */

        .login-wrapper {

            width: 100%;
            max-width: 1050px;

            min-height: 620px;

            background: #fffdf9;

            border-radius: 28px;

            overflow: hidden;

            display: grid;

            grid-template-columns:
                1fr
                1fr;

            box-shadow:
                0 25px 70px
                rgba(73, 48, 31, 0.15);

            border:
                1px solid
                rgba(120, 85, 55, 0.12);
        }


        /* ==========================================
           LEFT BRAND SECTION
        ========================================== */

        .brand-section {

            background:
                linear-gradient(
                    145deg,
                    #174f3a,
                    #0d3b2c
                );

            color: white;

            padding: 55px;

            display: flex;
            flex-direction: column;

            justify-content: center;

            position: relative;

            overflow: hidden;
        }


        .brand-section::before {

            content: "";

            position: absolute;

            width: 280px;
            height: 280px;

            border-radius: 50%;

            background:
                rgba(255,255,255,0.06);

            top: -100px;
            right: -100px;
        }


        .brand-section::after {

            content: "";

            position: absolute;

            width: 220px;
            height: 220px;

            border-radius: 50%;

            background:
                rgba(226,177,110,0.08);

            bottom: -100px;
            left: -80px;
        }


        .brand-logo {

            width: 86px;
            height: 86px;

            border-radius: 24px;

            background:
                #f5dfc5;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 48px;

            margin-bottom: 28px;

            box-shadow:
                0 15px 30px
                rgba(0,0,0,0.15);
        }


        .brand-name {

            font-size: 44px;

            font-weight: 800;

            letter-spacing: -1.5px;

            margin-bottom: 8px;
        }


        .brand-tagline {

            color: #e7d5c0;

            font-size: 15px;

            font-weight: 500;

            margin-bottom: 42px;
        }


        .admin-title {

            font-size: 25px;

            font-weight: 700;

            margin-bottom: 12px;
        }


        .admin-description {

            max-width: 390px;

            line-height: 1.7;

            color: #d7e5de;

            font-size: 14px;
        }


        .brand-features {

            margin-top: 38px;

            display: grid;

            gap: 14px;
        }


        .brand-feature {

            display: flex;

            align-items: center;

            gap: 12px;

            font-size: 14px;

            color: #edf5f0;
        }


        .feature-icon {

            width: 34px;
            height: 34px;

            border-radius: 10px;

            background:
                rgba(255,255,255,0.10);

            display: flex;

            align-items: center;
            justify-content: center;
        }


        /* ==========================================
           RIGHT LOGIN SECTION
        ========================================== */

        .login-section {

            padding: 55px;

            display: flex;

            flex-direction: column;

            justify-content: center;
        }


        .login-header {

            margin-bottom: 35px;
        }


        .eyebrow {

            display: inline-block;

            font-size: 11px;

            font-weight: 800;

            letter-spacing: 1.8px;

            color: #8a5b38;

            margin-bottom: 10px;

            text-transform: uppercase;
        }


        .login-header h1 {

            font-size: 34px;

            line-height: 1.2;

            color: #2d211a;

            margin-bottom: 10px;
        }


        .login-header p {

            color: #806f62;

            font-size: 14px;

            line-height: 1.6;
        }


        /* ==========================================
           FORM
        ========================================== */

        .form-group {

            margin-bottom: 22px;
        }


        .form-group label {

            display: block;

            margin-bottom: 8px;

            font-size: 13px;

            font-weight: 700;

            color: #49372b;
        }


        .input-wrapper {

            position: relative;
        }


        .input-icon {

            position: absolute;

            left: 16px;

            top: 50%;

            transform:
                translateY(-50%);

            font-size: 17px;

            opacity: 0.75;

            pointer-events: none;
        }


        .form-group input {

            width: 100%;

            height: 52px;

            border-radius: 13px;

            border:
                1px solid
                #ddcec0;

            background: #fffaf5;

            color: #2d211a;

            padding:
                0 16px 0 48px;

            outline: none;

            font-size: 14px;

            transition:
                0.2s ease;
        }


        .form-group input:focus {

            border-color:
                #7b5437;

            background: white;

            box-shadow:
                0 0 0 4px
                rgba(123,84,55,0.08);
        }


        /* ==========================================
           PASSWORD
        ========================================== */

        .password-wrapper {

            position: relative;
        }


        .password-wrapper input {

            padding-right: 50px;
        }


        .password-toggle {

            position: absolute;

            right: 14px;

            top: 50%;

            transform:
                translateY(-50%);

            border: none;

            background: transparent;

            cursor: pointer;

            font-size: 17px;

            opacity: 0.65;
        }


        /* ==========================================
           REMEMBER / FORGOT
        ========================================== */

        .login-options {

            display: flex;

            align-items: center;

            justify-content: space-between;

            margin:
                4px 0 25px;
        }


        .remember {

            display: flex;

            align-items: center;

            gap: 8px;

            font-size: 13px;

            color: #746256;

            cursor: pointer;
        }


        .remember input {

            width: 15px;
            height: 15px;

            accent-color:
                #174f3a;
        }


        .forgot-link {

            color:
                #8a5b38;

            text-decoration: none;

            font-size: 13px;

            font-weight: 700;
        }


        .forgot-link:hover {

            text-decoration: underline;
        }


        /* ==========================================
           LOGIN BUTTON
        ========================================== */

        .login-button {

            width: 100%;

            height: 54px;

            border: none;

            border-radius: 14px;

            background:
                linear-gradient(
                    135deg,
                    #174f3a,
                    #0f6748
                );

            color: white;

            font-size: 15px;

            font-weight: 800;

            cursor: pointer;

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;

            box-shadow:
                0 12px 25px
                rgba(23,79,58,0.20);
        }


        .login-button:hover {

            transform:
                translateY(-2px);

            box-shadow:
                0 16px 30px
                rgba(23,79,58,0.28);
        }


        .login-button:active {

            transform:
                translateY(0);
        }


        /* ==========================================
           ERROR MESSAGE
        ========================================== */

        .error-message {

            margin-bottom: 20px;

            padding: 12px 14px;

            border-radius: 11px;

            background: #fcebea;

            border: 1px solid #f0c8c4;

            color: #a33b32;

            font-size: 12px;

            line-height: 1.5;
        }


        /* ==========================================
           SECURITY NOTE
        ========================================== */

        .security-note {

            margin-top: 24px;

            padding: 13px 15px;

            border-radius: 12px;

            background:
                #f7efe6;

            color:
                #725b48;

            font-size: 12px;

            line-height: 1.5;

            display: flex;

            gap: 9px;

            align-items: flex-start;
        }


        /* ==========================================
           FOOTER
        ========================================== */

        .login-footer {

            margin-top: 28px;

            text-align: center;

            font-size: 12px;

            color: #97887d;
        }


        /* ==========================================
           RESPONSIVE
        ========================================== */

        @media (max-width: 850px) {

            .login-wrapper {

                grid-template-columns: 1fr;

                max-width: 560px;

                min-height: auto;
            }


            .brand-section {

                padding: 40px;

                text-align: center;

                align-items: center;
            }


            .brand-features {

                text-align: left;

                width: 100%;

                max-width: 330px;
            }


            .login-section {

                padding: 40px;
            }

        }


        @media (max-width: 480px) {

            body {

                padding: 15px;
            }


            .brand-section {

                padding: 30px 24px;
            }


            .brand-name {

                font-size: 34px;
            }


            .admin-title {

                font-size: 22px;
            }


            .login-section {

                padding: 30px 24px;
            }


            .login-header h1 {

                font-size: 28px;
            }

        }

    </style>

</head>


<body>


<div class="login-wrapper">


    <!-- ==========================================
         LEFT BRAND
    =========================================== -->

    <section class="brand-section">

        <div class="brand-logo">
            🍽️
        </div>


        <div class="brand-name">
            GharSetu
        </div>


        <div class="brand-tagline">
            Home Food & Delivery Platform
        </div>


        <div class="admin-title">
            Admin Control Center
        </div>


        <p class="admin-description">

            Manage customers, restaurants,
            tiffin sellers, delivery partners,
            orders and the complete GharSetu
            platform from one place.

        </p>


        <div class="brand-features">


            <div class="brand-feature">

                <span class="feature-icon">
                    👥
                </span>

                <span>
                    Manage customers & partners
                </span>

            </div>


            <div class="brand-feature">

                <span class="feature-icon">
                    🍽️
                </span>

                <span>
                    Approve restaurants & tiffin sellers
                </span>

            </div>


            <div class="brand-feature">

                <span class="feature-icon">
                    📦
                </span>

                <span>
                    Monitor orders & deliveries
                </span>

            </div>


            <div class="brand-feature">

                <span class="feature-icon">
                    📊
                </span>

                <span>
                    Track business performance
                </span>

            </div>


        </div>

    </section>



    <!-- ==========================================
         LOGIN
    =========================================== -->

    <section class="login-section">


        <div class="login-header">

            <span class="eyebrow">
                GHARSETU ADMIN
            </span>

            <h1>
                Welcome Back, Admin
            </h1>

            <p>
                Sign in to manage your platform
                and keep everything running smoothly.
            </p>

        </div>


        <% if (typeof error !== "undefined" && error) { %>

            <div class="error-message">
                <%= error %>
            </div>

        <% } %>



        <!-- ======================================
             ADMIN LOGIN FORM
        ======================================= -->

        <form
            action="/admin/login"
            method="POST"
            id="adminLoginForm"
        >


            <!-- MOBILE -->

            <div class="form-group">

                <label for="mobile">
                    Mobile Number
                </label>


                <div class="input-wrapper">

                    <span class="input-icon">
                        📱
                    </span>


                    <input
                        type="tel"
                        id="mobile"
                        name="mobile"
                        placeholder="Enter admin mobile number"
                        autocomplete="username"
                        inputmode="numeric"
                        maxlength="10"
                        pattern="[0-9]{10}"
                        required
                    >

                </div>

            </div>



            <!-- PASSWORD -->

            <div class="form-group">

                <label for="password">
                    Password
                </label>


                <div class="password-wrapper">

                    <span class="input-icon">
                        🔒
                    </span>


                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                    >


                    <button
                        type="button"
                        class="password-toggle"
                        id="passwordToggle"
                        aria-label="Show password"
                    >
                        👁️
                    </button>

                </div>

            </div>



            <!-- OPTIONS -->

            <div class="login-options">

                <label class="remember">

                    <input
                        type="checkbox"
                        name="remember"
                    >

                    <span>
                        Remember me
                    </span>

                </label>


                <a
                    href="#"
                    class="forgot-link"
                    onclick="return false;"
                >
                    Forgot password?
                </a>

            </div>



            <!-- LOGIN BUTTON -->

            <button
                type="submit"
                class="login-button"
            >
                Login to Admin Panel →
            </button>


        </form>



        <!-- SECURITY -->

        <div class="security-note">

            <span>
                🔐
            </span>

            <span>
                This is a restricted admin area.
                Only authorized GharSetu administrators
                should access this panel.
            </span>

        </div>


        <!-- FOOTER -->

        <div class="login-footer">

            GharSetu Admin Panel
            •
            Manage · Monitor · Grow

        </div>


    </section>


</div>



<script>

    /* ==========================================
       PASSWORD TOGGLE
    ========================================== */

    const passwordInput =
        document.getElementById(
            "password"
        );


    const passwordToggle =
        document.getElementById(
            "passwordToggle"
        );


    passwordToggle.addEventListener(
        "click",
        function () {

            if (
                passwordInput.type ===
                "password"
            ) {

                passwordInput.type =
                    "text";

                passwordToggle.textContent =
                    "🙈";

            } else {

                passwordInput.type =
                    "password";

                passwordToggle.textContent =
                    "👁️";

            }

        }
    );



    /* ==========================================
       FORM VALIDATION
    ========================================== */

    const adminLoginForm =
        document.getElementById(
            "adminLoginForm"
        );


    adminLoginForm.addEventListener(
        "submit",
        function (event) {

            const mobile =
                document
                    .getElementById("mobile")
                    .value
                    .trim();

            const password =
                passwordInput.value;


            if (!mobile) {

                event.preventDefault();

                alert(
                    "Please enter admin mobile number."
                );

                return;
            }


            if (!/^[0-9]{10}$/.test(mobile)) {

                event.preventDefault();

                alert(
                    "Please enter a valid 10 digit mobile number."
                );

                return;
            }


            if (!password) {

                event.preventDefault();

                alert(
                    "Please enter admin password."
                );

                return;
            }


            if (password.length < 6) {

                event.preventDefault();

                alert(
                    "Password must be at least 6 characters."
                );

                return;
            }

        }
    );

</script>


</body>

</html>