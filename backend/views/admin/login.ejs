
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GharSetu | Admin Login</title>

    <link rel="stylesheet" href="/css/admin-login.css">
    <script src="/js/admin-login.js" defer></script>
</head>

<body>
    <div class="login-wrapper">

        <!-- LEFT BRAND SECTION -->
        <section class="brand-section">

            <div class="brand-logo">🍽️</div>

            <div class="brand-name">GharSetu</div>

            <div class="brand-tagline">
                Home Food &amp; Delivery Platform
            </div>

            <div class="admin-title">Admin Control Center</div>

            <p class="admin-description">
                Manage customers, restaurants, tiffin sellers, delivery
                partners, orders and the complete GharSetu platform
                from one place.
            </p>

            <div class="brand-features">

                <div class="brand-feature">
                    <span class="feature-icon">👥</span>
                    <span>Manage customers &amp; partners</span>
                </div>

                <div class="brand-feature">
                    <span class="feature-icon">🍽️</span>
                    <span>Approve restaurants &amp; tiffin sellers</span>
                </div>

                <div class="brand-feature">
                    <span class="feature-icon">📦</span>
                    <span>Monitor orders &amp; deliveries</span>
                </div>

                <div class="brand-feature">
                    <span class="feature-icon">📊</span>
                    <span>Track business performance</span>
                </div>

            </div>
        </section>

        <!-- RIGHT LOGIN SECTION -->
        <section class="login-section">

            <div class="login-header">
                <span class="eyebrow">GHARSETU ADMIN</span>

                <h1>Welcome Back, Admin</h1>

                <p>
                    Sign in to manage your platform and keep everything
                    running smoothly.
                </p>
            </div>

            <% if (typeof error !== "undefined" && error) { %>
                <div class="error-message" role="alert">
                    <%= error %>
                </div>
            <% } %>

            <!-- ADMIN LOGIN FORM -->
            <form
                action="/admin/login"
                method="POST"
                id="adminLoginForm"
            >

                <!-- MOBILE -->
                <div class="form-group">
                    <label for="mobile">Mobile Number</label>

                    <div class="input-wrapper">
                        <span class="input-icon">📱</span>

                        <input
                            type="tel"
                            id="mobile"
                            name="mobile"
                            placeholder="Enter admin mobile number"
                            autocomplete="username"
                            inputmode="numeric"
                            maxlength="10"
                            pattern="[0-9]{10}"
                            required
                        >
                    </div>
                </div>

                <!-- PASSWORD -->
                <div class="form-group">
                    <label for="password">Password</label>

                    <div class="password-wrapper">
                        <span class="input-icon">🔒</span>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            id="passwordToggle"
                            aria-label="Show password"
                            aria-pressed="false"
                        >
                            👁️
                        </button>
                    </div>
                </div>

                <!-- REMEMBER / FORGOT -->
                <div class="login-options">

                    <label class="remember">
                        <input type="checkbox" name="remember">
                        <span>Remember me</span>
                    </label>

                    <a
                        href="#"
                        class="forgot-link"
                        id="forgotPasswordLink"
                    >
                        Forgot password?
                    </a>

                </div>

                <!-- LOGIN BUTTON -->
                <button type="submit" class="login-button">
                    Login to Admin Panel →
                </button>

            </form>

            <!-- SECURITY NOTE -->
            <div class="security-note">
                <span>🔐</span>

                <span>
                    This is a restricted admin area. Only authorized
                    GharSetu administrators should access this panel.
                </span>
            </div>

            <!-- FOOTER -->
            <div class="login-footer">
                GharSetu Admin Panel • Manage · Monitor · Grow
            </div>

        </section>
    </div>
</body>
</html>
