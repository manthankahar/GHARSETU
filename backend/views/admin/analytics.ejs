
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics | GHARSETU Admin</title>

    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/analytics.css">
    <link rel="stylesheet" href="/css/admin-sidebar.css">
</head>

<body>
    <%- include("../partials/adminSidebar", {
        admin: typeof admin !== "undefined" ? admin : null,
        activePage: "analytics"
    }) %>

    <main class="admin-main analytics-main">

        <section class="analytics-header">
            <div>
                <span class="analytics-eyebrow">ADMIN MANAGEMENT</span>
                <h1>Analytics</h1>
                <p>Monitor business performance and platform activity.</p>
            </div>

            <div class="analytics-admin">
                <div class="analytics-admin-icon">👤</div>
                <strong>
                    <%= admin && admin.name ? admin.name : "Administrator" %>
                </strong>
            </div>
        </section>

        <!-- MAIN STATISTICS -->
        <section class="analytics-stats">
            <div class="analytics-stat">
                <div class="stat-head">
                    <span>Total Orders</span>
                    <div class="stat-icon">📦</div>
                </div>
                <strong><%= totalOrders || 0 %></strong>
                <small>All customer orders</small>
            </div>

            <div class="analytics-stat revenue">
                <div class="stat-head">
                    <span>Total Revenue</span>
                    <div class="stat-icon">₹</div>
                </div>
                <strong>₹<%= Number(totalRevenue || 0).toLocaleString("en-IN") %></strong>
                <small>Total order value</small>
            </div>

            <div class="analytics-stat customers">
                <div class="stat-head">
                    <span>Customers</span>
                    <div class="stat-icon">👥</div>
                </div>
                <strong><%= totalCustomers || 0 %></strong>
                <small>Registered customers</small>
            </div>

            <div class="analytics-stat average">
                <div class="stat-head">
                    <span>Average Order</span>
                    <div class="stat-icon">📈</div>
                </div>
                <strong>₹<%= Number(averageOrderValue || 0).toLocaleString("en-IN", {
                    maximumFractionDigits: 0
                }) %></strong>
                <small>Average order value</small>
            </div>
        </section>

        <!-- BUSINESS NETWORK -->
        <section class="analytics-section-title">
            <span>PLATFORM OVERVIEW</span>
            <h2>Business Network</h2>
        </section>

        <section class="network-grid">
            <div class="network-card">
                <div class="network-icon">🍽️</div>
                <div class="network-info">
                    <span>Restaurants</span>
                    <strong><%= totalRestaurants || 0 %></strong>
                    <small><%= approvedRestaurants || 0 %> approved</small>
                </div>
            </div>

            <div class="network-card">
                <div class="network-icon">🍱</div>
                <div class="network-info">
                    <span>Tiffin Sellers</span>
                    <strong><%= totalTiffinSellers || 0 %></strong>
                    <small><%= approvedTiffinSellers || 0 %> approved</small>
                </div>
            </div>

            <div class="network-card">
                <div class="network-icon">🛵</div>
                <div class="network-info">
                    <span>Delivery Partners</span>
                    <strong><%= totalDeliveryPartners || 0 %></strong>
                    <small>Delivery network</small>
                </div>
            </div>

            <div class="network-card">
                <div class="network-icon">👤</div>
                <div class="network-info">
                    <span>Active Users</span>
                    <strong><%= activeUsers || 0 %></strong>
                    <small>of <%= totalUsers || 0 %> total users</small>
                </div>
            </div>
        </section>

        <!-- ORDER STATUS AND PAYMENT METHODS -->
        <section class="analytics-charts">
            <div class="analytics-card">
                <div class="analytics-card-header">
                    <div>
                        <span>ORDERS</span>
                        <h2>Order Status</h2>
                    </div>
                </div>

                <div class="status-list">
                    <% if (!orderStatusData || orderStatusData.length === 0) { %>
                        <div class="analytics-empty">No order data available.</div>
                    <% } else { %>
                        <% orderStatusData.forEach(item => {
                            const count = Number(item.count || 0);
                            const percentage = Number(totalOrders) > 0
                                ? Math.round((count / Number(totalOrders)) * 100)
                                : 0;
                        %>
                            <div class="status-row">
                                <div class="status-label">
                                    <span><%= item._id || "Unknown" %></span>
                                    <strong><%= count %></strong>
                                </div>

                                <div class="status-progress-line">
                                    <div class="progress-track">
                                        <div class="progress-fill"
                                             data-width="<%= Math.min(100, Math.max(0, percentage)) %>"></div>
                                    </div>
                                    <span class="status-percent"><%= percentage %>%</span>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <div class="analytics-card">
                <div class="analytics-card-header">
                    <div>
                        <span>PAYMENTS</span>
                        <h2>Payment Methods</h2>
                    </div>
                </div>

                <div class="payment-list">
                    <% if (!paymentMethodData || paymentMethodData.length === 0) { %>
                        <div class="analytics-empty">No payment data available.</div>
                    <% } else { %>
                        <% paymentMethodData.forEach(item => { %>
                            <div class="payment-row">
                                <div class="payment-icon">
                                    <%= item._id === "online"
                                        ? "💳"
                                        : item._id === "cash"
                                            ? "💵"
                                            : "💰" %>
                                </div>

                                <div class="payment-info">
                                    <strong><%= item._id || "Unknown" %></strong>
                                    <span><%= item.count || 0 %> orders</span>
                                </div>

                                <strong class="payment-amount">
                                    ₹<%= Number(item.amount || 0).toLocaleString("en-IN") %>
                                </strong>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- MONTHLY REVENUE -->
        <section class="analytics-card revenue-card">
            <div class="analytics-card-header">
                <div>
                    <span>REVENUE</span>
                    <h2>Monthly Performance</h2>
                </div>
            </div>

            <% if (!monthlyRevenue || monthlyRevenue.length === 0) { %>
                <div class="analytics-empty">No monthly revenue data available.</div>
            <% } else { %>
                <%
                    const maxRevenue = Math.max(
                        ...monthlyRevenue.map(item => Number(item.revenue || 0)),
                        1
                    );
                %>

                <div class="revenue-chart">
                    <% monthlyRevenue.forEach(item => {
                        const revenue = Number(item.revenue || 0);
                        const height = Math.max(8, (revenue / maxRevenue) * 100);

                        const monthName = item._id && item._id.month && item._id.year
                            ? new Date(item._id.year, item._id.month - 1, 1)
                                .toLocaleDateString("en-IN", { month: "short" })
                            : "-";
                    %>
                        <div class="bar-column">
                            <div class="bar-value">
                                ₹<%= revenue.toLocaleString("en-IN") %>
                            </div>

                            <div class="bar-area">
                                <div class="revenue-bar"
                                     data-height="<%= Math.min(100, Math.max(0, height)) %>"></div>
                            </div>

                            <span>
                                <%= monthName %>
                                <% if (item._id && item._id.year) { %>
                                    <%= item._id.year %>
                                <% } %>
                            </span>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </section>

        <!-- DELIVERY STATUS -->
        <section class="analytics-card delivery-card">
            <div class="analytics-card-header">
                <div>
                    <span>DELIVERY</span>
                    <h2>Delivery Status</h2>
                </div>
            </div>

            <div class="delivery-grid">
                <% if (!deliveryStatusData || deliveryStatusData.length === 0) { %>
                    <div class="analytics-empty">No delivery data available.</div>
                <% } else { %>
                    <% deliveryStatusData.forEach(item => { %>
                        <div class="delivery-status">
                            <strong><%= item.count || 0 %></strong>
                            <span><%= item._id || "Unknown" %></span>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </section>

        <!-- RECENT ORDERS -->
        <section class="analytics-card recent-card">
            <div class="analytics-card-header">
                <div>
                    <span>RECENT ACTIVITY</span>
                    <h2>Recent Orders</h2>
                </div>

                <a href="/admin/orders" class="recent-view-all">View All</a>
            </div>

            <div class="recent-table">
                <% if (!recentOrders || recentOrders.length === 0) { %>
                    <div class="analytics-empty">No recent orders found.</div>
                <% } else { %>
                    <table>
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% recentOrders.forEach(order => { %>
                                <tr>
                                    <td>
                                        <strong>#<%= String(order._id).slice(-8) %></strong>
                                    </td>

                                    <td>
                                        <%= order.customer && order.customer.name
                                            ? order.customer.name
                                            : "Unknown" %>
                                    </td>

                                    <td>
                                        <strong>
                                            ₹<%= Number(order.total || 0).toLocaleString("en-IN") %>
                                        </strong>
                                    </td>

                                    <td>
                                        <span class="recent-status">
                                            <%= order.status || "unknown" %>
                                        </span>
                                    </td>

                                    <td>
                                        <%= order.createdAt
                                            ? new Date(order.createdAt).toLocaleDateString("en-IN")
                                            : "-" %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </section>

    </main>

    <script>
        document.querySelectorAll(".progress-fill[data-width]").forEach(function (element) {
            const width = Number(element.dataset.width) || 0;

            setTimeout(function () {
                element.style.width = Math.min(100, Math.max(0, width)) + "%";
            }, 100);
        });

        document.querySelectorAll(".revenue-bar[data-height]").forEach(function (element) {
            const height = Number(element.dataset.height) || 0;

            setTimeout(function () {
                element.style.height = Math.min(100, Math.max(0, height)) + "%";
            }, 100);
        });
    </script>
</body>
</html>
