<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Analytics | GHARSETU Admin</title>

    <link rel="stylesheet" href="/css/admin.css">

    <style>

        :root {
            --ivory: #f8f4ec;
            --cream: #fffdf8;
            --beige: #eee3d2;
            --beige-dark: #d9c7af;

            --coffee: #3f2d25;
            --coffee-light: #6c574d;
            --muted: #8a7970;

            --green: #2f6f4e;
            --green-dark: #24583e;
            --green-light: #e4f0e8;

            --gold: #b78322;
            --gold-light: #fff3d5;

            --blue: #4d7187;
            --blue-light: #e8f1f6;

            --red: #b44d4d;
            --red-light: #fbe9e9;

            --white: #ffffff;

            --border: rgba(63, 45, 37, 0.10);

            --shadow:
                0 12px 35px
                rgba(63, 45, 37, 0.07);

            --radius: 20px;
        }


        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;

            background: var(--ivory);

            color: var(--coffee);

            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }


        /* =====================================================
           MAIN
        ===================================================== */

        .analytics-main {
            min-height: 100vh;

            padding: 34px;
        }


        /* =====================================================
           HEADER
        ===================================================== */

        .analytics-header {
            display: flex;

            align-items: flex-start;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 28px;
        }


        .analytics-eyebrow {
            display: inline-block;

            margin-bottom: 8px;

            color: var(--green);

            font-size: 10px;

            font-weight: 850;

            letter-spacing: 1.8px;
        }


        .analytics-header h1 {
            margin: 0;

            color: var(--coffee);

            font-size: 35px;

            line-height: 1.1;

            letter-spacing: -0.9px;
        }


        .analytics-header p {
            margin: 9px 0 0;

            color: var(--muted);

            font-size: 14px;
        }


        .analytics-admin {
            display: flex;

            align-items: center;

            gap: 10px;

            padding: 10px 14px;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: 13px;

            box-shadow: var(--shadow);

            white-space: nowrap;
        }


        .analytics-admin-icon {
            width: 34px;

            height: 34px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 10px;

            background: var(--green-light);

            font-size: 17px;
        }


        .analytics-admin strong {
            color: var(--coffee);

            font-size: 12px;
        }


        /* =====================================================
           MAIN STAT CARDS
        ===================================================== */

        .analytics-stats {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 16px;

            margin-bottom: 30px;
        }


        .analytics-stat {
            position: relative;

            min-height: 150px;

            overflow: hidden;

            padding: 20px;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: var(--radius);

            box-shadow: var(--shadow);

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }


        .analytics-stat:hover {
            transform: translateY(-3px);

            box-shadow:
                0 18px 45px
                rgba(63, 45, 37, 0.11);
        }


        .analytics-stat::after {
            content: "";

            position: absolute;

            width: 95px;

            height: 95px;

            right: -32px;

            bottom: -32px;

            border-radius: 50%;

            background: var(--green-light);
        }


        .analytics-stat.revenue::after {
            background: var(--gold-light);
        }


        .analytics-stat.customers::after {
            background: var(--blue-light);
        }


        .analytics-stat.average::after {
            background: var(--beige);
        }


        .stat-head {
            position: relative;

            z-index: 2;

            display: flex;

            align-items: center;

            justify-content: space-between;
        }


        .stat-head span {
            color: var(--muted);

            font-size: 10px;

            font-weight: 800;

            text-transform: uppercase;

            letter-spacing: 0.8px;
        }


        .stat-icon {
            width: 38px;

            height: 38px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 11px;

            background: var(--green-light);

            font-size: 17px;
        }


        .revenue .stat-icon {
            background: var(--gold-light);
        }


        .customers .stat-icon {
            background: var(--blue-light);
        }


        .average .stat-icon {
            background: var(--beige);
        }


        .analytics-stat > strong {
            position: relative;

            z-index: 2;

            display: block;

            margin-top: 18px;

            color: var(--coffee);

            font-size: 29px;

            line-height: 1;
        }


        .analytics-stat.revenue > strong {
            color: var(--green);
        }


        .analytics-stat > small {
            position: relative;

            z-index: 2;

            display: block;

            margin-top: 9px;

            color: var(--muted);

            font-size: 10px;
        }


        /* =====================================================
           SECTION TITLE
        ===================================================== */

        .analytics-section-title {
            margin-bottom: 15px;
        }


        .analytics-section-title span {
            color: var(--green);

            font-size: 9px;

            font-weight: 850;

            letter-spacing: 1.6px;
        }


        .analytics-section-title h2 {
            margin: 5px 0 0;

            color: var(--coffee);

            font-size: 21px;
        }


        /* =====================================================
           NETWORK
        ===================================================== */

        .network-grid {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 15px;

            margin-bottom: 30px;
        }


        .network-card {
            display: flex;

            align-items: center;

            gap: 14px;

            padding: 18px;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: 17px;

            box-shadow: var(--shadow);

            transition:
                transform 0.2s ease;
        }


        .network-card:hover {
            transform: translateY(-2px);
        }


        .network-icon {
            flex: 0 0 auto;

            width: 48px;

            height: 48px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 14px;

            background: var(--green-light);

            font-size: 22px;
        }


        .network-card:nth-child(2)
        .network-icon {
            background: var(--gold-light);
        }


        .network-card:nth-child(3)
        .network-icon {
            background: var(--blue-light);
        }


        .network-card:nth-child(4)
        .network-icon {
            background: var(--beige);
        }


        .network-info span {
            display: block;

            color: var(--muted);

            font-size: 10px;

            font-weight: 700;
        }


        .network-info strong {
            display: block;

            margin-top: 4px;

            color: var(--coffee);

            font-size: 23px;
        }


        .network-info small {
            display: block;

            margin-top: 3px;

            color: var(--green);

            font-size: 9px;

            font-weight: 700;
        }


        /* =====================================================
           CHART GRID
        ===================================================== */

        .analytics-charts {
            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 18px;

            margin-bottom: 18px;
        }


        .analytics-card {
            background: var(--white);

            border: 1px solid var(--border);

            border-radius: var(--radius);

            box-shadow: var(--shadow);

            overflow: hidden;
        }


        .analytics-card-header {
            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 20px 21px;

            border-bottom: 1px solid var(--border);
        }


        .analytics-card-header span {
            display: block;

            color: var(--green);

            font-size: 9px;

            font-weight: 850;

            letter-spacing: 1.4px;
        }


        .analytics-card-header h2 {
            margin: 5px 0 0;

            color: var(--coffee);

            font-size: 18px;
        }


        /* =====================================================
           ORDER STATUS
        ===================================================== */

        .status-list {
            padding: 20px 21px;
        }


        .status-row {
            margin-bottom: 18px;
        }


        .status-row:last-child {
            margin-bottom: 0;
        }


        .status-label {
            display: flex;

            align-items: center;

            justify-content: space-between;

            margin-bottom: 7px;
        }


        .status-label span {
            color: var(--coffee-light);

            font-size: 11px;

            font-weight: 650;

            text-transform: capitalize;
        }


        .status-label strong {
            color: var(--coffee);

            font-size: 11px;
        }


        .status-progress-line {
            display: flex;

            align-items: center;

            gap: 10px;
        }


        .progress-track {
            flex: 1;

            height: 8px;

            overflow: hidden;

            background: var(--beige);

            border-radius: 20px;
        }


        .progress-fill {
            width: 0;

            height: 100%;

            background: var(--green);

            border-radius: 20px;

            transition:
                width 0.7s ease;
        }


        .status-percent {
            min-width: 34px;

            color: var(--muted);

            font-size: 10px;

            text-align: right;
        }


        /* =====================================================
           PAYMENT
        ===================================================== */

        .payment-list {
            padding: 14px 21px 20px;
        }


        .payment-row {
            display: flex;

            align-items: center;

            gap: 12px;

            padding: 13px 0;

            border-bottom:
                1px solid
                rgba(63, 45, 37, 0.07);
        }


        .payment-row:last-child {
            border-bottom: 0;
        }


        .payment-icon {
            width: 42px;

            height: 42px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: var(--green-light);

            border-radius: 12px;

            font-size: 18px;
        }


        .payment-info {
            flex: 1;
        }


        .payment-info strong {
            display: block;

            color: var(--coffee);

            font-size: 12px;

            text-transform: capitalize;
        }


        .payment-info span {
            display: block;

            margin-top: 4px;

            color: var(--muted);

            font-size: 9px;
        }


        .payment-amount {
            color: var(--green);

            font-size: 13px;
        }


        /* =====================================================
           MONTHLY REVENUE
        ===================================================== */

        .revenue-card {
            margin-bottom: 18px;
        }


        .revenue-chart {
            min-height: 290px;

            display: flex;

            align-items: flex-end;

            gap: 13px;

            padding: 28px 24px 20px;

            overflow-x: auto;
        }


        .bar-column {
            flex: 1;

            min-width: 65px;

            height: 245px;

            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: flex-end;
        }


        .bar-value {
            min-height: 25px;

            margin-bottom: 7px;

            color: var(--green);

            font-size: 9px;

            font-weight: 750;

            white-space: nowrap;
        }


        .bar-area {
            width: 100%;

            max-width: 48px;

            height: 180px;

            display: flex;

            align-items: flex-end;

            justify-content: center;

            background:
                linear-gradient(
                    to top,
                    rgba(63, 45, 37, 0.045),
                    transparent
                );

            border-radius: 10px;
        }


        .revenue-bar {
            width: 72%;

            height: 0;

            min-height: 7px;

            background: var(--green);

            border-radius:
                8px 8px 5px 5px;

            transition:
                height 0.7s ease;
        }


        .bar-column > span {
            margin-top: 9px;

            color: var(--muted);

            font-size: 9px;

            font-weight: 650;

            text-align: center;

            white-space: nowrap;
        }


        /* =====================================================
           DELIVERY STATUS
        ===================================================== */

        .delivery-card {
            margin-bottom: 18px;
        }


        .delivery-grid {
            display: grid;

            grid-template-columns:
                repeat(5, 1fr);

            gap: 12px;

            padding: 20px;
        }


        .delivery-status {
            padding: 20px 12px;

            background: var(--ivory);

            border: 1px solid var(--border);

            border-radius: 15px;

            text-align: center;
        }


        .delivery-status strong {
            display: block;

            color: var(--green);

            font-size: 24px;
        }


        .delivery-status span {
            display: block;

            margin-top: 6px;

            color: var(--muted);

            font-size: 10px;

            text-transform: capitalize;
        }


        /* =====================================================
           RECENT ORDERS
        ===================================================== */

        .recent-card {
            margin-bottom: 18px;
        }


        .recent-view-all {
            padding: 7px 11px;

            background: var(--green-light);

            color: var(--green);

            border-radius: 9px;

            text-decoration: none;

            font-size: 10px;

            font-weight: 800;
        }


        .recent-view-all:hover {
            background: var(--green);

            color: white;
        }


        .recent-table {
            overflow-x: auto;
        }


        .recent-table table {
            width: 100%;

            min-width: 700px;

            border-collapse: collapse;
        }


        .recent-table th {
            padding: 12px 18px;

            background: #fcfaf6;

            color: var(--coffee-light);

            text-align: left;

            font-size: 9px;

            text-transform: uppercase;

            letter-spacing: 0.7px;
        }


        .recent-table td {
            padding: 14px 18px;

            border-top:
                1px solid
                rgba(63, 45, 37, 0.07);

            color: var(--coffee-light);

            font-size: 11px;
        }


        .recent-table td strong {
            color: var(--coffee);
        }


        .recent-status {
            display: inline-flex;

            padding: 6px 9px;

            background: var(--green-light);

            color: var(--green);

            border-radius: 8px;

            font-size: 9px;

            font-weight: 800;

            text-transform: capitalize;
        }


        /* =====================================================
           EMPTY
        ===================================================== */

        .analytics-empty {
            padding: 45px 20px;

            color: var(--muted);

            text-align: center;

            font-size: 12px;
        }


        .analytics-empty::before {
            content: "📊";

            display: block;

            margin-bottom: 10px;

            font-size: 28px;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 1200px) {

            .analytics-stats {
                grid-template-columns:
                    repeat(2, 1fr);
            }


            .network-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }


            .delivery-grid {
                grid-template-columns:
                    repeat(3, 1fr);
            }

        }


        @media (max-width: 850px) {

            .analytics-main {
                padding: 24px;
            }


            .analytics-charts {
                grid-template-columns: 1fr;
            }


            .delivery-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }

        }


        @media (max-width: 600px) {

            .analytics-main {
                padding: 15px;
            }


            .analytics-header {
                flex-direction: column;
            }


            .analytics-header h1 {
                font-size: 28px;
            }


            .analytics-stats {
                grid-template-columns: 1fr;
            }


            .network-grid {
                grid-template-columns: 1fr;
            }


            .delivery-grid {
                grid-template-columns: 1fr 1fr;
            }


            .analytics-card-header {
                padding: 17px;
            }


            .revenue-chart {
                padding-left: 15px;

                padding-right: 15px;
            }

        }

    </style>

</head>


<body>


<!-- =====================================================
     SIDEBAR
===================================================== -->

<%- include("../partials/adminSidebar") %>


<!-- =====================================================
     MAIN
===================================================== -->

<main class="admin-main analytics-main">


    <!-- =====================================================
         HEADER
    ===================================================== -->

    <section class="analytics-header">

        <div>

            <span class="analytics-eyebrow">
                ADMIN MANAGEMENT
            </span>

            <h1>
                Analytics
            </h1>

            <p>
                Monitor business performance and platform activity.
            </p>

        </div>


        <div class="analytics-admin">

            <div class="analytics-admin-icon">
                👤
            </div>

            <strong>

                <%= admin && admin.name
                    ? admin.name
                    : "Administrator"
                %>

            </strong>

        </div>

    </section>



    <!-- =====================================================
         MAIN STATS
    ===================================================== -->

    <section class="analytics-stats">


        <!-- TOTAL ORDERS -->

        <div class="analytics-stat">

            <div class="stat-head">

                <span>
                    Total Orders
                </span>

                <div class="stat-icon">
                    📦
                </div>

            </div>


            <strong>
                <%= totalOrders || 0 %>
            </strong>


            <small>
                All customer orders
            </small>

        </div>



        <!-- TOTAL REVENUE -->

        <div class="analytics-stat revenue">

            <div class="stat-head">

                <span>
                    Total Revenue
                </span>

                <div class="stat-icon">
                    ₹
                </div>

            </div>


            <strong>

                ₹<%= Number(
                    totalRevenue || 0
                ).toLocaleString(
                    "en-IN"
                ) %>

            </strong>


            <small>
                Total order value
            </small>

        </div>



        <!-- CUSTOMERS -->

        <div class="analytics-stat customers">

            <div class="stat-head">

                <span>
                    Customers
                </span>

                <div class="stat-icon">
                    👥
                </div>

            </div>


            <strong>
                <%= totalCustomers || 0 %>
            </strong>


            <small>
                Registered customers
            </small>

        </div>



        <!-- AVERAGE -->

        <div class="analytics-stat average">

            <div class="stat-head">

                <span>
                    Average Order
                </span>

                <div class="stat-icon">
                    📈
                </div>

            </div>


            <strong>

                ₹<%= Number(
                    averageOrderValue || 0
                ).toLocaleString(
                    "en-IN",
                    {
                        maximumFractionDigits: 0
                    }
                ) %>

            </strong>


            <small>
                Average order value
            </small>

        </div>


    </section>



    <!-- =====================================================
         NETWORK TITLE
    ===================================================== -->

    <section class="analytics-section-title">

        <span>
            PLATFORM OVERVIEW
        </span>

        <h2>
            Business Network
        </h2>

    </section>



    <!-- =====================================================
         NETWORK CARDS
    ===================================================== -->

    <section class="network-grid">


        <!-- RESTAURANTS -->

        <div class="network-card">

            <div class="network-icon">
                🍽️
            </div>


            <div class="network-info">

                <span>
                    Restaurants
                </span>


                <strong>
                    <%= totalRestaurants || 0 %>
                </strong>


                <small>

                    <%= approvedRestaurants || 0 %>
                    approved

                </small>

            </div>

        </div>



        <!-- TIFFIN SELLERS -->

        <div class="network-card">

            <div class="network-icon">
                🍱
            </div>


            <div class="network-info">

                <span>
                    Tiffin Sellers
                </span>


                <strong>
                    <%= totalTiffinSellers || 0 %>
                </strong>


                <small>

                    <%= approvedTiffinSellers || 0 %>
                    approved

                </small>

            </div>

        </div>



        <!-- DELIVERY -->

        <div class="network-card">

            <div class="network-icon">
                🛵
            </div>


            <div class="network-info">

                <span>
                    Delivery Partners
                </span>


                <strong>
                    <%= totalDeliveryPartners || 0 %>
                </strong>


                <small>
                    Delivery network
                </small>

            </div>

        </div>



        <!-- ACTIVE USERS -->

        <div class="network-card">

            <div class="network-icon">
                👤
            </div>


            <div class="network-info">

                <span>
                    Active Users
                </span>


                <strong>
                    <%= activeUsers || 0 %>
                </strong>


                <small>

                    of
                    <%= totalUsers || 0 %>
                    total users

                </small>

            </div>

        </div>


    </section>



    <!-- =====================================================
         CHARTS
    ===================================================== -->

    <section class="analytics-charts">


        <!-- =================================================
             ORDER STATUS
        ================================================= -->

        <div class="analytics-card">

            <div class="analytics-card-header">

                <div>

                    <span>
                        ORDERS
                    </span>

                    <h2>
                        Order Status
                    </h2>

                </div>

            </div>


            <div class="status-list">


                <% if (
                    !orderStatusData ||
                    orderStatusData.length === 0
                ) { %>


                    <div class="analytics-empty">
                        No order data available.
                    </div>


                <% } else { %>


                    <% orderStatusData.forEach(
                        item => {

                            const count =
                                Number(
                                    item.count || 0
                                );

                            const percentage =
                                totalOrders > 0
                                    ? Math.round(
                                        (
                                            count /
                                            totalOrders
                                        ) * 100
                                    )
                                    : 0;
                    %>


                        <div class="status-row">


                            <div class="status-label">

                                <span>
                                    <%= item._id || "Unknown" %>
                                </span>

                                <strong>
                                    <%= count %>
                                </strong>

                            </div>


                            <div class="status-progress-line">

                                <div class="progress-track">

                                    <div
                                        class="progress-fill"
                                        data-width="<%= percentage %>"
                                    ></div>

                                </div>


                                <span class="status-percent">
                                    <%= percentage %>%
                                </span>

                            </div>


                        </div>


                    <% }) %>


                <% } %>


            </div>

        </div>



        <!-- =================================================
             PAYMENT METHODS
        ================================================= -->

        <div class="analytics-card">

            <div class="analytics-card-header">

                <div>

                    <span>
                        PAYMENTS
                    </span>

                    <h2>
                        Payment Methods
                    </h2>

                </div>

            </div>


            <div class="payment-list">


                <% if (
                    !paymentMethodData ||
                    paymentMethodData.length === 0
                ) { %>


                    <div class="analytics-empty">
                        No payment data available.
                    </div>


                <% } else { %>


                    <% paymentMethodData.forEach(
                        item => {
                    %>


                        <div class="payment-row">


                            <div class="payment-icon">

                                <%= item._id === "online"
                                    ? "💳"
                                    : item._id === "cash"
                                        ? "💵"
                                        : "💰"
                                %>

                            </div>


                            <div class="payment-info">

                                <strong>
                                    <%= item._id || "Unknown" %>
                                </strong>


                                <span>

                                    <%= item.count || 0 %>
                                    orders

                                </span>

                            </div>


                            <strong class="payment-amount">

                                ₹<%= Number(
                                    item.amount || 0
                                ).toLocaleString(
                                    "en-IN"
                                ) %>

                            </strong>


                        </div>


                    <% }) %>


                <% } %>


            </div>

        </div>


    </section>



    <!-- =====================================================
         MONTHLY REVENUE
    ===================================================== -->

    <section class="analytics-card revenue-card">


        <div class="analytics-card-header">

            <div>

                <span>
                    REVENUE
                </span>

                <h2>
                    Monthly Performance
                </h2>

            </div>

        </div>


        <% if (
            !monthlyRevenue ||
            monthlyRevenue.length === 0
        ) { %>


            <div class="analytics-empty">
                No monthly revenue data available.
            </div>


        <% } else { %>


            <%
                const maxRevenue =
                    Math.max(
                        ...monthlyRevenue.map(
                            function (x) {
                                return Number(
                                    x.revenue || 0
                                );
                            }
                        ),
                        1
                    );
            %>


            <div class="revenue-chart">


                <% monthlyRevenue.forEach(
                    item => {

                        const revenue =
                            Number(
                                item.revenue || 0
                            );

                        const height =
                            Math.max(
                                8,
                                (
                                    revenue /
                                    maxRevenue
                                ) * 100
                            );

                        const monthName =
                            item._id &&
                            item._id.month &&
                            item._id.year
                                ? new Date(
                                    item._id.year,
                                    item._id.month - 1,
                                    1
                                ).toLocaleDateString(
                                    "en-IN",
                                    {
                                        month: "short"
                                    }
                                )
                                : "-";
                %>


                    <div class="bar-column">


                        <div class="bar-value">

                            ₹<%= revenue.toLocaleString(
                                "en-IN"
                            ) %>

                        </div>


                        <div class="bar-area">

                            <div
                                class="revenue-bar"
                                data-height="<%= height %>"
                            ></div>

                        </div>


                        <span>

                            <%= monthName %>

                            <% if (
                                item._id &&
                                item._id.year
                            ) { %>

                                <%= item._id.year %>

                            <% } %>

                        </span>


                    </div>


                <% }) %>


            </div>


        <% } %>


    </section>



    <!-- =====================================================
         DELIVERY STATUS
    ===================================================== -->

    <section class="analytics-card delivery-card">


        <div class="analytics-card-header">

            <div>

                <span>
                    DELIVERY
                </span>

                <h2>
                    Delivery Status
                </h2>

            </div>

        </div>


        <div class="delivery-grid">


            <% if (
                !deliveryStatusData ||
                deliveryStatusData.length === 0
            ) { %>


                <div class="analytics-empty">
                    No delivery data available.
                </div>


            <% } else { %>


                <% deliveryStatusData.forEach(
                    item => {
                %>


                    <div class="delivery-status">

                        <strong>
                            <%= item.count || 0 %>
                        </strong>


                        <span>
                            <%= item._id || "Unknown" %>
                        </span>

                    </div>


                <% }) %>


            <% } %>


        </div>


    </section>



    <!-- =====================================================
         RECENT ORDERS
    ===================================================== -->

    <section class="analytics-card recent-card">


        <div class="analytics-card-header">

            <div>

                <span>
                    RECENT ACTIVITY
                </span>

                <h2>
                    Recent Orders
                </h2>

            </div>


            <a
                href="/admin/orders"
                class="recent-view-all"
            >
                View All
            </a>

        </div>


        <div class="recent-table">


            <% if (
                !recentOrders ||
                recentOrders.length === 0
            ) { %>


                <div class="analytics-empty">
                    No recent orders found.
                </div>


            <% } else { %>


                <table>


                    <thead>

                        <tr>

                            <th>
                                Order
                            </th>

                            <th>
                                Customer
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Date
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                        <% recentOrders.forEach(
                            order => {
                        %>


                            <tr>


                                <td>

                                    <strong>

                                        #<%= String(
                                            order._id
                                        ).slice(-8) %>

                                    </strong>

                                </td>


                                <td>

                                    <%= order.customer
                                        ? order.customer.name
                                        : "Unknown"
                                    %>

                                </td>


                                <td>

                                    <strong>

                                        ₹<%= Number(
                                            order.total || 0
                                        ).toLocaleString(
                                            "en-IN"
                                        ) %>

                                    </strong>

                                </td>


                                <td>

                                    <span class="recent-status">

                                        <%= order.status ||
                                            "unknown"
                                        %>

                                    </span>

                                </td>


                                <td>

                                    <%= order.createdAt
                                        ? new Date(
                                            order.createdAt
                                        ).toLocaleDateString(
                                            "en-IN"
                                        )
                                        : "-"
                                    %>

                                </td>


                            </tr>


                        <% }) %>


                    </tbody>


                </table>


            <% } %>


        </div>


    </section>


</main>



<!-- =====================================================
     ANIMATION
===================================================== -->

<script>


document
    .querySelectorAll(
        ".progress-fill[data-width]"
    )
    .forEach(
        function (element) {

            var width =
                Number(
                    element.dataset.width
                ) || 0;


            if (width > 100) {

                width = 100;

            }


            if (width < 0) {

                width = 0;

            }


            setTimeout(
                function () {

                    element.style.width =
                        width + "%";

                },
                100
            );

        }
    );



document
    .querySelectorAll(
        ".revenue-bar[data-height]"
    )
    .forEach(
        function (element) {

            var height =
                Number(
                    element.dataset.height
                ) || 0;


            if (height > 100) {

                height = 100;

            }


            if (height < 0) {

                height = 0;

            }


            setTimeout(
                function () {

                    element.style.height =
                        height + "%";

                },
                100
            );

        }
    );

</script>


</body>

</html>