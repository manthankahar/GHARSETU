        function sendReviewReply() {

            var reply =
                document
                    .getElementById("adminReply")
                    .value
                    .trim();


            if (!reply) {

                alert(
                    "Please write a response first."
                );

                return;
            }


            alert(
                "Admin response sent successfully in demo mode."
            );


            document
                .getElementById("adminReply")
                .value = "";

        }


        function viewReview(id) {

            fetch(
                "/admin/reviews/" + id
            )
            .then(function(response) {

                if (!response.ok) {
                    throw new Error(
                        "Failed to load review."
                    );
                }

                return response.json();

            })
            .then(function(data) {

                if (
                    !data ||
                    !data.review
                ) {

                    throw new Error(
                        "Review data not found."
                    );

                }


                var review =
                    data.review;


                var customer =
                    review.customer?.name ||
                    "Customer";


                var partner =
                    review.restaurant?.restaurantName ||
                    review.restaurant?.name ||
                    review.tiffinSeller?.name ||
                    review.partnerName ||
                    "Food Partner";


                var rating =
                    Number(review.rating || 0);


                var reviewText =
                    review.comment ||
                    review.review ||
                    review.text ||
                    "No review text";


                openReviewModal(
                    customer,
                    partner,
                    rating,
                    reviewText
                );

            })
            .catch(function(error) {

                console.error(error);

                alert(
                    "Review details are not connected yet."
                );

            });

        }


        function replyReview(id) {

            alert(
                "Reply feature backend connection pachi activate karishu."
            );

        }


        function deleteReview(id) {

            var confirmDelete =
                confirm(
