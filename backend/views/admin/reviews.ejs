<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GharSetu | Reviews & Ratings</title>

    <style>

        :root {
            --ivory: #fffdf8;
            --cream: #f8f1e5;
            --beige: #eadbc8;
            --coffee: #5b3a29;
            --coffee-dark: #3e281d;
            --green: #4f7d58;
            --green-dark: #3e6546;
            --green-light: #e8f1e9;
            --text: #30271f;
            --muted: #897c70;
            --border: #e7ddd0;
            --white: #ffffff;
            --danger: #b94b4b;
            --danger-light: #f9e8e8;
            --warning: #b27a2c;
            --warning-light: #fff3dc;
            --shadow: 0 10px 35px rgba(91, 58, 41, 0.08);
        }


        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--ivory);
            color: var(--text);
            min-height: 100vh;
        }


        button,
        input,
        select,
        textarea {
            font-family: inherit;
        }


        button {
            cursor: pointer;
        }


        /* ================= SIDEBAR ================= */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            height: 100vh;
            background: var(--white);
            border-right: 1px solid var(--border);
            padding: 24px 16px;
            z-index: 1000;
            overflow-y: auto;
        }


        .brand {
            padding: 8px 12px 26px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 20px;
        }


        .brand-name {
            color: var(--coffee);
            font-size: 25px;
            font-weight: 800;
        }


        .brand-subtitle {
            color: var(--muted);
            font-size: 10px;
            margin-top: 5px;
            letter-spacing: 1.4px;
            text-transform: uppercase;
        }


        .nav-title {
            color: #aa9c8e;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            padding: 0 12px 10px;
            text-transform: uppercase;
        }


        .nav-menu {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }


        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #65594f;
            padding: 12px 13px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            transition: 0.2s ease;
        }


        .nav-link:hover {
            background: var(--cream);
            color: var(--coffee);
        }


        .nav-link.active {
            background: var(--green-light);
            color: var(--green-dark);
        }


        .nav-icon {
            width: 23px;
            text-align: center;
            font-size: 16px;
        }


        /* ================= MAIN ================= */

        .main {
            margin-left: 250px;
            min-height: 100vh;
        }


        .topbar {
            height: 76px;
            background: rgba(255, 253, 248, 0.96);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 34px;
            position: sticky;
            top: 0;
            z-index: 900;
            backdrop-filter: blur(10px);
        }


        .page-title h1 {
            font-size: 23px;
            color: var(--coffee-dark);
            margin-bottom: 4px;
        }


        .page-title p {
            color: var(--muted);
            font-size: 12px;
        }


        .admin-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }


        .admin-info {
            text-align: right;
        }


        .admin-name {
            font-size: 13px;
            font-weight: 700;
            color: var(--coffee-dark);
        }


        .admin-role {
            font-size: 11px;
            color: var(--muted);
            margin-top: 2px;
        }


        .admin-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--coffee);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }


        .content {
            padding: 30px 34px 45px;
        }


        /* ================= STATS ================= */

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 28px;
        }


        .stat-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 21px;
            box-shadow: var(--shadow);
        }


        .stat-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }


        .stat-icon {
            width: 43px;
            height: 43px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--cream);
            font-size: 19px;
        }


        .stat-label {
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
            margin-top: 17px;
        }


        .stat-value {
            font-size: 27px;
            color: var(--coffee-dark);
            font-weight: 800;
            margin-top: 5px;
        }


        .stat-note {
            font-size: 11px;
            color: var(--green);
            margin-top: 7px;
        }


        /* ================= RATING OVERVIEW ================= */

        .rating-overview {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 18px;
            margin-bottom: 24px;
        }


        .rating-summary {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 25px;
            box-shadow: var(--shadow);
            text-align: center;
        }


        .rating-number {
            font-size: 48px;
            line-height: 1;
            font-weight: 800;
            color: var(--coffee-dark);
        }


        .stars {
            color: #d99a32;
            font-size: 23px;
            letter-spacing: 2px;
            margin: 10px 0 6px;
        }


        .rating-summary p {
            color: var(--muted);
            font-size: 11px;
        }


        .rating-breakdown {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 22px 25px;
            box-shadow: var(--shadow);
        }


        .rating-breakdown h3 {
            color: var(--coffee-dark);
            font-size: 15px;
            margin-bottom: 17px;
        }


        .rating-row {
            display: grid;
            grid-template-columns: 45px 1fr 45px;
            align-items: center;
            gap: 10px;
            margin: 10px 0;
        }


        .rating-row-label {
            font-size: 11px;
            font-weight: 700;
            color: #66594e;
        }


        .rating-bar {
            height: 7px;
            background: #eee5da;
            border-radius: 20px;
            overflow: hidden;
        }


        .rating-fill {
            height: 100%;
            background: var(--green);
            border-radius: 20px;
        }


        .rating-count {
            font-size: 11px;
            color: var(--muted);
            text-align: right;
        }


        /* ================= TOOLBAR ================= */

        .toolbar {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 18px;
            margin-bottom: 20px;
            box-shadow: var(--shadow);
        }


        .toolbar-row {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }


        .search-box {
            flex: 1;
            min-width: 230px;
            position: relative;
        }


        .search-box span {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #a69889;
        }


        .search-box input {
            width: 100%;
            height: 43px;
            border: 1px solid var(--border);
            border-radius: 11px;
            padding: 0 14px 0 40px;
            outline: none;
            background: #fffefa;
            font-size: 13px;
        }


        .filter-select {
            height: 43px;
            border: 1px solid var(--border);
            border-radius: 11px;
            padding: 0 35px 0 13px;
            background: #fffefa;
            color: var(--text);
            outline: none;
            min-width: 145px;
            font-size: 13px;
        }


        .btn {
            border: none;
            border-radius: 11px;
            height: 43px;
            padding: 0 18px;
            font-weight: 700;
            font-size: 13px;
        }


        .btn-primary {
            background: var(--green);
            color: white;
        }


        .btn-primary:hover {
            background: var(--green-dark);
        }


        .btn-secondary {
            background: var(--cream);
            color: var(--coffee);
        }


        /* ================= TABLE ================= */

        .table-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }


        .table-header {
            padding: 21px 22px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }


        .table-header h2 {
            font-size: 16px;
            color: var(--coffee-dark);
        }


        .table-header p {
            color: var(--muted);
            font-size: 11px;
            margin-top: 4px;
        }


        .review-count {
            color: var(--muted);
            font-size: 11px;
        }


        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }


        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1050px;
        }


        th {
            text-align: left;
            background: #fcf8f1;
            color: #85776a;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 13px 18px;
            white-space: nowrap;
        }


        td {
            padding: 16px 18px;
            border-top: 1px solid #f0e8dd;
            color: #51463d;
            font-size: 12px;
            vertical-align: middle;
        }


        tbody tr:hover {
            background: #fffdf9;
        }


        .customer {
            display: flex;
            align-items: center;
            gap: 10px;
        }


        .customer-avatar {
            width: 37px;
            height: 37px;
            border-radius: 11px;
            background: var(--cream);
            color: var(--coffee);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 13px;
        }


        .customer-name {
            font-weight: 700;
            color: var(--coffee-dark);
        }


        .small-text {
            font-size: 10px;
            color: var(--muted);
            margin-top: 3px;
        }


        .partner-name {
            font-weight: 700;
            color: var(--coffee-dark);
        }


        .order-id {
            color: var(--green-dark);
            font-weight: 700;
            font-size: 11px;
        }


        .rating-stars {
            color: #d99a32;
            font-size: 14px;
            letter-spacing: 1px;
            white-space: nowrap;
        }


        .rating-value {
            font-size: 10px;
            color: var(--muted);
            margin-top: 3px;
        }


        .review-text {
            max-width: 250px;
            line-height: 1.5;
            color: #5d5147;
        }


        .status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 30px;
            font-size: 10px;
            font-weight: 800;
        }


        .status.approved {
            background: var(--green-light);
            color: var(--green-dark);
        }


        .status.pending {
            background: var(--warning-light);
            color: var(--warning);
        }


        .status.hidden {
            background: var(--danger-light);
            color: var(--danger);
        }


        .actions {
            display: flex;
            gap: 6px;
        }


        .action-btn {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            border: 1px solid var(--border);
            background: var(--ivory);
            color: var(--coffee);
            font-size: 13px;
        }


        .action-btn:hover {
            background: var(--cream);
        }


        .action-btn.delete {
            color: var(--danger);
        }


        .action-btn.delete:hover {
            background: var(--danger-light);
        }


        /* ================= MODAL ================= */

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(48, 39, 31, 0.48);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 3000;
            padding: 20px;
        }


        .modal-overlay.show {
            display: flex;
        }


        .modal {
            width: 100%;
            max-width: 600px;
            max-height: 90vh;
            overflow-y: auto;
            background: white;
            border-radius: 22px;
            box-shadow: 0 25px 80px rgba(48, 39, 31, 0.2);
        }


        .modal-header {
            padding: 21px 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }


        .modal-header h2 {
            font-size: 18px;
            color: var(--coffee-dark);
        }


        .modal-close {
            width: 35px;
            height: 35px;
            border: none;
            border-radius: 10px;
            background: var(--cream);
            color: var(--coffee);
            font-size: 18px;
        }


        .modal-body {
            padding: 24px;
        }


        .review-box {
            background: #fcf8f1;
            border-radius: 15px;
            padding: 18px;
            margin-bottom: 18px;
        }


        .review-header {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 13px;
        }


        .review-customer {
            display: flex;
            align-items: center;
            gap: 10px;
        }


        .review-avatar {
            width: 43px;
            height: 43px;
            border-radius: 12px;
            background: var(--cream);
            color: var(--coffee);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }


        .review-customer strong {
            display: block;
            font-size: 13px;
            color: var(--coffee-dark);
        }


        .review-customer span {
            font-size: 10px;
            color: var(--muted);
        }


        .modal-stars {
            color: #d99a32;
            font-size: 18px;
        }


        .review-content {
            color: #5d5147;
            font-size: 13px;
            line-height: 1.7;
        }


        .detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }


        .detail-item {
            padding: 13px;
            background: var(--cream);
            border-radius: 11px;
        }


        .detail-item small {
            display: block;
            color: var(--muted);
            font-size: 10px;
            margin-bottom: 5px;
        }


        .detail-item strong {
            color: var(--coffee-dark);
            font-size: 12px;
        }


        .reply-box {
            margin-top: 18px;
        }


        .reply-box label {
            display: block;
            color: #675b51;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 7px;
        }


        .reply-box textarea {
            width: 100%;
            height: 85px;
            border: 1px solid var(--border);
            border-radius: 11px;
            padding: 12px;
            resize: vertical;
            outline: none;
            font-size: 12px;
        }


        .modal-footer {
            padding: 18px 24px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }


        /* ================= EMPTY ================= */

        .empty-state {
            text-align: center;
            padding: 65px 25px;
        }


        .empty-icon {
            width: 70px;
            height: 70px;
            border-radius: 22px;
            background: var(--cream);
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }


        .empty-state h3 {
            color: var(--coffee-dark);
            font-size: 17px;
            margin-bottom: 7px;
        }


        .empty-state p {
            color: var(--muted);
            font-size: 12px;
        }


        /* ================= RESPONSIVE ================= */

        @media (max-width: 1100px) {

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .rating-overview {
                grid-template-columns: 1fr;
            }
        }


        @media (max-width: 850px) {

            .sidebar {
                width: 72px;
                padding: 18px 10px;
            }

            .brand {
                display: none;
            }

            .nav-title {
                display: none;
            }

            .nav-link {
                justify-content: center;
                padding: 13px 8px;
            }

            .nav-text {
                display: none;
            }

            .main {
                margin-left: 72px;
            }

            .topbar {
                padding: 0 20px;
            }

            .content {
                padding: 24px 20px;
            }
        }


        @media (max-width: 620px) {

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .admin-info {
                display: none;
            }

            .page-title h1 {
                font-size: 19px;
            }

            .detail-grid {
                grid-template-columns: 1fr;
            }
        }

    </style>
</head>


<body>


    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div class="brand">
            <div class="brand-name">GharSetu</div>
            <div class="brand-subtitle">
                Admin Control Center
            </div>
        </div>


        <div class="nav-title">
            Main Menu
        </div>


        <nav class="nav-menu">

            <a href="/admin/dashboard" class="nav-link">
                <span class="nav-icon">⌂</span>
                <span class="nav-text">Dashboard</span>
            </a>


            <a href="/admin/customers" class="nav-link">
                <span class="nav-icon">👥</span>
                <span class="nav-text">Customers</span>
            </a>


            <a href="/admin/restaurants" class="nav-link">
                <span class="nav-icon">🍽</span>
                <span class="nav-text">Restaurants</span>
            </a>


            <a href="/admin/tiffin-sellers" class="nav-link">
                <span class="nav-icon">🥘</span>
                <span class="nav-text">Tiffin Sellers</span>
            </a>


            <a href="/admin/delivery" class="nav-link">
                <span class="nav-icon">🛵</span>
                <span class="nav-text">Delivery Partners</span>
            </a>


            <a href="/admin/orders" class="nav-link">
                <span class="nav-icon">📦</span>
                <span class="nav-text">Orders</span>
            </a>


            <a href="/admin/payments" class="nav-link">
                <span class="nav-icon">💳</span>
                <span class="nav-text">Payments</span>
            </a>


            <a href="/admin/complaints" class="nav-link">
                <span class="nav-icon">💬</span>
                <span class="nav-text">Complaints</span>
            </a>


            <a href="/admin/analytics" class="nav-link">
                <span class="nav-icon">📊</span>
                <span class="nav-text">Analytics</span>
            </a>


            <a href="/admin/coupons" class="nav-link">
                <span class="nav-icon">🎟</span>
                <span class="nav-text">Coupons</span>
            </a>


            <a href="/admin/reviews" class="nav-link active">
                <span class="nav-icon">⭐</span>
                <span class="nav-text">Reviews</span>
            </a>


            <a href="/admin/settings" class="nav-link">
                <span class="nav-icon">⚙</span>
                <span class="nav-text">Settings</span>
            </a>


            <a href="/admin/profile" class="nav-link">
                <span class="nav-icon">👤</span>
                <span class="nav-text">Admin Profile</span>
            </a>


            <a href="/admin/logout" class="nav-link">
                <span class="nav-icon">↪</span>
                <span class="nav-text">Logout</span>
            </a>

        </nav>

    </aside>


    <!-- ================= MAIN ================= -->

    <main class="main">


        <header class="topbar">

            <div class="page-title">

                <h1>
                    Reviews & Ratings
                </h1>

                <p>
                    Monitor customer feedback and food partner ratings
                </p>

            </div>


            <div class="admin-area">

                <div class="admin-info">

                    <div class="admin-name">
                        <%= admin?.name || "Administrator" %>
                    </div>

                    <div class="admin-role">
                        GharSetu Admin
                    </div>

                </div>


                <div class="admin-avatar">

                    <%= (admin?.name || "A").charAt(0).toUpperCase() %>

                </div>

            </div>

        </header>


        <section class="content">


            <!-- ================= STATS ================= -->

            <div class="stats-grid">


                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon">
                            ⭐
                        </div>

                    </div>

                    <div class="stat-label">
                        Total Reviews
                    </div>

                    <div class="stat-value">
                        <%= typeof totalReviews !== "undefined"
                            ? totalReviews
                            : "1,842" %>
                    </div>

                    <div class="stat-note">
                        Customer feedback received
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon">
                            ★
                        </div>

                    </div>

                    <div class="stat-label">
                        Average Rating
                    </div>

                    <div class="stat-value">
                        <%= typeof averageRating !== "undefined"
                            ? averageRating
                            : "4.6" %>
                    </div>

                    <div class="stat-note">
                        Overall platform rating
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon">
                            👍
                        </div>

                    </div>

                    <div class="stat-label">
                        5 Star Reviews
                    </div>

                    <div class="stat-value">
                        <%= typeof fiveStarReviews !== "undefined"
                            ? fiveStarReviews
                            : "1,124" %>
                    </div>

                    <div class="stat-note">
                        Highly satisfied customers
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon">
                            ⚠
                        </div>

                    </div>

                    <div class="stat-label">
                        Low Rating Reviews
                    </div>

                    <div class="stat-value">
                        <%= typeof lowRatingReviews !== "undefined"
                            ? lowRatingReviews
                            : "86" %>
                    </div>

                    <div class="stat-note">
                        1–2 star reviews
                    </div>

                </div>

            </div>


            <!-- ================= RATING OVERVIEW ================= -->

            <div class="rating-overview">


                <div class="rating-summary">

                    <div class="rating-number">
                        <%= typeof averageRating !== "undefined"
                            ? averageRating
                            : "4.6" %>
                    </div>


                    <div class="stars">
                        ★★★★★
                    </div>


                    <p>
