                confirm(
                    "Delete review from " +
                    customer +
                    "?"
                );


            if (!confirmDelete) {
                return;
            }


            alert(
                "Demo review delete action."
            );

        }


        document
            .getElementById("reviewModal")
            .addEventListener(
                "click",
                function(event) {

                    if (
                        event.target ===
                        document.getElementById("reviewModal")
                    ) {

                        closeReviewModal();

                    }

                }
            );


    </script>


