                .getElementById("modalCustomer")
                .textContent = customer;


            document
                .getElementById("modalPartner")
                .textContent = partner;


            document
                .getElementById("detailCustomer")
                .textContent = customer;


            document
                .getElementById("detailPartner")
                .textContent = partner;


            document
                .getElementById("detailRating")
                .textContent =
                rating + " / 5";


            document
                .getElementById("modalReview")
                .textContent = review;


            document
                .getElementById("modalAvatar")
                .textContent =
                customer.charAt(0).toUpperCase();


            var stars = "";


            for (
                var i = 1;
                i <= 5;
                i++
            ) {

                if (i <= Number(rating)) {
                    stars += "★";
                } else {
                    stars += "☆";
                }

            }


            document
                .getElementById("modalStars")
                .textContent = stars;


            document
                .getElementById("reviewModal")
                .classList
                .add("show");

        }


