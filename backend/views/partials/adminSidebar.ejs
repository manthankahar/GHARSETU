
<%
    const currentPage =
        typeof activePage !== "undefined" && activePage
            ? activePage
            : "";

    const currentAdmin =
        typeof admin !== "undefined" && admin
            ? admin
            : null;
%>

<aside class="admin-sidebar">

    <!-- BRAND -->
    <div class="admin-brand">
        <div class="brand-logo">🍽️</div>

        <div class="brand-text">
            <strong>GharSetu</strong>
            <span>ADMIN PANEL</span>
        </div>
    </div>

    <!-- ADMIN PROFILE -->
    <div class="admin-profile">
        <div class="admin-avatar">
            <%= (
                currentAdmin && currentAdmin.name
                    ? currentAdmin.name.charAt(0)
                    : "A"
            ).toUpperCase() %>
        </div>

        <div class="admin-profile-info">
            <strong>
                <%= currentAdmin && currentAdmin.name
                    ? currentAdmin.name
                    : "Administrator" %>
            </strong>
            <span>Administrator</span>
        </div>
    </div>

    <!-- NAVIGATION -->
    <nav class="admin-nav">

        <div class="admin-nav-heading">MAIN MENU</div>

        <a href="/admin/dashboard"
           class="admin-nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>">
            <span class="nav-icon">📊</span>
            <span class="nav-label">Dashboard</span>
        </a>

        <a href="/admin/customers"
           class="admin-nav-link <%= currentPage === 'customers' ? 'active' : '' %>">
            <span class="nav-icon">👥</span>
            <span class="nav-label">Customers</span>
        </a>

        <a href="/admin/restaurants"
           class="admin-nav-link <%= currentPage === 'restaurants' ? 'active' : '' %>">
            <span class="nav-icon">🍽️</span>
            <span class="nav-label">Restaurants</span>
        </a>

        <a href="/admin/tiffin-sellers"
           class="admin-nav-link <%= currentPage === 'tiffin-sellers' ? 'active' : '' %>">
            <span class="nav-icon">🏠</span>
            <span class="nav-label">Tiffin Sellers</span>
        </a>

        <a href="/admin/delivery"
           class="admin-nav-link <%= currentPage === 'delivery' ? 'active' : '' %>">
            <span class="nav-icon">🛵</span>
            <span class="nav-label">Delivery Partners</span>
        </a>

        <div class="admin-nav-heading">MANAGEMENT</div>

        <a href="/admin/orders"
           class="admin-nav-link <%= currentPage === 'orders' ? 'active' : '' %>">
            <span class="nav-icon">📦</span>
            <span class="nav-label">Orders</span>
        </a>

        <a href="/admin/payments"
           class="admin-nav-link <%= currentPage === 'payments' ? 'active' : '' %>">
            <span class="nav-icon">💳</span>
            <span class="nav-label">Payments</span>
        </a>

        <a href="/admin/coupons"
           class="admin-nav-link <%= currentPage === 'coupons' ? 'active' : '' %>">
            <span class="nav-icon">🎟️</span>
            <span class="nav-label">Coupons</span>
        </a>

        <a href="/admin/reviews"
           class="admin-nav-link <%= currentPage === 'reviews' ? 'active' : '' %>">
            <span class="nav-icon">⭐</span>
            <span class="nav-label">Reviews</span>
        </a>

        <a href="/admin/messages"
           class="admin-nav-link <%= currentPage === 'messages' ? 'active' : '' %>">
            <span class="nav-icon">💬</span>
            <span class="nav-label">Mail Center</span>
        </a>

        <div class="admin-nav-heading">SYSTEM</div>

        <a href="/admin/analytics"
           class="admin-nav-link <%= currentPage === 'analytics' ? 'active' : '' %>">
            <span class="nav-icon">📈</span>
            <span class="nav-label">Analytics</span>
        </a>

        <a href="/admin/complaints"
           class="admin-nav-link <%= currentPage === 'complaints' ? 'active' : '' %>">
            <span class="nav-icon">⚠️</span>
            <span class="nav-label">Complaints</span>
        </a>

        <a href="/admin/settings"
           class="admin-nav-link <%= currentPage === 'settings' ? 'active' : '' %>">
            <span class="nav-icon">⚙️</span>
            <span class="nav-label">Settings</span>
        </a>

        <a href="/admin/profile"
           class="admin-nav-link <%= currentPage === 'profile' ? 'active' : '' %>">
            <span class="nav-icon">👤</span>
            <span class="nav-label">Admin Profile</span>
        </a>

    </nav>

    <!-- LOGOUT -->
    <div class="admin-sidebar-bottom">
        <a href="/admin/logout" class="admin-logout">
            <span class="nav-icon">🚪</span>
            <span class="nav-label">Logout</span>
        </a>
    </div>

</aside>
