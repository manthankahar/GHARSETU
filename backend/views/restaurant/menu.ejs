<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Restaurant Menu</title>

    <link
        rel="stylesheet"
        href="/css/restaurant.css"
    >

</head>

<body>

<div class="restaurant-layout">

    <!-- SIDEBAR -->

    <%- include("../partials/restaurantSidebar") %>


    <!-- MAIN CONTENT -->

    <main class="restaurant-main">


        <!-- PAGE HEADER -->

        <header class="page-header">

            <div>

                <span class="eyebrow">
                    RESTAURANT PANEL
                </span>

                <h1>
                    Menu Management
                </h1>

                <p>
                    Manage your food items, prices
                    and availability.
                </p>

            </div>

        </header>



        <!-- ADD MENU ITEM -->

        <section class="dashboard-section">

            <div class="section-heading">

                <div>

                    <span class="eyebrow">
                        MENU
                    </span>

                    <h2>
                        Add New Item
                    </h2>

                </div>

            </div>


            <div class="menu-form-card">

                <form
                    action="/restaurant/menu/add"
                    method="POST"
                >


                    <div class="menu-form-grid">


                        <!-- FOOD NAME -->

                        <div class="form-group">

                            <label>
                                Food Name
                            </label>

                            <input
                                type="text"
                                name="name"
                                placeholder="Example: Paneer Tikka"
                                required
                            >

                        </div>



                        <!-- CATEGORY -->

                        <div class="form-group">

                            <label>
                                Category
                            </label>

                            <select name="category">

                                <option value="North Indian">
                                    North Indian
                                </option>

                                <option value="South Indian">
                                    South Indian
                                </option>

                                <option value="Gujarati">
                                    Gujarati
                                </option>

                                <option value="Chinese">
                                    Chinese
                                </option>

                                <option value="Fast Food">
                                    Fast Food
                                </option>

                                <option value="Pizza">
                                    Pizza
                                </option>

                                <option value="Dessert">
                                    Dessert
                                </option>

                                <option value="Beverages">
                                    Beverages
                                </option>

                                <option value="Other" selected>
                                    Other
                                </option>

                            </select>

                        </div>



                        <!-- PRICE -->

                        <div class="form-group">

                            <label>
                                Price
                            </label>

                            <div class="price-input">

                                <span>
                                    ₹
                                </span>

                                <input
                                    type="number"
                                    name="price"
                                    placeholder="0.00"
                                    min="1"
                                    step="0.01"
                                    required
                                >

                            </div>

                        </div>


                    </div>



                    <!-- DESCRIPTION -->

                    <div class="form-group">

                        <label>
                            Description
                        </label>

                        <textarea
                            name="description"
                            rows="4"
                            placeholder="Describe your food item..."
                        ></textarea>

                    </div>



                    <!-- SUBMIT -->

                    <div class="menu-form-actions">

                        <button
                            type="submit"
                            class="primary-button"
                        >
                            + Add Menu Item
                        </button>

                    </div>


                </form>

            </div>

        </section>



        <!-- MENU LIST -->

        <section class="dashboard-section">


            <div class="section-heading">

                <div>

                    <span class="eyebrow">
                        YOUR MENU
                    </span>

                    <h2>
                        Menu Items
                    </h2>

                </div>


                <div class="menu-total">

                    <strong>
                        <%= menuItems?.length || 0 %>
                    </strong>

                    <span>
                        Items
                    </span>

                </div>

            </div>



            <% if (!menuItems || menuItems.length === 0) { %>


                <!-- EMPTY STATE -->

                <div class="empty-card menu-empty">

                    <div class="menu-empty-icon">
                        🍽️
                    </div>

                    <h3>
                        No Menu Items Yet
                    </h3>

                    <p>
                        Your restaurant menu is empty.
                        Add your first food item above.
                    </p>

                </div>


            <% } else { %>


                <!-- MENU GRID -->

                <div class="menu-grid">


                    <% menuItems.forEach(item => { %>


                        <article class="menu-card">


                            <!-- TOP -->

                            <div class="menu-card-top">

                                <div class="menu-food-icon">
                                    🍽️
                                </div>


                                <span
                                    class="menu-status
                                    <%= item.isAvailable
                                        ? 'available'
                                        : 'unavailable'
                                    %>"
                                >

                                    <span></span>

                                    <%= item.isAvailable
                                        ? "Available"
                                        : "Unavailable"
                                    %>

                                </span>

                            </div>



                            <!-- CONTENT -->

                            <div class="menu-card-content">

                                <span class="menu-category">

                                    <%= item.category || "Other" %>

                                </span>


                                <h3>
                                    <%= item.name %>
                                </h3>


                                <p>

                                    <%= item.description ||
                                        "No description available."
                                    %>

                                </p>

                            </div>



                            <!-- BOTTOM -->

                            <div class="menu-card-bottom">


                                <div>

                                    <span class="price-label">
                                        PRICE
                                    </span>

                                    <strong class="menu-price">

                                        ₹<%= Number(
                                            item.price || 0
                                        ).toFixed(2) %>

                                    </strong>

                                </div>


                                <div class="menu-actions">


                                    <!-- TOGGLE -->

                                    <form
                                        action="/restaurant/menu/<%= item._id %>/toggle"
                                        method="POST"
                                    >

                                        <button
                                            type="submit"
                                            class="menu-action-button toggle-button"
                                        >

                                            <%= item.isAvailable
                                                ? "Disable"
                                                : "Enable"
                                            %>

                                        </button>

                                    </form>



                                    <!-- DELETE -->

                                    <form
                                        action="/restaurant/menu/<%= item._id %>/delete"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this menu item?')"
                                    >

                                        <button
                                            type="submit"
                                            class="menu-action-button delete-button"
                                        >
                                            Delete
                                        </button>

                                    </form>


                                </div>

                            </div>


                        </article>


                    <% }) %>


                </div>


            <% } %>


        </section>



        <!-- FOOTER -->

        <%- include("../partials/footer") %>


    </main>

</div>


<script src="/js/restaurant.js"></script>

</body>

</html>