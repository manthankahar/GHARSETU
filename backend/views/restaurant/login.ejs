<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Restaurant Login</title>

    <link rel="stylesheet" href="/css/restaurant.css">

</head>

<body class="auth-page">

<div class="auth-container">

    <div class="auth-card">

        <div class="auth-logo">
            🍽️
        </div>

        <span class="eyebrow">
            GHARSETU RESTAURANT
        </span>

        <h1>
            Restaurant Login
        </h1>

        <p class="auth-subtitle">
            Login to manage your restaurant.
        </p>


        <form
            action="/restaurant/login"
            method="POST"
        >

            <div class="form-group">

                <label>
                    Mobile Number
                </label>

                <input
                    type="tel"
                    name="mobile"
                    placeholder="Enter mobile number"
                    maxlength="10"
                    required
                >

            </div>


            <div class="form-group">

                <label>
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    placeholder="Enter password"
                    required
                >

            </div>


            <button
                type="submit"
                class="primary-button full-button"
            >
                Login
            </button>

        </form>


        <p class="auth-footer">

            Don't have an account?

            <a href="/restaurant/signup">
                Create Restaurant Account
            </a>

        </p>


        <a
            href="/customer/login"
            class="back-link"
        >
            ← Customer Login
        </a>

    </div>

</div>
   <script src="/js/restaurant.js"></script>
</body>
</html>