<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Restaurant Signup</title>

    <link
        rel="stylesheet"
        href="/css/restaurant.css"
    >

</head>

<body class="auth-page">

<div class="auth-container">

    <div class="auth-card">

        <div class="auth-logo">
            🍽️
        </div>

        <span class="eyebrow">
            GHARSETU PARTNER
        </span>

        <h1>
            Create Restaurant Account
        </h1>

        <p class="auth-subtitle">
            Register your restaurant with GharSetu.
        </p>


        <!-- SIGNUP FORM -->

        <form
            action="/restaurant/signup"
            method="POST"
        >


            <!-- OWNER NAME -->

            <div class="form-group">

                <label>
                    Owner Name
                </label>

                <input
                    type="text"
                    name="name"
                    placeholder="Enter owner name"
                    required
                >

            </div>


            <!-- RESTAURANT NAME -->

            <div class="form-group">

                <label>
                    Restaurant Name
                </label>

                <input
                    type="text"
                    name="restaurantName"
                    placeholder="Enter restaurant name"
                    required
                >

            </div>


            <!-- MOBILE -->

            <div class="form-group">

                <label>
                    Mobile Number
                </label>

                <input
                    type="tel"
                    name="mobile"
                    placeholder="Enter 10-digit mobile"
                    maxlength="10"
                    pattern="[0-9]{10}"
                    required
                >

            </div>


            <!-- EMAIL -->

            <div class="form-group">

                <label>
                    Email
                </label>

                <input
                    type="email"
                    name="email"
                    placeholder="Enter restaurant email"
                    required
                >

            </div>


            <!-- ADDRESS -->

            <div class="form-group">

                <label>
                    Restaurant Address
                </label>

                <textarea
                    name="address"
                    placeholder="Enter restaurant address"
                    rows="3"
                    required
                ></textarea>

            </div>


            <!-- PASSWORD -->

            <div class="form-group">

                <label>
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    placeholder="Create password"
                    minlength="6"
                    required
                >

            </div>


            <!-- SUBMIT -->

            <button
                type="submit"
                class="primary-button full-button"
            >
                Create Restaurant Account
            </button>

        </form>


        <!-- LOGIN -->

        <p class="auth-footer">

            Already have an account?

            <a href="/restaurant/login">
                Login
            </a>

        </p>


        <!-- CUSTOMER LOGIN -->

        <a
            href="/customer/login"
            class="back-link"
        >
            ← Customer Login
        </a>

    </div>

</div>


<script src="/js/restaurant.js"></script>

</body>

</html>