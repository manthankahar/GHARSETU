<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Restaurant Signup</title>

    <link
        rel="stylesheet"
        href="/css/restaurant.css"
    >

</head>

<body class="auth-page">

<div class="auth-container">

    <div class="auth-card">

        <!-- LOGO -->

        <div class="auth-logo">
            🍽️
        </div>

        <span class="eyebrow">
            GHARSETU PARTNER
        </span>

        <h1>
            Create Restaurant Account
        </h1>

        <p class="auth-subtitle">
            Register your restaurant with GharSetu.
        </p>


        <!-- SIGNUP FORM -->

        <form
            action="/restaurant/signup"
            method="POST"
            id="restaurantSignupForm"
        >


            <!-- RESTAURANT NAME -->

            <div class="form-group">

                <label for="restaurantName">
                    Restaurant Name
                </label>

                <input
                    type="text"
                    id="restaurantName"
                    name="restaurantName"
                    placeholder="Enter restaurant name"
                    autocomplete="organization"
                    required
                >

            </div>


            <!-- OWNER NAME -->

            <div class="form-group">

                <label for="ownerName">
                    Owner Name
                </label>

                <input
                    type="text"
                    id="ownerName"
                    name="name"
                    placeholder="Enter owner name"
                    autocomplete="name"
                    required
                >

            </div>


            <!-- EMAIL / MOBILE -->

            <div class="form-group">

                <label for="contact">
                    Email / Mobile Number
                </label>

                <input
                    type="text"
                    id="contact"
                    name="contact"
                    placeholder="Enter email or mobile number"
                    autocomplete="email"
                    required
                >

                <small id="contactMessage">
                    Enter your email or 10-digit mobile number.
                </small>

            </div>


            <!-- SEND OTP -->

            <div class="otp-action">

                <button
                    type="button"
                    class="primary-button full-button"
                    id="sendOtpBtn"
                >
                    Send OTP
                </button>

            </div>


            <!-- OTP -->

            <div
                class="form-group otp-section"
                id="otpSection"
                style="display: none;"
            >

                <label for="otp">
                    Enter OTP
                </label>

                <input
                    type="text"
                    id="otp"
                    name="otp"
                    placeholder="Enter 6-digit OTP"
                    maxlength="6"
                    inputmode="numeric"
                    pattern="[0-9]{6}"
                    autocomplete="one-time-code"
                >

                <small id="otpMessage">
                    OTP sent successfully.
                </small>

            </div>


            <!-- VERIFY OTP -->

            <div
                class="otp-action"
                id="verifyOtpSection"
                style="display: none;"
            >

                <button
                    type="button"
                    class="primary-button full-button"
                    id="verifyOtpBtn"
                >
                    Verify OTP
                </button>

            </div>


            <!-- PASSWORD -->

            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Create password"
                    minlength="6"
                    autocomplete="new-password"
                    required
                >

            </div>


            <!-- CONFIRM PASSWORD -->

            <div class="form-group">

                <label for="confirmPassword">
                    Confirm Password
                </label>

                <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    placeholder="Confirm password"
                    minlength="6"
                    autocomplete="new-password"
                    required
                >

                <small id="passwordMessage"></small>

            </div>


            <!-- ADDRESS -->

            <div class="form-group">

                <label for="address">
                    Restaurant Address
                </label>

                <textarea
                    id="address"
                    name="address"
                    placeholder="Enter restaurant address"
                    rows="3"
                    required
                ></textarea>

            </div>


            <!-- CREATE ACCOUNT -->

            <button
                type="submit"
                class="primary-button full-button"
                id="createAccountBtn"
            >
                Create Restaurant Account
            </button>

        </form>


        <!-- LOGIN -->

        <p class="auth-footer">

            Already have an account?

            <a href="/restaurant/login">
                Login
            </a>

        </p>


        <!-- CUSTOMER LOGIN -->

        <a
            href="/customer/login"
            class="back-link"
        >
            ← Customer Login
        </a>

    </div>

</div>


<script src="/js/restaurant.js"></script>

</body>

</html>