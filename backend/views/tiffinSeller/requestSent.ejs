<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        GharSetu | Request Sent
    </title>

    <link
        rel="stylesheet"
        href="/css/tiffinSeller.css"
    >

</head>


<body>


<div class="seller-auth-page">


    <div class="seller-auth-card request-card">


        <div class="request-success-icon">
            ✓
        </div>


        <span class="seller-label">
            REGISTRATION REQUEST
        </span>


        <h1>
            Request Sent Successfully
        </h1>


        <p class="seller-subtitle">

            Thank you for registering with
            <strong>GharSetu</strong>.

        </p>


        <div class="request-message">

            <strong>
                We will connect you within 24 hours.
            </strong>

            <p>
                Our team will review your
                registration request and contact
                you shortly.
            </p>

        </div>


        <a
            href="/tiffin-seller/login"
            class="seller-primary-button"
        >
            Go To Login
        </a>


    </div>


</div>


</body>

</html>