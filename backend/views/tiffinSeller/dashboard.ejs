<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Tiffin Seller Dashboard</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f6fa;
            color: #222;
        }

        .dashboard {
            padding: 30px;
            max-width: 1400px;
            margin: auto;
        }

        .header {
            background: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        }

        .header h1 {
            margin-bottom: 8px;
        }

        .header p {
            color: #777;
        }

        .cards {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(210px, 1fr));

            gap: 20px;

            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 22px;
            border-radius: 15px;

            box-shadow:
                0 5px 20px rgba(0,0,0,0.06);
        }

        .card h3 {
            font-size: 15px;
            color: #777;
            margin-bottom: 12px;
        }

        .card .number {
            font-size: 30px;
            font-weight: bold;
        }

        .earning {
            border-left: 5px solid #16a085;
        }

        .active {
            border-left: 5px solid #27ae60;
        }

        .inactive {
            border-left: 5px solid #e74c3c;
        }

        .orders {
            border-left: 5px solid #3498db;
        }

        .new {
            border-left: 5px solid #f39c12;
        }

        .packed {
            border-left: 5px solid #9b59b6;
        }

        .dispatched {
            border-left: 5px solid #34495e;
        }

        .delivered {
            border-left: 5px solid #2ecc71;
        }

        .section {
            background: white;
            padding: 25px;
            border-radius: 15px;

            box-shadow:
                0 5px 20px rgba(0,0,0,0.06);
        }

        .section h2 {
            margin-bottom: 20px;
        }

        .order-table {
            width: 100%;
            border-collapse: collapse;
        }

        .order-table th,
        .order-table td {
            padding: 14px;
            border-bottom: 1px solid #eee;
            text-align: left;
        }

        .order-table th {
            color: #666;
            font-size: 14px;
        }

        .status {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            background: #eee;
            font-size: 12px;
        }

        .empty {
            text-align: center;
            padding: 30px;
            color: #888;
        }

        @media (max-width: 700px) {

            .dashboard {
                padding: 15px;
            }

            .order-table {
                display: block;
                overflow-x: auto;
            }

        }

    </style>

</head>


<body>


<div class="dashboard">


    <!-- ========================================= -->
    <!-- HEADER -->
    <!-- ========================================= -->

    <div class="header">

        <h1>
            Welcome,
            <%= seller.tiffinCompanyName %> 🍱
        </h1>

        <p>
            Tiffin Seller Dashboard
        </p>

    </div>


    <!-- ========================================= -->
    <!-- DASHBOARD CARDS -->
    <!-- ========================================= -->

    <div class="cards">


        <!-- EARNING -->

        <div class="card earning">

            <h3>
                💰 Total Earnings
            </h3>

            <div class="number">

                ₹<%= Number(totalEarning || 0).toFixed(2) %>

            </div>

        </div>


        <!-- ACTIVE PLANS -->

        <div class="card active">

            <h3>
                🟢 Active Plans
            </h3>

            <div class="number">

                <%= activePlans || 0 %>

            </div>

        </div>


        <!-- DEACTIVE PLANS -->

        <div class="card inactive">

            <h3>
                🔴 Deactive Plans
            </h3>

            <div class="number">

                <%= deactivePlans || 0 %>

            </div>

        </div>


        <!-- TOTAL ORDERS -->

        <div class="card orders">

            <h3>
                📦 Total Orders
            </h3>

            <div class="number">

                <%= totalOrders || 0 %>

            </div>

        </div>


        <!-- NEW -->

        <div class="card new">

            <h3>
                🆕 New Orders
            </h3>

            <div class="number">

                <%= newOrders || 0 %>

            </div>

        </div>


        <!-- PACKED -->

        <div class="card packed">

            <h3>
                📦 Packed
            </h3>

            <div class="number">

                <%= packedOrders || 0 %>

            </div>

        </div>


        <!-- DISPATCHED -->

        <div class="card dispatched">

            <h3>
                🚚 Dispatched
            </h3>

            <div class="number">

                <%= dispatchedOrders || 0 %>

            </div>

        </div>


        <!-- DELIVERED -->

        <div class="card delivered">

            <h3>
                ✅ Delivered
            </h3>

            <div class="number">

                <%= deliveredOrders || 0 %>

            </div>

        </div>


    </div>


    <!-- ========================================= -->
    <!-- RECENT ORDERS -->
    <!-- ========================================= -->

    <div class="section">

        <h2>
            📋 Recent Tiffin Orders
        </h2>


        <% if (
            recentOrders &&
            recentOrders.length > 0
        ) { %>


            <table class="order-table">

                <thead>

                    <tr>

                        <th>
                            Customer
                        </th>

                        <th>
                            Mobile
                        </th>

                        <th>
                            Amount
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Date
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <% recentOrders.forEach(order => { %>


                        <tr>

                            <td>

                                <%= order.customer?.name || "Customer" %>

                            </td>


                            <td>

                                <%= order.customer?.mobile || "-" %>

                            </td>


                            <td>

                                ₹<%= Number(
                                    order.amount || 0
                                ).toFixed(2) %>

                            </td>


                            <td>

                                <span class="status">

                                    <%= order.status || "new" %>

                                </span>

                            </td>


                            <td>

                                <%= order.createdAt
                                    ? new Date(
                                        order.createdAt
                                    ).toLocaleDateString()
                                    : "-"
                                %>

                            </td>

                        </tr>


                    <% }); %>


                </tbody>

            </table>


        <% } else { %>


            <div class="empty">

                No tiffin orders found yet 📦

            </div>


        <% } %>


    </div>


</div>


</body>

</html>