<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Tiffin Seller Registration</title>

    <link
        rel="stylesheet"
        href="/css/tiffinSeller.css"
    >

</head>


<body>


<div class="seller-auth-page">


    <div class="seller-auth-card">


        <div class="seller-logo">
            🍱
        </div>


        <span class="seller-label">
            GHARSETU TIFFIN PARTNER
        </span>


        <h1>
            Register Your Tiffin Business
        </h1>


        <p class="seller-subtitle">
            Join GharSetu and start selling your
            tiffin plans online.
        </p>


        <% if (typeof error !== "undefined" && error) { %>

            <div class="seller-error">
                <%= error %>
            </div>

        <% } %>


        <form
            action="/tiffin-seller/register"
            method="POST"
        >


            <label>
                Mobile Number
            </label>

            <input
                type="tel"
                name="mobile"
                placeholder="Enter mobile number"
                maxlength="10"
                required
            >


            <label>
                Password
            </label>

            <input
                type="password"
                name="password"
                placeholder="Create password"
                required
            >


            <label>
                Tiffin Company Name
            </label>

            <input
                type="text"
                name="tiffinCompanyName"
                placeholder="Enter company name"
                required
            >


            <label>
                Business Address
            </label>

            <textarea
                name="address"
                placeholder="Enter complete business address"
                rows="4"
                required
            ></textarea>


            <button
                type="submit"
                class="seller-primary-button"
            >
                Send Registration Request
            </button>


        </form>


        <p class="seller-bottom">

            Already registered?

            <a href="/tiffin-seller/login">
                Login
            </a>

        </p>


    </div>


</div>


</body>

</html>