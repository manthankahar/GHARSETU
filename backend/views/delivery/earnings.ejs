<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Earnings</title>

    <link
        rel="stylesheet"
        href="/css/delivery.css"
    >

</head>

<body>

    <div class="delivery-layout">

        <!-- SIDEBAR -->
        <%- include("../partials/sidebar") %>


        <!-- MAIN -->
        <main class="delivery-main">


            <!-- ============================== -->
            <!-- PAGE HEADER -->
            <!-- ============================== -->

            <header class="page-header">

                <div>

                    <span class="eyebrow">
                        MONEY
                    </span>

                    <h1>
                        Earnings
                    </h1>

                    <p>
                        Track your delivery earnings
                    </p>

                </div>

            </header>



            <!-- ============================== -->
            <!-- TOTAL EARNINGS -->
            <!-- ============================== -->

            <div class="earning-main-card">

                <span>
                    Total Earnings
                </span>

                <h2>
                    ₹<%= Number(totalEarnings || 0).toFixed(2) %>
                </h2>

                <p>
                    From completed deliveries
                </p>

            </div>



            <!-- ============================== -->
            <!-- EARNINGS HISTORY -->
            <!-- ============================== -->

            <section class="dashboard-section">

                <div class="section-heading">

                    <div>

                        <span class="eyebrow">
                            TRANSACTIONS
                        </span>

                        <h2>
                            Earnings History
                        </h2>

                    </div>

                    <span class="history-count">
                        <%= orders ? orders.length : 0 %>
                        Deliveries
                    </span>

                </div>



                <!-- ============================== -->
                <!-- EMPTY -->
                <!-- ============================== -->

                <% if (!orders || orders.length === 0) { %>

                    <div class="empty-card">

                        <div class="empty-icon">
                            💰
                        </div>

                        <h3>
                            No earnings yet
                        </h3>

                        <p>
                            Complete deliveries to start
                            earning money.
                        </p>

                    </div>

                <% } else { %>


                    <!-- ============================== -->
                    <!-- EARNING LIST -->
                    <!-- ============================== -->

                    <div class="history-list">

                        <% orders.forEach(order => { %>

                            <div class="history-card">


                                <!-- LEFT -->
                                <div class="history-info">

                                    <span class="order-id">
                                        ORDER #<%= order.id %>
                                    </span>

                                    <h3>
                                        <%= order.item %>
                                    </h3>

                                    <p class="delivery-route">

                                        <span>
                                            📍
                                            <%= order.pickup %>
                                        </span>

                                        <span class="route-arrow">
                                            →
                                        </span>

                                        <span>
                                            🏠
                                            <%= order.customer %>
                                        </span>

                                    </p>

                                </div>


                                <!-- RIGHT -->
                                <div class="history-right">

                                    <strong class="earning-green">

                                        +
                                        ₹<%= Number(order.amount || 0).toFixed(2) %>

                                    </strong>

                                    <span class="success-text">
                                        ✓ Completed
                                    </span>

                                </div>


                            </div>

                        <% }); %>

                    </div>

                <% } %>


            </section>



            <!-- ============================== -->
            <!-- FOOTER -->
            <!-- ============================== -->

            <%- include("../partials/footer") %>


        </main>

    </div>


    <!-- DELIVERY JS -->
    <script src="/js/delivery.js"></script>

</body>

</html>