<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Delivery Signup</title>

    <link
        rel="stylesheet"
        href="/css/delivery.css"
    >

</head>

<body class="auth-body">

    <main class="auth-container">

        <div class="auth-card">

            <div class="auth-logo">
                🚴
            </div>

            <h1>Join GharSetu</h1>

            <p class="auth-subtitle">
                Become a Delivery Partner
            </p>

            <form id="deliverySignupForm">

                <label>
                    Full Name
                </label>

                <input
                    type="text"
                    id="signupName"
                    placeholder="Enter full name"
                    required
                >

                <label>
                    Mobile Number
                </label>

                <input
                    type="tel"
                    id="signupMobile"
                    placeholder="10 digit mobile number"
                    maxlength="10"
                    required
                >

                <label>
                    Email
                </label>

                <input
                    type="email"
                    id="signupEmail"
                    placeholder="Enter email"
                    required
                >

                <label>
                    Password
                </label>

                <input
                    type="password"
                    id="signupPassword"
                    placeholder="Create password"
                    required
                >

                <button
                    type="submit"
                    class="primary-button"
                >
                    Create Account
                </button>

            </form>

            <p class="auth-bottom">

                Already registered?

                <a href="/delivery/login">
                    Login
                </a>

            </p>

        </div>

    </main>

    <script src="/js/delivery.js"></script>

</body>

</html>