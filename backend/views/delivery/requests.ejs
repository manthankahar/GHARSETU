<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Requests</title>

    <link
        rel="stylesheet"
        href="/css/delivery.css"
    >
</head>


<body>

    <div class="delivery-layout">

        <!-- DELIVERY SIDEBAR -->
        <%- include("../partials/sidebar") %>


        <!-- MAIN CONTENT -->
        <main class="delivery-main">


            <!-- ============================= -->
            <!-- HEADER -->
            <!-- ============================= -->

            <header class="page-header">

                <div>

                    <span class="eyebrow">
                        NEW
                    </span>

                    <h1>
                        Delivery Requests
                    </h1>

                    <p>
                        New orders waiting for delivery
                    </p>

                </div>

            </header>



            <!-- ============================= -->
            <!-- REQUESTS -->
            <!-- ============================= -->

            <section class="dashboard-section">


                <% if (!deliveries || deliveries.length === 0) { %>

                    <div class="empty-card">

                        <div>
                            📦
                        </div>

                        <h3>
                            No new requests
                        </h3>

                        <p>
                            New delivery requests will appear here.
                        </p>

                    </div>

                <% } else { %>


                    <% deliveries.forEach(delivery => { %>

                        <article
                            class="request-card"
                            id="request-<%= delivery._id %>"
                        >


                            <!-- ============================= -->
                            <!-- TOP -->
                            <!-- ============================= -->

                            <div class="request-top">

                                <div>

                                    <span class="order-id">

                                        DELIVERY #

                                        <%= delivery._id %>

                                    </span>


                                    <h2>

                                        <%= delivery.order?.item ||
                                            delivery.order?.title ||
                                            delivery.order?.name ||
                                            "Food Order" %>

                                    </h2>

                                </div>


                                <strong>

                                    ₹<%= Number(
                                        delivery.orderAmount ||
                                        delivery.order?.amount ||
                                        delivery.order?.totalAmount ||
                                        0
                                    ) %>

                                </strong>

                            </div>



                            <!-- ============================= -->
                            <!-- ROUTE -->
                            <!-- ============================= -->

                            <div class="route-box">


                                <p>

                                    📍

                                    <strong>
                                        Pickup:
                                    </strong>

                                    <%= delivery.order?.pickup ||
                                        delivery.order?.restaurant ||
                                        delivery.order?.restaurantName ||
                                        "Restaurant" %>

                                </p>



                                <p>

                                    🏠

                                    <strong>
                                        Customer:
                                    </strong>

                                    <%= delivery.order?.customer ||
                                        delivery.order?.customerName ||
                                        delivery.order?.deliveryAddress ||
                                        delivery.order?.address ||
                                        "Customer Location" %>

                                </p>


                            </div>



                            <!-- ============================= -->
                            <!-- STATUS -->
                            <!-- ============================= -->

                            <div class="request-status">

                                <span>
                                    🟡 New Delivery Request
                                </span>

                            </div>



                            <!-- ============================= -->
                            <!-- ACTIONS -->
                            <!-- ============================= -->

                            <div class="request-actions">


                                <button
                                    type="button"
                                    class="primary-button"
                                    onclick="acceptDelivery('<%= delivery._id %>', this)"
                                >
                                    ✓ Accept Order
                                </button>


                                <button
                                    type="button"
                                    class="secondary-button"
                                    onclick="rejectDelivery('<%= delivery._id %>', this)"
                                >
                                    Reject
                                </button>


                            </div>


                        </article>

                    <% }); %>

                <% } %>


            </section>


            <!-- FOOTER -->

            <%- include("../partials/footer") %>


        </main>

    </div>



    <!-- ============================= -->
    <!-- REQUEST FUNCTIONS -->
    <!-- ============================= -->

    <script>

        // =========================================
        // ACCEPT DELIVERY
        // =========================================

        async function acceptDelivery(id, button) {

            try {

                if (!id) {

                    alert("Delivery ID not found");

                    return;
                }


                // Disable button

                button.disabled = true;

                button.innerText = "Accepting...";


                const response = await fetch(
                    "/delivery/" + id + "/accept",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        }
                    }
                );


                const data = await response.json();


                if (!response.ok || !data.success) {

                    alert(
                        data.message ||
                        "Failed to accept delivery"
                    );

                    button.disabled = false;

                    button.innerText =
                        "✓ Accept Order";

                    return;
                }


                // SUCCESS

                alert(
                    "✅ Delivery accepted successfully!"
                );


                // Go to Active Delivery

                window.location.href =
                    "/delivery/active";


            } catch (error) {

                console.error(
                    "Accept Delivery Error:",
                    error
                );


                alert(
                    "Something went wrong while accepting delivery."
                );


                button.disabled = false;

                button.innerText =
                    "✓ Accept Order";
            }

        }



        // =========================================
        // REJECT DELIVERY
        // =========================================

        async function rejectDelivery(id, button) {

            try {

                if (!id) {

                    alert("Delivery ID not found");

                    return;
                }


                const confirmReject =
                    confirm(
                        "Are you sure you want to reject this delivery?"
                    );


                if (!confirmReject) {

                    return;
                }


                button.disabled = true;

                button.innerText =
                    "Rejecting...";


                const response = await fetch(
                    "/delivery/" + id + "/reject",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        }
                    }
                );


                const data =
                    await response.json();


                if (!response.ok || !data.success) {

                    alert(
                        data.message ||
                        "Failed to reject delivery"
                    );


                    button.disabled = false;

                    button.innerText =
                        "Reject";

                    return;
                }


                // Remove card from page

                const card =
                    document.getElementById(
                        "request-" + id
                    );


                if (card) {

                    card.remove();

                }


                alert(
                    "❌ Delivery rejected"
                );


                // If no requests remain,
                // reload page

                const remainingCards =
                    document.querySelectorAll(
                        ".request-card"
                    );


                if (remainingCards.length === 0) {

                    window.location.reload();

                }


            } catch (error) {

                console.error(
                    "Reject Delivery Error:",
                    error
                );


                alert(
                    "Something went wrong while rejecting delivery."
                );


                button.disabled = false;

                button.innerText =
                    "Reject";
            }

        }

    </script>


</body>

</html>