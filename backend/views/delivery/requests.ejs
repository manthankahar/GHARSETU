<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Requests</title>

    <link
        rel="stylesheet"
        href="/css/delivery.css"
    >

</head>


<body>

    <div class="delivery-layout">

        <%- include("../partials/sidebar") %>


        <main class="delivery-main">


            <!-- ============================= -->
            <!-- HEADER -->
            <!-- ============================= -->

            <header class="page-header">

                <div>

                    <span class="eyebrow">
                        NEW
                    </span>

                    <h1>
                        Delivery Requests
                    </h1>

                    <p>
                        New orders waiting for delivery
                    </p>

                </div>

            </header>



            <!-- ============================= -->
            <!-- REQUESTS -->
            <!-- ============================= -->

            <section class="dashboard-section">


                <% if (!deliveries || deliveries.length === 0) { %>

                    <div class="empty-card">

                        <div>
                            📦
                        </div>

                        <h3>
                            No new requests
                        </h3>

                        <p>
                            New delivery requests will appear here.
                        </p>

                    </div>

                <% } %>



                <% deliveries.forEach(delivery => { %>

                    <article class="request-card">


                        <!-- ============================= -->
                        <!-- TOP -->
                        <!-- ============================= -->

                        <div class="request-top">

                            <div>

                                <span class="order-id">

                                    DELIVERY #

                                    <%= delivery._id %>

                                </span>


                                <h2>

                                    <%= delivery.order?.item ||
                                        delivery.order?.title ||
                                        "Food Order" %>

                                </h2>

                            </div>


                            <strong>

                                ₹<%= delivery.orderAmount ||
                                    delivery.order?.amount ||
                                    0 %>

                            </strong>

                        </div>



                        <!-- ============================= -->
                        <!-- ROUTE -->
                        <!-- ============================= -->

                        <div class="route-box">


                            <p>

                                📍

                                <strong>
                                    Pickup:
                                </strong>

                                <%= delivery.order?.pickup ||
                                    delivery.order?.restaurant ||
                                    delivery.order?.restaurantName ||
                                    "Restaurant" %>

                            </p>



                            <p>

                                🏠

                                <strong>
                                    Customer:
                                </strong>

                                <%= delivery.order?.customer ||
                                    delivery.order?.customerName ||
                                    delivery.order?.address ||
                                    "Customer Location" %>

                            </p>


                        </div>



                        <!-- ============================= -->
                        <!-- ACTIONS -->
                        <!-- ============================= -->

                        <div class="request-actions">


                            <button
                                type="button"
                                class="primary-button"
                                onclick="acceptDelivery('<%= delivery._id %>')"
                            >

                                ✓ Accept Order

                            </button>



                            <button
                                type="button"
                                class="secondary-button"
                                onclick="rejectDelivery('<%= delivery._id %>')"
                            >

                                Reject

                            </button>


                        </div>


                    </article>

                <% }); %>


            </section>



            <%- include("../partials/footer") %>


        </main>

    </div>


    <script src="/js/delivery.js"></script>


</body>

</html>