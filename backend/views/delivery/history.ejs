<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Delivery History</title>

    <link
        rel="stylesheet"
        href="/css/delivery.css"
    >

</head>

<body>

    <div class="delivery-layout">

        <!-- SIDEBAR -->
        <%- include("../partials/sidebar") %>


        <!-- MAIN CONTENT -->
        <main class="delivery-main">

            <!-- HEADER -->
            <header class="page-header">

                <div>

                    <span class="eyebrow">
                        DELIVERY PARTNER
                    </span>

                    <h1>
                        Delivery History
                    </h1>

                    <p>
                        Your completed deliveries
                    </p>

                </div>

            </header>


            <!-- HISTORY SECTION -->
            <section class="dashboard-section">


                <!-- ============================= -->
                <!-- EMPTY STATE -->
                <!-- ============================= -->

                <% if (!orders || orders.length === 0) { %>

                    <div class="empty-card">

                        <div class="empty-icon">
                            📦
                        </div>

                        <h3>
                            No completed deliveries
                        </h3>

                        <p>
                            Your completed delivery history
                            will appear here.
                        </p>

                    </div>

                <% } else { %>


                    <!-- ============================= -->
                    <!-- HISTORY COUNT -->
                    <!-- ============================= -->

                    <div class="history-summary">

                        <div>

                            <span class="summary-label">
                                COMPLETED DELIVERIES
                            </span>

                            <strong>
                                <%= orders.length %>
                            </strong>

                        </div>

                    </div>


                    <!-- ============================= -->
                    <!-- HISTORY LIST -->
                    <!-- ============================= -->

                    <div class="history-list">

                        <% orders.forEach(order => { %>

                            <div class="history-card">


                                <!-- LEFT -->
                                <div class="history-info">

                                    <span class="order-id">
                                        ORDER #<%= order.id %>
                                    </span>


                                    <h3>
                                        <%= order.item %>
                                    </h3>


                                    <p class="delivery-route">

                                        <span>
                                            📍
                                            <%= order.pickup %>
                                        </span>

                                        <span class="route-arrow">
                                            →
                                        </span>

                                        <span>
                                            🏠
                                            <%= order.customer %>
                                        </span>

                                    </p>


                                    <% if (order.pickupArea) { %>

                                        <p class="location-text">
                                            Pickup:
                                            <%= order.pickupArea %>
                                        </p>

                                    <% } %>


                                    <% if (order.dropArea) { %>

                                        <p class="location-text">
                                            Drop:
                                            <%= order.dropArea %>
                                        </p>

                                    <% } %>

                                </div>


                                <!-- RIGHT -->
                                <div class="history-right">


                                    <strong class="history-amount">
                                        ₹<%= Number(order.amount || 0).toFixed(2) %>
                                    </strong>


                                    <span class="success-text">
                                        ✓ Delivered
                                    </span>


                                    <span class="history-status">
                                        Completed
                                    </span>

                                </div>


                            </div>

                        <% }); %>

                    </div>

                <% } %>


            </section>


            <!-- FOOTER -->
            <%- include("../partials/footer") %>


        </main>

    </div>


    <!-- DELIVERY JAVASCRIPT -->
    <script src="/js/delivery.js"></script>

</body>

</html>