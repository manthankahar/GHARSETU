<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GHARSETU | Complete Delivery</title>

    <link
        rel="stylesheet"
        href="/css/delivery.css"
    >

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #222;
        }

        .complete-page {
            max-width: 650px;
            margin: 0 auto;
            padding: 20px;
        }

        .complete-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .back-btn {
            width: 42px;
            height: 42px;
            border: none;
            border-radius: 50%;
            background: #ffffff;
            font-size: 20px;
            cursor: pointer;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .complete-header h1 {
            margin: 0;
            font-size: 24px;
        }

        .complete-header p {
            margin: 4px 0 0;
            color: #777;
            font-size: 14px;
        }

        .card {
            background: #ffffff;
            border-radius: 18px;
            padding: 20px;
            margin-bottom: 18px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.07);
        }

        .success-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 15px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8f8ee;
            font-size: 35px;
        }

        .ready-title {
            text-align: center;
            margin: 0;
            font-size: 22px;
        }

        .ready-text {
            text-align: center;
            color: #777;
            margin: 8px 0 0;
        }

        .order-info {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 13px 0;
            border-bottom: 1px solid #eeeeee;
        }

        .order-info:last-child {
            border-bottom: none;
        }

        .info-label {
            color: #777;
            font-size: 14px;
        }

        .info-value {
            font-weight: 600;
            text-align: right;
        }

        .amount-box {
            text-align: center;
            padding: 10px 0 5px;
        }

        .amount-label {
            color: #777;
            font-size: 14px;
        }

        .payment-amount {
            margin: 7px 0 0;
            font-size: 32px;
        }

        .payment-amount strong {
            font-weight: 700;
        }

        .section-title {
            margin: 0 0 15px;
            font-size: 18px;
        }

        .payment-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .payment-btn {
            border: 2px solid #e4e7ec;
            background: #ffffff;
            border-radius: 14px;
            padding: 18px 10px;
            cursor: pointer;
            text-align: center;
            transition: 0.2s;
        }

        .payment-btn:hover {
            transform: translateY(-2px);
        }

        .payment-btn.selected {
            border-color: #222;
            background: #f2f4f7;
        }

        .payment-icon {
            display: block;
            font-size: 28px;
            margin-bottom: 7px;
        }

        .payment-name {
            display: block;
            font-weight: 700;
            font-size: 15px;
        }

        .payment-description {
            display: block;
            color: #777;
            font-size: 12px;
            margin-top: 5px;
        }

        #demoQrBox {
            display: none;
            margin-top: 18px;
            padding: 18px;
            text-align: center;
            background: #f7f8fa;
            border-radius: 14px;
        }

        .qr-placeholder {
            width: 150px;
            height: 150px;
            margin: 0 auto 12px;
            background:
                linear-gradient(45deg, #111 25%, transparent 25%),
                linear-gradient(-45deg, #111 25%, transparent 25%),
                linear-gradient(45deg, transparent 75%, #111 75%),
                linear-gradient(-45deg, transparent 75%, #111 75%);
            background-size: 30px 30px;
            background-position:
                0 0,
                0 15px,
                15px -15px,
                -15px 0;
            border: 8px solid #ffffff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .qr-title {
            font-weight: 700;
            margin: 0;
        }

        .qr-text {
            color: #777;
            font-size: 13px;
            margin: 5px 0 0;
        }

        .complete-btn {
            width: 100%;
            border: none;
            border-radius: 14px;
            padding: 16px;
            font-size: 17px;
            font-weight: 700;
            cursor: pointer;
            background: #222;
            color: #ffffff;
            margin-top: 8px;
        }

        .complete-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .note {
            text-align: center;
            color: #888;
            font-size: 12px;
            line-height: 1.5;
            margin-top: 15px;
        }

        /* =================================
           SUCCESS POPUP
        ================================= */

        .success-popup {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.55);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;

            opacity: 0;
            visibility: hidden;
            pointer-events: none;

            transition: 0.25s;
            z-index: 9999;
        }

        .success-popup.show {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .success-popup-card {
            width: 100%;
            max-width: 430px;
            background: #ffffff;
            border-radius: 22px;
            padding: 28px 22px;
            text-align: center;
            box-shadow: 0 15px 50px rgba(0,0,0,0.2);
        }

        .popup-icon {
            width: 75px;
            height: 75px;
            margin: 0 auto 15px;
            border-radius: 50%;
            background: #e8f8ee;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 38px;
        }

        .success-popup-card h2 {
            margin: 0;
            font-size: 24px;
        }

        .success-popup-card p {
            color: #777;
            line-height: 1.5;
        }

        .earning-box {
            background: #f6f7f9;
            border-radius: 15px;
            padding: 15px;
            margin: 18px 0;
        }

        .earning-label {
            display: block;
            color: #777;
            font-size: 13px;
        }

        #successEarning {
            display: block;
            margin-top: 5px;
            font-size: 30px;
            font-weight: 700;
        }

        #successPaymentText {
            font-size: 13px;
        }

        .close-popup-btn {
            width: 100%;
            border: none;
            border-radius: 13px;
            padding: 14px;
            background: #222;
            color: #ffffff;
            font-weight: 700;
            font-size: 15px;
            cursor: pointer;
        }

        @media (max-width: 500px) {

            .complete-page {
                padding: 14px;
            }

            .payment-options {
                grid-template-columns: 1fr;
            }

            .complete-header h1 {
                font-size: 21px;
            }

        }

    </style>

</head>


<body>


<!-- =========================================
     COMPLETE DELIVERY PAGE
========================================= -->

<main class="complete-page">


    <!-- HEADER -->

    <div class="complete-header">

        <button
            class="back-btn"
            onclick="history.back()"
        >
            ←
        </button>

        <div>

            <h1>
                Complete Delivery
            </h1>

            <p>
                Collect payment and finish the order
            </p>

        </div>

    </div>


    <!-- =====================================
         SUCCESS / READY CARD
    ====================================== -->

    <section class="card">

        <div class="success-icon">
            📦
        </div>

        <h2 class="ready-title">
            Ready to Complete
        </h2>

        <p class="ready-text">
            You have reached the customer's location.
        </p>

    </section>


    <!-- =====================================
         ORDER DETAILS
    ====================================== -->

    <section class="card">

        <h3 class="section-title">
            Order Details
        </h3>


        <div class="order-info">

            <span class="info-label">
                Customer
            </span>

            <span class="info-value">

                <%= delivery?.order?.customerName ||
                    delivery?.order?.customer ||
                    "Customer" %>

            </span>

        </div>


        <div class="order-info">

            <span class="info-label">
                Order
            </span>

            <span class="info-value">

                <%= delivery?.order?.item ||
                    delivery?.order?.name ||
                    delivery?.order?.title ||
                    "Delivery Order" %>

            </span>

        </div>


        <div class="order-info">

            <span class="info-label">
                Delivery Status
            </span>

            <span class="info-value">
                Reached Location
            </span>

        </div>


    </section>


    <!-- =====================================
         PAYMENT AMOUNT
    ====================================== -->

    <section class="card">

        <div class="amount-box">

            <div class="amount-label">
                Amount to Collect
            </div>

            <div class="payment-amount">

                ₹<strong>

                    <%= Number(
                        delivery?.orderAmount ||
                        delivery?.order?.amount ||
                        delivery?.order?.totalAmount ||
                        0
                    ) %>

                </strong>

            </div>

        </div>

    </section>


    <!-- =====================================
         PAYMENT METHOD
    ====================================== -->

    <section class="card">

        <h3 class="section-title">
            Select Payment Method
        </h3>


        <div class="payment-options">


            <!-- CASH -->

            <button
                type="button"
                id="cashPaymentBtn"
                class="payment-btn"
                onclick="selectPayment('cash')"
            >

                <span class="payment-icon">
                    💵
                </span>

                <span class="payment-name">
                    Cash
                </span>

                <span class="payment-description">
                    Customer pays cash
                </span>

            </button>


            <!-- ONLINE -->

            <button
                type="button"
                id="onlinePaymentBtn"
                class="payment-btn"
                onclick="selectPayment('online')"
            >

                <span class="payment-icon">
                    📱
                </span>

                <span class="payment-name">
                    Online
                </span>

                <span class="payment-description">
                    UPI / QR payment
                </span>

            </button>


        </div>


        <!-- =================================
             DEMO QR
        ================================== -->

        <div id="demoQrBox">

            <div class="qr-placeholder"></div>

            <p class="qr-title">
                Scan to Pay
            </p>

            <p class="qr-text">
                Demo QR for online payment
            </p>

        </div>


    </section>


    <!-- =====================================
         COMPLETE BUTTON
    ====================================== -->

    <section class="card">

        <button
            type="button"
            id="completeDeliveryBtn"
            class="complete-btn"
            disabled
            onclick="completeDelivery('<%= delivery._id %>')"
        >

            ✅ Complete Delivery

        </button>


        <p class="note">

            Please confirm the payment method before
            completing the delivery.

        </p>

    </section>


</main>



<!-- =========================================
     DELIVERY SUCCESS POPUP
========================================= -->

<div
    id="deliverySuccessPopup"
    class="success-popup"
>

    <div class="success-popup-card">


        <div class="popup-icon">
            🎉
        </div>


        <h2>
            Delivery Completed!
        </h2>


        <p>
            Great job! The delivery has been
            successfully completed.
        </p>


        <div class="earning-box">

            <span class="earning-label">
                Your Earning
            </span>

            <span id="successEarning">
                ₹0
            </span>

        </div>


        <p id="successPaymentText">
            Payment processed successfully.
        </p>


        <button
            type="button"
            class="close-popup-btn"
            onclick="closeDeliverySuccess()"
        >

            Go to Dashboard

        </button>


    </div>

</div>



<!-- =========================================
     JAVASCRIPT
========================================= -->

<script src="/js/delivery.js"></script>


</body>

</html>