<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Profile</title>

    <link
        rel="stylesheet"
        href="/css/delivery.css"
    >

</head>

<body>

    <div class="delivery-layout">

        <!-- ========================= -->
        <!-- SIDEBAR -->
        <!-- ========================= -->

        <%- include("../partials/sidebar") %>


        <!-- ========================= -->
        <!-- MAIN -->
        <!-- ========================= -->

        <main class="delivery-main">


            <!-- ========================= -->
            <!-- HEADER -->
            <!-- ========================= -->

            <header class="page-header">

                <div>

                    <span class="eyebrow">
                        ACCOUNT
                    </span>

                    <h1>
                        Profile
                    </h1>

                    <p>
                        Manage your delivery partner profile
                    </p>

                </div>

            </header>



            <!-- ========================= -->
            <!-- PROFILE -->
            <!-- ========================= -->

            <section class="profile-card">

                <div class="large-profile-circle">

                    <%= (user?.name || "D")
                        .charAt(0)
                        .toUpperCase()
                    %>

                </div>


                <h2>

                    <%= user?.name || "Delivery Partner" %>

                </h2>


                <span class="profile-role">

                    <%= user?.role || "Delivery Partner" %>

                </span>


                <span
                    class="profile-online"
                    id="profileOnlineStatus"
                >

                    ● Online

                </span>

            </section>



            <!-- ========================= -->
            <!-- PROFILE INFORMATION -->
            <!-- ========================= -->

            <section class="profile-info-card">


                <!-- MOBILE -->

                <div class="profile-row">

                    <span>
                        📱
                    </span>

                    <div>

                        <small>
                            Mobile Number
                        </small>

                        <strong>

                            <%= user?.mobile ||
                                "Not available"
                            %>

                        </strong>

                    </div>

                </div>



                <!-- EMAIL -->

                <div class="profile-row">

                    <span>
                        📧
                    </span>

                    <div>

                        <small>
                            Email
                        </small>

                        <strong>

                            <%= user?.email ||
                                "Not available"
                            %>

                        </strong>

                    </div>

                </div>



                <!-- ADDRESS -->

                <div class="profile-row">

                    <span>
                        📍
                    </span>

                    <div>

                        <small>
                            Address
                        </small>

                        <strong>

                            <%= user?.address ||
                                "Address not added"
                            %>

                        </strong>

                    </div>

                </div>


            </section>



            <!-- ========================= -->
            <!-- EDIT PROFILE -->
            <!-- ========================= -->

            <button
                type="button"
                class="primary-button profile-edit-button"
                onclick="editDeliveryProfile()"
            >

                ✏️ Edit Profile

            </button>



            <!-- ========================= -->
            <!-- SUPPORT -->
            <!-- ========================= -->

            <section class="profile-info-card support-card">

                <div class="profile-row">

                    <span>
                        🆘
                    </span>

                    <div>

                        <small>
                            Need Help?
                        </small>

                        <strong>
                            Delivery Partner Support
                        </strong>

                    </div>

                </div>



                <div class="support-actions">


                    <!-- CALL SUPPORT -->

                    <button
                        type="button"
                        class="primary-small-button"
                        onclick="callDeliverySupport()"
                    >

                        📞 Call Support

                    </button>



                    <!-- COMPLAINT -->

                    <button
                        type="button"
                        class="secondary-button"
                        onclick="openComplaintPage()"
                    >

                        📝 Register Complaint

                    </button>


                </div>

            </section>



            <!-- ========================= -->
            <!-- LOGOUT -->
            <!-- ========================= -->

            <button
                type="button"
                class="logout-button"
                onclick="deliveryLogout()"
            >

                🚪 Logout

            </button>



            <!-- ========================= -->
            <!-- FOOTER -->
            <!-- ========================= -->

            <%- include("../partials/footer") %>


        </main>

    </div>



    <!-- ========================= -->
    <!-- DELIVERY JAVASCRIPT -->
    <!-- ========================= -->

    <script src="/js/delivery.js"></script>


</body>

</html>