<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Ratings</title>

    <link
        rel="stylesheet"
        href="/css/delivery.css"
    >

</head>

<body>

    <div class="delivery-layout">

        <!-- SIDEBAR -->
        <%- include("../partials/sidebar") %>


        <!-- MAIN CONTENT -->
        <main class="delivery-main">


            <!-- ============================== -->
            <!-- PAGE HEADER -->
            <!-- ============================== -->

            <header class="page-header">

                <div>

                    <span class="eyebrow">
                        FEEDBACK
                    </span>

                    <h1>
                        Ratings
                    </h1>

                    <p>
                        See your customer feedback
                    </p>

                </div>

            </header>



            <!-- ============================== -->
            <!-- RATING SUMMARY -->
            <!-- ============================== -->

            <section class="rating-summary">

                <div class="rating-number">

                    <%= Number(rating || 0).toFixed(1) %>

                </div>


                <div>

                    <div class="stars">
                        ★★★★★
                    </div>

                    <p>

                        Based on
                        <%= totalRatings || 0 %>
                        customer ratings

                    </p>

                </div>

            </section>



            <!-- ============================== -->
            <!-- CUSTOMER FEEDBACK -->
            <!-- ============================== -->

            <section class="dashboard-section">

                <div class="section-heading">

                    <div>

                        <span class="eyebrow">
                            CUSTOMER FEEDBACK
                        </span>

                        <h2>
                            Recent Reviews
                        </h2>

                    </div>

                    <span class="history-count">

                        <%= totalRatings || 0 %>
                        Ratings

                    </span>

                </div>



                <!-- ============================== -->
                <!-- NO RATINGS -->
                <!-- ============================== -->

                <% if (!ratings || ratings.length === 0) { %>

                    <div class="empty-card">

                        <div class="empty-icon">
                            ⭐
                        </div>

                        <h3>
                            No ratings yet
                        </h3>

                        <p>
                            Customer ratings will appear here
                            after completed deliveries.
                        </p>

                    </div>

                <% } else { %>


                    <!-- ============================== -->
                    <!-- RATINGS LIST -->
                    <!-- ============================== -->

                    <div class="feedback-list">

                        <% ratings.forEach(item => { %>

                            <div class="feedback-card">

                                <div class="feedback-header">

                                    <strong>
                                        <%= item.customerName || "Customer" %>
                                    </strong>

                                    <span>

                                        <%
                                            const userRating =
                                                Number(item.rating || 0);

                                            const fullStars =
                                                Math.max(
                                                    0,
                                                    Math.min(
                                                        5,
                                                        Math.round(userRating)
                                                    )
                                                );
                                        %>

                                        <%= "★".repeat(fullStars) %>

                                    </span>

                                </div>


                                <p>

                                    <%= item.comment ||
                                        "No written feedback provided." %>

                                </p>


                                <% if (item.createdAt) { %>

                                    <small>

                                        <%= new Date(
                                            item.createdAt
                                        ).toLocaleDateString() %>

                                    </small>

                                <% } %>

                            </div>

                        <% }); %>

                    </div>

                <% } %>


            </section>



            <!-- ============================== -->
            <!-- FOOTER -->
            <!-- ============================== -->

            <%- include("../partials/footer") %>


        </main>

    </div>


    <!-- DELIVERY JAVASCRIPT -->
    <script src="/js/delivery.js"></script>

</body>

</html>