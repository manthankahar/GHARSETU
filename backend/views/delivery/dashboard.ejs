<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Delivery Dashboard</title>

    <link
        rel="stylesheet"
        href="/css/delivery.css"
    >

</head>


<body>

    <div class="delivery-layout">

        <%- include("../partials/deliverySidebar") %>


        <main class="delivery-main">


            <!-- ============================= -->
            <!-- HEADER -->
            <!-- ============================= -->

            <header class="page-header">

                <div>

                    <span class="eyebrow">
                        DELIVERY PARTNER
                    </span>

                    <h1>
                        Dashboard
                    </h1>

                    <p>
                        Welcome back 👋
                    </p>

                </div>


                <div class="header-profile">
                    K
                </div>

            </header>



            <!-- ============================= -->
            <!-- ONLINE / OFFLINE -->
            <!-- ============================= -->

            <section class="status-card">

                <div>

                    <span>
                        Delivery Status
                    </span>

                    <strong id="onlineText">
                        You are Offline
                    </strong>

                </div>


                <button
                    type="button"
                    id="onlineToggle"
                    class="status-toggle"
                >

                    <span></span>

                </button>

            </section>



            <!-- ============================= -->
            <!-- STATS -->
            <!-- ============================= -->

            <section class="stats-grid">


                <!-- EARNINGS -->

                <div class="stat-card">

                    <div class="stat-icon">
                        ₹
                    </div>

                    <p>
                        Total Earnings
                    </p>

                    <h2>

                        ₹<%= deliveries
                            .filter(d => d.status === "completed")
                            .reduce(
                                (sum, d) =>
                                    sum + Number(d.earning || 0),
                                0
                            )
                        %>

                    </h2>

                </div>



                <!-- COMPLETED -->

                <div class="stat-card">

                    <div class="stat-icon">
                        📦
                    </div>

                    <p>
                        Completed Deliveries
                    </p>

                    <h2>

                        <%= deliveries.filter(
                            d => d.status === "completed"
                        ).length %>

                    </h2>

                </div>


            </section>



            <!-- ============================= -->
            <!-- NEW DELIVERY REQUESTS -->
            <!-- ============================= -->

            <section class="dashboard-section">


                <div class="section-heading">

                    <h2>
                        New Delivery Requests
                    </h2>

                </div>



                <%
                    const newDeliveries =
                        deliveries.filter(
                            d => d.status === "pending"
                        );
                %>



                <!-- EMPTY -->

                <% if (newDeliveries.length === 0) { %>

                    <div class="empty-card">

                        <div>
                            📦
                        </div>

                        <h3>
                            No new deliveries
                        </h3>

                        <p>
                            New delivery requests will appear here.
                        </p>

                    </div>

                <% } %>



                <!-- DELIVERY LIST -->

                <% newDeliveries.forEach(delivery => { %>


                    <article class="order-card">


                        <div>

                            <span class="order-id">

                                DELIVERY #

                                <%= delivery._id %>

                            </span>


                            <h3>

                                <% if (
                                    delivery.order &&
                                    delivery.order._id
                                ) { %>

                                    Order #<%= delivery.order._id %>

                                <% } else { %>

                                    New Delivery

                                <% } %>

                            </h3>


                            <p>

                                Status:
                                <strong>
                                    Pending
                                </strong>

                            </p>

                        </div>



                        <div class="delivery-actions">


                            <!-- ACCEPT -->

                            <button
                                type="button"
                                class="primary-small-button"
                                onclick="acceptDelivery('<%= delivery._id %>')"
                            >

                                Accept

                            </button>



                            <!-- REJECT -->

                            <button
                                type="button"
                                class="small-button"
                                onclick="rejectDelivery('<%= delivery._id %>')"
                            >

                                Reject

                            </button>


                        </div>


                    </article>


                <% }); %>


            </section>



            <!-- ============================= -->
            <!-- ACTIVE DELIVERIES -->
            <!-- ============================= -->

            <section class="dashboard-section">


                <div class="section-heading">

                    <h2>
                        Active Deliveries
                    </h2>

                </div>



                <%
                    const activeDeliveries =
                        deliveries.filter(
                            d =>
                                d.status === "accepted" ||
                                d.status === "reached_restaurant" ||
                                d.status === "picked_up" ||
                                d.status === "reached_location"
                        );
                %>



                <!-- EMPTY -->

                <% if (activeDeliveries.length === 0) { %>

                    <div class="empty-card">

                        <div>
                            🚴
                        </div>

                        <h3>
                            No active delivery
                        </h3>

                        <p>
                            Accepted deliveries will appear here.
                        </p>

                    </div>

                <% } %>



                <!-- ACTIVE LIST -->

                <% activeDeliveries.forEach(delivery => { %>


                    <article class="order-card">


                        <div>


                            <span class="order-id">

                                DELIVERY #

                                <%= delivery._id %>

                            </span>



                            <h3>

                                <% if (
                                    delivery.order &&
                                    delivery.order._id
                                ) { %>

                                    Order #<%= delivery.order._id %>

                                <% } else { %>

                                    Active Delivery

                                <% } %>

                            </h3>



                            <span class="status-badge">

                                <%= delivery.status
                                    .replaceAll("_", " ")
                                    .toUpperCase()
                                %>

                            </span>


                        </div>



                        <a
                            href="/delivery/active/<%= delivery._id %>"
                            class="small-button"
                        >

                            View

                        </a>


                    </article>


                <% }); %>


            </section>



            <!-- ============================= -->
            <!-- COMPLETED DELIVERIES -->
            <!-- ============================= -->

            <section class="dashboard-section">


                <div class="section-heading">

                    <h2>
                        Recently Completed
                    </h2>

                </div>



                <%
                    const completedDeliveries =
                        deliveries
                            .filter(
                                d => d.status === "completed"
                            )
                            .slice(0, 5);
                %>



                <% if (completedDeliveries.length === 0) { %>

                    <div class="empty-card">

                        <div>
                            ✅
                        </div>

                        <h3>
                            No completed deliveries
                        </h3>

                    </div>

                <% } %>



                <% completedDeliveries.forEach(delivery => { %>


                    <article class="order-card">


                        <div>

                            <span class="order-id">

                                DELIVERY #

                                <%= delivery._id %>

                            </span>


                            <h3>

                                Order Completed

                            </h3>


                            <span class="status-badge">

                                COMPLETED

                            </span>

                        </div>



                        <strong>

                            ₹<%= delivery.earning || 0 %>

                        </strong>


                    </article>


                <% }); %>


            </section>



            <%- include("../partials/footer") %>


        </main>

    </div>



    <script src="/js/delivery.js"></script>


</body>

</html>