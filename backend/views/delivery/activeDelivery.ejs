<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Active Delivery</title>

    <link
        rel="stylesheet"
        href="/css/delivery.css"
    >

</head>


<body>

    <div class="delivery-layout">

        <!-- SIDEBAR -->
        <%- include("../partials/sidebar") %>


        <main class="delivery-main">


            <!-- ============================= -->
            <!-- HEADER -->
            <!-- ============================= -->

            <header class="page-header">

                <div>

                    <span class="eyebrow">
                        DELIVERY
                    </span>

                    <h1>
                        Active Delivery
                    </h1>

                    <p>
                        Manage your current deliveries
                    </p>

                </div>

            </header>



            <!-- ============================= -->
            <!-- ACTIVE DELIVERIES -->
            <!-- ============================= -->

            <section class="dashboard-section">


                <% if (!orders || orders.length === 0) { %>

                    <div class="empty-card">

                        <div>
                            🚲
                        </div>

                        <h3>
                            No active deliveries
                        </h3>

                        <p>
                            Accepted deliveries will appear here.
                        </p>

                    </div>

                <% } else { %>


                    <% orders.forEach(order => { %>


                        <article
                            class="request-card"
                            id="delivery-<%= order.id %>"
                        >


                            <!-- ============================= -->
                            <!-- TOP -->
                            <!-- ============================= -->

                            <div class="request-top">

                                <div>

                                    <span class="order-id">

                                        DELIVERY #

                                        <%= order.id %>

                                    </span>


                                    <h2>

                                        <%= order.item %>

                                    </h2>

                                </div>


                                <strong>

                                    ₹<%= order.amount %>

                                </strong>

                            </div>



                            <!-- ============================= -->
                            <!-- ROUTE -->
                            <!-- ============================= -->

                            <div class="route-box">


                                <p>

                                    📍

                                    <strong>
                                        Pickup:
                                    </strong>

                                    <%= order.pickup %>

                                </p>


                                <% if (order.pickupArea) { %>

                                    <p>

                                        📌

                                        <strong>
                                            Area:
                                        </strong>

                                        <%= order.pickupArea %>

                                    </p>

                                <% } %>


                                <p>

                                    🏠

                                    <strong>
                                        Customer:
                                    </strong>

                                    <%= order.customer %>

                                </p>


                                <% if (order.dropArea) { %>

                                    <p>

                                        📍

                                        <strong>
                                            Address:
                                        </strong>

                                        <%= order.dropArea %>

                                    </p>

                                <% } %>


                            </div>



                            <!-- ============================= -->
                            <!-- STATUS -->
                            <!-- ============================= -->

                            <div class="request-status">

                                <span>

                                    <% if (order.status === "accepted") { %>

                                        🟡 Accepted

                                    <% } else if (order.status === "reached_restaurant") { %>

                                        📍 Restaurant Reached

                                    <% } else if (order.status === "picked_up") { %>

                                        📦 Order Picked Up

                                    <% } else if (order.status === "reached_location") { %>

                                        🏠 Customer Location Reached

                                    <% } else { %>

                                        <%= order.status %>

                                    <% } %>

                                </span>

                            </div>



                            <!-- ============================= -->
                            <!-- ACTION -->
                            <!-- ============================= -->

                            <div class="request-actions">


                                <button
                                    type="button"
                                    class="primary-button"
                                    onclick="openDelivery('<%= order.id %>')"
                                >

                                    View Delivery

                                </button>


                            </div>


                        </article>


                    <% }); %>


                <% } %>


            </section>



            <!-- FOOTER -->

            <%- include("../partials/footer") %>


        </main>

    </div>



    <!-- ============================= -->
    <!-- JAVASCRIPT -->
    <!-- ============================= -->

    <script>

        function openDelivery(id) {

            if (!id) {

                alert("Delivery ID not found.");

                return;

            }


            window.location.href =
                "/delivery/active/" + id;

        }

    </script>


    <script src="/js/delivery.js"></script>


</body>

</html>