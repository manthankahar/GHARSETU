<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>GharSetu | Active Delivery</title>

    <link
        rel="stylesheet"
        href="/css/delivery.css"
    >

</head>

<body>

    <div class="delivery-layout">

        <%- include("../partials/sidebar") %>

        <main class="delivery-main">

            <!-- ========================= -->
            <!-- HEADER -->
            <!-- ========================= -->

            <header class="page-header">

                <div>

                    <span class="eyebrow">
                        DELIVERY
                    </span>

                    <h1>
                        Active Delivery
                    </h1>

                    <p>
                        Manage your current delivery
                    </p>

                </div>

            </header>


            <!-- ========================= -->
            <!-- DELIVERY CARD -->
            <!-- ========================= -->

            <section class="dashboard-section">

                <article class="delivery-detail-card">

                    <!-- ========================= -->
                    <!-- ORDER HEADER -->
                    <!-- ========================= -->

                    <div class="order-card-header">

                        <div>

                            <span class="order-id">

                                ORDER #

                                <%= delivery.order?._id || delivery._id %>

                            </span>

                            <h2>

                                Tiffin Delivery

                            </h2>

                        </div>


                        <span class="status-badge">

                            <%= delivery.status.replaceAll("_", " ") %>

                        </span>

                    </div>


                    <!-- ========================= -->
                    <!-- DELIVERY INFO -->
                    <!-- ========================= -->

                    <div class="route-box">

                        <!-- RESTAURANT -->

                        <div class="route-row">

                            <span class="route-dot pickup">
                            </span>

                            <div>

                                <small>
                                    Restaurant
                                </small>

                                <strong>
                                    GharSetu Restaurant
                                </strong>

                                <p>
                                    Pickup your customer's order
                                </p>

                            </div>

                        </div>


                        <div class="route-line">
                        </div>


                        <!-- CUSTOMER -->

                        <div class="route-row">

                            <span class="route-dot drop">
                            </span>

                            <div>

                                <small>
                                    Customer
                                </small>

                                <strong>

                                    <%= delivery.order?.deliveryDetails?.name
                                        || "Customer"
                                    %>

                                </strong>

                                <p>

                                    <%= delivery.order?.deliveryDetails?.address
                                        || "Customer location"
                                    %>

                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- EARNING -->
                    <!-- ========================= -->

                    <div class="earning-row">

                        <div>

                            <small>
                                Current Earnings
                            </small>

                            <strong>

                                ₹<%= delivery.currentEarning || 0 %>

                            </strong>

                        </div>


                        <div>

                            <small>
                                Order Amount
                            </small>

                            <strong>

                                ₹<%= delivery.orderAmount || 0 %>

                            </strong>

                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- STEP 1 -->
                    <!-- REACHED RESTAURANT
                    <!-- ========================= -->

                    <% if (delivery.status === "accepted") { %>

                        <div class="delivery-action-card">

                            <h3>
                                📍 Step 1
                            </h3>

                            <p>
                                Reach the restaurant to pickup the order.
                            </p>

                            <button
                                class="delivery-action-button"
                                onclick="reachedRestaurant('<%= delivery._id %>')"
                            >

                                Reached at Restaurant

                            </button>

                        </div>

                    <% } %>


                    <!-- ========================= -->
                    <!-- STEP 2 -->
                    <!-- PICKUP -->
                    <!-- ========================= -->

                    <% if (delivery.status === "reached_restaurant") { %>

                        <div class="delivery-action-card">

                            <h3>
                                📦 Step 2
                            </h3>

                            <p>
                                Verify pickup using OTP or photo.
                            </p>


                            <!-- OTP -->

                            <div class="pickup-method-box">

                                <h4>
                                    🔐 Verify with OTP
                                </h4>

                                <input
                                    type="text"
                                    id="pickupOtp"
                                    placeholder="Enter OTP"
                                    maxlength="4"
                                    inputmode="numeric"
                                >

                                <button
                                    class="delivery-action-button"
                                    onclick="verifyPickupOtp('<%= delivery._id %>')"
                                >

                                    Verify OTP

                                </button>

                                <small>
                                    Demo OTP: <strong>1234</strong>
                                </small>

                            </div>


                            <div class="pickup-divider">

                                OR

                            </div>


                            <!-- PHOTO -->

                            <div class="pickup-method-box">

                                <h4>
                                    📷 Verify with Photo
                                </h4>

                                <p>
                                    Take a pickup photo using your camera.
                                </p>

                                <input
                                    type="file"
                                    id="pickupPhoto"
                                    accept="image/*"
                                    capture="environment"
                                >

                                <div
                                    id="pickupPreview"
                                    class="pickup-photo-preview"
                                >
                                </div>

                                <button
                                    class="delivery-action-button"
                                    onclick="uploadPickupPhoto('<%= delivery._id %>')"
                                >

                                    Verify Pickup Photo

                                </button>

                            </div>

                        </div>

                    <% } %>


                    <!-- ========================= -->
                    <!-- STEP 3 -->
                    <!-- REACHED LOCATION -->
                    <!-- ========================= -->

                    <% if (delivery.status === "picked_up") { %>

                        <div class="delivery-action-card">

                            <h3>
                                📍 Step 3
                            </h3>

                            <p>
                                You have picked up the order.
                                Reach the customer's location.
                            </p>

                            <button
                                class="delivery-action-button"
                                onclick="reachedCustomerLocation('<%= delivery._id %>')"
                            >

                                Reached at Location

                            </button>

                        </div>

                    <% } %>


                    <!-- ========================= -->
                    <!-- STEP 4 -->
                    <!-- PAYMENT -->
                    <!-- ========================= -->

                    <% if (delivery.status === "reached_location") { %>

                        <div class="delivery-action-card payment-card">

                            <h3>
                                💳 Step 4 — Payment
                            </h3>

                            <p>
                                Select how the customer paid.
                            </p>


                            <!-- ORDER AMOUNT -->

                            <div class="payment-amount">

                                <span>
                                    Order Amount
                                </span>

                                <strong>
                                    ₹<%= delivery.orderAmount || delivery.order?.total || 0 %>
                                </strong>

                            </div>


                            <!-- PAYMENT OPTIONS -->

                            <div class="payment-options">

                                <button
                                    type="button"
                                    class="payment-option"
                                    onclick="selectPayment('cash')"
                                    id="cashPaymentBtn"
                                >

                                    💵

                                    <span>
                                        Cash
                                    </span>

                                </button>


                                <button
                                    type="button"
                                    class="payment-option"
                                    onclick="selectPayment('online')"
                                    id="onlinePaymentBtn"
                                >

                                    📱

                                    <span>
                                        Online
                                    </span>

                                </button>

                            </div>


                            <!-- DEMO QR -->

                            <div
                                id="demoQrBox"
                                class="demo-qr-box"
                                style="display:none;"
                            >

                                <h4>
                                    Scan to Pay
                                </h4>

                                <div class="demo-qr">

                                    <div class="qr-placeholder">

                                        DEMO QR

                                    </div>

                                </div>

                                <p>
                                    Demo payment QR
                                </p>

                            </div>


                            <!-- COMPLETE -->

                            <button
                                id="completeDeliveryBtn"
                                class="complete-delivery-button"
                                onclick="completeDelivery('<%= delivery._id %>')"
                                disabled
                            >

                                Complete Delivery

                            </button>

                        </div>

                    <% } %>


                    <!-- ========================= -->
                    <!-- COMPLETED -->
                    <!-- ========================= -->

                    <% if (delivery.status === "completed") { %>

                        <div class="delivery-completed-card">

                            <div class="completed-icon">
                                ✓
                            </div>

                            <h2>
                                Delivery Completed
                            </h2>

                            <p>
                                This delivery has already been completed.
                            </p>

                            <div class="completed-earning">

                                ₹<%= delivery.currentEarning || 0 %>

                            </div>

                            <span>
                                Current Earnings
                            </span>

                        </div>

                    <% } %>


                </article>

            </section>


            <!-- ========================= -->
            <!-- FOOTER -->
            <!-- ========================= -->

            <%- include("../partials/footer") %>

        </main>

    </div>


    <!-- ========================= -->
    <!-- COMPLETION POPUP -->
    <!-- ========================= -->

    <div
        id="deliverySuccessPopup"
        class="delivery-success-overlay"
    >

        <div class="delivery-success-popup">

            <div class="success-icon">
                ✓
            </div>

            <h2>
                Congratulations! 🎉
            </h2>

            <p id="successPaymentText">
                Delivery completed successfully.
            </p>

            <div
                id="successEarning"
                class="success-big-earning"
            >
                ₹0
            </div>

            <span>
                Current Earnings
            </span>

            <button
                onclick="closeDeliverySuccess()"
                class="success-close-button"
            >

                Continue

            </button>

        </div>

    </div>


    <script src="/js/delivery.js"></script>

</body>

</html>