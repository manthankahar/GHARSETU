<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GharSetu | Checkout</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("../partials/navbar") %>

    <main class="checkout-page">

        <!-- HEADER -->
        <section class="checkout-header">

            <p class="section-label">
                CHECKOUT
            </p>

            <h1>
                Almost <span>home.</span>
            </h1>

            <p>
                Confirm your delivery details and place your order.
            </p>

        </section>


        <!-- CHECKOUT FORM -->
        <form
            action="/customer/place-order"
            method="POST"
        >

            <section class="checkout-container">

                <!-- LEFT SIDE -->
                <div class="checkout-left">

                    <!-- DELIVERY DETAILS -->
                    <div class="checkout-card">

                        <div class="checkout-card-header">

                            <div>

                                <p class="section-label">
                                    01
                                </p>

                                <h2>
                                    Delivery details
                                </h2>

                            </div>

                        </div>


                        <div class="form-grid">

                            <!-- NAME -->
                            <div class="form-group">

                                <label for="name">
                                    Full Name
                                </label>

                                <input
                                    type="text"
                                    id="name"
                                    name="name"
                                    placeholder="Enter your name"
                                    required
                                >

                            </div>


                            <!-- MOBILE -->
                            <div class="form-group">

                                <label for="mobile">
                                    Mobile Number
                                </label>

                                <input
                                    type="tel"
                                    id="mobile"
                                    name="mobile"
                                    placeholder="9876543210"
                                    required
                                >

                            </div>


                            <!-- ADDRESS -->
                            <div class="form-group full">

                                <label for="address">
                                    Delivery Address
                                </label>

                                <textarea
                                    id="address"
                                    name="address"
                                    rows="4"
                                    placeholder="Enter your complete address"
                                    required
                                ></textarea>

                            </div>


                            <!-- CITY -->
                            <div class="form-group">

                                <label for="city">
                                    City
                                </label>

                                <input
                                    type="text"
                                    id="city"
                                    name="city"
                                    placeholder="Ahmedabad"
                                    required
                                >

                            </div>


                            <!-- PINCODE -->
                            <div class="form-group">

                                <label for="pincode">
                                    Pincode
                                </label>

                                <input
                                    type="text"
                                    id="pincode"
                                    name="pincode"
                                    placeholder="380001"
                                    required
                                >

                            </div>

                        </div>

                    </div>



                    <!-- PAYMENT -->
                    <div class="checkout-card">

                        <p class="section-label">
                            02
                        </p>

                        <h2>
                            Payment method
                        </h2>


                        <div class="payment-options">

                            <!-- COD -->
                            <label class="payment-option">

                                <input
                                    type="radio"
                                    name="payment"
                                    value="cod"
                                    checked
                                >

                                <div>

                                    <strong>
                                        Cash on Delivery
                                    </strong>

                                    <span>
                                        Pay when your food arrives
                                    </span>

                                </div>

                            </label>


                            <!-- ONLINE -->
                            <label class="payment-option">

                                <input
                                    type="radio"
                                    name="payment"
                                    value="online"
                                >

                                <div>

                                    <strong>
                                        Online Payment
                                    </strong>

                                    <span>
                                        Pay securely online
                                    </span>

                                </div>

                            </label>

                        </div>

                    </div>

                </div>



                <!-- RIGHT SIDE -->
                <aside class="checkout-summary">

                    <p class="section-label">
                        YOUR ORDER
                    </p>

                    <h2>
                        Order summary
                    </h2>


                    <!-- PRODUCT -->
                    <div class="checkout-product">

                        <img
                            src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=300&q=80"
                            alt="Gujarati Ghar Nu Tiffin"
                        >

                        <div>

                            <h3>
                                Gujarati Ghar Nu Tiffin
                            </h3>

                            <p>
                                1 × ₹120
                            </p>

                        </div>

                        <strong>
                            ₹120
                        </strong>

                    </div>


                    <div class="summary-divider"></div>


                    <!-- SUBTOTAL -->
                    <div class="summary-row">

                        <span>
                            Subtotal
                        </span>

                        <strong>
                            ₹120
                        </strong>

                    </div>


                    <!-- DELIVERY -->
                    <div class="summary-row">

                        <span>
                            Delivery
                        </span>

                        <strong>
                            ₹20
                        </strong>

                    </div>


                    <!-- TOTAL -->
                    <div class="summary-row checkout-total">

                        <span>
                            Total
                        </span>

                        <strong>
                            ₹140
                        </strong>

                    </div>


                    <!-- PLACE ORDER -->
                    <button
                        type="submit"
                        class="primary-btn place-order-btn"
                    >
                        Place Order →
                    </button>


                    <p class="secure-note">
                        🔒 Your order information is secure.
                    </p>

                </aside>

            </section>

        </form>

    </main>


    <%- include("../partials/footer") %>

    <script src="/js/checkout.js"></script>

</body>

</html>