<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        GharSetu | <%= restaurant.name %>
    </title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("../partials/navbar") %>

    <main class="restaurant-details-page">

        <% if (restaurant) { %>

            <!-- =========================
                 RESTAURANT BANNER
            ========================== -->

            <section class="restaurant-banner">

                <img
                    src="<%= restaurant.image || '/images/restaurant-placeholder.jpg' %>"
                    alt="<%= restaurant.name %>"
                >

                <div>

                    <h1>
                        <%= restaurant.name %>
                    </h1>

                    <p>
                        <%= restaurant.description || "" %>
                    </p>

                    <% if (restaurant.location) { %>
                        <p>
                            📍 <%= restaurant.location %>
                        </p>
                    <% } %>

                </div>

            </section>


            <!-- =========================
                 RESTAURANT MENU
            ========================== -->

            <section class="restaurant-menu">

                <h2>Menu</h2>

                <% if (products && products.length > 0) { %>

                    <div class="product-grid">

                        <% products.forEach(product => { %>

                            <div class="product-card">

                                <img
                                    src="<%= product.image || '/images/restaurant-placeholder.jpg' %>"
                                    alt="<%= product.name %>"
                                >

                                <h3>
                                    <%= product.name %>
                                </h3>

                                <p>
                                    <%= product.description || "" %>
                                </p>

                                <strong>
                                    ₹<%= product.price %>
                                </strong>


                                <!-- =========================
                                     ADD TO CART
                                ========================== -->

                                <button
                                    type="button"
                                    class="add-to-cart-btn"
                                    data-product-id="<%= product._id %>"
                                    data-product-name="<%= product.name %>"
                                >
                                    Add to Cart
                                </button>

                            </div>

                        <% }) %>

                    </div>

                <% } else { %>

                    <p>
                        No menu items available.
                    </p>

                <% } %>

            </section>

        <% } else { %>

            <h2>
                Restaurant not found.
            </h2>

        <% } %>

    </main>


    <!-- =========================
         POPUP MESSAGE
    ========================== -->

    <div
        id="cartMessage"
        style="
            display:none;
            position:fixed;
            right:20px;
            bottom:20px;
            z-index:9999;
            padding:14px 20px;
            border-radius:10px;
            background:#333;
            color:#fff;
            font-weight:600;
        "
    ></div>


    <!-- =========================
         ADD TO CART JAVASCRIPT
    ========================== -->

    <script>

        const cartMessage = document.getElementById("cartMessage");


        function showCartMessage(message, success = true) {

            cartMessage.textContent = message;

            cartMessage.style.display = "block";

            cartMessage.style.background = success
                ? "#4CAF50"
                : "#d9534f";


            setTimeout(() => {

                cartMessage.style.display = "none";

            }, 2500);
        }


        document.querySelectorAll(".add-to-cart-btn").forEach(button => {

            button.addEventListener("click", async function () {

                const productId = this.dataset.productId;
                const productName = this.dataset.productName;


                if (!productId) {

                    showCartMessage(
                        "Product ID missing",
                        false
                    );

                    return;
                }


                try {

                    this.disabled = true;

                    this.textContent = "Adding...";


                    const response = await fetch("/cart/add", {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        credentials: "include",

                        body: JSON.stringify({

                            productId: productId,
                            quantity: 1

                        })

                    });


                    const data = await response.json();


                    if (!response.ok) {

                        if (
                            response.status === 401 ||
                            response.status === 403
                        ) {

                            showCartMessage(
                                "Please login first",
                                false
                            );

                        } else {

                            showCartMessage(
                                data.message || "Failed to add item",
                                false
                            );
                        }

                        return;
                    }


                    showCartMessage(
                        `${productName} added to cart 🛒`,
                        true
                    );


                } catch (error) {

                    console.error(
                        "ADD TO CART ERROR:",
                        error
                    );

                    showCartMessage(
                        "Something went wrong",
                        false
                    );


                } finally {

                    this.disabled = false;

                    this.textContent = "Add to Cart";

                }

            });

        });

    </script>

</body>
</html>