<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GharSetu | Tiffins</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <%- include("../partials/navbar") %>

    <main class="tiffin-page">

        <section class="tiffin-header">

            <p class="section-label">DISCOVER</p>

            <h1>
                Fresh tiffins,
                <span>made with care.</span>
            </h1>

            <p>
                Explore homemade meals from trusted kitchens near you.
            </p>

        </section>


        <section class="tiffin-grid">


            <!-- ==============================
                 TIFFIN 1
            =============================== -->

            <div class="tiffin-card">

                <div class="tiffin-image">

                    <img
                        src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=85"
                        alt="Gujarati Home Tiffin"
                    >

                </div>

                <div class="tiffin-content">

                    <span class="tiffin-badge">
                        HOMEMADE
                    </span>

                    <h2>Gujarati Ghar Nu Tiffin</h2>

                    <p>
                        Rotli, shaak, dal, rice, salad and homemade
                        sweet.
                    </p>

                    <div class="tiffin-bottom">

                        <strong>₹120</strong>

                        <a href="/customer/tiffins/1">
                            View Tiffin →
                        </a>

                    </div>

                </div>

            </div>


            <!-- ==============================
                 TIFFIN 2
            =============================== -->

            <div class="tiffin-card">

                <div class="tiffin-image">

                    <img
                        src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=900&q=85"
                        alt="Healthy Tiffin"
                    >

                </div>

                <div class="tiffin-content">

                    <span class="tiffin-badge green">
                        HEALTHY
                    </span>

                    <h2>Healthy Daily Tiffin</h2>

                    <p>
                        Fresh vegetables, dal, rice and nutritious
                        homemade food.
                    </p>

                    <div class="tiffin-bottom">

                        <strong>₹140</strong>

                        <a href="/customer/tiffins/2">
                            View Tiffin →
                        </a>

                    </div>

                </div>

            </div>


            <!-- ==============================
                 TIFFIN 3
            =============================== -->

            <div class="tiffin-card">

                <div class="tiffin-image">

                    <img
                        src="https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=900&q=85"
                        alt="Punjabi Tiffin"
                    >

                </div>

                <div class="tiffin-content">

                    <span class="tiffin-badge">
                        POPULAR
                    </span>

                    <h2>Punjabi Home Tiffin</h2>

                    <p>
                        Delicious Punjabi-style homemade lunch
                        prepared fresh.
                    </p>

                    <div class="tiffin-bottom">

                        <strong>₹150</strong>

                        <a href="/customer/tiffins/3">
                            View Tiffin →
                        </a>

                    </div>

                </div>

            </div>


        </section>

    </main>


    <%- include("../partials/footer") %>

</body>

</html>