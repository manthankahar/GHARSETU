<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        GharSetu | Tiffins
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <style>

        .tiffin-message {

            position: fixed;

            top: 25px;

            right: 25px;

            z-index: 9999;

            background: #5b3a29;

            color: white;

            padding: 14px 20px;

            border-radius: 12px;

            box-shadow:
                0 10px 30px rgba(0, 0, 0, .18);

            transform:
                translateX(150%);

            transition:
                transform .3s ease;

        }


        .tiffin-message.show {

            transform:
                translateX(0);

        }


        .tiffin-card {

            cursor: pointer;

        }


        .tiffin-actions {

            display: flex;

            gap: 10px;

            align-items: center;

            margin-top: 15px;

        }


        .view-btn,
        .add-cart-btn {

            display: inline-block;

            padding: 10px 16px;

            border-radius: 8px;

            text-decoration: none;

            border: none;

            cursor: pointer;

            transition: .2s;

            font-size: 14px;

        }


        .view-btn {

            background: #5b3a29;

            color: white;

        }


        .add-cart-btn {

            background: #ead7c4;

            color: #5b3a29;

            font-weight: 600;

        }


        .view-btn:hover,
        .add-cart-btn:hover {

            transform:
                translateY(-2px);

        }


        .add-cart-btn:disabled {

            opacity: .6;

            cursor: not-allowed;

            transform: none;

        }


        .empty-tiffin {

            text-align: center;

            padding: 60px 20px;

        }

    </style>

</head>


<body>


    <!-- =========================================
         NAVBAR
    ========================================== -->

    <%- include("../partials/navbar") %>



    <!-- =========================================
         POPUP MESSAGE
    ========================================== -->

    <div
        id="tiffinMessage"
        class="tiffin-message"
    ></div>



    <main class="tiffin-page">


        <!-- =========================================
             HEADER
        ========================================== -->

        <section class="tiffin-header">

            <p class="section-label">
                DISCOVER
            </p>


            <h1>

                Fresh tiffins,

                <span>
                    made with care.
                </span>

            </h1>


            <p>
                Explore homemade meals from
                trusted kitchens near you.
            </p>

        </section>



        <!-- =========================================
             TIFFIN GRID
        ========================================== -->

        <section class="tiffin-grid">


            <% if (products && products.length > 0) { %>


                <% products.forEach(product => { %>


                    <div
                        class="tiffin-card"
                        onclick="openTiffin('<%= product._id %>')"
                    >


                        <!-- =================================
                             IMAGE
                        ================================== -->

                        <div class="tiffin-image">


                            <% if (product.image) { %>

                                <img
                                    src="<%= product.image %>"
                                    alt="<%= product.name %>"
                                >

                            <% } else { %>

                                <img
                                    src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=85"
                                    alt="Tiffin"
                                >

                            <% } %>


                        </div>



                        <!-- =================================
                             CONTENT
                        ================================== -->

                        <div class="tiffin-content">


                            <span class="tiffin-badge">
                                HOMEMADE
                            </span>


                            <h2>
                                <%= product.name %>
                            </h2>


                            <p>
                                <%= product.description || "Fresh homemade tiffin prepared with care." %>
                            </p>



                            <!-- =================================
                                 BOTTOM
                            ================================== -->

                            <div class="tiffin-bottom">


                                <strong>

                                    ₹<%= Number(
                                        product.finalPrice ||
                                        product.price ||
                                        0
                                    ).toFixed(0) %>

                                </strong>


                            </div>



                            <!-- =================================
                                 ACTIONS
                            ================================== -->

                            <div class="tiffin-actions">


                                <!-- VIEW -->

                                <a
                                    href="/customer/tiffins/<%= product._id %>"
                                    class="view-btn"
                                    onclick="event.stopPropagation()"
                                >
                                    View Tiffin →
                                </a>



                                <!-- ADD TO CART -->

                                <button
                                    type="button"
                                    class="add-cart-btn"
                                    onclick="event.stopPropagation(); addToCart('<%= product._id %>', this)"
                                >
                                    🛒 Add to Cart
                                </button>


                            </div>


                        </div>


                    </div>


                <% }) %>


            <% } else { %>


                <!-- =================================
                     EMPTY
                ================================== -->

                <div class="empty-tiffin">

                    <h2>
                        🍱 No Tiffins Available
                    </h2>

                    <p>
                        New homemade tiffins will
                        appear here soon.
                    </p>

                </div>


            <% } %>


        </section>


    </main>



    <!-- =========================================
         FOOTER
    ========================================== -->

    <%- include("../partials/footer") %>



    <!-- =========================================
         JAVASCRIPT
    ========================================== -->

    <script>


        // =========================================
        // POPUP
        // =========================================

        function showTiffinMessage(
            message,
            success = true
        ) {

            const popup =
                document.getElementById(
                    "tiffinMessage"
                );


            if (!popup) {
                return;
            }


            popup.textContent =
                message;


            popup.style.background =
                success
                    ? "#5b3a29"
                    : "#9b2c2c";


            popup.classList.add(
                "show"
            );


            setTimeout(
                () => {

                    popup.classList.remove(
                        "show"
                    );

                },
                2500
            );

        }



        // =========================================
        // OPEN TIFFIN DETAILS
        // =========================================

        function openTiffin(id) {

            if (!id) {
                return;
            }


            window.location.href =
                "/customer/tiffins/" + id;

        }



        // =========================================
        // ADD TIFFIN TO CART
        // =========================================

        async function addToCart(
            menuItemId,
            button
        ) {

            if (!menuItemId) {

                showTiffinMessage(
                    "Invalid tiffin.",
                    false
                );

                return;

            }


            // -------------------------------------
            // BUTTON LOADING
            // -------------------------------------

            const originalText =
                button
                    ? button.textContent
                    : "";


            if (button) {

                button.disabled =
                    true;

                button.textContent =
                    "Adding...";

            }


            try {


                // ---------------------------------
                // API REQUEST
                // ---------------------------------

                const response =
                    await fetch(
                        "/api/cart/add",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            credentials:
                                "include",

                            body:
                                JSON.stringify({

                                    itemType:
                                        "menuItem",

                                    menuItemId:
                                        menuItemId,

                                    quantity:
                                        1

                                })

                        }
                    );



                // ---------------------------------
                // RESPONSE
                // ---------------------------------

                const data =
                    await response.json();



                // ---------------------------------
                // LOGIN REQUIRED
                // ---------------------------------

                if (
                    response.status === 401
                ) {

                    showTiffinMessage(
                        "Please login first.",
                        false
                    );


                    setTimeout(
                        () => {

                            window.location.href =
                                "/customer/login";

                        },
                        1000
                    );


                    return;

                }



                // ---------------------------------
                // ERROR
                // ---------------------------------

                if (!response.ok) {

                    showTiffinMessage(
                        data.message ||
                        "Failed to add tiffin to cart.",
                        false
                    );

                    return;

                }



                // ---------------------------------
                // SUCCESS
                // ---------------------------------

                showTiffinMessage(
                    data.message ||
                    "Tiffin added to cart! 🛒",
                    true
                );


                // ---------------------------------
                // BUTTON UPDATE
                // ---------------------------------

                if (button) {

                    button.textContent =
                        "✓ Added";

                }



            } catch (error) {


                console.error(
                    "ADD TIFFIN CART ERROR:",
                    error
                );


                showTiffinMessage(
                    "Unable to connect to server.",
                    false
                );


            } finally {


                // ---------------------------------
                // RESTORE BUTTON
                // ---------------------------------

                setTimeout(
                    () => {

                        if (button) {

                            button.disabled =
                                false;

                            button.textContent =
                                originalText;

                        }

                    },
                    1800
                );

            }

        }


    </script>


</body>

</html>