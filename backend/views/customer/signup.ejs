<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Account | Tiffin App</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="auth-container">

        <!-- Left Side -->
        <div class="auth-info">

            <div class="brand">
                🍱 Tiffin App
            </div>

            <div class="info-content">
                <h1>Fresh food.<br>Made for you.</h1>

                <p>
                    Discover delicious homemade tiffins,
                    trusted restaurants and convenient
                    daily meal subscriptions.
                </p>

                <div class="features">
                    <div class="feature">
                        <span>🥗</span>
                        <div>
                            <strong>Fresh Meals</strong>
                            <small>Homemade & healthy food</small>
                        </div>
                    </div>

                    <div class="feature">
                        <span>🚴</span>
                        <div>
                            <strong>Fast Delivery</strong>
                            <small>Meals delivered to your door</small>
                        </div>
                    </div>

                    <div class="feature">
                        <span>⭐</span>
                        <div>
                            <strong>Trusted Providers</strong>
                            <small>Quality food from verified sellers</small>
                        </div>
                    </div>
                </div>
            </div>

        </div>


        <!-- Right Side -->
        <div class="auth-form-section">

            <div class="auth-card">

                <div class="form-header">
                    <span class="form-icon">👋</span>

                    <h2>Create your account</h2>

                    <p>
                        Join Tiffin App and discover your
                        perfect meal.
                    </p>
                </div>


                <form id="signupForm">

                    <!-- Name -->
                    <div class="form-group">

                        <label for="name">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter your full name"
                            autocomplete="name"
                            required
                        >

                    </div>


                    <!-- Email -->
                    <div class="form-group">

                        <label for="email">
                            Email Address
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            autocomplete="email"
                            required
                        >

                    </div>


                    <!-- Mobile -->
                    <div class="form-group">

                        <label for="mobile">
                            Mobile Number
                        </label>

                        <input
                            type="tel"
                            id="mobile"
                            name="mobile"
                            placeholder="Enter your mobile number"
                            autocomplete="tel"
                            maxlength="10"
                            required
                        >

                    </div>


                    <!-- Password -->
                    <div class="form-group">

                        <label for="password">
                            Password
                        </label>

                        <div class="password-wrapper">

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Create a password"
                                autocomplete="new-password"
                                minlength="6"
                                required
                            >

                            <button
                                type="button"
                                id="togglePassword"
                                class="password-toggle"
                            >
                                👁
                            </button>

                        </div>

                    </div>


                    <!-- Confirm Password -->
                    <div class="form-group">

                        <label for="confirmPassword">
                            Confirm Password
                        </label>

                        <div class="password-wrapper">

                            <input
                                type="password"
                                id="confirmPassword"
                                placeholder="Confirm your password"
                                autocomplete="new-password"
                                required
                            >

                            <button
                                type="button"
                                id="toggleConfirmPassword"
                                class="password-toggle"
                            >
                                👁
                            </button>

                        </div>

                    </div>


                    <!-- Terms -->
                    <div class="terms">

                        <input
                            type="checkbox"
                            id="terms"
                            required
                        >

                        <label for="terms">
                            I agree to the Terms & Conditions
                        </label>

                    </div>


                    <!-- Submit -->
                    <button
                        type="submit"
                        class="auth-button"
                        id="signupButton"
                    >
                        Create Account
                    </button>

                </form>


                <div class="divider">
                    <span>Already have an account?</span>
                </div>


                <a
                    href="/customer/login"
                    class="login-link"
                >
                    Login to your account
                </a>

            </div>

        </div>

    </div>


    <!-- Toast -->
    <div id="toast" class="toast"></div>


    <script src="/js/signup.js"></script>

</body>

</html>