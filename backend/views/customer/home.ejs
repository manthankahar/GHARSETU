<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GharSetu | Home</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("../partials/navbar") %>

    <main>

        <!-- HERO -->

        <section class="hero-section">

            <div class="hero-content">

                <h1>Welcome to GharSetu</h1>

                <p>
                    Fresh food, delicious tiffins and trusted restaurants
                    delivered to your doorstep.
                </p>

                <div class="hero-buttons">

                    <a href="/tiffins" class="btn">
                        Explore Tiffins
                    </a>

                    <a href="/restaurants" class="btn">
                        Find Restaurants
                    </a>

                </div>

            </div>

        </section>


        <!-- SERVICES -->

        <section class="services-section">

            <h2>What are you looking for?</h2>

            <div class="service-grid">

                <a href="/tiffins" class="service-card">

                    <div class="service-icon">🍱</div>

                    <h3>Tiffins</h3>

                    <p>
                        Find fresh and affordable homemade tiffins.
                    </p>

                </a>


                <a href="/restaurants" class="service-card">

                    <div class="service-icon">🍽️</div>

                    <h3>Restaurants</h3>

                    <p>
                        Explore restaurants and their delicious food.
                    </p>

                </a>


                <a href="/subscriptions" class="service-card">

                    <div class="service-icon">📅</div>

                    <h3>Subscriptions</h3>

                    <p>
                        Manage your monthly food subscriptions.
                    </p>

                </a>

            </div>

        </section>


        <!-- QUICK LINKS -->

        <section class="quick-section">

            <h2>Quick Access</h2>

            <div class="quick-links">

                <a href="/search">
                    🔍 Search Food
                </a>

                <a href="/orders">
                    📦 My Orders
                </a>

                <a href="/cart">
                    🛒 My Cart
                </a>

                <a href="/profile">
                    👤 My Profile
                </a>

            </div>

        </section>

    </main>

</body>
</html>